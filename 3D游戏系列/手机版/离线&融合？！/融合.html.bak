<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>体素沙盒 · 离线/联机</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Segoe UI','PingFang SC',sans-serif;overflow:hidden;background:#0b0f1a;user-select:none;touch-action:none;position:fixed;width:100%;height:100%}
#scene-container{width:100vw;height:100vh;background:#151e2e;overflow:hidden;position:relative}
#scene-container canvas{display:block;width:100%!important;height:100%!important}
#hud{position:absolute;top:14px;left:50%;transform:translateX(-50%);z-index:20;display:flex;align-items:center;gap:14px;padding:6px 20px;background:rgba(8,14,30,.75);border-radius:40px;border:1px solid rgba(255,255,255,.06);color:#b0c8e8;font-size:.6rem;pointer-events:none;white-space:nowrap;box-shadow:0 4px 24px rgba(0,0,0,.3)}
#hud .dot{width:16px;height:16px;border-radius:4px;display:inline-block;border:1.5px solid rgba(255,255,255,.1);margin-right:4px}
#hud .name{color:#e0ecff;font-weight:600}
#hud .right{display:flex;gap:12px;font-family:monospace;font-size:.5rem;color:#4ecdc4;align-items:center}
.hud-btn{pointer-events:auto;position:relative;width:24px;height:24px;border-radius:8px;border:1px solid rgba(255,255,255,.12);background:rgba(78,205,196,.15);color:#4ecdc4;display:flex;align-items:center;justify-content:center;cursor:pointer;padding:0;transition:.1s}
.hud-btn:active{transform:scale(.86);background:rgba(78,205,196,.4)}
.hud-btn svg{width:15px;height:15px;fill:currentColor;display:block}
.hud-btn.chat{background:rgba(255,159,67,.15);color:#ff9f43;border-color:rgba(255,159,67,.25)}
.hud-btn.chat:active{background:rgba(255,159,67,.4)}
.hud-btn.chat .badge{position:absolute;top:-4px;right:-4px;min-width:14px;height:14px;padding:0 3px;border-radius:7px;background:#ff6b6b;color:#fff;font-size:.45rem;font-weight:700;display:flex;align-items:center;justify-content:center;font-family:monospace;line-height:1;pointer-events:none}
.hud-btn.chat .badge.hidden{display:none}
.hud-btn.panel{background:rgba(162,155,254,.15);color:#a29bfe;border-color:rgba(162,155,254,.25)}
.hud-btn.panel:active{background:rgba(162,155,254,.4)}
.hud-btn.hidden{display:none}
#bottom-controls{position:absolute;bottom:16px;left:0;right:0;z-index:30;display:flex;flex-direction:column;gap:8px;padding:0 12px;pointer-events:none}
#bottom-controls>*{pointer-events:auto}
#toolbar{display:flex;align-items:center;justify-content:space-between;padding:6px 0;position:relative}
.tool-group{display:flex;gap:6px;align-items:center}
.btn-icon{width:42px;height:42px;border:none;border-radius:12px;background:rgba(0,0,0,.55);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;touch-action:none;transition:.08s;border:1px solid rgba(255,255,255,.08);box-shadow:0 2px 10px rgba(0,0,0,.3);font-family:inherit}
.btn-icon:active{transform:scale(.85);background:rgba(78,205,196,.35)}
.btn-icon.action:active{background:rgba(255,107,107,.35)}
.btn-icon svg{width:22px;height:22px;fill:currentColor;display:block}
#shape-indicator{display:flex;align-items:center;gap:8px;background:rgba(0,0,0,.45);padding:3px 12px 3px 6px;border-radius:30px;border:1px solid rgba(255,255,255,.05)}
#shape-dot{width:20px;height:20px;border-radius:6px;border:1.5px solid rgba(255,255,255,.1);flex-shrink:0}
#shape-name{color:#e0ecff;font-size:.6rem;font-weight:500}
#control-row{display:flex;align-items:center;justify-content:space-between;padding:6px 0}
#joystick-area{position:relative;width:100px;height:100px;touch-action:none;flex-shrink:0}
#joystick-base{position:absolute;inset:0;border-radius:50%;background:transparent;border:2px solid rgba(255,255,255,.18)}
#joystick-thumb{position:absolute;width:44%;height:44%;border-radius:50%;background:radial-gradient(circle at 35% 35%,#6e6e6e,#050505);border:2.5px solid rgba(255,255,255,.18);box-shadow:0 0 20px rgba(0,0,0,.5);top:28%;left:28%;pointer-events:none;transition:none}
#btn-jump{width:80px;height:80px;border:none;border-radius:50%;color:#fff;background:linear-gradient(145deg,#3a3a3a,#0a0a0a);box-shadow:0 6px 24px rgba(0,0,0,.45),inset 0 -4px 0 rgba(0,0,0,.15);cursor:pointer;touch-action:none;transition:.06s;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:2px solid rgba(255,255,255,.12)}
#btn-jump:active{transform:scale(.85);box-shadow:0 3px 12px rgba(0,0,0,.35)}
#btn-jump svg{width:32px;height:32px;fill:#fff}
#color-overlay,#profile-overlay,#chat-overlay{position:fixed;inset:0;z-index:200;background:rgba(0,0,0,.6);display:flex;align-items:center;justify-content:center;opacity:0;visibility:hidden;transition:opacity .25s ease,visibility .25s ease}
#color-overlay{z-index:205}
#profile-overlay{z-index:210}
#chat-overlay{z-index:215}
#color-overlay.show,#profile-overlay.show,#chat-overlay.show{opacity:1;visibility:visible}
#color-panel,#profile-panel,#chat-panel{background:rgba(18,26,48,.98);border:1.5px solid rgba(78,205,196,.25);border-radius:28px;padding:22px 22px 18px;width:300px;max-width:88vw;box-shadow:0 24px 80px rgba(0,0,0,.7);transform:scale(.88) translateY(12px);opacity:0;transition:transform .3s cubic-bezier(.34,1.56,.64,1),opacity .25s ease;display:flex;flex-direction:column;gap:14px}
#chat-panel{width:340px;max-width:92vw;max-height:76vh;padding:16px;gap:10px;border-color:rgba(255,159,67,.25)}
#color-overlay.show #color-panel,#profile-overlay.show #profile-panel,#chat-overlay.show #chat-panel{transform:scale(1) translateY(0);opacity:1}
.cp-header,.pf-header,.ch-header{display:flex;align-items:center;justify-content:space-between;color:#e0ecff;font-size:.9rem;font-weight:600;letter-spacing:.5px;gap:8px}
.ch-header .ch-status{font-size:.55rem;font-weight:400;color:#ff9f43;font-family:monospace;flex:1;text-align:right}
.ch-close{width:26px;height:26px;border-radius:8px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.06);color:#b0c8e8;font-size:.9rem;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;font-family:inherit;flex-shrink:0}
.ch-close:active{transform:scale(.9);background:rgba(255,107,107,.3);color:#fff}
.cp-header .cp-preview{width:32px;height:32px;border-radius:10px;border:2px solid rgba(255,255,255,.12);background:#4ecdc4;transition:background .1s}
.cp-row,.pf-row{display:flex;flex-direction:column;gap:6px}
.cp-row label,.pf-row label{color:#8aa4c8;font-size:.65rem;display:flex;justify-content:space-between;font-weight:500}
.cp-row label span{color:#4ecdc4;font-family:monospace;font-size:.6rem}
.cp-slider{-webkit-appearance:none;appearance:none;width:100%;height:8px;border-radius:6px;outline:none;cursor:pointer;touch-action:none}
.cp-slider::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;width:20px;height:20px;border-radius:50%;background:#fff;border:3px solid #4ecdc4;box-shadow:0 2px 10px rgba(0,0,0,.5);cursor:pointer}
.cp-slider::-moz-range-thumb{width:20px;height:20px;border-radius:50%;background:#fff;border:3px solid #4ecdc4;box-shadow:0 2px 10px rgba(0,0,0,.5);cursor:pointer}
#cp-hue{background:linear-gradient(to right,#ff0000,#ffff00,#00ff00,#00ffff,#0000ff,#ff00ff,#ff0000)}
#cp-sat{background:linear-gradient(to right,#808080,#ff6b6b)}
#cp-light{background:linear-gradient(to right,#000000,#ff6b6b,#ffffff)}
#cp-alpha{background:linear-gradient(to right,rgba(255,255,255,.05),#ff6b6b)}
.cp-actions{display:flex;gap:10px;margin-top:4px}
.cp-btn{flex:1;padding:10px 0;border-radius:14px;border:1px solid rgba(255,255,255,.08);font-size:.75rem;font-weight:600;cursor:pointer;transition:.1s;font-family:inherit;touch-action:manipulation}
.cp-btn:active{transform:scale(.96)}
.cp-btn.cancel{background:rgba(255,255,255,.06);color:#b0c8e8}
.cp-btn.confirm{background:linear-gradient(145deg,#4ecdc4,#1f8a82);color:#fff;border:none;box-shadow:0 4px 16px rgba(78,205,196,.3)}
.pf-role{font-size:.6rem;padding:2px 10px;border-radius:20px;background:rgba(78,205,196,.15);color:#4ecdc4;font-weight:500}
.pf-role.member{background:rgba(255,159,67,.15);color:#ff9f43}
.pf-input{width:100%;padding:10px 12px;border-radius:12px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);color:#eaf2ff;font-size:.8rem;font-family:inherit;outline:none;transition:border .15s}
.pf-input:focus{border-color:rgba(78,205,196,.5)}
.pf-color-row{display:flex;align-items:center;gap:10px}
.pf-color-swatch{width:40px;height:40px;border-radius:12px;border:2px solid rgba(255,255,255,.12);flex-shrink:0;cursor:pointer;transition:.1s}
.pf-color-swatch:active{transform:scale(.9)}
.pf-color-hint{color:#8aa4c8;font-size:.55rem}
#chat-log{flex:1;min-height:180px;max-height:50vh;overflow-y:auto;-webkit-overflow-scrolling:touch;touch-action:pan-y;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.05);border-radius:12px;padding:10px;font-size:.7rem;line-height:1.5;color:#eaf2ff;display:flex;flex-direction:column;gap:6px}
.chat-msg{display:flex;flex-direction:column;gap:2px}
.chat-msg .chat-meta{display:flex;align-items:baseline;gap:6px;flex-wrap:wrap}
.chat-msg .chat-from{font-weight:700;font-size:.6rem}
.chat-msg .chat-time{font-size:.5rem;color:#5d7291;font-family:monospace}
.chat-msg .chat-text{word-break:break-word;white-space:pre-wrap}
.chat-msg.me .chat-from{color:#4ecdc4}
.chat-msg.other .chat-from{color:#ff9f43}
.chat-msg.sys{color:#8aa4c8;font-style:italic;font-size:.62rem}
.chat-input-row{display:flex;gap:8px}
.chat-input{flex:1;padding:10px 12px;border-radius:12px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);color:#eaf2ff;font-size:.72rem;font-family:inherit;outline:none;transition:border .15s;min-width:0}
.chat-input:focus{border-color:rgba(255,159,67,.5)}
.chat-send{padding:0 16px;border-radius:12px;border:none;background:linear-gradient(145deg,#ff9f43,#e17055);color:#fff;font-size:.72rem;font-weight:600;font-family:inherit;cursor:pointer;box-shadow:0 4px 16px rgba(255,159,67,.25);flex-shrink:0}
.chat-send:active{transform:scale(.95)}
.chat-hint{color:#5d7291;font-size:.52rem;line-height:1.4}
.chat-bubble{position:absolute;z-index:50;pointer-events:none;background:#fff;color:#000;font-size:.65rem;font-weight:600;line-height:1.35;padding:4px 10px;border-radius:12px;max-width:160px;text-align:center;word-break:break-word;white-space:pre-wrap;box-shadow:0 4px 16px rgba(0,0,0,.25);transform:translate(-50%,-100%);transition:opacity .3s ease}
.chat-bubble::after{content:'';position:absolute;left:50%;bottom:-6px;transform:translateX(-50%);width:0;height:0;border-left:6px solid transparent;border-right:6px solid transparent;border-top:6px solid #fff}
.chat-bubble.hidden{opacity:0}
#console-overlay,#gpanel-overlay{position:fixed;inset:0;z-index:220;background:rgba(0,0,0,.6);display:flex;align-items:center;justify-content:center;opacity:0;visibility:hidden;transition:opacity .25s ease,visibility .25s ease}
#gpanel-overlay{z-index:221}
#console-overlay.show,#gpanel-overlay.show{opacity:1;visibility:visible}
#console-panel,#gpanel-panel{background:rgba(18,26,48,.98);border:1.5px solid rgba(78,205,196,.25);border-radius:24px;padding:16px;width:340px;max-width:92vw;max-height:80vh;display:flex;flex-direction:column;gap:10px;box-shadow:0 24px 80px rgba(0,0,0,.7);transform:scale(.88) translateY(12px);opacity:0;transition:transform .3s cubic-bezier(.34,1.56,.64,1),opacity .25s ease}
#gpanel-panel{border-color:rgba(162,155,254,.3)}
#console-overlay.show #console-panel,#gpanel-overlay.show #gpanel-panel{transform:scale(1) translateY(0);opacity:1}
.cs-header{display:flex;align-items:center;justify-content:space-between;color:#e0ecff;font-size:.85rem;font-weight:600;letter-spacing:.5px;gap:8px}
.cs-header .cs-status{font-size:.55rem;font-weight:400;color:#4ecdc4;font-family:monospace;flex:1;text-align:right}
.cs-close{width:26px;height:26px;border-radius:8px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.06);color:#b0c8e8;font-size:.9rem;line-height:1;cursor:pointer;display:flex;align-items:center;justify-content:center;font-family:inherit;flex-shrink:0}
.cs-close:active{transform:scale(.9);background:rgba(255,107,107,.3);color:#fff}
.cs-log{flex:1;min-height:150px;max-height:40vh;overflow-y:auto;-webkit-overflow-scrolling:touch;touch-action:pan-y;background:rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.05);border-radius:12px;padding:10px;font-family:monospace;font-size:.62rem;line-height:1.55;color:#9fb6d4;display:flex;flex-direction:column;gap:2px}
.cs-line{white-space:pre-wrap;word-break:break-all}
.cs-line.info{color:#9fb6d4}
.cs-line.cmd{color:#4ecdc4;font-weight:600}
.cs-line.warn{color:#ff9f43}
.cs-line.error{color:#ff6b6b}
.cs-input-row{display:flex;gap:8px}
.cs-input{flex:1;padding:10px 12px;border-radius:12px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);color:#eaf2ff;font-size:.72rem;font-family:monospace;outline:none;transition:border .15s;min-width:0}
.cs-input:focus{border-color:rgba(78,205,196,.5)}
.cs-send{padding:0 16px;border-radius:12px;border:none;background:linear-gradient(145deg,#4ecdc4,#1f8a82);color:#fff;font-size:.72rem;font-weight:600;font-family:inherit;cursor:pointer;box-shadow:0 4px 16px rgba(78,205,196,.25);flex-shrink:0}
.cs-send:active{transform:scale(.95)}
.cs-hint{color:#5d7291;font-size:.52rem;line-height:1.4;font-family:monospace}
.gp-info{background:rgba(0,0,0,.3);border:1px solid rgba(255,255,255,.05);border-radius:12px;padding:10px 12px;font-family:monospace;font-size:.62rem;line-height:1.6;color:#9fb6d4}
.gp-info b{color:#4ecdc4;font-weight:600}
.gp-players{background:rgba(0,0,0,.3);border:1px solid rgba(255,255,255,.05);border-radius:12px;padding:8px;max-height:28vh;overflow-y:auto;display:flex;flex-direction:column;gap:4px}
.gp-player{display:flex;align-items:center;justify-content:space-between;gap:6px;padding:6px 8px;border-radius:8px;background:rgba(255,255,255,.04);font-size:.65rem}
.gp-player .gp-pname{color:#eaf2ff;font-weight:600;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.gp-player .gp-prole{font-size:.5rem;padding:1px 6px;border-radius:10px;background:rgba(78,205,196,.15);color:#4ecdc4;flex-shrink:0}
.gp-player .gp-prole.member{background:rgba(255,159,67,.15);color:#ff9f43}
.gp-player .gp-kick{width:26px;height:26px;border-radius:8px;border:none;background:rgba(255,107,107,.2);color:#ff6b6b;cursor:pointer;display:flex;align-items:center;justify-content:center;padding:0;flex-shrink:0}
.gp-player .gp-kick:active{transform:scale(.9);background:rgba(255,107,107,.5)}
.gp-player .gp-kick svg{width:13px;height:13px;fill:currentColor}
.gp-empty{color:#5d7291;font-size:.65rem;text-align:center;padding:10px}
.gp-btns{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.gp-btn{padding:10px 0;border-radius:12px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.06);color:#b0c8e8;font-size:.7rem;font-weight:600;font-family:inherit;cursor:pointer;transition:.1s;display:flex;align-items:center;justify-content:center;gap:6px}
.gp-btn:active{transform:scale(.96)}
.gp-btn svg{width:14px;height:14px;fill:currentColor}
.gp-btn.danger{background:rgba(255,107,107,.15);color:#ff6b6b;border-color:rgba(255,107,107,.25)}
.gp-btn.danger:active{background:rgba(255,107,107,.4)}
.gp-btn.warn{background:rgba(255,159,67,.15);color:#ff9f43;border-color:rgba(255,159,67,.25)}
.gp-btn.warn:active{background:rgba(255,159,67,.4)}
.gp-btn.ok{background:rgba(78,205,196,.15);color:#4ecdc4;border-color:rgba(78,205,196,.25)}
.gp-btn.ok:active{background:rgba(78,205,196,.4)}
.gp-banner{background:rgba(162,155,254,.12);border:1px solid rgba(162,155,254,.25);border-radius:12px;padding:8px 10px;font-size:.6rem;color:#a29bfe;text-align:center;line-height:1.5}
.gp-row{display:flex;gap:8px}
.gp-row input{flex:1;padding:10px 12px;border-radius:12px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);color:#eaf2ff;font-size:.7rem;font-family:inherit;outline:none;min-width:0}
.gp-row input:focus{border-color:rgba(162,155,254,.5)}
#debug-panel{position:fixed;top:80px;right:10px;width:210px;z-index:9999;background:rgba(8,16,32,.95);border:1px solid rgba(78,205,196,.2);color:#b0f0e0;padding:12px 14px;border-radius:16px;opacity:0;pointer-events:none;transition:opacity .2s;font-family:monospace;font-size:.55rem;backdrop-filter:blur(14px);max-height:78vh;overflow-y:auto;box-shadow:0 8px 30px rgba(0,0,0,.5)}
#debug-panel.visible{opacity:1;pointer-events:auto}
#debug-panel .dbg-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;cursor:grab;user-select:none;touch-action:none}
#debug-panel .dbg-header span{color:#4ecdc4;font-size:.7rem;font-weight:600}
#debug-panel .dbg-close{background:none;border:none;color:rgba(255,255,255,.4);font-size:.9rem;cursor:pointer;padding:0 4px;font-family:inherit}
#debug-panel .dbg-close:active{color:#ff6b6b}
#debug-panel label{display:flex;align-items:center;justify-content:space-between;margin:4px 0}
#debug-panel input[type="range"]{width:70px;accent-color:#4ecdc4}
#debug-panel input[type="checkbox"]{accent-color:#4ecdc4}
#debug-panel .dbg-btn{width:100%;padding:5px;margin:3px 0;background:rgba(0,255,200,.06);border:1px solid rgba(0,255,200,.15);color:#b0f0e0;border-radius:6px;cursor:pointer;font-size:.55rem;font-family:inherit}
#debug-panel .dbg-btn:active{background:rgba(0,255,200,.2)}
#debug-panel .dbg-row{display:flex;align-items:center;justify-content:space-between;margin:4px 0}
#start-overlay{position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at center,rgba(8,12,26,.98),rgba(0,0,0,.99));transition:opacity .4s ease,visibility .4s ease;visibility:visible}
#start-overlay.hidden{opacity:0;pointer-events:none;visibility:hidden}
#start-box{background:rgba(18,26,48,.95);border:1.5px solid rgba(78,205,196,.15);border-radius:32px;padding:28px 24px;text-align:center;color:#eaf2ff;max-width:320px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,.5);animation:breathe 2.4s ease-in-out infinite}
@keyframes breathe{0%,100%{transform:scale(1);box-shadow:0 20px 60px rgba(0,0,0,.5)}50%{transform:scale(1.02);box-shadow:0 20px 80px rgba(78,205,196,.15)}}
#start-box h1{font-size:1.8rem;margin-bottom:2px;background:linear-gradient(135deg,#4ecdc4,#ff6b6b);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
#start-box .sub{color:#4ecdc4;font-size:.9rem;margin-bottom:6px;animation:pulse 1.6s infinite}
@keyframes pulse{0%,100%{opacity:.7}50%{opacity:1}}
#start-box p{font-size:.65rem;color:#8aa4c8;margin:2px 0}
#start-box .key{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.05);border-radius:4px;padding:1px 6px;font-size:.5rem;display:inline-block;color:#b0c8e8}
#mode-btns{display:flex;gap:10px;margin-top:16px}
#net-status{position:absolute;bottom:20px;left:20px;color:#4ecdc4;font-size:.7rem;z-index:99;pointer-events:none;text-shadow:0 2px 4px #000}
</style>
</head>
<body>

<div id="start-overlay">
  <div id="start-box">
    <h1>体素沙盒</h1>
    <p class="sub" id="role-text">选择模式</p>
    <p><span class="key">摇杆</span> 移动 · <span class="key">跳跃</span> 大按钮</p>
    <p><span class="key">点击屏幕</span> 放置 · <span class="key">右滑</span> 视角</p>
    <div id="mode-btns">
      <button class="cp-btn cancel" id="btn-offline">离线游玩</button>
      <button class="cp-btn confirm" id="btn-online">联机进入</button>
    </div>
  </div>
</div>

<div id="scene-container">
  <div id="net-status">离线模式</div>
  <div id="hud">
    <span id="shape-indicator"><span id="shape-dot" class="dot"></span><span id="shape-name" class="name">立方体</span></span>
    <span class="right">
      <span style="display:flex;align-items:center;gap:2px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg><span id="obj-count">0</span></span>
      <span style="display:flex;align-items:center;gap:2px;"><svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg><span id="fps-val">60</span>fps</span>
      <button class="hud-btn chat" id="btn-chat" title="聊天室"><svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H6l-2 2V4h16v12z"/></svg><span class="badge hidden" id="chat-badge">0</span></button>
      <button class="hud-btn" id="btn-console" title="控制台"><svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V8h16v10zM6 10l2 2-2 2 1.4 1.4L10.8 12 7.4 8.6 6 10zm5 5h6v-2h-6v2z"/></svg></button>
      <button class="hud-btn panel" id="btn-gpanel" title="图形面板"><svg viewBox="0 0 24 24"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/></svg></button>
      <button class="hud-btn" id="btn-fullscreen" title="全屏"><svg viewBox="0 0 24 24"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg></button>
    </span>
  </div>

  <div id="bottom-controls">
    <div id="toolbar">
      <div class="tool-group">
        <button class="btn-icon action" id="btn-place"><svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg></button>
        <button class="btn-icon action" id="btn-remove"><svg viewBox="0 0 24 24"><path d="M19 13H5v-2h14v2z"/></svg></button>
        <button class="btn-icon" id="btn-next"><svg viewBox="0 0 24 24"><path d="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8-8-8z"/></svg></button>
        <button class="btn-icon" id="btn-grab"><svg viewBox="0 0 24 24"><path d="M9 11.24V7.5a2.5 2.5 0 0 1 5 0v3.74c1.21-.81 2-2.18 2-3.74A4.5 4.5 0 0 0 11.5 3 4.5 4.5 0 0 0 7 7.5c0 1.56.79 2.93 2 3.74zm9.84 4.63l-4.54-2.26c-.17-.07-.35-.11-.54-.11H13v-6a1.5 1.5 0 0 0-3 0v10.74l-3.43-.72c-.08-.01-.15-.03-.24-.03-.31 0-.59.13-.79.33l-.79.8 4.94 4.94c.27.27.65.44 1.06.44h6.79c.75 0 1.33-.55 1.44-1.28l.75-5.27c.01-.07.02-.14.02-.2 0-.62-.38-1.16-.91-1.38z"/></svg></button>
        <button class="btn-icon" id="btn-push"><svg viewBox="0 0 24 24"><path d="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z"/></svg></button>
      </div>
      <div class="tool-group">
        <button class="btn-icon" id="btn-explode"><svg viewBox="0 0 24 24"><path d="M12 2l2.4 7.2h7.6l-6 4.8 2.4 7.2-6-4.8-6 4.8 2.4-7.2-6-4.8h7.6z"/></svg></button>
        <button class="btn-icon" id="btn-vacuum"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14.5v-9l6 4.5-6 4.5z"/></svg></button>
        <button class="btn-icon" id="btn-color"><svg viewBox="0 0 24 24"><path d="M12 2C6.49 2 2 6.49 2 12s4.49 10 10 10c1.38 0 2.5-1.12 2.5-2.5 0-.61-.23-1.2-.64-1.67-.08-.1-.13-.21-.13-.33 0-.28.22-.5.5-.5H16c3.31 0 6-2.69 6-6 0-4.96-4.49-9-10-9zm-5.5 9c-.83 0-1.5-.67-1.5-1.5S5.67 8 6.5 8 8 8.67 8 9.5 7.33 11 6.5 11zm3-4C8.67 7 8 6.33 8 5.5S8.67 4 9.5 4s1.5.67 1.5 1.5S10.33 7 9.5 7zm5 0c-.83 0-1.5-.67-1.5-1.5S13.67 4 14.5 4s1.5.67 1.5 1.5S15.33 7 14.5 7zm3 4c-.83 0-1.5-.67-1.5-1.5S16.67 8 17.5 8s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/></svg></button>
        <button class="btn-icon" id="btn-profile"><svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg></button>
      </div>
    </div>
    <div id="control-row">
      <div id="joystick-area"><div id="joystick-base"></div><div id="joystick-thumb"></div></div>
      <button id="btn-jump"><svg viewBox="0 0 24 24"><path d="M12 4l-8 8h5v8h6v-8h5z"/></svg></button>
    </div>
  </div>
</div>

<div id="bubble-layer" style="position:fixed;inset:0;pointer-events:none;z-index:50;"></div>

<div id="color-overlay"><div id="color-panel">
  <div class="cp-header"><span>颜色调节</span><div class="cp-preview" id="cp-preview"></div></div>
  <div class="cp-row"><label>色相 <span id="cp-hue-val">200</span>°</label><input type="range" class="cp-slider" id="cp-hue" min="0" max="360" value="200"></div>
  <div class="cp-row"><label>饱和度 <span id="cp-sat-val">70</span>%</label><input type="range" class="cp-slider" id="cp-sat" min="0" max="100" value="70"></div>
  <div class="cp-row"><label>亮度 <span id="cp-light-val">60</span>%</label><input type="range" class="cp-slider" id="cp-light" min="0" max="100" value="60"></div>
  <div class="cp-row"><label>透明度 <span id="cp-alpha-val">100</span>%</label><input type="range" class="cp-slider" id="cp-alpha" min="0" max="100" value="100"></div>
  <div class="cp-actions"><button class="cp-btn cancel" id="cp-cancel">取消</button><button class="cp-btn confirm" id="cp-confirm">确定</button></div>
</div></div>

<div id="profile-overlay"><div id="profile-panel">
  <div class="pf-header"><span>玩家设置</span><span class="pf-role" id="pf-role">房主</span></div>
  <div class="pf-row"><label>称呼</label><input type="text" class="pf-input" id="pf-name" maxlength="12" placeholder="输入称呼..."></div>
  <div class="pf-row"><label>球体颜色</label><div class="pf-color-row"><div class="pf-color-swatch" id="pf-color-swatch"></div><span class="pf-color-hint">点击打开调色板</span></div></div>
  <div class="cp-actions"><button class="cp-btn cancel" id="pf-cancel">取消</button><button class="cp-btn confirm" id="pf-confirm">保存</button></div>
</div></div>

<div id="chat-overlay"><div id="chat-panel">
  <div class="ch-header"><span id="chat-title">聊天室</span><span class="ch-status" id="chat-status">0 条消息</span><button class="ch-close" id="chat-close">✕</button></div>
  <div id="chat-log"></div>
  <div class="chat-input-row"><input type="text" class="chat-input" id="chat-input" maxlength="200" placeholder="输入消息后回车..." autocomplete="off" autocapitalize="off" spellcheck="false"><button class="chat-send" id="chat-send">发送</button></div>
  <div class="chat-hint" id="chat-hint">消息会显示在头顶</div>
</div></div>

<div id="console-overlay"><div id="console-panel">
  <div class="cs-header"><span>控制台</span><span class="cs-status" id="cs-status">离线</span><button class="cs-close" id="cs-close">✕</button></div>
  <div class="cs-log" id="cs-log"></div>
  <div class="cs-input-row"><input type="text" class="cs-input" id="cs-input" placeholder="输入命令后回车..." autocomplete="off" autocapitalize="off" spellcheck="false"><button class="cs-send" id="cs-send">发送</button></div>
  <div class="cs-hint" id="cs-hint">help · list · status · say 消息 · clear · chujian</div>
</div></div>

<div id="gpanel-overlay"><div id="gpanel-panel">
  <div class="cs-header"><span>图形控制面板</span><span class="cs-status" id="gp-status">离线</span><button class="cs-close" id="gp-close">✕</button></div>
  <div class="gp-banner" id="gp-banner">本地状态</div>
  <div class="gp-info" id="gp-info">等待刷新...</div>
  <div class="gp-players" id="gp-players"><div class="gp-empty">暂无玩家</div></div>
  <div class="gp-row"><input type="text" id="gp-announce" maxlength="80" placeholder="输入公告内容..."><button class="gp-btn warn" id="gp-say" style="padding:0 14px;">公告</button></div>
  <div class="gp-btns">
    <button class="gp-btn danger" id="gp-kickall"><svg viewBox="0 0 24 24"><path d="M16 13c1.66 0 2.99-1.34 2.99-3S17.66 7 16 7c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 7 8 7C6.34 7 5 8.34 5 10s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-1.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-1.5c0-2.33-4.67-3.5-7-3.5z"/></svg>全体踢出</button>
    <button class="gp-btn ok" id="gp-restart-http"><svg viewBox="0 0 24 24"><path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg>重启 HTTP</button>
    <button class="gp-btn" id="gp-refresh"><svg viewBox="0 0 24 24"><path d="M12 6v3l4-4-4-4v3c-4.42 0-8 3.58-8 8 0 1.57.46 3.03 1.24 4.26L6.7 14.8c-.45-.83-.7-1.79-.7-2.8 0-3.31 2.69-6 6-6zm6.76 1.74L17.3 9.2c.44.84.7 1.79.7 2.8 0 3.31-2.69 6-6 6v-3l-4 4 4 4v-3c4.42 0 8-3.58 8-8 0-1.57-.46-3.03-1.24-4.26z"/></svg>刷新状态</button>
    <button class="gp-btn danger" id="gp-stop"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/></svg>停止服务器</button>
  </div>
</div></div>

<div id="debug-panel">
  <div class="dbg-header" id="dbg-drag"><span>调试面板</span><button class="dbg-close" id="dbg-close">✕</button></div>
  <label>飞行 <input type="checkbox" id="dbg-fly"></label>
  <label>上帝 <input type="checkbox" id="dbg-god" checked></label>
  <label>无限距离 <input type="checkbox" id="dbg-range"></label>
  <label>自动放置 <input type="checkbox" id="dbg-auto"></label>
  <div class="dbg-row">天空颜色 <button class="dbg-btn" id="dbg-sky" style="width:auto;padding:2px 10px;margin:0;">打开调色板</button></div>
  <div class="dbg-row">雾距离 <input type="range" id="dbg-fog" min="0" max="150" value="110" step="1"></div>
  <div>重力 <input type="range" id="dbg-gravity" min="-20" max="20" value="-12" step="0.5"></div>
  <div>速度 <input type="range" id="dbg-speed" min="2" max="30" value="6" step="0.5"></div>
  <div>跳跃 <input type="range" id="dbg-jump" min="2" max="20" value="7" step="0.5"></div>
  <button class="dbg-btn" id="dbg-spawn">批量生成(30)</button>
  <button class="dbg-btn" id="dbg-random">随机颜色</button>
  <button class="dbg-btn" id="dbg-clear">清空所有</button>
</div>

<script type="importmap">
{"imports":{"three":"https://unpkg.com/three@0.160.0/build/three.module.js","cannon-es":"https://unpkg.com/cannon-es@0.20.0/dist/cannon-es.js"}}
</script>

<script type="module">
// ============ 依赖加载：本地优先，CDN 回退 ============
let THREE, CANNON;
try {
  THREE = await import('./three.module.js');
  CANNON = await import('./cannon-es.js');
} catch (e) {
  THREE = await import('three');
  CANNON = await import('cannon-es');
}

// ============ 配置 ============
const CFG = { moveSpeed: 6, jumpForce: 7, gravity: -12, playerRadius: 0.4, blockSize: 0.95, physicsSize: 0.475, worldSize: 17 };
const DEFAULT_SERVER = 'ws://10.102.142.39:8765';
const STORAGE_KEY_PROFILE = 'voxel_profile';
const STORAGE_KEY_CHAT = 'voxel_offline_chat';

function getServerUrl() {
  const q = new URLSearchParams(location.search).get('server');
  if (q) return q;
  return DEFAULT_SERVER;
}

// ============ DOM ============
const $ = id => document.getElementById(id);
const container = $('scene-container');
const dom = {
  startOverlay: $('start-overlay'), roleText: $('role-text'), netStatus: $('net-status'),
  btnOffline: $('btn-offline'), btnOnline: $('btn-online'),
  joystickArea: $('joystick-area'), joystickThumb: $('joystick-thumb'), btnJump: $('btn-jump'),
  btnPlace: $('btn-place'), btnRemove: $('btn-remove'), btnNext: $('btn-next'), btnGrab: $('btn-grab'),
  btnPush: $('btn-push'), btnExplode: $('btn-explode'), btnVacuum: $('btn-vacuum'),
  btnColor: $('btn-color'), btnProfile: $('btn-profile'), btnFullscreen: $('btn-fullscreen'),
  colorOverlay: $('color-overlay'), cpPreview: $('cp-preview'), cpHue: $('cp-hue'), cpSat: $('cp-sat'),
  cpLight: $('cp-light'), cpAlpha: $('cp-alpha'), cpHueVal: $('cp-hue-val'), cpSatVal: $('cp-sat-val'),
  cpLightVal: $('cp-light-val'), cpAlphaVal: $('cp-alpha-val'), cpCancel: $('cp-cancel'), cpConfirm: $('cp-confirm'),
  profileOverlay: $('profile-overlay'), pfRole: $('pf-role'), pfName: $('pf-name'), pfColorSwatch: $('pf-color-swatch'),
  pfCancel: $('pf-cancel'), pfConfirm: $('pf-confirm'),
  objCount: $('obj-count'), fpsVal: $('fps-val'), shapeDot: $('shape-dot'), shapeName: $('shape-name'),
  bubbleLayer: $('bubble-layer'),
};
const csOverlay = $('console-overlay'), csLog = $('cs-log'), csInput = $('cs-input'), csSendBtn = $('cs-send'), csCloseBtn = $('cs-close'), csStatus = $('cs-status'), btnConsole = $('btn-console'), csHint = $('cs-hint');
const chatOverlay = $('chat-overlay'), chatLog = $('chat-log'), chatInput = $('chat-input'), chatSendBtn = $('chat-send'), chatCloseBtn = $('chat-close'), chatStatus = $('chat-status'), btnChat = $('btn-chat'), chatBadge = $('chat-badge'), chatTitle = $('chat-title'), chatHint = $('chat-hint');
const gpanelOverlay = $('gpanel-overlay'), btnGpanel = $('btn-gpanel'), gpClose = $('gp-close'), gpStatus = $('gp-status'), gpInfo = $('gp-info'), gpPlayers = $('gp-players'), gpAnnounce = $('gp-announce'), gpSay = $('gp-say'), gpKickall = $('gp-kickall'), gpRestartHttp = $('gp-restart-http'), gpRefresh = $('gp-refresh'), gpStop = $('gp-stop'), gpBanner = $('gp-banner');
const dbgPanel = $('debug-panel'), dbgFly = $('dbg-fly'), dbgGod = $('dbg-god'), dbgRange = $('dbg-range'), dbgAuto = $('dbg-auto'), dbgSkyBtn = $('dbg-sky'), dbgFog = $('dbg-fog'), dbgGravity = $('dbg-gravity'), dbgSpeed = $('dbg-speed'), dbgJump = $('dbg-jump'), dbgClose = $('dbg-close'), dbgDrag = $('dbg-drag');

// ============ 工具 ============
function randomColor() {
  const hue = Math.floor(Math.random() * 360), sat = 60 + Math.floor(Math.random() * 30), light = 45 + Math.floor(Math.random() * 25);
  const a = sat * Math.min(light / 100, 1 - light / 100) / 100;
  const f = n => { const k = (n + hue / 30) % 12; const c = light / 100 - a * Math.max(Math.min(k - 3, 9 - k, 1), -1); return Math.round(255 * c).toString(16).padStart(2, '0'); };
  return `#${f(0)}${f(8)}${f(4)}`;
}
function nowTimeStr() { const d = new Date(), p = n => String(n).padStart(2, '0'); return `${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`; }
function hslToHex(h, s, l) { s /= 100; l /= 100; const a = s * Math.min(l, 1 - l); const f = n => { const k = (n + h / 30) % 12; const c = l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1); return Math.round(255 * c).toString(16).padStart(2, '0'); }; return `#${f(0)}${f(8)}${f(4)}`; }
function hexToHsl(hex) { const rgb = parseInt(hex.slice(1), 16), r = (rgb >> 16) & 255, g = (rgb >> 8) & 255, b = rgb & 255, rn = r / 255, gn = g / 255, bn = b / 255; const max = Math.max(rn, gn, bn), min = Math.min(rn, gn, bn); let h = 0, s = 0, l = (max + min) / 2; if (max !== min) { const d = max - min; s = l > .5 ? d / (2 - max - min) : d / (max + min); switch (max) { case rn: h = (gn - bn) / d + (gn < bn ? 6 : 0); break; case gn: h = (bn - rn) / d + 2; break; case bn: h = (rn - gn) / d + 4; break; } h /= 6; } return { h: Math.round(h * 360), s: Math.round(s * 100), l: Math.round(l * 100) }; }

// ============ 玩家档案 ============
function loadProfile() { try { const s = localStorage.getItem(STORAGE_KEY_PROFILE); if (s) return JSON.parse(s); } catch (e) {} return { name: '玩家', color: randomColor() }; }
const profile = loadProfile();
if (!profile.name) profile.name = '玩家';
function saveProfile() { if (net && net.isOnline()) return; try { localStorage.setItem(STORAGE_KEY_PROFILE, JSON.stringify(profile)); } catch (e) {} }

// ============ 网络适配器 ============
class BaseNet {
  constructor() {
    this.mode = 'offline'; this.isHost = true; this.myId = null; this.connected = true;
    this.handlers = {};
  }
  on(name, fn) { this.handlers[name] = fn; }
  emit(name, data) { const f = this.handlers[name]; if (f) f(data); }
  isOnline() { return false; }
  connect() {}
  sendProfile() {}
  sendChat() {}
  sendMove() {}
  sendBlockStates() {}
  sendAddBlock() {}
  sendAddBlocksBatch() {}
  sendRemoveBlock() {}
  sendEffect() {}
  sendSky() {}
  sendConsoleCmd() {}
  requestProfiles() {}
}

class OfflineNet extends BaseNet {
  constructor() { super(); this.mode = 'offline'; this.isHost = true; this.connected = true; }
  isOnline() { return false; }
}

class OnlineNet extends BaseNet {
  constructor(url) { super(); this.mode = 'online'; this.isHost = false; this.connected = false; this.url = url; this.ws = null; this.reconnectTimer = null; this.wasKicked = false; }
  isOnline() { return true; }
  connect() {
    if (this.reconnectTimer) { clearTimeout(this.reconnectTimer); this.reconnectTimer = null; }
    if (this.ws) { try { this.ws.close(); } catch (e) {} }
    this.ws = new WebSocket(this.url);
    this.ws.onopen = () => { this.connected = true; this.emit('open'); };
    this.ws.onmessage = ev => {
      let msg; try { msg = JSON.parse(ev.data); } catch (e) { return; }
      this.dispatch(msg);
    };
    this.ws.onclose = () => {
      this.connected = false; this.myId = null;
      this.emit('close', { kicked: this.wasKicked });
      if (this.wasKicked) return;
      this.reconnectTimer = setTimeout(() => this.connect(), 2000);
    };
    this.ws.onerror = () => { try { this.ws.close(); } catch (e) {} };
  }
  send(obj) { if (this.ws && this.ws.readyState === WebSocket.OPEN) this.ws.send(JSON.stringify(obj)); }
  sendProfile() { this.send({ type: 'profile', name: profile.name, color: profile.color }); }
  sendChat(text) { this.send({ type: 'chat_message', text }); }
  sendMove(pos) { this.send({ type: 'player_move', pos }); }
  sendBlockStates(updates) { this.send({ type: 'block_states', updates }); }
  sendAddBlock(b) { this.send({ type: 'add_block', ...b }); }
  sendAddBlocksBatch(blocks) { this.send({ type: 'add_blocks_batch', blocks }); }
  sendRemoveBlock(id) { this.send({ type: 'remove_block', id }); }
  sendEffect(e) { this.send({ type: 'effect', ...e }); }
  sendSky(color) { this.send({ type: 'sky_color', color }); }
  sendConsoleCmd(cmd) { this.send({ type: 'console_cmd', cmd }); }
  requestProfiles() { this.send({ type: 'request_profile' }); }
  dispatch(msg) {
    switch (msg.type) {
      case 'server_log': this.emit('log', msg); break;
      case 'console_clear': this.emit('consoleClear'); break;
      case 'server_notice': this.emit('notice', msg); break;
      case 'gp_stats': this.emit('gpStats', msg); break;
      case 'chat_message': this.emit('chat', msg); break;
      case 'sky_color': this.emit('skyColor', msg.color); break;
      case 'role': this.emit('role', msg); break;
      case 'request_profile': this.sendProfile(); break;
      case 'kicked': this.wasKicked = true; this.emit('kicked'); try { this.ws.close(); } catch (e) {} break;
      case 'profile': this.emit('profile', msg); break;
      case 'player_leave': this.emit('playerLeave', msg.id); break;
      case 'player_move': this.emit('playerMove', msg); break;
      case 'add_block': this.emit('addBlock', msg); break;
      case 'add_blocks_batch': this.emit('addBlocksBatch', msg); break;
      case 'remove_block': this.emit('removeBlock', msg.id); break;
      case 'block_states': this.emit('blockStates', msg.updates); break;
      case 'effect': this.emit('effect', msg); break;
    }
  }
}

let net = new OfflineNet();

// ============ 渲染 / 场景 ============
const DEFAULT_SKY = 0x87CEEB;
const scene = new THREE.Scene();
scene.background = new THREE.Color(DEFAULT_SKY);
scene.fog = new THREE.Fog(DEFAULT_SKY, 40, 110);

const camera = new THREE.PerspectiveCamera(68, container.clientWidth / container.clientHeight, 0.1, 200);
camera.position.set(0, 2.6, 8);

const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: 'high-performance' });
renderer.setSize(container.clientWidth, container.clientHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
container.appendChild(renderer.domElement);

scene.add(new THREE.AmbientLight(0xbcd4f0, 0.6));
const dirLight = new THREE.DirectionalLight(0xfff8e7, 1.2);
dirLight.position.set(20, 30, 10); dirLight.castShadow = true;
dirLight.shadow.mapSize.width = 512; dirLight.shadow.mapSize.height = 512;
scene.add(dirLight);

const groundMesh = new THREE.Mesh(new THREE.PlaneGeometry(36, 36), new THREE.MeshStandardMaterial({ color: 0xd5c4a1, roughness: 0.8 }));
groundMesh.rotation.x = -Math.PI / 2; groundMesh.position.y = -0.2; groundMesh.receiveShadow = true;
scene.add(groundMesh);
const allObjects = [groundMesh];
scene.add(new THREE.GridHelper(36, 24, 0xc4b99a, 0xe0d5c0));

// ============ 物理 ============
const world = new CANNON.World();
world.gravity.set(0, CFG.gravity, 0);
world.broadphase = new CANNON.SAPBroadphase(world);
world.allowSleep = true;
world.defaultContactMaterial.restitution = 0.05;
world.defaultContactMaterial.friction = 0.6;
world.solver.iterations = 10;
world.solver.tolerance = 0.01;

const groundBody = new CANNON.Body({ mass: 0 });
groundBody.addShape(new CANNON.Box(new CANNON.Vec3(18, 0.2, 18)));
groundBody.position.set(0, -0.3, 0);
world.addBody(groundBody);

const playerBody = new CANNON.Body({ mass: 1 });
playerBody.addShape(new CANNON.Sphere(CFG.playerRadius));
playerBody.position.set(0, 2, 8);
playerBody.linearDamping = 0.9; playerBody.angularDamping = 0.9;
playerBody.allowSleep = true; playerBody.sleepSpeedLimit = 0.15; playerBody.sleepTimeLimit = 0.5;
world.addBody(playerBody);

// ============ 方块容器 ============
const placed = [];
const blockMap = new Map();
let nextBlockId = 1;
let isOnGround = false;

const shapes = {
  types: ['cube', 'sphere', 'cylinder', 'cone', 'torus', 'pyramid'],
  names: ['立方体', '球体', '圆柱', '圆锥', '圆环', '金字塔'],
  index: 0,
  colors: ['#ff6b6b', '#4ecdc4', '#ffe66d', '#a29bfe', '#fd79a8', '#00d2d3', '#ff9f43', '#55efc4'],
  colorIndex: 0,
};

// ============ 玩家显示 ============
const playerGroup = new THREE.Group();
scene.add(playerGroup);
const playerMesh = new THREE.Mesh(new THREE.SphereGeometry(CFG.playerRadius, 16, 16), new THREE.MeshStandardMaterial({ color: profile.color, roughness: 0.3, metalness: 0.1 }));
playerMesh.castShadow = true;
playerGroup.add(playerMesh);

function makeLabelSprite(text, color, withCrown) {
  const canvas = document.createElement('canvas');
  canvas.width = 384; canvas.height = 72;
  const ctx = canvas.getContext('2d');
  ctx.clearRect(0, 0, 384, 72);
  let textX = 60;
  if (withCrown) {
    ctx.save(); ctx.translate(16, 36);
    ctx.fillStyle = '#ffd93b';
    ctx.beginPath(); ctx.moveTo(-14, 10); ctx.lineTo(-10, -8); ctx.lineTo(-4, 2); ctx.lineTo(0, -12); ctx.lineTo(4, 2); ctx.lineTo(10, -8); ctx.lineTo(14, 10); ctx.closePath(); ctx.fill();
    ctx.strokeStyle = 'rgba(0,0,0,.4)'; ctx.lineWidth = 2; ctx.stroke();
    ctx.fillStyle = '#ff6b6b';
    [[-10, -8], [0, -12], [10, -8]].forEach(([x, y]) => { ctx.beginPath(); ctx.arc(x, y, 2.2, 0, Math.PI * 2); ctx.fill(); });
    ctx.restore(); textX = 68;
  }
  ctx.fillStyle = color; ctx.beginPath(); ctx.arc(38, 36, 20, 0, Math.PI * 2); ctx.fill();
  ctx.strokeStyle = 'rgba(255,255,255,.8)'; ctx.lineWidth = 3; ctx.stroke();
  ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(38, 28, 6.5, 0, Math.PI * 2); ctx.fill();
  ctx.beginPath(); ctx.ellipse(38, 46, 8.5, 9.5, 0, 0, Math.PI * 2); ctx.fill();
  ctx.font = 'bold 30px "PingFang SC","Segoe UI",sans-serif';
  ctx.fillStyle = '#fff'; ctx.textAlign = 'left'; ctx.textBaseline = 'middle';
  ctx.shadowColor = 'rgba(0,0,0,.6)'; ctx.shadowBlur = 6;
  ctx.fillText(text, textX, 38);
  const tex = new THREE.CanvasTexture(canvas); tex.minFilter = THREE.LinearFilter;
  const sprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, transparent: true, depthTest: false }));
  sprite.scale.set(2.6, 0.5, 1);
  return sprite;
}
let localLabelSprite = null;
function refreshLocalLabel() {
  if (localLabelSprite) { playerGroup.remove(localLabelSprite); localLabelSprite.material.map.dispose(); localLabelSprite.material.dispose(); }
  localLabelSprite = makeLabelSprite(profile.name, profile.color, net.isHost);
  localLabelSprite.position.set(0, 0.9, 0);
  playerGroup.add(localLabelSprite);
}
refreshLocalLabel();

// ============ 远程玩家 ============
const remotePlayers = new Map();
function createRemotePlayer(id, color, name, isRemoteHost) {
  if (remotePlayers.has(id)) { updateRemoteProfile(id, color, name, isRemoteHost); return; }
  const group = new THREE.Group(); group.frustumCulled = false;
  const mesh = new THREE.Mesh(new THREE.SphereGeometry(CFG.playerRadius, 16, 16), new THREE.MeshStandardMaterial({ color, transparent: true, opacity: 0.85 }));
  mesh.castShadow = true; mesh.frustumCulled = false; group.add(mesh);
  const label = makeLabelSprite(name, color, !!isRemoteHost); label.position.set(0, 0.9, 0); group.add(label);
  group.position.set(0, 2, 0); scene.add(group);
  const remoteBody = new CANNON.Body({ mass: 1 });
  remoteBody.addShape(new CANNON.Sphere(CFG.playerRadius));
  remoteBody.position.set(0, 2, 0); remoteBody.linearDamping = 0.9; remoteBody.angularDamping = 0.9; remoteBody.allowSleep = false;
  world.addBody(remoteBody);
  remotePlayers.set(id, { group, mesh, label, name, color, isRemoteHost: !!isRemoteHost, remoteBody, targetPos: new THREE.Vector3(0, 2, 0), hasTarget: false });
}
function updateRemoteProfile(id, color, name, isRemoteHost) {
  const rp = remotePlayers.get(id); if (!rp) return;
  rp.color = color; rp.name = name; rp.isRemoteHost = !!isRemoteHost;
  rp.mesh.material.color.set(color);
  rp.group.remove(rp.label); rp.label.material.map.dispose(); rp.label.material.dispose();
  rp.label = makeLabelSprite(name, color, rp.isRemoteHost); rp.label.position.set(0, 0.9, 0); rp.group.add(rp.label);
}
function removeRemotePlayer(id) {
  const rp = remotePlayers.get(id); if (!rp) return;
  scene.remove(rp.group); rp.mesh.geometry.dispose(); rp.mesh.material.dispose();
  rp.label.material.map.dispose(); rp.label.material.dispose();
  if (rp.remoteBody) world.removeBody(rp.remoteBody);
  remotePlayers.delete(id);
}

// ============ 气泡 ============
const bubbles = new Map();
function showBubble(key, text) {
  let b = bubbles.get(key);
  if (!b) { const el = document.createElement('div'); el.className = 'chat-bubble hidden'; dom.bubbleLayer.appendChild(el); b = { el, expireAt: 0 }; bubbles.set(key, b); }
  b.el.textContent = text; b.el.classList.remove('hidden'); b.expireAt = performance.now() + 4000;
}
function updateBubbles() {
  const now = performance.now();
  bubbles.forEach((b, key) => {
    if (now > b.expireAt) { b.el.classList.add('hidden'); return; }
    let worldPos = null;
    if (key === 'local') { worldPos = playerGroup.position.clone(); worldPos.y += 1.1; }
    else { const rp = remotePlayers.get(key); if (!rp) { b.el.classList.add('hidden'); return; } worldPos = rp.group.position.clone(); worldPos.y += 1.1; }
    const v = worldPos.clone().project(camera);
    if (v.z > 1 || v.z < -1) { b.el.classList.add('hidden'); return; }
    b.el.style.left = ((v.x * 0.5 + 0.5) * window.innerWidth) + 'px';
    b.el.style.top = ((-v.y * 0.5 + 0.5) * window.innerHeight - 6) + 'px';
    b.el.classList.remove('hidden');
  });
}

// ============ 聊天 ============
const chatHistory = [];
let unreadChat = 0;
function updateChatBadge() {
  if (chatOverlay.classList.contains('show')) unreadChat = 0;
  if (unreadChat > 0) { chatBadge.textContent = unreadChat > 99 ? '99+' : String(unreadChat); chatBadge.classList.remove('hidden'); }
  else chatBadge.classList.add('hidden');
  chatStatus.textContent = `${chatHistory.length} 条消息`;
}
function appendChatMessage(fromName, text, isSelf, isSystem, timeStr) {
  const t = timeStr || nowTimeStr();
  if (isSystem) {
    const el = document.createElement('div'); el.className = 'chat-msg sys'; el.textContent = `[${t}] ${text}`;
    chatLog.appendChild(el); chatHistory.push({ from: '', text, system: true, time: t });
  } else {
    const el = document.createElement('div'); el.className = 'chat-msg ' + (isSelf ? 'me' : 'other');
    const meta = document.createElement('div'); meta.className = 'chat-meta';
    const from = document.createElement('span'); from.className = 'chat-from'; from.textContent = fromName;
    const tm = document.createElement('span'); tm.className = 'chat-time'; tm.textContent = t;
    meta.appendChild(from); meta.appendChild(tm);
    const body = document.createElement('div'); body.className = 'chat-text'; body.textContent = text;
    el.appendChild(meta); el.appendChild(body); chatLog.appendChild(el);
    chatHistory.push({ from: fromName, text, time: t });
    if (!isSelf && !chatOverlay.classList.contains('show')) unreadChat++;
  }
  while (chatLog.childElementCount > 300) chatLog.removeChild(chatLog.firstElementChild);
  chatLog.scrollTop = chatLog.scrollHeight;
  updateChatBadge();
}
function saveOfflineChat() { if (net.isOnline()) return; try { localStorage.setItem(STORAGE_KEY_CHAT, JSON.stringify(chatHistory.slice(-200))); } catch (e) {} }
function loadOfflineChat() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY_CHAT); if (!raw) return;
    const arr = JSON.parse(raw); if (!Array.isArray(arr)) return;
    arr.forEach(item => {
      if (item.system) appendChatMessage('', item.text, false, true, item.time);
      else appendChatMessage(item.from || '玩家', item.text, item.from === profile.name, false, item.time);
    });
  } catch (e) {}
}
function openChatPanel() { chatOverlay.classList.add('show'); unreadChat = 0; updateChatBadge(); setTimeout(() => { try { chatInput.focus(); } catch (e) {} }, 120); }
function closeChatPanel() { chatOverlay.classList.remove('show'); try { chatInput.blur(); } catch (e) {} updateChatBadge(); }
function sendChatMessage() {
  const text = chatInput.value.trim(); if (!text) return;
  chatInput.value = '';
  if (net.isOnline() && !net.connected) { appendChatMessage('', '未连接到服务器', false, true); return; }
  appendChatMessage(profile.name, text, true, false);
  showBubble('local', text);
  if (net.isOnline()) net.sendChat(text);
  else saveOfflineChat();
}
btnChat.addEventListener('pointerdown', e => { e.stopPropagation(); openChatPanel(); });
chatCloseBtn.addEventListener('pointerdown', e => { e.stopPropagation(); closeChatPanel(); });
chatSendBtn.addEventListener('pointerdown', e => { e.stopPropagation(); sendChatMessage(); });
chatInput.addEventListener('keydown', e => { e.stopPropagation(); if (e.key === 'Enter') { e.preventDefault(); sendChatMessage(); } });
chatOverlay.addEventListener('pointerdown', e => { if (e.target === chatOverlay) closeChatPanel(); });

// ============ 颜色面板 ============
let cpState = { h: 200, s: 70, l: 60, a: 100 }, cpTarget = 'block';
function updatePreview() {
  const hex = hslToHex(cpState.h, cpState.s, cpState.l);
  dom.cpPreview.style.background = hex; dom.cpPreview.style.opacity = cpState.a / 100;
  dom.cpHueVal.textContent = cpState.h; dom.cpSatVal.textContent = cpState.s; dom.cpLightVal.textContent = cpState.l; dom.cpAlphaVal.textContent = cpState.a;
  dom.cpHue.value = cpState.h; dom.cpSat.value = cpState.s; dom.cpLight.value = cpState.l; dom.cpAlpha.value = cpState.a;
}
function openColorPanel(target, initialHex) {
  cpTarget = target;
  const hsl = hexToHsl(initialHex);
  cpState = { h: hsl.h, s: hsl.s, l: hsl.l, a: 100 };
  updatePreview(); dom.colorOverlay.classList.add('show');
}
function closeColorPanel() { dom.colorOverlay.classList.remove('show'); }
dom.cpHue.addEventListener('input', () => { cpState.h = +dom.cpHue.value; updatePreview(); });
dom.cpSat.addEventListener('input', () => { cpState.s = +dom.cpSat.value; updatePreview(); });
dom.cpLight.addEventListener('input', () => { cpState.l = +dom.cpLight.value; updatePreview(); });
dom.cpAlpha.addEventListener('input', () => { cpState.a = +dom.cpAlpha.value; updatePreview(); });
dom.cpCancel.addEventListener('pointerdown', e => { e.stopPropagation(); closeColorPanel(); });
dom.cpConfirm.addEventListener('pointerdown', e => {
  e.stopPropagation();
  const hex = hslToHex(cpState.h, cpState.s, cpState.l);
  if (cpTarget === 'block') { shapes.colors[shapes.colorIndex] = hex; updateUI(); }
  else if (cpTarget === 'player') { profile.color = hex; playerMesh.material.color.set(hex); refreshLocalLabel(); dom.pfColorSwatch.style.background = hex; if (net.isOnline()) net.sendProfile(); else saveProfile(); }
  else if (cpTarget === 'sky') { applySkyColor(hex); if (net.isOnline()) net.sendSky(hex); }
  closeColorPanel();
});
dom.colorOverlay.addEventListener('pointerdown', e => { if (e.target === dom.colorOverlay) closeColorPanel(); });

function applySkyColor(hex) { const col = new THREE.Color(hex); scene.background = col; if (scene.fog) scene.fog.color.copy(col); }

// ============ 玩家设置 ============
function openProfile() {
  dom.pfRole.textContent = net.isHost ? '房主' : '房员';
  dom.pfRole.className = 'pf-role' + (net.isHost ? '' : ' member');
  dom.pfName.value = profile.name;
  dom.pfColorSwatch.style.background = profile.color;
  dom.profileOverlay.classList.add('show');
}
function closeProfile() { dom.profileOverlay.classList.remove('show'); }
dom.pfColorSwatch.addEventListener('pointerdown', e => { e.stopPropagation(); openColorPanel('player', profile.color); });
dom.pfCancel.addEventListener('pointerdown', e => { e.stopPropagation(); closeProfile(); });
dom.pfConfirm.addEventListener('pointerdown', e => {
  e.stopPropagation();
  profile.name = dom.pfName.value.trim() || '玩家';
  refreshLocalLabel();
  if (net.isOnline()) net.sendProfile(); else saveProfile();
  closeProfile();
});
dom.profileOverlay.addEventListener('pointerdown', e => { if (e.target === dom.profileOverlay) closeProfile(); });

// ============ 几何/物理形状缓存 ============
const geoCache = {}, shapeCache = {};
function getGeometry(type) {
  if (!geoCache[type]) {
    const s = CFG.blockSize, r = CFG.physicsSize;
    switch (type) {
      case 'cube': geoCache[type] = new THREE.BoxGeometry(s, s, s); break;
      case 'sphere': geoCache[type] = new THREE.SphereGeometry(r, 16, 12); break;
      case 'cylinder': geoCache[type] = new THREE.CylinderGeometry(r, r, s, 12); break;
      case 'cone': geoCache[type] = new THREE.ConeGeometry(r, s, 12); break;
      case 'torus': geoCache[type] = new THREE.TorusGeometry(r * 0.85, 0.18, 10, 16); break;
      case 'pyramid': geoCache[type] = new THREE.ConeGeometry(r, s * 0.95, 4); break;
      default: geoCache[type] = new THREE.BoxGeometry(s, s, s);
    }
  }
  return geoCache[type];
}
function getCannonShape(type) {
  if (!shapeCache[type]) {
    const s = CFG.physicsSize;
    switch (type) {
      case 'cube': shapeCache[type] = new CANNON.Box(new CANNON.Vec3(s, s, s)); break;
      case 'sphere': shapeCache[type] = new CANNON.Sphere(s); break;
      case 'cylinder': shapeCache[type] = new CANNON.Cylinder(s, s, CFG.blockSize, 6); break;
      case 'cone': shapeCache[type] = new CANNON.Cylinder(0, s, CFG.blockSize, 6); break;
      case 'torus': shapeCache[type] = new CANNON.Sphere(s * 0.85); break;
      case 'pyramid': shapeCache[type] = new CANNON.Cylinder(0, s, CFG.blockSize * 0.95, 4); break;
      default: shapeCache[type] = new CANNON.Box(new CANNON.Vec3(s, s, s));
    }
  }
  return shapeCache[type];
}

// ============ 方块创建/删除 ============
function createPlaced(type, color, position, isStatic = false, netId = null) {
  let id;
  if (netId !== null) {
    id = netId;
    if (blockMap.has(id)) { while (blockMap.has(nextBlockId)) nextBlockId++; id = nextBlockId++; }
    else if (netId >= nextBlockId) nextBlockId = netId + 1;
  } else {
    while (blockMap.has(nextBlockId)) nextBlockId++;
    id = nextBlockId++;
  }
  const mesh = new THREE.Mesh(getGeometry(type), new THREE.MeshStandardMaterial({ color, roughness: 0.35, metalness: 0.05 }));
  mesh.position.copy(position); mesh.castShadow = true; mesh.receiveShadow = true;
  scene.add(mesh); allObjects.push(mesh);
  const body = new CANNON.Body({ mass: isStatic ? 0 : 1 });
  body.addShape(getCannonShape(type));
  body.position.set(position.x, position.y, position.z);
  body.linearDamping = 0.5; body.angularDamping = 0.5;
  world.addBody(body);
  const entry = { id, mesh, body, type, color, isStatic, isDemo: false };
  placed.push(entry); blockMap.set(id, entry);
  return entry;
}
function removePlaced(entry) {
  world.removeBody(entry.body); scene.remove(entry.mesh);
  const idx = placed.indexOf(entry); if (idx !== -1) placed.splice(idx, 1);
  const pIdx = allObjects.indexOf(entry.mesh); if (pIdx !== -1) allObjects.splice(pIdx, 1);
  blockMap.delete(entry.id);
}
function getPlacement() {
  const raycaster = new THREE.Raycaster();
  raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);
  raycaster.far = cheatRange ? 100 : 30;
  const hits = raycaster.intersectObjects(allObjects, false);
  if (hits.length > 0) {
    const point = hits[0].point.clone();
    const normal = hits[0].face.normal.clone().transformDirection(hits[0].object.matrixWorld);
    const pos = point.add(normal.multiplyScalar(CFG.physicsSize));
    pos.x = THREE.MathUtils.clamp(pos.x, -CFG.worldSize, CFG.worldSize);
    pos.z = THREE.MathUtils.clamp(pos.z, -CFG.worldSize, CFG.worldSize);
    pos.y = Math.max(pos.y, 0.2);
    if (!cheatRange && pos.distanceTo(camera.position) < 0.9) return null;
    return pos;
  }
  return null;
}

// ============ 力场 ============
function applyForce(attract, origin) {
  const p = origin || playerBody.position, str = 1500;
  placed.forEach(entry => {
    if (entry.isStatic) return;
    const dx = p.x - entry.body.position.x, dy = p.y - entry.body.position.y, dz = p.z - entry.body.position.z;
    const dist = Math.hypot(dx, dy, dz);
    if (dist < 8 && dist > 0.3) {
      const power = (1 - dist / 8) * str, factor = attract ? 1 : -1;
      entry.body.wakeUp();
      entry.body.applyForce(new CANNON.Vec3(dx / dist * power * factor, dy / dist * power * factor, dz / dist * power * factor), entry.body.position);
    }
  });
}
function explode(origin) {
  const p = origin || playerBody.position, str = 1500 * 0.7;
  placed.forEach(entry => {
    if (entry.isStatic) return;
    const dx = entry.body.position.x - p.x, dy = entry.body.position.y - p.y, dz = entry.body.position.z - p.z;
    const dist = Math.hypot(dx, dy, dz);
    if (dist < 10 && dist > 0.3) {
      const factor = (1 - dist / 10) * str / dist;
      entry.body.wakeUp();
      entry.body.applyImpulse(new CANNON.Vec3(dx * factor, (dy + 0.5) * factor, dz * factor), entry.body.position);
    }
  });
}
function vacuum(origin) {
  const p = origin || playerBody.position;
  placed.forEach(entry => {
    if (entry.isStatic) return;
    const dx = p.x - entry.body.position.x, dy = p.y + 0.5 - entry.body.position.y, dz = p.z - entry.body.position.z;
    const dist = Math.hypot(dx, dy, dz);
    if (dist > 1 && dist < 15) {
      entry.body.wakeUp();
      entry.body.applyImpulse(new CANNON.Vec3(dx * 12, dy * 12, dz * 12), entry.body.position);
    }
  });
}

function updateUI() {
  dom.shapeDot.style.background = shapes.colors[shapes.colorIndex];
  dom.shapeName.textContent = shapes.names[shapes.index];
  dom.objCount.textContent = placed.length;
}

// ============ 联机同步（仅 OnlineNet 使用）============
function sendBlockStates() {
  if (!net.isOnline() || !net.connected) return;
  const updates = [];
  for (const entry of placed) {
    if (entry.isStatic || entry.isDemo) continue;
    const b = entry.body;
    if (b.sleepState === CANNON.Body.SLEEPING) continue;
    const speed = Math.hypot(b.velocity.x, b.velocity.y, b.velocity.z);
    const angSpeed = Math.hypot(b.angularVelocity.x, b.angularVelocity.y, b.angularVelocity.z);
    if (speed > 0.1 || angSpeed > 0.1) {
      updates.push({ id: entry.id, p: [b.position.x, b.position.y, b.position.z], q: [b.quaternion.x, b.quaternion.y, b.quaternion.z, b.quaternion.w], v: [b.velocity.x, b.velocity.y, b.velocity.z], av: [b.angularVelocity.x, b.angularVelocity.y, b.angularVelocity.z] });
    }
  }
  if (updates.length > 0) net.sendBlockStates(updates);
}
function applyBlockStates(updates) {
  for (const upd of updates) {
    const entry = blockMap.get(upd.id);
    if (!entry || entry.isDemo) continue;
    const dist = Math.hypot(entry.body.position.x - upd.p[0], entry.body.position.y - upd.p[1], entry.body.position.z - upd.p[2]);
    if (dist > 1.5) {
      entry.body.position.set(upd.p[0], upd.p[1], upd.p[2]);
      entry.body.quaternion.set(upd.q[0], upd.q[1], upd.q[2], upd.q[3]);
      entry.body.velocity.set(upd.v[0], upd.v[1], upd.v[2]);
      entry.body.angularVelocity.set(upd.av[0], upd.av[1], upd.av[2]);
    } else {
      entry.body.velocity.set(upd.v[0], upd.v[1], upd.v[2]);
      entry.body.angularVelocity.set(upd.av[0], upd.av[1], upd.av[2]);
    }
    entry.body.wakeUp();
  }
}

// ============ 控制台 ============
function csAppend(text, level) {
  const line = document.createElement('div'); line.className = 'cs-line ' + (level || 'info'); line.textContent = text;
  csLog.appendChild(line);
  while (csLog.childElementCount > 400) csLog.removeChild(csLog.firstElementChild);
  csLog.scrollTop = csLog.scrollHeight;
}
function openConsolePanel() {
  csOverlay.classList.add('show');
  if (net.isOnline() && net.connected) {
    csLog.innerHTML = ''; csStatus.textContent = (net.isHost ? '房主' : '房员') + ' · 已连接'; csStatus.style.color = '#4ecdc4';
    net.sendConsoleCmd('gp_fetch'); // 顺便刷新
    net.send({ type: 'console_fetch' });
  } else if (net.isOnline()) {
    csStatus.textContent = '未连接'; csStatus.style.color = '#ff6b6b'; csAppend('当前未连接到服务器', 'error');
  } else {
    csLog.innerHTML = ''; csStatus.textContent = '离线'; csStatus.style.color = '#4ecdc4'; csAppend('离线控制台已就绪，输入 help 查看命令', 'info');
  }
  setTimeout(() => { try { csInput.focus(); } catch (e) {} }, 120);
}
function closeConsolePanel() { csOverlay.classList.remove('show'); try { csInput.blur(); } catch (e) {} }

function csSubmit() {
  const cmd = csInput.value.trim(); if (!cmd) return; csInput.value = '';
  const lower = cmd.toLowerCase();
  if (lower === 'chujian') { csAppend('> ' + cmd, 'cmd'); csAppend('✨ 调试面板已开启 ✨', 'warn'); openDebugPanel(); return; }
  if (!net.isOnline()) {
    // 离线本地命令
    if (lower === 'help') { csAppend('> ' + cmd, 'cmd'); csAppend('可用: help, list, status, say <消息>, clear, chujian', 'info'); return; }
    if (lower === 'list') { csAppend('> ' + cmd, 'cmd'); csAppend(`本地玩家: ${profile.name} (房主)`, 'info'); return; }
    if (lower === 'status') { csAppend('> ' + cmd, 'cmd'); csAppend(`离线 · 物体数: ${placed.length} · 玩家: ${profile.name}`, 'info'); return; }
    if (lower.startsWith('say ')) { const msg = cmd.slice(4).trim(); csAppend('> ' + cmd, 'cmd'); if (msg) { appendChatMessage('系统', msg, false, true); saveOfflineChat(); csAppend(`公告已广播: ${msg}`, 'warn'); } else csAppend('用法: say <消息>', 'warn'); return; }
    if (lower === 'clear') { csLog.innerHTML = ''; csAppend('控制台已清空', 'info'); return; }
    csAppend('> ' + cmd, 'cmd'); csAppend('未知命令', 'error'); return;
  }
  if (!net.connected) { csAppend('未连接到服务器', 'error'); return; }
  csAppend('> ' + cmd, 'cmd'); net.sendConsoleCmd(cmd);
}
btnConsole.addEventListener('pointerdown', e => { e.stopPropagation(); openConsolePanel(); });
csCloseBtn.addEventListener('pointerdown', e => { e.stopPropagation(); closeConsolePanel(); });
csSendBtn.addEventListener('pointerdown', e => { e.stopPropagation(); csSubmit(); });
csInput.addEventListener('keydown', e => { e.stopPropagation(); if (e.key === 'Enter') { e.preventDefault(); csSubmit(); } });
csOverlay.addEventListener('pointerdown', e => { if (e.target === csOverlay) closeConsolePanel(); });

// ============ 全屏 ============
function tryEnterFullscreen() {
  const el = document.documentElement;
  if (document.fullscreenElement || document.webkitFullscreenElement) return;
  const req = el.requestFullscreen || el.webkitRequestFullscreen || el.mozRequestFullScreen || el.msRequestFullscreen;
  if (req) { try { const p = req.call(el); if (p && p.catch) p.catch(() => {}); } catch (e) {} }
}
function toggleFullscreen() {
  if (document.fullscreenElement || document.webkitFullscreenElement) { const exit = document.exitFullscreen || document.webkitExitFullscreen || document.mozCancelFullScreen || document.msExitFullscreen; if (exit) { try { exit.call(document); } catch (e) {} } }
  else tryEnterFullscreen();
}
dom.btnFullscreen.addEventListener('pointerdown', e => { e.stopPropagation(); toggleFullscreen(); });

// ============ 调试面板 ============
let cheatFly = false, cheatGod = true, cheatRange = false, cheatAuto = false, autoTimer = 0, flyUpPressed = false;
function openDebugPanel() { dbgPanel.classList.add('visible'); dbgPanel.style.left = 'auto'; dbgPanel.style.top = '80px'; dbgPanel.style.right = '10px'; }
function closeDebugPanel() { dbgPanel.classList.remove('visible'); }
dbgClose.addEventListener('pointerdown', e => { e.stopPropagation(); closeDebugPanel(); });
dbgFly.addEventListener('change', e => { cheatFly = e.target.checked; world.gravity.set(0, cheatFly ? 0 : CFG.gravity, 0); if (cheatFly) playerBody.velocity.set(0, 0, 0); });
dbgGod.addEventListener('change', e => { cheatGod = e.target.checked; });
dbgRange.addEventListener('change', e => { cheatRange = e.target.checked; });
dbgAuto.addEventListener('change', e => { cheatAuto = e.target.checked; });
dbgSkyBtn.addEventListener('pointerdown', e => { e.stopPropagation(); openColorPanel('sky', '#' + scene.background.getHexString()); });
dbgFog.addEventListener('input', e => { if (scene.fog) scene.fog.far = Math.max(1, parseFloat(e.target.value)); });
dbgGravity.addEventListener('input', e => { CFG.gravity = parseFloat(e.target.value); if (!cheatFly) world.gravity.set(0, CFG.gravity, 0); });
dbgSpeed.addEventListener('input', e => { CFG.moveSpeed = parseFloat(e.target.value); });
dbgJump.addEventListener('input', e => { CFG.jumpForce = parseFloat(e.target.value); });
$('dbg-spawn').addEventListener('pointerdown', e => { e.stopPropagation(); spawnBatch(30); });
$('dbg-random').addEventListener('pointerdown', e => { e.stopPropagation(); shapes.colorIndex = Math.floor(Math.random() * shapes.colors.length); updateUI(); });
$('dbg-clear').addEventListener('pointerdown', e => { e.stopPropagation(); clearAllRemote(); });

let dbgDragData = null;
dbgDrag.addEventListener('pointerdown', e => {
  if (e.target.closest('.dbg-close')) return;
  const rect = dbgPanel.getBoundingClientRect();
  dbgDragData = { id: e.pointerId, offsetX: e.clientX - rect.left, offsetY: e.clientY - rect.top };
  dbgDrag.setPointerCapture(e.pointerId); e.preventDefault();
});
document.addEventListener('pointermove', e => {
  if (!dbgDragData || dbgDragData.id !== e.pointerId) return;
  let x = e.clientX - dbgDragData.offsetX, y = e.clientY - dbgDragData.offsetY;
  const r = dbgPanel.getBoundingClientRect();
  x = Math.max(0, Math.min(window.innerWidth - r.width, x)); y = Math.max(0, Math.min(window.innerHeight - r.height, y));
  dbgPanel.style.left = x + 'px'; dbgPanel.style.top = y + 'px'; dbgPanel.style.right = 'auto';
});
document.addEventListener('pointerup', e => { if (dbgDragData && dbgDragData.id === e.pointerId) dbgDragData = null; });
document.addEventListener('pointercancel', () => { dbgDragData = null; });

// ============ 批量 ============
function spawnBatch(count) {
  const num = Math.min(30, Math.max(1, Math.floor(count)));
  const type = shapes.types[shapes.index], color = shapes.colors[shapes.colorIndex];
  const dir = new THREE.Vector3(); camera.getWorldDirection(dir);
  const base = camera.position.clone().add(dir.multiplyScalar(3));
  const payload = [];
  for (let i = 0; i < num; i++) {
    const ang = (i / num) * Math.PI * 2 + Math.random() * 0.5;
    const r = 1.5 + Math.random() * 3;
    const x = base.x + Math.cos(ang) * r, z = base.z + Math.sin(ang) * r, y = base.y + Math.random() * 2;
    const entry = createPlaced(type, color, new THREE.Vector3(x, y, z));
    if (net.isOnline()) payload.push({ id: entry.id, shapeType: type, color, pos: [x, y, z] });
  }
  if (net.isOnline() && payload.length) net.sendAddBlocksBatch(payload);
  updateUI();
}
function clearAllRemote() {
  for (const entry of placed.slice()) {
    if (!entry.isDemo && net.isOnline()) net.sendRemoveBlock(entry.id);
    removePlaced(entry);
  }
  updateUI();
}

// ============ 图形面板 ============
function gpSetStatus(ok, text) { gpStatus.textContent = text; gpStatus.style.color = ok ? '#4ecdc4' : '#ff6b6b'; gpBanner.textContent = ok ? '已连接' : '未连接'; }
function gpRenderInfo(stats) {
  gpInfo.innerHTML = '';
  const lines = stats
    ? [['IP', stats.ip || '未知'], ['WebSocket', stats.wsPort || '--'], ['HTTP', stats.httpPort || '--'], ['在线玩家', stats.count ?? '--'], ['HTML 目录', stats.dir || '--']]
    : [['模式', '离线本地'], ['玩家', profile.name], ['物体数', placed.length], ['存储', 'localStorage']];
  lines.forEach(([k, v]) => { const d = document.createElement('div'); d.innerHTML = `${k}：<b>${v}</b>`; gpInfo.appendChild(d); });
}
function gpRenderPlayers(players) {
  gpPlayers.innerHTML = '';
  if (!players || players.length === 0) { const d = document.createElement('div'); d.className = 'gp-empty'; d.textContent = net.isOnline() ? '暂无玩家' : '本地玩家'; gpPlayers.appendChild(d); return; }
  players.forEach((p, idx) => {
    const row = document.createElement('div'); row.className = 'gp-player';
    const name = document.createElement('div'); name.className = 'gp-pname'; name.textContent = `${idx + 1}. ${p.name}`;
    const role = document.createElement('div'); role.className = 'gp-prole' + (p.role === 'host' ? '' : ' member'); role.textContent = p.role === 'host' ? '房主' : '房员';
    const kick = document.createElement('button'); kick.className = 'gp-kick'; kick.title = '踢出';
    kick.innerHTML = '<svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>';
    kick.addEventListener('pointerdown', e => { e.stopPropagation(); if (!net.isOnline() || !net.connected) { gpBanner.textContent = '未连接'; return; } net.sendConsoleCmd('kick ' + (idx + 1)); gpBanner.textContent = `已发送踢出：${p.name}`; setTimeout(refreshGpanel, 300); });
    row.appendChild(name); row.appendChild(role); row.appendChild(kick); gpPlayers.appendChild(row);
  });
}
function refreshGpanel() {
  if (!net.isOnline()) { gpSetStatus(true, '离线'); gpRenderInfo(null); gpRenderPlayers([]); return; }
  if (!net.connected) { gpSetStatus(false, '未连接'); gpInfo.textContent = '等待连接...'; gpPlayers.innerHTML = '<div class="gp-empty">暂无玩家</div>'; return; }
  net.sendConsoleCmd('gp_fetch');
}
function openGpanel() { gpanelOverlay.classList.add('show'); gpBanner.textContent = '正在加载...'; refreshGpanel(); }
function closeGpanel() { gpanelOverlay.classList.remove('show'); }
btnGpanel.addEventListener('pointerdown', e => { e.stopPropagation(); openGpanel(); });
gpClose.addEventListener('pointerdown', e => { e.stopPropagation(); closeGpanel(); });
gpanelOverlay.addEventListener('pointerdown', e => { if (e.target === gpanelOverlay) closeGpanel(); });
gpRefresh.addEventListener('pointerdown', e => { e.stopPropagation(); refreshGpanel(); });
gpSay.addEventListener('pointerdown', e => {
  e.stopPropagation();
  const text = gpAnnounce.value.trim(); if (!text) { gpBanner.textContent = '请输入公告内容'; return; }
  if (net.isOnline()) { if (!net.connected) { gpBanner.textContent = '未连接'; return; } net.sendConsoleCmd('say ' + text); }
  else { appendChatMessage('系统', text, false, true); saveOfflineChat(); }
  gpAnnounce.value = ''; gpBanner.textContent = '公告已广播';
});
gpKickall.addEventListener('pointerdown', e => { e.stopPropagation(); if (!net.isOnline()) { gpBanner.textContent = '离线无其他玩家'; return; } if (!net.connected) { gpBanner.textContent = '未连接'; return; } net.sendConsoleCmd('kickall'); gpBanner.textContent = '已发送全体踢出'; setTimeout(refreshGpanel, 300); });
gpRestartHttp.addEventListener('pointerdown', e => { e.stopPropagation(); if (!net.isOnline()) { gpBanner.textContent = '离线无 HTTP 服务'; return; } if (!net.connected) { gpBanner.textContent = '未连接'; return; } net.sendConsoleCmd('http restart'); gpBanner.textContent = '已发送重启 HTTP'; });
gpStop.addEventListener('pointerdown', e => { e.stopPropagation(); if (!net.isOnline()) { gpBanner.textContent = '离线无法停止'; return; } if (!net.connected) { gpBanner.textContent = '未连接'; return; } net.sendConsoleCmd('stop'); gpBanner.textContent = '已发送停止指令'; });

// ============ 网络事件绑定 ============
function setNetStatus(text, color, revertMs) {
  dom.netStatus.textContent = text; dom.netStatus.style.color = color || '#4ecdc4';
  if (revertMs) setTimeout(() => { if (net.isOnline() && net.connected) { dom.netStatus.textContent = '已连接网络'; dom.netStatus.style.color = '#4ecdc4'; } }, revertMs);
}
function bindNet(n) {
  n.on('open', () => { setNetStatus('已连接网络', '#4ecdc4'); csStatus.textContent = '已连接'; csStatus.style.color = '#4ecdc4'; gpSetStatus(true, '已连接'); });
  n.on('close', d => {
    remotePlayers.forEach((rp, id) => removeRemotePlayer(id));
    csStatus.textContent = '未连接'; csStatus.style.color = '#ff6b6b'; gpSetStatus(false, '未连接');
    if (d && d.kicked) { dom.netStatus.textContent = '你已被踢出'; dom.netStatus.style.color = '#ff6b6b'; return; }
    dom.netStatus.textContent = '连接断开，重连中...'; dom.netStatus.style.color = '#ff6b6b';
  });
  n.on('log', d => csAppend(`[${d.time || '--:--:--'}] ${d.msg}`, d.level));
  n.on('consoleClear', () => { csLog.innerHTML = ''; });
  n.on('notice', d => { csAppend(`[公告] ${d.msg}`, 'warn'); appendChatMessage('系统', d.msg, false, true); setNetStatus(`公告: ${d.msg}`, '#ff9f43', 4000); gpBanner.textContent = `公告: ${d.msg}`; });
  n.on('gpStats', d => { gpSetStatus(true, '已连接'); gpRenderInfo(d.stats || {}); gpRenderPlayers(d.players || []); });
  n.on('chat', d => {
    const from = d._from, name = d.fromName || '玩家', text = d.text || '', t = d.time || nowTimeStr();
    if (!text) return;
    if (from == null || from === n.myId) {
      if (!chatHistory.some(h => !h.system && h.text === text && h.time === t)) appendChatMessage(name, text, true, false, t);
      return;
    }
    appendChatMessage(name, text, false, false, t);
    showBubble(from, text);
  });
  n.on('skyColor', c => { if (c) applySkyColor(c); });
  n.on('role', d => {
    n.myId = d.id; n.isHost = (d.role === 'host');
    if (profile.name === '玩家') profile.name = n.isHost ? '房主' : '房员';
    refreshLocalLabel();
    dom.roleText.textContent = (n.isHost ? '你是房主' : '你是房员') + '，开始建造！';
    n.sendProfile();
    if (!n.isHost) n.requestProfiles();
  });
  n.on('kicked', () => { dom.netStatus.textContent = '你已被踢出'; dom.netStatus.style.color = '#ff6b6b'; });
  n.on('profile', d => {
    const from = d._from; if (from == null || from === n.myId) return;
    if (!remotePlayers.has(from)) createRemotePlayer(from, d.color, d.name, d.role === 'host');
    else updateRemoteProfile(from, d.color, d.name, d.role === 'host');
  });
  n.on('playerLeave', id => removeRemotePlayer(id));
  n.on('playerMove', d => {
    const from = d._from; if (from == null || from === n.myId) return;
    let rp = remotePlayers.get(from);
    if (!rp) { createRemotePlayer(from, '#4ecdc4', '玩家', false); rp = remotePlayers.get(from); }
    const nx = d.pos[0], ny = d.pos[1], nz = d.pos[2];
    const dist = Math.hypot(nx - rp.targetPos.x, ny - rp.targetPos.y, nz - rp.targetPos.z);
    if (dist > 3 || ny < -5) { if (rp.remoteBody) { rp.remoteBody.position.set(nx, ny, nz); rp.remoteBody.velocity.set(0, 0, 0); } rp.group.position.set(nx, ny, nz); }
    rp.targetPos.set(nx, ny, nz); rp.hasTarget = true;
  });
  n.on('addBlock', d => { createPlaced(d.shapeType, d.color, new THREE.Vector3(d.pos[0], d.pos[1], d.pos[2]), false, d.id ?? null); updateUI(); });
  n.on('addBlocksBatch', d => { (d.blocks || []).forEach(b => { if (!b || !b.pos) return; createPlaced(b.shapeType, b.color, new THREE.Vector3(b.pos[0], b.pos[1], b.pos[2]), false, b.id ?? null); }); updateUI(); });
  n.on('removeBlock', id => { const e = blockMap.get(id); if (e && !e.isDemo) { removePlaced(e); updateUI(); } });
  n.on('blockStates', u => applyBlockStates(u));
  n.on('effect', d => {
    const origin = d.pos ? { x: d.pos[0], y: d.pos[1], z: d.pos[2] } : null;
    if (d.action === 'explode') explode(origin);
    else if (d.action === 'vacuum') vacuum(origin);
    else if (d.action === 'force') applyForce(d.attract, origin);
  });
}

// ============ 摇杆 / 视角 ============
let joyPointerId = null;
const joyMaxDist = 30;
const joyValue = { x: 0, y: 0 };
function updateJoystick(clientX, clientY) {
  const rect = dom.joystickArea.getBoundingClientRect();
  const cx = rect.left + rect.width / 2, cy = rect.top + rect.height / 2;
  let dx = clientX - cx, dy = clientY - cy;
  const dist = Math.hypot(dx, dy), clamped = Math.min(dist, joyMaxDist);
  if (dist > 0.001) { dx = dx / dist * clamped; dy = dy / dist * clamped; }
  joyValue.x = dx / joyMaxDist; joyValue.y = -dy / joyMaxDist;
  dom.joystickThumb.style.transform = `translate(${dx}px, ${dy}px)`;
}
function resetJoystick() { joyValue.x = 0; joyValue.y = 0; dom.joystickThumb.style.transform = 'translate(0px,0px)'; joyPointerId = null; }
dom.joystickArea.addEventListener('pointerdown', e => { e.preventDefault(); joyPointerId = e.pointerId; dom.joystickArea.setPointerCapture(e.pointerId); updateJoystick(e.clientX, e.clientY); });
dom.joystickArea.addEventListener('pointermove', e => { if (joyPointerId === null) return; updateJoystick(e.clientX, e.clientY); });
dom.joystickArea.addEventListener('pointerup', e => { if (joyPointerId === e.pointerId) resetJoystick(); });
dom.joystickArea.addEventListener('pointercancel', resetJoystick);

let viewDrag = { active: false, id: null, lastX: 0, lastY: 0 };
const euler = new THREE.Euler(0, 0, 0, 'YXZ');
document.addEventListener('pointerdown', e => {
  if (e.target.closest('button') || e.target.closest('#toolbar') || e.target.closest('#control-row') || e.target.closest('#start-overlay') || e.target.closest('#color-overlay') || e.target.closest('#profile-overlay') || e.target.closest('#console-overlay') || e.target.closest('#chat-overlay') || e.target.closest('#gpanel-overlay') || e.target.closest('#debug-panel') || e.target.closest('#hud')) return;
  if (e.target.closest('#joystick-area')) return;
  viewDrag.active = true; viewDrag.id = e.pointerId; viewDrag.lastX = e.clientX; viewDrag.lastY = e.clientY; e.preventDefault();
});
document.addEventListener('pointermove', e => {
  if (!viewDrag.active || viewDrag.id !== e.pointerId) return;
  const dx = e.clientX - viewDrag.lastX, dy = e.clientY - viewDrag.lastY;
  viewDrag.lastX = e.clientX; viewDrag.lastY = e.clientY;
  euler.y -= dx * 0.008; euler.x -= dy * 0.008;
  euler.x = Math.max(-Math.PI / 2.2, Math.min(Math.PI / 2.2, euler.x));
  camera.quaternion.setFromEuler(euler);
});
document.addEventListener('pointerup', e => { if (viewDrag.id === e.pointerId) { viewDrag.active = false; viewDrag.id = null; } });
document.addEventListener('pointercancel', () => { viewDrag.active = false; viewDrag.id = null; });

const keys = {};
document.addEventListener('keydown', e => { if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA')) return; keys[e.code] = true; if (e.code === 'Space') e.preventDefault(); });
document.addEventListener('keyup', e => { keys[e.code] = false; });

// ============ 按钮 ============
dom.btnJump.addEventListener('pointerdown', e => {
  e.preventDefault(); playerBody.wakeUp();
  if (cheatFly) flyUpPressed = true;
  else if (isOnGround) { playerBody.velocity.y = CFG.jumpForce; isOnGround = false; }
});
dom.btnJump.addEventListener('pointerup', () => { if (cheatFly) flyUpPressed = false; });
dom.btnJump.addEventListener('pointercancel', () => { if (cheatFly) flyUpPressed = false; });
dom.btnJump.addEventListener('pointerleave', () => { if (cheatFly) flyUpPressed = false; });

dom.btnPlace.addEventListener('pointerdown', () => {
  const p = getPlacement(); if (!p) return;
  const type = shapes.types[shapes.index], color = shapes.colors[shapes.colorIndex];
  const entry = createPlaced(type, color, p);
  updateUI();
  if (net.isOnline()) net.sendAddBlock({ id: entry.id, shapeType: type, color, pos: [p.x, p.y, p.z] });
});
dom.btnRemove.addEventListener('pointerdown', () => {
  const raycaster = new THREE.Raycaster(); raycaster.setFromCamera(new THREE.Vector2(0, 0), camera);
  const hits = raycaster.intersectObjects(allObjects, false);
  for (const hit of hits) {
    const entry = placed.find(e => e.mesh === hit.object);
    if (entry) { removePlaced(entry); updateUI(); if (!entry.isDemo && net.isOnline()) net.sendRemoveBlock(entry.id); break; }
  }
});
dom.btnNext.addEventListener('pointerdown', () => { shapes.index = (shapes.index + 1) % shapes.types.length; updateUI(); });
dom.btnGrab.addEventListener('pointerdown', () => {
  const pos = [playerBody.position.x, playerBody.position.y, playerBody.position.z];
  applyForce(true, { x: pos[0], y: pos[1], z: pos[2] });
  if (net.isOnline()) net.sendEffect({ action: 'force', attract: true, pos });
});
dom.btnPush.addEventListener('pointerdown', () => {
  const pos = [playerBody.position.x, playerBody.position.y, playerBody.position.z];
  applyForce(false, { x: pos[0], y: pos[1], z: pos[2] });
  if (net.isOnline()) net.sendEffect({ action: 'force', attract: false, pos });
});
dom.btnExplode.addEventListener('pointerdown', () => {
  const pos = [playerBody.position.x, playerBody.position.y, playerBody.position.z];
  explode({ x: pos[0], y: pos[1], z: pos[2] });
  if (net.isOnline()) net.sendEffect({ action: 'explode', pos });
});
dom.btnVacuum.addEventListener('pointerdown', () => {
  const pos = [playerBody.position.x, playerBody.position.y, playerBody.position.z];
  vacuum({ x: pos[0], y: pos[1], z: pos[2] });
  if (net.isOnline()) net.sendEffect({ action: 'vacuum', pos });
});
dom.btnColor.addEventListener('pointerdown', e => { e.stopPropagation(); openColorPanel('block', shapes.colors[shapes.colorIndex]); });
dom.btnProfile.addEventListener('pointerdown', e => { e.stopPropagation(); openProfile(); });

// ============ 示例方块 ============
const demos = [[0, 1, -2, 'cube', '#ff6b6b'], [3, 1, 1, 'sphere', '#4ecdc4'], [-3, 1, 2, 'cylinder', '#ffe66d'], [2, 1, 3, 'pyramid', '#a29bfe'], [-2, 1, -3, 'cone', '#00d2d3'], [0, 1, 4, 'torus', '#fd79a8']];
demos.forEach(([x, y, z, type, color]) => { const e = createPlaced(type, color, new THREE.Vector3(x, y, z)); e.isDemo = true; blockMap.delete(e.id); });
updateUI();

// ============ 启动模式 ============
bindNet(net);

dom.btnOffline.addEventListener('pointerdown', () => {
  tryEnterFullscreen();
  net = new OfflineNet(); bindNet(net);
  chatTitle.textContent = '本地聊天室';
  chatHint.textContent = '消息会显示在头顶，并保存到本地存储';
  csHint.textContent = 'help · list · status · say 消息 · clear · chujian';
  dom.netStatus.textContent = '离线模式'; dom.netStatus.style.color = '#4ecdc4';
  loadOfflineChat();
  dom.roleText.textContent = '离线模式';
  dom.startOverlay.classList.add('hidden');
});

dom.btnOnline.addEventListener('pointerdown', () => {
  tryEnterFullscreen();
  net = new OnlineNet(getServerUrl()); bindNet(net);
  chatTitle.textContent = '聊天室';
  chatHint.textContent = '消息会显示在头顶，所有玩家都能看到';
  csHint.textContent = 'help · list · kick 序号 · kickall · status · say 消息 · clear · http restart · stop';
  dom.netStatus.textContent = '连接中...'; dom.netStatus.style.color = '#ff9f43';
  dom.roleText.textContent = '连接服务器...';
  net.connect();
  dom.startOverlay.classList.add('hidden');
});

// ============ 窗口尺寸 ============
window.addEventListener('resize', () => {
  const w = container.clientWidth, h = container.clientHeight;
  camera.aspect = w / h; camera.updateProjectionMatrix(); renderer.setSize(w, h);
});

// ============ 主循环 ============
const clock = new THREE.Clock();
let stats = { frames: 0, time: 0 };
let lastSyncTime = 0, lastBlockSyncTime = 0;

function respawnPlayer() {
  playerBody.position.set(0, 2, 8);
  playerBody.velocity.set(0, 0, 0); playerBody.angularVelocity.set(0, 0, 0);
  playerBody.quaternion.set(0, 0, 0, 1); playerBody.wakeUp();
}

function animate() {
  requestAnimationFrame(animate);
  const dt = Math.min(clock.getDelta(), 0.033);
  const now = performance.now();

  world.step(1 / 60, dt, 5);
  isOnGround = playerBody.position.y <= 0.5 && Math.abs(playerBody.velocity.y) < 0.5;

  const dead = 0.15;
  let mx = 0, mz = 0;
  if (Math.abs(joyValue.x) > dead) mx = joyValue.x;
  if (Math.abs(joyValue.y) > dead) mz = joyValue.y;
  if (keys['KeyW']) mz = 1; else if (keys['KeyS']) mz = -1;
  if (keys['KeyA']) mx = -1; else if (keys['KeyD']) mx = 1;
  const len = Math.hypot(mx, mz);
  if (len > 1) { mx /= len; mz /= len; }

  const forward = new THREE.Vector3(); camera.getWorldDirection(forward); forward.y = 0;
  if (forward.length() > 0.001) forward.normalize();
  const right = new THREE.Vector3().crossVectors(forward, new THREE.Vector3(0, 1, 0)).normalize();
  const dir = new THREE.Vector3().addScaledVector(forward, mz).addScaledVector(right, mx);

  if (cheatFly) {
    const speed = CFG.moveSpeed * 1.2;
    if (dir.length() > 0.001) { dir.normalize(); playerBody.velocity.x = dir.x * speed; playerBody.velocity.z = dir.z * speed; }
    else { playerBody.velocity.x = 0; playerBody.velocity.z = 0; }
    const up = flyUpPressed || keys['Space'], down = keys['ShiftLeft'] || keys['ShiftRight'];
    if (up && !down) playerBody.velocity.y = speed * 0.8;
    else if (down && !up) playerBody.velocity.y = -speed * 0.8;
    else playerBody.velocity.y = 0;
  } else {
    if (dir.length() > 0.001) { dir.normalize(); playerBody.wakeUp(); playerBody.velocity.x = dir.x * CFG.moveSpeed; playerBody.velocity.z = dir.z * CFG.moveSpeed; }
    else if (playerBody.sleepState !== CANNON.Body.SLEEPING) { playerBody.velocity.x *= 0.92; playerBody.velocity.z *= 0.92; }
    if (keys['Space'] && isOnGround) { playerBody.wakeUp(); playerBody.velocity.y = CFG.jumpForce; isOnGround = false; }
  }

  const pos = playerBody.position, limit = CFG.worldSize + 0.5;
  if (pos.x > limit || pos.x < -limit || pos.z > limit || pos.z < -limit || pos.y < -5) respawnPlayer();
  else if (!cheatGod && pos.y < -10) respawnPlayer();

  playerGroup.position.copy(playerBody.position);
  playerMesh.quaternion.copy(playerBody.quaternion);

  for (const entry of placed) { entry.mesh.position.copy(entry.body.position); entry.mesh.quaternion.copy(entry.body.quaternion); }

  remotePlayers.forEach(rp => {
    if (rp.hasTarget && rp.remoteBody) {
      const dx = rp.targetPos.x - rp.remoteBody.position.x, dy = rp.targetPos.y - rp.remoteBody.position.y, dz = rp.targetPos.z - rp.remoteBody.position.z;
      const dist = Math.hypot(dx, dy, dz);
      if (dist > 3) { rp.remoteBody.position.set(rp.targetPos.x, rp.targetPos.y, rp.targetPos.z); rp.remoteBody.velocity.set(0, 0, 0); rp.remoteBody.angularVelocity.set(0, 0, 0); }
      else rp.remoteBody.velocity.set(dx * 10, dy * 10, dz * 10);
      rp.group.position.copy(rp.remoteBody.position);
    }
  });

  updateBubbles();
  const camPos = new THREE.Vector3().copy(playerBody.position); camPos.y += 0.6; camera.position.copy(camPos);

  if (cheatAuto && !cheatFly) {
    autoTimer += dt;
    if (autoTimer > 0.2) {
      autoTimer = 0;
      const p = getPlacement();
      if (p) {
        const type = shapes.types[shapes.index], color = shapes.colors[shapes.colorIndex];
        const entry = createPlaced(type, color, p); updateUI();
        if (net.isOnline()) net.sendAddBlock({ id: entry.id, shapeType: type, color, pos: [p.x, p.y, p.z] });
      }
    }
  }

  if (net.isOnline() && net.connected) {
    if (now - lastSyncTime > 50) { lastSyncTime = now; net.sendMove([playerBody.position.x, playerBody.position.y, playerBody.position.z]); }
    if (now - lastBlockSyncTime > 33) { lastBlockSyncTime = now; sendBlockStates(); }
  }

  stats.frames++;
  if (!stats.time) stats.time = now;
  if (now - stats.time >= 500) { dom.fpsVal.textContent = Math.round(stats.frames / ((now - stats.time) / 1000)); stats.frames = 0; stats.time = now; }

  renderer.render(scene, camera);
}

animate();
</script>
</body>
</html>