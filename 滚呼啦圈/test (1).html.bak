<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<title>滚呼啦圈 · P1 vs P2</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box;}
  html,body{
    width:100%;height:100%;background:#000;overflow:hidden;
    font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;
    -webkit-user-select:none;user-select:none;
    -webkit-tap-highlight-color:transparent;
    touch-action:none;
  }
  #game{display:block;width:100%;height:100%;background:#000;}

  /* 虚拟按键 */
  .pad{
    position:fixed;bottom:0;height:84px;display:flex;gap:8px;
    padding:8px 12px;align-items:center;z-index:10;
  }
  #pad1{left:0;width:50%;}
  #pad2{right:0;width:50%;}
  .btn{
    flex:1;height:64px;border-radius:14px;
    border:1px solid rgba(255,255,255,0.18);
    background:rgba(255,255,255,0.05);
    color:rgba(255,255,255,0.75);
    font-size:20px;font-family:inherit;
    display:flex;align-items:center;justify-content:center;
    -webkit-user-select:none;user-select:none;
    touch-action:none;cursor:pointer;
    transition:background .08s,transform .08s;
  }
  .btn.active{background:rgba(255,255,255,0.16);transform:scale(0.96);}
  #pad1 .btn{border-color:rgba(56,232,255,0.35);color:#38e8ff;}
  #pad2 .btn{border-color:rgba(255,79,216,0.35);color:#ff4fd8;}
  .btn.charge{font-weight:600;letter-spacing:2px;}

  /* 桌面端淡化虚拟按键 */
  @media (hover:hover) and (pointer:fine){
    .pad{opacity:0.4;}
  }

  /* 竖屏提示 */
  #rotate-tip{
    position:fixed;inset:0;background:#000;color:rgba(255,255,255,0.7);
    display:none;align-items:center;justify-content:center;
    font-size:16px;letter-spacing:2px;z-index:100;
  }
  @media (orientation:portrait){
    #rotate-tip{display:flex;}
  }
</style>
</head>
<body>
<canvas id="game"></canvas>

<div class="pad" id="pad1">
  <div class="btn" data-p="p1" data-k="left">◀</div>
  <div class="btn charge" data-p="p1" data-k="charge">蓄力</div>
  <div class="btn" data-p="p1" data-k="right">▶</div>
</div>
<div class="pad" id="pad2">
  <div class="btn" data-p="p2" data-k="left">◀</div>
  <div class="btn charge" data-p="p2" data-k="charge">蓄力</div>
  <div class="btn" data-p="p2" data-k="right">▶</div>
</div>

<div id="rotate-tip">请横屏游玩</div>

<script>
(function(){
'use strict';

const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');

/* ---------- 常量 ---------- */
const R = 22;                 // 呼啦圈半径
const PAD_BOTTOM = 84;        // 底部虚拟按键高度
const DECEL = 760;            // 纵向减速度 px/s²
const DRIFT_ACC = 1000;       // 偏移加速度基数
const STEER_ACC = 1000;       // 玩家横向修正加速度
const MAX_VX = 380;           // 横向速度上限
const GOAL_OFFSET = 46;       // 终点线距区域顶部距离

/* ---------- 状态 ---------- */
let W = 1, H = 1, DPR = 1;
let state = 'playing';        // playing | over
let overTimer = 0;
let resultMsg = '';

const input = {
  p1: { left:false, right:false, charge:false },
  p2: { left:false, right:false, charge:false }
};

function mkPlayer(id, color){
  return {
    id, color,
    area: {x:0, y:0, w:0, h:0},
    x:0, y:0, vx:0, vy:0, rot:0,
    power:0, charging:false,
    offSign:1, offFactor:0.2,
    status:'ready',           // ready | rolling | out | win
    trail:[]
  };
}

const P1 = mkPlayer(1, '#38e8ff');
const P2 = mkPlayer(2, '#ff4fd8');
const ALL = [P1, P2];

/* ---------- 尺寸与布局 ---------- */
function resize(){
  const nw = Math.max(1, canvas.clientWidth);
  const nh = Math.max(1, canvas.clientHeight);
  const changed = Math.abs(nw - W) > 40 || Math.abs(nh - H) > 40;

  W = nw; H = nh;
  DPR = Math.min(window.devicePixelRatio || 1, 2);

  canvas.width  = Math.round(W * DPR);
  canvas.height = Math.round(H * DPR);
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);

  if (changed) layout();
}

function layout(){
  const pad = 14;
  const halfW = W / 2;
  const aw = halfW - pad * 1.5;
  const ah = H - pad * 2 - PAD_BOTTOM;

  P1.area = { x: pad,          y: pad, w: aw, h: ah };
  P2.area = { x: halfW + pad*0.5, y: pad, w: aw, h: ah };

  resetRound();
}

/* ---------- 回合 ---------- */
function resetRound(){
  state = 'playing';
  overTimer = 0;
  resultMsg = '';

  for (const k in input){
    input[k].left = input[k].right = input[k].charge = false;
  }
  document.querySelectorAll('.btn.active').forEach(el => el.classList.remove('active'));

  for (const p of ALL){
    p.x = p.area.x + p.area.w / 2;
    p.y = p.area.y + p.area.h - R - 10;
    p.vx = 0; p.vy = 0; p.rot = 0;
    p.power = 0;
    p.charging = false;
    p.offSign = Math.random() < 0.5 ? -1 : 1;
    p.offFactor = 0.1 + Math.random() * 0.2;
    p.status = 'ready';
    p.trail.length = 0;
  }
}

function launch(p){
  const power = p.power;
  p.charging = false;
  p.status = 'rolling';

  // 满蓄力时的滚动距离约为赛道的 1.7 倍，跨屏幕尺寸保持一致手感
  const need = Math.max(60, p.area.h - GOAL_OFFSET - (R + 10));
  const vmax = Math.sqrt(2 * DECEL * need * 1.7);
  p.vy = -(vmax * Math.max(power, 0.08));
  p.vx = 0;

  // 偏移量：随蓄力增大而增大，范围约 0.1 ~ 0.3
  p.offSign = Math.random() < 0.5 ? -1 : 1;
  p.offFactor = Math.min(0.3, Math.max(0.1,
      0.1 + power * 0.2 + (Math.random() - 0.5) * 0.04));

  p.power = 0;
}

function endRound(winner){
  state = 'over';
  overTimer = 0;
  resultMsg = winner ? ('P' + winner.id + ' 获胜') : '双双出界 · 平局';
}

/* ---------- 更新 ---------- */
function updatePlayer(p, inp, dt){
  if (p.status === 'ready'){
    if (inp.charge){
      p.charging = true;
      p.power = Math.min(1, p.power + dt * 1.5);
    } else if (p.charging){
      launch(p);
    }
    return;
  }

  if (p.status !== 'rolling') return;

  // 纵向减速
  p.vy += DECEL * dt;
  if (p.vy >= 0){
    p.vy = 0; p.vx = 0;
    p.status = 'out';
    return;
  }

  // 随机偏移 + 玩家修正
  p.vx += p.offSign * p.offFactor * DRIFT_ACC * dt;
  if (inp.left)  p.vx -= STEER_ACC * dt;
  if (inp.right) p.vx += STEER_ACC * dt;
  if (p.vx >  MAX_VX) p.vx =  MAX_VX;
  if (p.vx < -MAX_VX) p.vx = -MAX_VX;

  p.x += p.vx * dt;
  p.y += p.vy * dt;
  p.rot -= p.vy * dt / 26;

  // 轨迹
  p.trail.push({ x: p.x, y: p.y });
  if (p.trail.length > 26) p.trail.shift();

  const a = p.area;

  // 横向出界
  if (p.x < a.x || p.x > a.x + a.w){
    p.status = 'out';
    return;
  }

  // 抵达终点
  if (p.y <= a.y + GOAL_OFFSET){
    p.y = a.y + GOAL_OFFSET;
    p.status = 'win';
  }
}

function update(dt){
  if (state === 'playing'){
    updatePlayer(P1, input.p1, dt);
    updatePlayer(P2, input.p2, dt);

    if (P1.status === 'win')                endRound(P1);
    else if (P2.status === 'win')           endRound(P2);
    else if (P1.status === 'out' && P2.status === 'out') endRound(null);
    else if (P1.status === 'out')           endRound(P2);
    else if (P2.status === 'out')           endRound(P1);
  } else {
    overTimer += dt;
    if (overTimer > 2.6) resetRound();
  }
}

/* ---------- 渲染 ---------- */
function drawTrack(p){
  const a = p.area;

  ctx.fillStyle = 'rgba(255,255,255,0.015)';
  ctx.fillRect(a.x, a.y, a.w, a.h);

  ctx.strokeStyle = 'rgba(255,255,255,0.09)';
  ctx.lineWidth = 1;
  ctx.strokeRect(a.x + 0.5, a.y + 0.5, a.w - 1, a.h - 1);

  // 终点线
  const gy = a.y + GOAL_OFFSET;
  ctx.save();
  ctx.setLineDash([9, 9]);
  ctx.globalAlpha = 0.5;
  ctx.lineWidth = 2;
  ctx.strokeStyle = p.color;
  ctx.beginPath();
  ctx.moveTo(a.x + 4, gy);
  ctx.lineTo(a.x + a.w - 4, gy);
  ctx.stroke();
  ctx.restore();
}

function drawHoop(p){
  const r = R;

  // 拖尾
  if (p.trail.length > 1){
    ctx.save();
    ctx.globalAlpha = 0.2;
    ctx.strokeStyle = p.color;
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(p.trail[0].x, p.trail[0].y);
    for (let i = 1; i < p.trail.length; i++){
      ctx.lineTo(p.trail[i].x, p.trail[i].y);
    }
    ctx.stroke();
    ctx.restore();
  }

  // 蓄力环
  if (p.charging && p.power > 0){
    const rr = r + 12 + p.power * 10;
    ctx.save();
    ctx.strokeStyle = p.color;
    ctx.lineCap = 'round';

    ctx.globalAlpha = 0.22;
    ctx.lineWidth = 6;
    ctx.beginPath();
    ctx.arc(p.x, p.y, rr, 0, Math.PI * 2);
    ctx.stroke();

    ctx.globalAlpha = 0.95;
    ctx.lineWidth = 6;
    ctx.beginPath();
    ctx.arc(p.x, p.y, rr, -Math.PI/2, -Math.PI/2 + Math.PI * 2 * p.power);
    ctx.stroke();
    ctx.restore();
  }

  // 呼啦圈本体
  ctx.save();
  ctx.translate(p.x, p.y);

  const c = Math.abs(Math.cos(p.rot));
  const rx = Math.max(3, r * (0.24 + 0.76 * c));

  ctx.shadowColor = p.color;
  ctx.shadowBlur = 18;
  ctx.strokeStyle = p.color;
  ctx.lineWidth = 5.5;
  ctx.beginPath();
  ctx.ellipse(0, 0, rx, r, 0, 0, Math.PI * 2);
  ctx.stroke();

  // 滚动高亮弧
  ctx.shadowBlur = 0;
  ctx.globalAlpha = 0.9;
  ctx.strokeStyle = '#ffffff';
  ctx.lineWidth = 3.5;
  ctx.beginPath();
  ctx.ellipse(0, 0, rx, r, 0, p.rot, p.rot + 0.8);
  ctx.stroke();

  ctx.restore();
}

function drawLabels(){
  ctx.save();
  ctx.textBaseline = 'top';

  ctx.font = '600 15px -apple-system,"PingFang SC",sans-serif';
  ctx.textAlign = 'left';
  ctx.fillStyle = P1.color;
  ctx.fillText('P1', P1.area.x + 10, P1.area.y + 10);

  ctx.textAlign = 'right';
  ctx.fillStyle = P2.color;
  ctx.fillText('P2', P2.area.x + P2.area.w - 10, P2.area.y + 10);

  // 操作提示（区域底部）
  ctx.font = '500 11px -apple-system,"PingFang SC",sans-serif';
  ctx.fillStyle = 'rgba(255,255,255,0.3)';
  ctx.textAlign = 'left';
  ctx.fillText('W 蓄力 · A/D 微调', P1.area.x + 10, P1.area.y + P1.area.h - 20);

  ctx.textAlign = 'right';
  ctx.fillText('↑ 蓄力 · ←/→ 微调', P2.area.x + P2.area.w - 10, P2.area.y + P2.area.h - 20);

  ctx.restore();
}

function drawResult(){
  const t = Math.min(1, overTimer / 0.25);
  const cy = H / 2 - PAD_BOTTOM / 2;

  ctx.save();
  ctx.globalAlpha = t;
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';

  ctx.font = '700 34px -apple-system,"PingFang SC",sans-serif';
  ctx.shadowColor = '#ffffff';
  ctx.shadowBlur = 24;
  ctx.fillStyle = '#ffffff';
  ctx.fillText(resultMsg, W / 2, cy);

  ctx.shadowBlur = 0;
  ctx.globalAlpha = 0.45 * t;
  ctx.font = '500 13px -apple-system,"PingFang SC",sans-serif';
  ctx.fillText('即将开始下一回合', W / 2, cy + 42);
  ctx.restore();
}

function render(){
  ctx.fillStyle = '#000';
  ctx.fillRect(0, 0, W, H);

  drawTrack(P1);
  drawTrack(P2);

  // 中间分隔线
  ctx.strokeStyle = 'rgba(255,255,255,0.06)';
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.moveTo(W / 2, 10);
  ctx.lineTo(W / 2, H - PAD_BOTTOM - 10);
  ctx.stroke();

  drawHoop(P1);
  drawHoop(P2);
  drawLabels();

  if (state === 'over') drawResult();
}

/* ---------- 主循环 ---------- */
let last = 0;
function loop(now){
  if (!last) last = now;
  let dt = (now - last) / 1000;
  last = now;
  if (dt > 0.05) dt = 0.05;

  update(dt);
  render();
  requestAnimationFrame(loop);
}

/* ---------- 输入：键盘 ---------- */
const keyMap = {
  KeyW: ['p1', 'charge'],
  KeyA: ['p1', 'left'],
  KeyD: ['p1', 'right'],
  ArrowUp:    ['p2', 'charge'],
  ArrowLeft:  ['p2', 'left'],
  ArrowRight: ['p2', 'right']
};

window.addEventListener('keydown', e => {
  const m = keyMap[e.code];
  if (m){
    e.preventDefault();
    input[m[0]][m[1]] = true;
  }
  if (e.code === 'KeyR' && !e.repeat){
    resetRound();
  }
}, { passive: false });

window.addEventListener('keyup', e => {
  const m = keyMap[e.code];
  if (m){
    e.preventDefault();
    input[m[0]][m[1]] = false;
  }
}, { passive: false });

window.addEventListener('blur', () => {
  for (const k in input){
    input[k].left = input[k].right = input[k].charge = false;
  }
});

/* ---------- 输入：虚拟按键 ---------- */
document.querySelectorAll('.btn').forEach(el => {
  const pk = el.dataset.p;
  const key = el.dataset.k;

  const press = e => {
    e.preventDefault();
    input[pk][key] = true;
    el.classList.add('active');
  };
  const release = e => {
    if (e) e.preventDefault();
    input[pk][key] = false;
    el.classList.remove('active');
  };

  el.addEventListener('pointerdown', press);
  el.addEventListener('pointerup', release);
  el.addEventListener('pointercancel', release);
  el.addEventListener('pointerleave', release);
});

/* ---------- 启动 ---------- */
resize();
window.addEventListener('resize', resize);
requestAnimationFrame(loop);

})();
</script>
</body>
</html>