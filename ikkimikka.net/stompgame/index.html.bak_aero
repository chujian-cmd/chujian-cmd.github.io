<!DOCTYPE html>
<html lang="zh-CN">
<title>踩踏游戏</title>
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, height=device-height, viewport-fit=cover" />
	<style>
		body {
			--barh: 36px;
			--yoff: 0px;
			font-family: VT323, sans-serif;
			background-color: #dae5d6;
			overflow: hidden;
			margin: 0;
			user-select: none;
			touch-action: pinch-zoom;
		}
		a {
			position: relative;
			z-index: 1;
			color: blue;
		}
		@font-face {
			font-family: VT323;
			font-display: swap;
			src: url(VT323-Regular.ttf);
		}
		.slider {
			height: 12px;
			position: relative;
			top: 3px;
		}
		#screen {
			position: absolute;
			transform: translate(-50%, -50%);
			top: 50%;
			left: 50%;
		}
		#err {
			display: none;
			position: absolute;
			transform: translate(-50%, -50%);
			top: 50%;
			left: 50%;
			user-select: text;
		}
		#controls {
			position: relative;
			top: var(--yoff);
			height: var(--barh);
			text-align: center;
			vertical-align: top;
		}
		#outcanvas {
			position: relative;
			top: var(--yoff);
			display: block;
			margin-left: auto;
			margin-right: auto;
		}
		@media (max-aspect-ratio: 800/516) {
			#outcanvas { width: min(800px, 100vw); }
		}
		@media (min-aspect-ratio: 800/516) {
			#outcanvas { height: min(480px, calc(100dvh - var(--barh))); }
		}
		@media not (display-mode: browser) {
			body { background-color: black; }
			#controls { display: none; }
			@media (max-aspect-ratio: 800/480) { #outcanvas { width: 100vw; } }
			@media (min-aspect-ratio: 800/480) { #outcanvas { height: 100vh; } }
		}
		#stats {
			position: absolute;
			z-index: 1;
			display: none;
			width: 80%;
			left: 50%;
			transform: translate(-50%, 0);
			height: calc(100% - var(--barh));
			overflow-y: auto;
			overflow-x: hidden;
			user-select: text;
			font-size: 24px;
			text-align: left;
			color: white;
			padding: 0px 8px 0px 8px;
			background-color: #00000088;
			text-shadow: 1px 1px 2px black;
			touch-action: manipulation;
		}
		.upload {
			display: block;
			position: absolute;
			top: 0;
			left: 0;
			width: 100%;
			height: 100%;
			box-sizing: border-box;
			border-width: 2px;
			border-style: dashed;
		}
		#upload {
			position: absolute;
			opacity: 0%;
		}
	</style>
</head>
<div id="__dbg" style="position:fixed;right:8px;top:8px;z-index:2147483647;font-family:VT323,monospace;font-size:18px;line-height:1.2;color:#000;background:#dae5d6;border:2px solid #000;box-shadow:2px 2px 0 #000;width:260px;user-select:text;touch-action:manipulation;">
  <div id="__dbg_h" style="padding:3px 6px;cursor:move;background:#000;color:#dae5d6;display:flex;justify-content:space-between;align-items:center;touch-action:none;">
    <span>调试面板</span><span id="__dbg_toggle" style="cursor:pointer;touch-action:manipulation;user-select:none;padding:0 6px;">-</span>
  </div>
  <div id="__dbg_b" style="padding:6px;overflow:visible;">
    <div style="border:1px solid #000;padding:3px;margin-bottom:4px;font-size:14px;white-space:pre-wrap;" id="__dbg_state">状态载入中...</div>
    <div style="margin-bottom:4px;font-size:15px;">
      <a href="javascript:void(0)" id="__dbg_stats">统计</a> &middot;
      <a href="javascript:void(0)" id="__dbg_pause">暂停</a> &middot;
      <a href="javascript:void(0)" id="__dbg_slow">慢速</a> &middot;
      <a href="javascript:void(0)" id="__dbg_reset">重开</a> &middot;
      <a href="javascript:void(0)" id="__dbg_end">结束</a><br>
      <a href="javascript:void(0)" id="__dbg_shot">截图</a> &middot;
      <a href="javascript:void(0)" id="__dbg_fs">全屏</a> &middot;
      <a href="javascript:void(0)" id="__dbg_clear">清缓存</a>
    </div>
    <div style="margin-bottom:4px;">音量 <input id="__dbg_vol" type="range" min="0" max="100" style="width:110px;vertical-align:middle;"><span id="__dbg_volv"></span></div>
    <div style="margin-bottom:4px;font-size:15px;"><a href="javascript:void(0)" id="__dbg_stomp">踩</a> &middot; <a href="javascript:void(0)" id="__dbg_spawn">加虫</a> &middot; <a href="javascript:void(0)" id="__dbg_killall">全灭</a> &middot; <a href="javascript:void(0)" id="__dbg_start">开始</a> &middot; <a href="javascript:void(0)" id="__dbg_finish">结束</a></div>
    <div style="margin-bottom:4px;font-size:14px;">角色: <a href="javascript:void(0)" id="__dbg_char_default">默认</a> &middot; <a href="javascript:void(0)" id="__dbg_char_toobs">toobs</a> &middot; <a href="javascript:void(0)" id="__dbg_char_ragna">ragna</a> &middot; <a href="javascript:void(0)" id="__dbg_char_toobsflop">toobsflop</a> &middot; <a href="javascript:void(0)" id="__dbg_char_joey">joey</a> &middot; <a href="javascript:void(0)" id="__dbg_char_sacchy">sacchy</a> &middot; <a href="javascript:void(0)" id="__dbg_char_mikkaflop">mikkaflop</a> &middot; <a href="javascript:void(0)" id="__dbg_char_konna">konna</a></div>
    <div style="margin-bottom:4px;font-size:15px;"><a href="javascript:void(0)" id="__dbg_bot">机器人:关</a> &middot; <a href="javascript:void(0)" id="__dbg_botspeed">速度:中</a></div>
    <div style="margin-bottom:4px;font-size:15px;"><a href="javascript:void(0)" id="__dbg_ego_up">Ego+</a> &middot; <a href="javascript:void(0)" id="__dbg_ego_down">Ego-</a> &middot; <a href="javascript:void(0)" id="__dbg_ego_zero">Ego0</a> &middot; <a href="javascript:void(0)" id="__dbg_ego_max">Ego满</a> &middot; <a href="javascript:void(0)" id="__dbg_t30">+30s</a> &middot; <a href="javascript:void(0)" id="__dbg_t300">+300s</a> &middot; <a href="javascript:void(0)" id="__dbg_k100">击杀+100</a></div>
    <div style="margin-bottom:4px;font-size:15px;"><a href="javascript:void(0)" id="__dbg_left">爪左</a> &middot; <a href="javascript:void(0)" id="__dbg_mid">爪中</a> &middot; <a href="javascript:void(0)" id="__dbg_right">爪右</a> &middot; <a href="javascript:void(0)" id="__dbg_up">抬起</a> &middot; <a href="javascript:void(0)" id="__dbg_down">踩下</a> &middot; <a href="javascript:void(0)" id="__dbg_spawn50">加50虫</a></div>
    <div style="margin-bottom:4px;font-size:15px;"><a href="javascript:void(0)" id="__dbg_knockall">全部击倒</a> &middot; <a href="javascript:void(0)" id="__dbg_wipe">全清</a> &middot; <a href="javascript:void(0)" id="__dbg_day">白天</a> &middot; <a href="javascript:void(0)" id="__dbg_night">夜晚</a> &middot; <a href="javascript:void(0)" id="__dbg_hpaw">显隐爪</a> &middot; <a href="javascript:void(0)" id="__dbg_hcam">显隐相机</a></div>
    <div style="border-top:1px solid #000;margin-top:4px;padding-top:4px;">
      <div id="__dbg_ft" style="margin-bottom:2px;cursor:pointer;user-select:none;">数值调整 &#9662;</div>
      <div id="__dbg_fields" style="display:block;height:90px;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;touch-action:pan-y;"></div>
    </div>
    <div id="__dbg_info" style="font-size:13px;max-height:80px;overflow:auto;border-top:1px solid #000;margin-top:4px;padding-top:4px;white-space:pre-wrap;"></div>
  </div>
</div>
<script>
(function(){
try{
  var $=function(id){return document.getElementById(id)};
  var panel=$("__dbg"), body=$("__dbg_b"), ff=$("__dbg_fields"), ft=$("__dbg_ft");
  var G=window.__G;

  // 折叠整块
  function togglePanel(e){ if(e)e.stopPropagation();
    var hide=body.style.display!=="none";
    body.style.display=hide?"none":"block";
    $("__dbg_toggle").textContent=hide?"+":"-";
  }
  $("__dbg_toggle").addEventListener("click",togglePanel);

  // 折叠数值区
  ft.addEventListener("click",function(){
    var open=ff.style.display!=="none";
    ff.style.display=open?"none":"block";
    ft.innerHTML="数值调整 "+(open?"&#9656;":"&#9662;");
  });

  // 拖动
  var drag=false,dx=0,dy=0;
  function startDrag(e){
    var t=e.touches?e.touches[0]:e;
    var tg=e.target;
    if(tg&&(tg.id==="__dbg_toggle"||tg.closest&&(tg.closest("#__dbg_toggle")||tg.closest("a,button,input"))))return;
    var r=panel.getBoundingClientRect();
    panel.style.left=r.left+"px"; panel.style.top=r.top+"px"; panel.style.right="auto";
    drag=true; dx=t.clientX-r.left; dy=t.clientY-r.top; e.preventDefault();
  }
  function moveDrag(e){
    if(!drag)return; var t=e.touches?e.touches[0]:e;
    panel.style.left=(t.clientX-dx)+"px"; panel.style.top=(t.clientY-dy)+"px"; e.preventDefault();
  }
  function endDrag(){drag=false;}
  var hh=$("__dbg_h");
  hh.addEventListener("mousedown",startDrag);
  hh.addEventListener("touchstart",startDrag,{passive:false});
  document.addEventListener("mousemove",moveDrag);
  document.addEventListener("touchmove",moveDrag,{passive:false});
  document.addEventListener("mouseup",endDrag);
  document.addEventListener("touchend",endDrag);

  // 音量
  var vol=$("__dbg_vol"),volv=$("__dbg_volv"),realVol=document.getElementById("volume");
  function syncVol(){var v=+(localStorage.getItem("volume")||0.3)*100;vol.value=v;volv.textContent=Math.round(v)+"%";}
  syncVol();
  vol.oninput=function(){var v=+vol.value/100;localStorage.setItem("volume",v);volv.textContent=vol.value+"%";if(realVol){realVol.value=vol.value;realVol.dispatchEvent(new Event("input"));}};

  // 按钮
  $("__dbg_stats").onclick=function(){var s=document.getElementById("stats");if(!s)return;s.style.display="block";if(!s.innerHTML.trim())s.innerHTML="<br><br><div style='text-align:center;'>统计面板由游戏内逻辑填充，请在结束页点击统计按钮。</div>";};
  $("__dbg_clear").onclick=function(){if(confirm("清空 localStorage 并刷新？")){localStorage.clear();location.reload();}};
  $("__dbg_shot").onclick=function(){var oc=document.getElementById("outcanvas");if(!oc)return;var a=document.createElement("a");a.download="stomp_"+Date.now()+".png";a.href=oc.toDataURL("image/png");a.click();};
  $("__dbg_fs").onclick=function(){var d=document.getElementById("outcanvasd");if(d)d.requestFullscreen();};
  $("__dbg_pause").onclick=function(){ var G=window.__G; if(G){ G.game_pause=!G.game_pause; } };
  $("__dbg_slow").onclick=function(){ var G=window.__G; if(G){ G.slow=!G.slow; } };
  $("__dbg_stomp").onclick=function(){ var G=window.__G; if(G)G.stomp(); };
  $("__dbg_spawn").onclick=function(){ var G=window.__G; if(G)G.spawn_bug(10); };
  $("__dbg_killall").onclick=function(){ var G=window.__G; if(G)G.kill_all; };
  $("__dbg_start").onclick=function(){ var G=window.__G; if(G){ G.started_playing=true; G.game_pause=false; } };
  $("__dbg_finish").onclick=function(){ var G=window.__G; if(G){ G.finished=true; } };
  (function(){
    // 自动获取当前目录，生成相对路径，无论地址怎么变都能用
    var BASE = location.pathname.replace(/[^/]*$/, "") + "index.html?character=";
    ["toobs","ragna","toobsflop","joey","sacchy","mikkaflop","konna"].forEach(function(n){
      var el=document.getElementById("__dbg_char_"+n);
      if(el) el.onclick=function(){ location.href=BASE+n; };
    });
    // 默认角色（不带参数）
    var el_def=document.getElementById("__dbg_char_default");
    if(el_def) el_def.onclick=function(){ location.href = location.pathname; };
  })();
  $("__dbg_reset").onclick=function(){ var G=window.__G; if(G&&G.change_game&&G.Endless){ G.game_pause=false; G.change_game(G.Endless, false); } };

  // ===== 自动刷分机器人 =====
  // 规律：每 tick 横向平移 16px，到边反向；每 4 tick 踩一次，落地后抬起。
  window.__BOT = window.__BOT || { on:false, speed:120, step:24 };
  var bot_timer=null;
  var bot_dir=1, bot_x=0, bot_tick=0, bot_down=0;

  function botTick(){
    var G=window.__G; if(!G){return;}
    G.started_playing=true;
    G.active=true;
    G.paw_follows_mouse=false;
    if(G.game_pause) G.game_pause=false;
    if(G.finished) G.finished=false;

    // 虫子不够就补
    var alive=0, bs=G.bugs;
    for(var i=0;i<bs.length;i++) if(bs[i]) alive++;
    if(alive<8) G.spawn_bug(4);

    bot_tick++;
    var W=G.w||800;

    // 踩下：保持到真正落地再抬起
    if(bot_down>0){
      if(G.paw_y >= (G.floor_y||G.h)){ G.paw_dest_y=0; bot_down=0; }
    } else if(bot_tick%4===0){
      G.paw_dest_y = G.h*2;
      bot_down = 1;
    }

    // 横扫，到边反向
    if(bot_x<=0){ bot_x=0; bot_dir=1; }
    if(bot_x>=W){ bot_x=W; bot_dir=-1; }
    bot_x += bot_dir*__BOT.step;
    G.paw_dest_x = bot_x;
  }
  function botStart(){
    if(bot_timer) return;
    bot_timer=setInterval(botTick, __BOT.speed);
  }
  function botStop(){
    if(bot_timer){ clearInterval(bot_timer); bot_timer=null; }
    var G=window.__G; if(G) G.paw_dest_y=0;
  }  $("__dbg_bot").onclick=function(){
    __BOT.on=!__BOT.on;
    this.textContent="机器人:"+(__BOT.on?"开":"关");
    if(__BOT.on) botStart(); else botStop();
  };
  $("__dbg_botspeed").onclick=function(){
    var arr=[120,250,500]; var names=["快","中","慢"];
    var idx=arr.indexOf(__BOT.speed); idx=(idx+1)%arr.length;
    __BOT.speed=arr[idx]; this.textContent="速度:"+names[idx];
    if(__BOT.on){ botStop(); botStart(); }
  };

  $("__dbg_end").onclick=function(){ var G=window.__G; if(G&&G.change_game&&G.EndScreen){ G.game_pause=false; G.change_game(G.EndScreen); } };
  $("__dbg_ego_up").onclick=function(){var G=window.__G;if(G)G.affect_ego(1000,400,200);};
  $("__dbg_ego_down").onclick=function(){var G=window.__G;if(G)G.affect_ego(-1000,400,200);};
  $("__dbg_ego_zero").onclick=function(){var G=window.__G;if(G){G.ego_val=0;G.ego_climb=0;}};
  $("__dbg_ego_max").onclick=function(){var G=window.__G;if(G){G.ego_val=G.ego.step*G.ego.levels-1;G.ego_climb=G.ego_val;}};
  $("__dbg_t30").onclick=function(){var G=window.__G;if(G)G.stats.time_elapsed+=30;};
  $("__dbg_t300").onclick=function(){var G=window.__G;if(G)G.stats.time_elapsed+=300;};
  $("__dbg_k100").onclick=function(){var G=window.__G;if(G)G.stats.total_kills+=100;};
  $("__dbg_left").onclick=function(){var G=window.__G;if(G){G.paw_dest_x=G.paw.width/2;}};
  $("__dbg_mid").onclick=function(){var G=window.__G;if(G){G.paw_dest_x=G.w/2;}};
  $("__dbg_right").onclick=function(){var G=window.__G;if(G){G.paw_dest_x=G.w-G.paw.width/2;}};
  $("__dbg_up").onclick=function(){var G=window.__G;if(G)G.paw_dest_y=0;};
  $("__dbg_down").onclick=function(){var G=window.__G;if(G)G.paw_dest_y=G.h*2;};
  $("__dbg_spawn50").onclick=function(){var G=window.__G;if(G)G.spawn_bug(50);};
  $("__dbg_knockall").onclick=function(){var G=window.__G;if(!G)return;var bs=G.bugs;for(var i=0;i<bs.length;i++){var b=bs[i];if(b&&b.knock)b.knock();}};
  $("__dbg_wipe").onclick=function(){var G=window.__G;if(!G)return;var bs=G.bugs;for(var i=0;i<bs.length;i++){if(bs[i])G.delete_bug(i);}};
  $("__dbg_day").onclick=function(){var G=window.__G;if(G)G.time_of_day=0;};
  $("__dbg_night").onclick=function(){var G=window.__G;if(G)G.time_of_day=1;};
  $("__dbg_hpaw").onclick=function(){var G=window.__G;if(G)G.hide_paws=!G.hide_paws;};
  $("__dbg_hcam").onclick=function(){var G=window.__G;if(G)G.hide_cam=!G.hide_cam;};

  // 数值
  var FIELDS=[
    ["paw.width","爪宽",40,400,1],
    ["paw.speed.0","横移速度",0,60,0.5],
    ["paw.speed.1","下移速度",0,60,0.5],
    ["paw.max_velocity","最大速度",200,6000,100],
    ["paw.strength","踩踏强度",0,20,0.5],
    ["paw.friction","摩擦",0,10,0.5],
    ["paw.shake_max","最大震动",0,20,0.5],
    ["paw.wetness","潮湿",0,1,0.05],
    ["paw.stam_max","体力上限",1,100,1],
    ["paw.stam_loss","体力消耗",0,20,0.1],
    ["paw.stam_gain","体力恢复",0,50,1],
    ["ego.gain_mul","Ego增益",0,100,1],
    ["ego.loss_mul","Ego损失",0,100,1],
    ["ego.passive_loss","Ego流失",0,50,0.5],
    ["ego.levels","Ego等级",1,20,1],
    ["bug.max_ego","虫Ego上限",0,10000,5],
    ["bug.ego_rng","虫Ego随机",0,100,1],
    ["bug.suffer_mul","受苦倍数",0,100,1],
    ["bug.strength_base","虫基础力量",0,5,0.1],
    ["bug.strength_rng","虫力量随机",0,5,0.1],
    ["set.starter_bugs","初始虫子",0,500,1],
    ["set.spawn_rng","生成概率",0,1,0.01],
    ["set.spawn_ego_base","Ego生成",0,1,0.01],
    ["set.combo_duration","连杀时长",0,10,0.1],
    ["set.seconds_in_day","一天时长",10,3600,10]
    ["__bot_speed","机器人间隔",60,2000,10],
    ["__bot_step","机器人步长",1,80,1],
  ];
  function getPath(o,p){var a=p.split(".");for(var i=0;i<a.length;i++){if(o==null)return undefined;o=o[a[i]];}return o;}
  function setPath(o,p,v){var a=p.split(".");for(var i=0;i<a.length-1;i++){if(o==null)return;o=o[a[i]];}if(o!=null)o[a[a.length-1]]=v;}
  var inputs=[];
  function buildFields(){
    if(!window.__G)return;
    try{
      console.log("buildFields bot_speed=",typeof bot_speed, "bot_step=",typeof bot_step);
    }catch(e){ console.log("bot vars err", e.message); }
    ff.innerHTML=""; inputs=[];
    FIELDS.forEach(function(f){
      var path=f[0],label=f[1],mn=f[2],mx=f[3],stp=f[4];
      var cur;
      if(path==="__bot_speed") cur=window.__BOT.speed;
      else if(path==="__bot_step") cur=window.__BOT.step;
      else cur=getPath(window.__G,path);
      if(cur==null)return;
      var row=document.createElement("div");
      row.style.cssText="display:flex;align-items:center;gap:4px;margin:0;height:18px;line-height:18px;";
      var lab=document.createElement("span");
      lab.textContent=label;
      lab.style.cssText="flex:1;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;";
      var inp=document.createElement("input");
      inp.type="number"; inp.min=mn; inp.max=mx; inp.step=stp; inp.value=cur;
      inp.style.cssText="width:60px;font-family:inherit;font-size:13px;padding:0 2px;";
      inp.addEventListener("input",function(){
        var v=parseFloat(inp.value); if(isNaN(v))return;
        if(path==="__bot_speed"){ window.__BOT.speed=v; if(window.__BOT.on){botStop();botStart();} }
        else if(path==="__bot_step"){ window.__BOT.step=v; }
        else setPath(window.__G,path,v);
      });
      inp.addEventListener("change",function(){
        var v=parseFloat(inp.value); if(isNaN(v))return;
        v=Math.min(mx,Math.max(mn,v));
        if(path==="__bot_speed"){ window.__BOT.speed=v; if(window.__BOT.on){botStop();botStart();} }
        else if(path==="__bot_step"){ window.__BOT.step=v; }
        else setPath(window.__G,path,v);
        inp.value=v;
      });
      row.appendChild(lab); row.appendChild(inp);
      ff.appendChild(row); inputs.push({path:path,inp:inp});
    });
  }
  var tries=0,timer=setInterval(function(){
    if(window.__G && ff.children.length===0){ buildFields(); }
    if(window.__G && ff.children.length>0){ clearInterval(timer); return; }
    if(++tries>400) clearInterval(timer);
  },250);

  // 反向同步
  setInterval(function(){
    if(!window.__G)return;
    for(var i=0;i<inputs.length;i++){
      var it=inputs[i];
      if(document.activeElement===it.inp)continue;
      var cur=getPath(window.__G,it.path);
      if(cur==null)continue;
      if(String(cur)!==it.inp.value)it.inp.value=Math.round(cur*1000)/1000;
    }
  },300);

  // 状态信息
  var info=$("__dbg_info"),prev="";
  setInterval(function(){
    var s=window.game_stats;
    if(!s){info.textContent="等待游戏载入...";return;}
    var txt="击杀 "+s.total_kills+"  逃脱 "+s.bugs_left+
            "\nEgo+ "+Math.floor(s.ego_gained)+"  Ego- "+Math.floor(s.ego_lost)+
            "\n时间 "+Math.floor(s.time_elapsed)+"s";
    if(txt!==prev){info.textContent=txt;prev=txt;}
  },250);

  // 状态区
  setInterval(function(){
    var s=window.game_stats; if(!s)return;
    var G2=window.__G||{};
    var eg=G2.ego_val!=null?Math.floor(G2.ego_val):"-";
    var fT=G2.paw&&G2.paw.stam_max?"":"";
    var txt="Ego "+eg+
            "\n击杀 "+s.total_kills+"  逃脱 "+s.bugs_left+
            "\n时间 "+Math.floor(s.time_elapsed)+"s";
    $("__dbg_state").textContent=txt;
  },300);

}catch(e){
  var d=document.getElementById("__dbg_info");
  if(d)d.textContent="面板错误: "+e.message;
  console.error(e);
}
})();
</script>
<body>
<div id="screen">
	<div id="outcanvasd">
		<div id="stats"></div>
		<canvas id="outcanvas" width="800" height="480"></canvas>
	</div>
	<div id="controls">
		<a href="https://ikkimikka.net/">更多</a>
		• <a href="javascript:void(0)" id="fullscreenlink">全屏</a>
		• <a href="https://patreon.com/ikkimikka">赞助</a>
		• <a href="https://ikkimikka.net/stompych.png">约稿?</a>
		<br>
		音量 <input type="range" min="0" max="100" value="30" class="slider" id="volume" title="音量">
	</div>
</div>
<div id="err"></div>
<noscript>需要启用 JavaScript。<br></noscript>
<script src="jszip.min.js"></script>
