<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>好玩的前端 CDN 资源</title>
<style>
  :root{
    --bg:#f7f8fc;
    --card:#ffffff;
    --text:#151824;
    --muted:#6b7280;
    --border:#e7e9f0;
    --code-bg:#f5f6fa;
    --radius:16px;
  }

  *{box-sizing:border-box;margin:0;padding:0}

  body{
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
    background:
      radial-gradient(1100px 560px at 8% -12%, #e9edff 0%, transparent 60%),
      radial-gradient(900px 480px at 100% 0%, #ffeef6 0%, transparent 55%),
      var(--bg);
    color:var(--text);
    min-height:100vh;
    padding:56px 24px 100px;
    -webkit-font-smoothing:antialiased;
  }

  /* ---------- 页头 ---------- */
  .page-head{max-width:1100px;margin:0 auto 46px}
  .page-head h1{
    font-size:clamp(26px,4vw,36px);
    font-weight:700;
    letter-spacing:-.025em;
  }
  .page-head p{
    margin-top:12px;
    font-size:15px;
    line-height:1.7;
    color:var(--muted);
    max-width:640px;
  }

  /* ---------- 分类 ---------- */
  .section{max-width:1100px;margin:0 auto 44px}

  .section-head{
    display:flex;
    align-items:center;
    gap:12px;
    margin-bottom:16px;
  }
  .section-icon{
    width:40px;height:40px;
    flex:none;
    border-radius:12px;
    display:grid;place-items:center;
    color:var(--accent);
    background:var(--soft);
  }
  .section-icon svg{width:20px;height:20px}
  .section-head h2{font-size:17px;font-weight:600;letter-spacing:-.01em}
  .count{
    margin-left:auto;
    font-size:12px;
    color:var(--muted);
    background:#fff;
    border:1px solid var(--border);
    padding:3px 10px;
    border-radius:99px;
  }

  /* ---------- 卡片网格 ---------- */
  .grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(300px,1fr));
    gap:16px;
  }

  .card{
    background:var(--card);
    border:1px solid var(--border);
    border-radius:var(--radius);
    padding:18px;
    display:flex;
    flex-direction:column;
    gap:12px;
    transition:transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  .card:hover{
    transform:translateY(-3px);
    box-shadow:0 14px 30px -14px rgba(20,24,40,.18);
    border-color:#dcdfe9;
  }

  .card-top{display:flex;align-items:center;gap:10px}
  .card-top h3{
    font-size:15px;
    font-weight:600;
    letter-spacing:-.01em;
  }
  .tag{
    font-size:11px;
    font-weight:500;
    padding:2px 9px;
    border-radius:99px;
    color:var(--accent);
    background:var(--soft);
    white-space:nowrap;
  }

  .desc{
    font-size:13.5px;
    line-height:1.65;
    color:var(--muted);
    flex:1;
  }

  /* ---------- 代码行 ---------- */
  .code{
    display:flex;
    align-items:center;
    gap:8px;
    background:var(--code-bg);
    border:1px solid var(--border);
    border-radius:10px;
    padding:6px 6px 6px 12px;
  }
  .code code{
    flex:1;
    min-width:0;
    font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
    font-size:12px;
    color:#3d4152;
    white-space:nowrap;
    overflow-x:auto;
    scrollbar-width:none;
  }
  .code code::-webkit-scrollbar{display:none}

  .copy{
    flex:none;
    width:30px;height:30px;
    border-radius:8px;
    border:1px solid var(--border);
    background:#fff;
    color:var(--muted);
    display:grid;place-items:center;
    cursor:pointer;
    transition:color .18s ease, border-color .18s ease, background .18s ease;
  }
  .copy:hover{color:var(--accent);border-color:currentColor}
  .copy:active{transform:scale(.94)}
  .copy svg{width:15px;height:15px}
  .copy .i-check{display:none}
  .copy.copied{
    color:#16a34a;
    border-color:currentColor;
    background:#f0fdf4;
  }
  .copy.copied .i-copy{display:none}
  .copy.copied .i-check{display:block}

  /* ---------- 响应式 ---------- */
  @media (max-width:640px){
    body{padding:36px 16px 72px}
    .grid{grid-template-columns:1fr}
    .page-head{margin-bottom:36px}
    .section{margin-bottom:36px}
  }

  @media (prefers-reduced-motion:reduce){
    .card,.copy{transition:none}
  }
</style>
</head>
<body>

<header class="page-head">
  <h1>好玩的前端 CDN 资源</h1>
  <p>一行 &lt;script&gt; 或 &lt;link&gt; 就能给页面加上的视觉与交互动效。点击右侧按钮复制链接。</p>
</header>

<main id="app"></main>

<script>
/* ---------------- SVG 图标 ---------------- */
const ICONS = {
  sparkle: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.5l2.4 7.1 7.1 2.4-7.1 2.4L12 21.5l-2.4-7.1L2.5 12l7.1-2.4z"/></svg>`,
  cursor:  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 3l14 7.6-6.1 1.7L10.6 19z"/></svg>`,
  cube:    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.8l8.4 4.7v9L12 21.2 3.6 16.5v-9z"/><path d="M12 12l8.4-4.5M12 12v9.2M12 12L3.6 7.5"/></svg>`,
  type:    `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 7V5.5h14V7M12 5.5V19M9 19h6"/></svg>`
};

const ICON_COPY  = `<svg class="i-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2.5"/><path d="M5 15V6a2 2 0 0 1 2-2h9"/></svg>`;
const ICON_CHECK = `<svg class="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>`;

/* ---------------- 数据 ---------------- */
const SECTIONS = [
  {
    title: '背景与粒子特效',
    icon: 'sparkle',
    accent: '#7c6cf7',
    soft: 'rgba(124,108,247,.12)',
    items: [
      { name:'Borealis', desc:'交互式极光 / 星云背景，基于噪声算法，效果很迷幻。',
        url:'https://cdn.jsdelivr.net/npm/@diabolic/borealis/dist/borealis.min.js', tag:'背景' },
      { name:'Particle Cake', desc:'3D 粒子蛋糕，点击爆炸成烟花，再聚合为你设定的文字（需 Three.js）。',
        url:'https://cdn.jsdelivr.net/npm/particle-cake/dist/particle-cake.min.js', tag:'粒子' },
      { name:'ASCIIGround', desc:'用动态 ASCII 字符铺满 Canvas 背景，复古终端感。',
        url:'https://unpkg.com/asciiground@latest/dist/asciiground.umd.js', tag:'背景' },
      { name:'bubbly-bg', desc:'极简气泡背景，体积不到 1kB，轻量点缀首选。',
        url:'https://cdn.jsdelivr.net/npm/bubbly-bg@0.2.3/dist/bubbly-bg.js', tag:'背景' }
    ]
  },
  {
    title: '鼠标交互整活',
    icon: 'cursor',
    accent: '#ec4899',
    soft: 'rgba(236,72,153,.12)',
    items: [
      { name:'mouse-animations', desc:'拖尾、点击涟漪、粒子爆发、磁吸元素、3D 倾斜，可自由组合。',
        url:'https://cdn.jsdelivr.net/npm/mouse-animations/+esm', tag:'ESM' },
      { name:'pd-animate', desc:'开箱即用的平滑鼠标跟随与磁吸效果，一行代码调用。',
        url:'https://cdn.jsdelivr.net/npm/pd-animate/dist/pd-animate.min.js', tag:'交互' }
    ]
  },
  {
    title: '3D 与高级视觉',
    icon: 'cube',
    accent: '#0ea5e9',
    soft: 'rgba(14,165,233,.12)',
    items: [
      { name:'Vanta.js', desc:'几行代码给网页加上漂亮的 3D 动画背景（波浪 / 云层 / 光晕），需搭配 Three.js。',
        url:'https://cdn.jsdelivr.net/npm/vanta/dist/vanta.waves.min.js', tag:'3D' },
      { name:'Shery.js', desc:'鼠标跟随、图像遮罩、文字动画与 3D 扭曲，风格现代。',
        url:'https://cdn.jsdelivr.net/npm/sheryjs/dist/Shery.js', tag:'视觉' },
      { name:'Zdog', desc:'轻量 3D 引擎，用代码绘制简单 3D 模型，压缩后仅 28KB。',
        url:'https://cdn.jsdelivr.net/npm/zdog@1/dist/zdog.dist.min.js', tag:'3D' }
    ]
  },
  {
    title: '文字与 CSS 动效',
    icon: 'type',
    accent: '#f59e0b',
    soft: 'rgba(245,158,11,.12)',
    items: [
      { name:'AwardsCSS', desc:'定位「Awwwards 级别」的 CSS 动效库，提供高端的动态界面效果。',
        url:'https://cdn.jsdelivr.net/npm/awardscss/dist/awardscss.css', tag:'CSS' },
      { name:'hoverfx', desc:'100+ 未来感悬停效果，给按钮和卡片加点料。',
        url:'https://unpkg.com/hoverfx/dist/hoverfx.min.css', tag:'CSS' },
      { name:'mojs', desc:'按钮点击炸开、图标变形、文字逐字浮现等精致微交互。',
        url:'https://unpkg.com/@mojs/core', tag:'动效' },
      { name:'letterfx', desc:'轻量级文字逐字动画库，让标题和段落动起来。',
        url:'https://cdn.jsdelivr.net/npm/letterfx/dist/letterfx.min.js', tag:'文字' }
    ]
  }
];

/* ---------------- 渲染 ---------------- */
const app = document.getElementById('app');

app.innerHTML = SECTIONS.map(section => `
  <section class="section" style="--accent:${section.accent};--soft:${section.soft}">
    <div class="section-head">
      <div class="section-icon">${ICONS[section.icon]}</div>
      <h2>${section.title}</h2>
      <span class="count">${section.items.length}</span>
    </div>
    <div class="grid">
      ${section.items.map(item => `
        <article class="card">
          <div class="card-top">
            <h3>${item.name}</h3>
            <span class="tag">${item.tag}</span>
          </div>
          <p class="desc">${item.desc}</p>
          <div class="code">
            <code>${item.url}</code>
            <button class="copy" data-url="${item.url}" aria-label="复制 ${item.name} 的链接">
              ${ICON_COPY}${ICON_CHECK}
            </button>
          </div>
        </article>
      `).join('')}
    </div>
  </section>
`).join('');

/* ---------------- 复制交互 ---------------- */
document.addEventListener('click', async (e) => {
  const btn = e.target.closest('.copy');
  if (!btn) return;

  const url = btn.dataset.url;
  try {
    await navigator.clipboard.writeText(url);
  } catch {
    // 非安全上下文下的兜底方案
    const ta = document.createElement('textarea');
    ta.value = url;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    ta.remove();
  }

  btn.classList.add('copied');
  clearTimeout(btn._t);
  btn._t = setTimeout(() => btn.classList.remove('copied'), 1600);
});
</script>
</body>
</html>