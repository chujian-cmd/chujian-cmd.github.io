    </div>

    <script>
        (function() {
            // ---------- 1. 生成背景星点 ----------
            const starField = document.getElementById('starField');
            const starCount = 120;
            for (let i = 0; i < starCount; i++) {
                const star = document.createElement('div');
                star.className = 'star';
                const x = Math.random() * 100;
                const y = Math.random() * 100;
                const size = Math.random() * 2.8 + 1.2;
                const delay = Math.random() * 8;
                const duration = Math.random() * 6 + 4;
                star.style.left = x + '%';
                star.style.top = y + '%';
                star.style.width = size + 'px';
                star.style.height = size + 'px';
                star.style.animationDelay = delay + 's';
                star.style.animationDuration = duration + 's';
                star.style.background = 'radial-gradient(circle, rgba(255,255,255,0.9) 0%, rgba(180,220,255,0.4) 100%)';
                starField.appendChild(star);
            }

            // ---------- 2. 滚动驱动背景色相 ----------
            const bgContainer = document.getElementById('bgContainer');
            const baseHue = 220; // 初始冷色
            
            function updateBackground() {
                const scrollY = window.scrollY;
                const docHeight = document.documentElement.scrollHeight - window.innerHeight;
                const progress = docHeight > 0 ? scrollY / docHeight : 0;
                
                // 色相从 220 (蓝) 逐渐偏移到 280 (紫) 甚至 340 (粉)，范围约 120 度
                const hue = (baseHue + progress * 140) % 360;
                
                const bgColor = `hsl(${hue}, 35%, 6%)`;
                const grad1Color = `hsla(${hue}, 70%, 60%, 0.12)`;
                const grad2Color = `hsla(${hue + 40}, 70%, 60%, 0.12)`;
                const grad3Color = `hsla(${hue - 30}, 70%, 60%, 0.08)`;
                
                bgContainer.style.backgroundColor = bgColor;
                bgContainer.style.backgroundImage =