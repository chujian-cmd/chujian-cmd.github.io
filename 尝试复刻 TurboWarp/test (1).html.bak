<!DOCTYPE html>
<html>
<head><meta charset="UTF-8"><title>SB3 导出器</title></head>
<body>
  <button id="exportBtn">导出 .sb3</button>

  <!-- 引入 JSZip 和 SparkMD5 -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/spark-md5/3.0.2/spark-md5.min.js"></script>
  <script>
    document.getElementById('exportBtn').onclick = async function() {
      const zip = new JSZip();

      // 1. 定义一个空白造型的 SVG 内容 (最简单的矩形)
      const svgContent = `<svg xmlns="http://www.w3.org/2000/svg" width="100" height="100"><rect width="100" height="100" fill="#4C97FF"/></svg>`;
      const svgBlob = new Blob([svgContent], {type: 'image/svg+xml'});
      
      // 计算 MD5 作为文件名 (Scratch 标准做法)
      const arrayBuffer = await svgBlob.arrayBuffer();
      const md5 = SparkMD5.ArrayBuffer.hash(arrayBuffer);
      const costumeFileName = `${md5}.svg`;

      // 2. 构建 project.json (最小化可用结构)
      const projectJson = {
        "targets": [
          {
            "isStage": true,
            "name": "Stage",
            "variables": {},
            "lists": {},
            "broadcasts": {},
            "blocks": {},
            "comments": {},
            "currentCostume": 0,
            "costumes": [{
              "name": "backdrop1",
              "dataFormat": "svg",
              "assetId": md5, // 必须与文件名一致
              "md5ext": costumeFileName,
              "rotationCenterX": 50,
              "rotationCenterY": 50
            }],
            "sounds": [],
            "volume": 100,
            "layerOrder": 0,
            "tempo": 60,
            "videoTransparency": 50,
            "videoState": "off",
            "textToSpeechLanguage": null
          },
          {
            "isStage": false,
            "name": "Sprite1",
            "variables": {},
            "lists": {},
            "broadcasts": {},
            "blocks": {
              // 这里放一个空的"绿旗"帽子块，让角色有基本逻辑
              "flagId": {
                "opcode": "event_whenflagclicked",
                "next": null,
                "parent": null,
                "inputs": {},
                "fields": {},
                "shadow": false,
                "topLevel": true,
                "x": 100,
                "y": 100
              }
            },
            "comments": {},
            "currentCostume": 0,
            "costumes": [{
              "name": "costume1",
              "dataFormat": "svg",
              "assetId": md5,
              "md5ext": costumeFileName,
              "rotationCenterX": 50,
              "rotationCenterY": 50
            }],
            "sounds": [],
            "volume": 100,
            "layerOrder": 1,
            "visible": true,
            "x": 0,
            "y": 0,
            "size": 100,
            "direction": 90,
            "draggable": false,
            "rotationStyle": "all around"
          }
        ],
        "monitors": [],
        "extensions": [],
        "meta": {
          "semver": "3.0.0",
          "vm": "0.2.0",
          "agent": "Mozilla/5.0"
        }
      };

      // 3. 将文件和素材加入 ZIP
      zip.file("project.json", JSON.stringify(projectJson, null, 2));
      zip.file(costumeFileName, svgBlob);

      // 4. 生成并下载
      const content = await zip.generateAsync({type: "blob"});
      const a = document.createElement('a');
      a.href = URL.createObjectURL(content);
      a.download = "project.sb3";
      a.click();
      URL.revokeObjectURL(a.href);
    };
  </script>
</body>
</html>