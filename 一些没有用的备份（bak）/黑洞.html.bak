<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<title>黑洞 Blackhole</title>
<style>
  html, body {
    margin: 0; height: 100%; overflow: hidden; background: #000;
    -webkit-tap-highlight-color: transparent; overscroll-behavior: none;
  }
  canvas { display: block; width: 100% !important; height: 100% !important; touch-action: none; }

  #bar {
    position: fixed; top: 0; left: 0; right: 0;
    padding: max(12px, env(safe-area-inset-top)) 12px 12px;
    display: flex; gap: 8px; align-items: center;
    background: linear-gradient(180deg, rgba(0,0,0,0.7), rgba(0,0,0,0));
    z-index: 10; pointer-events: none;
    font: 13px -apple-system, "PingFang SC", sans-serif;
    color: #c3c9d4;
  }
  #bar > * { pointer-events: auto; }
  #bar .mode { flex: 1; color: #8a8f98; }
  #bar .mode b { color: #f7f8f8; font-weight: 600; }

  .btn {
    height: 38px; padding: 0 14px; border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.14);
    background: rgba(255,255,255,0.06);
    color: #f7f8f8; font: 500 13px -apple-system, "PingFang SC", sans-serif;
    cursor: pointer; -webkit-user-select: none; user-select: none;
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  }
  .btn:active { background: rgba(255,255,255,0.14); }
  .btn.pri { background: rgba(94,106,210,0.32); border-color: rgba(94,106,210,0.6); }

  #hint {
    position: fixed; left: 0; right: 0;
    bottom: max(20px, env(safe-area-inset-bottom));
    text-align: center; color: #6a6f7a;
    font: 12px -apple-system, "PingFang SC", sans-serif;
    pointer-events: none; z-index: 10;
  }
</style>
</head>
<body>

<canvas id="cv"></canvas>

<div id="bar">
  <div class="mode">黑洞 <b id="m">Gargantua</b></div>
  <button class="btn" id="btn-reset">重置</button>
  <button class="btn pri" id="btn-change">换配色</button>
</div>

<div id="hint">按住拖动 = 改变观察方向</div>

<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.170.0/build/three.module.js"
  }
}
</script>

<script type="module">
import * as THREE from 'three';

const isMobile = /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent)
              || (navigator.maxTouchPoints > 1);

// ---------- 参数 ----------
const CFG = {
  spin: 0,         // 自动旋转
  diskBright: 1.2,    // 吸积盘亮度
  diskRadius: 1.6,    // 吸积盘半径
  diskThickness: 0.12,// 吸积盘厚度
  starDensity: 1.0,   // 星空密度
  starBright: 1.0,    // 星空亮度
  lens: 1.0,          // 引力透镜强度
  photonRing: 1.0,    // 光子环亮度
  hueShift: 0.0,      // 色相偏移（可动态）
  colorDiskA: '#ffb347', // 吸积盘内圈
  colorDiskB: '#ff3d00', // 吸积盘外圈
  colorStar: '#ffffff',  // 星星
  background: '#000000'
};

const PIXEL_RATIO = isMobile ? 0.55 : 0.85;

// ---------- three.js ----------
const canvasEl = document.getElementById('cv');

const renderer = new THREE.WebGLRenderer({ canvas: canvasEl, antialias: false });
renderer.setPixelRatio(PIXEL_RATIO);
renderer.setSize(innerWidth, innerHeight, false);

const scene = new THREE.Scene();
const camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

const vert = /* glsl */`
  varying vec2 vUv;
  void main() {
    vUv = uv;
    gl_Position = vec4(position.xy, 0.0, 1.0);
  }
`;

const frag = /* glsl */`
  precision highp float;
  varying vec2 vUv;

  uniform vec2  uResolution;
  uniform vec2  uMouse;
  uniform float uTime;
  uniform float uSpin;
  uniform float uDiskBright;
  uniform float uDiskRadius;
  uniform float uDiskThickness;
  uniform float uStarDensity;
  uniform float uStarBright;
  uniform float uLens;
  uniform float uPhotonRing;
  uniform float uHueShift;
  uniform vec3  uColorDiskA;
  uniform vec3  uColorDiskB;
  uniform vec3  uColorStar;
  uniform vec3  uBackground;

  #define TAU 6.28318530718
  #define PI 3.14159265359

  // 2D hash
  float hash21(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 45.32);
    return fract(p.x * p.y);
  }

  // 3D hash (用于星空)
  float hash31(vec3 p) {
    p = fract(p * vec3(0.1031, 0.1030, 0.0973));
    p += dot(p, p.yxz + 33.33);
    return fract((p.x + p.y) * p.z);
  }

  // 星空：在单位球面上撒一层哈希点，用 3x3x3 邻域采样
  float starfield(vec3 dir, float density) {
    // 用方向的反向投影得到"星图坐标"
    float t = 1.0;
    vec3 p = dir * density * 12.0;
    vec3 i = floor(p);
    vec3 f = fract(p);
    float best = 0.0;
    for (int x = -1; x <= 1; x++) {
      for (int y = -1; y <= 1; y++) {
        for (int z = -1; z <= 1; z++) {
          vec3 g = vec3(float(x), float(y), float(z));
          vec3 cellId = i + g;
          vec3 h = vec3(
            hash31(cellId),
            hash31(cellId + 17.0),
            hash31(cellId + 31.0)
          );
          if (h.x < 0.7) continue;   // 70% 的格子不放星
          vec3 point = g + 0.5 + 0.5 * (h - 0.5);
          float d = length(point - f);
          float s = smoothstep(0.08, 0.0, d);
          s *= 0.6 + 0.4 * hash31(cellId + 53.0);
          best = max(best, s);
        }
      }
    }
    return best;
  }

  // ---- 引力透镜核心 ----
  // 输入：观察方向 dir，黑洞质量 M
  // 输出：被弯曲后的方向 + 是否被吞入
  // 我们用一个简化的"光线在黑洞附近弯曲"模型：
  // 黑洞中心 = 原点，视界半径 r0 = 1.0
  // 用数值积分：光线每步被引力拉向中心
  void traceRay(vec3 origin, vec3 dir, out vec3 bentDir, out bool captured, out float closest) {
    vec3 p = origin;
    vec3 d = dir;
    closest = 1e9;
    captured = false;

    // 近似施瓦茨希尔德：用加速度 a = -1.5 * h² * r / |r|^5
    // 其中 h = |p × d| 是角动量
    vec3 L = cross(p, d);
    float h2 = dot(L, L);

    for (int i = 0; i < 80; i++) {
      float r = length(p);
      closest = min(closest, r);
      if (r < 1.0) { captured = true; break; }
      if (r > 20.0) break;

      // 引力加速度（简化的零测地线方程）
      float dt = 0.06 * (1.0 + 0.5 * r);
      vec3 acc = -1.5 * h2 * p / pow(r, 5.0) * uLens;
      d = normalize(d + acc * dt);
      p = p + d * dt;
    }

    bentDir = d;
  }

  // 吸积盘：在赤道面（y=0）上的一个发光环
  // 我们沿着弯曲后的光线，检测它是否穿过赤道面
  vec3 diskColor(vec3 p, vec3 d, out float hit) {
    hit = 0.0;
    // 只在接近赤道面时检测
    float r = length(p.xz);
    if (abs(p.y) < uDiskThickness && r < uDiskRadius && r > 1.05) {
      // 亮度随半径衰减
      float t = (r - 1.05) / (uDiskRadius - 1.05);
      float fade = pow(1.0 - t, 2.0);
      // 内圈更亮
      float heat = 1.0 / (1.0 + t * 2.5);
      // 用色相偏移做温度色
      vec3 col = mix(uColorDiskB, uColorDiskA, heat);
      // 加一点随机噪声让它不像塑料
      float n = hash21(p.xz * 8.0 + uTime * 0.1);
      col *= 0.8 + 0.4 * n;
      hit = fade * uDiskBright;
      return col;
    }
    return vec3(0.0);
  }

  // 完整的光线路径追踪
  vec3 trace(vec3 origin, vec3 dir, out float diskHit, out float starHit) {
    diskHit = 0.0;
    starHit = 0.0;
    vec3 p = origin;
    vec3 d = dir;
    vec3 L = cross(p, d);
    float h2 = dot(L, L);

    bool captured = false;
    vec3 diskAccum = vec3(0.0);

    for (int i = 0; i < 100; i++) {
      float r = length(p);
      if (r < 1.0) { captured = true; break; }
      if (r > 30.0) break;

      // 检测是否穿过赤道面
      if (abs(p.y) < uDiskThickness * 1.5) {
        float rr = length(p.xz);
        if (rr < uDiskRadius && rr > 1.05) {
          float t = (rr - 1.05) / (uDiskRadius - 1.05);
          float fade = pow(1.0 - t, 2.0);
          float heat = 1.0 / (1.0 + t * 2.5);
          vec3 col = mix(uColorDiskB, uColorDiskA, heat);
          float n = hash21(p.xz * 8.0 + uTime * 0.15);
          col *= 0.8 + 0.4 * n;
          // 沿着路径累积（外层被内层遮住）
          diskAccum += col * fade * uDiskBright * 0.08;
          diskHit = 1.0;
        }
      }

      // 引力加速度
      float dt = 0.08 * (1.0 + 0.4 * r);
      vec3 acc = -1.5 * h2 * p / pow(r, 5.0) * uLens;
      d = normalize(d + acc * dt);
      p = p + d * dt;
    }

    // 光线最终逃逸 / 被吞
    if (captured) {
      // 被吞入黑洞：黑色 + 光子环的光晕
      return diskAccum * 0.3;
    }

    // 逃逸：看背景星空
    vec3 finalDir = normalize(d);
    float star = starfield(finalDir, uStarDensity) * uStarBright;
    vec3 sky = uBackground + uColorStar * star;
    return sky + diskAccum;
  }

  // 光子环：在视界半径 ~1.0 附近加一圈亮环
  float photonRing(vec2 uv, float radius) {
    float r = length(uv);
    float ring = smoothstep(0.06, 0.0, abs(r - radius));
    return ring;
  }

  // 色相旋转
  vec3 hueShift(vec3 col, float a) {
    const mat3 toYIQ = mat3(
      0.299, 0.587, 0.114,
      0.5959, -0.2746, -0.3213,
      0.2115, -0.5227, 0.3112
    );
    const mat3 toRGB = mat3(
      1.0, 0.956, 0.619,
      1.0, -0.272, -0.647,
      1.0, -1.106, 1.703
    );
    vec3 yiq = toYIQ * col;
    float hue = atan(yiq.z, yiq.y) + a;
    float chroma = length(yiq.yz);
    yiq.yz = vec2(cos(hue), sin(hue)) * chroma;
    return toRGB * yiq;
  }

  void main() {
    vec2 uv = (vUv - 0.5) * 2.0;
    uv.x *= uResolution.x / uResolution.y;

    // 鼠标拖动改变视角（用一个简单的旋转）
    vec2 mouseOffset = (uMouse - 0.5) * 2.0;
    float yaw = mouseOffset.x * 3.14;     // 从 0.6 改成 3.14（转半个圈）
    float pitch = mouseOffset.y * 1.2;    // 从 0.3 改成 1.2（上下倾斜更大）

    // 相机位置 + 视线方向
    vec3 camPos = vec3(0.0, 0.3, 8.0);
    // 相机缓慢自转
    float autoYaw = uTime * uSpin * 0.3;
    float cy = cos(yaw + autoYaw);
    float sy = sin(yaw + autoYaw);
    camPos.xz = mat2(cy, -sy, sy, cy) * camPos.xz;

    vec3 forward = normalize(-camPos);
    vec3 right = normalize(cross(vec3(0.0, 1.0, 0.0), forward));
    vec3 up = cross(forward, right);

    vec3 dir = normalize(forward + uv.x * right * 0.6 + uv.y * up * 0.6);

    // 光线追踪
    float diskHit, starHit;
    vec3 col = trace(camPos, dir, diskHit, starHit);

    // 光子环：在视界边缘加亮环
    // 通过屏幕坐标近似
    float r = length(uv);
    float ringRadius = 0.28 + 0.02 * sin(uTime * 0.5);
    float ring = photonRing(uv, ringRadius);
    col += vec3(1.0, 0.75, 0.4) * ring * uPhotonRing * 0.6;

    // 视界黑洞阴影（圆盘内的纯黑）
    float shadowR = 0.32;
    float shadow = smoothstep(shadowR, shadowR - 0.02, r);
    col *= 1.0 - shadow * 0.95;

    // 色相偏移
    if (uHueShift != 0.0) {
      col = hueShift(col, uHueShift);
    }

    // 简单色调映射
    col = col / (1.0 + col * 0.4);
    col = pow(max(col, 0.0), vec3(0.9));

    gl_FragColor = vec4(col, 1.0);
  }
`;

const material = new THREE.ShaderMaterial({
  vertexShader: vert,
  fragmentShader: frag,
  uniforms: {
    uResolution: { value: new THREE.Vector2(1, 1) },
    uMouse: { value: new THREE.Vector2(0.5, 0.5) },
    uTime: { value: 0 },
    uSpin: { value: CFG.spin },
    uDiskBright: { value: CFG.diskBright },
    uDiskRadius: { value: CFG.diskRadius },
    uDiskThickness: { value: CFG.diskThickness },
    uStarDensity: { value: CFG.starDensity },
    uStarBright: { value: CFG.starBright },
    uLens: { value: CFG.lens },
    uPhotonRing: { value: CFG.photonRing },
    uHueShift: { value: CFG.hueShift },
    uColorDiskA: { value: new THREE.Color(CFG.colorDiskA) },
    uColorDiskB: { value: new THREE.Color(CFG.colorDiskB) },
    uColorStar: { value: new THREE.Color(CFG.colorStar) },
    uBackground: { value: new THREE.Color(CFG.background) }
  }
});

const mesh = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), material);
mesh.frustumCulled = false;
scene.add(mesh);

// ---------- 尺寸 ----------
function resize() {
  const W = innerWidth;
  const H = innerHeight;
  renderer.setPixelRatio(PIXEL_RATIO);
  renderer.setSize(W, H, false);
  material.uniforms.uResolution.value.set(W * PIXEL_RATIO, H * PIXEL_RATIO);
}
resize();

// ---------- 指针 ----------
const pointer = { x: 0.5, y: 0.5, targetX: 0.5, targetY: 0.5, down: false };
const rect = () => canvasEl.getBoundingClientRect();

const onDown = e => {
  const t = e.touches ? e.touches[0] : e;
  const r = rect();
  pointer.targetX = (t.clientX - r.left) / r.width;
  pointer.targetY = (t.clientY - r.top) / r.height;
  pointer.down = true;
  if (e.touches) e.preventDefault();
};
const onMove = e => {
  const t = e.touches ? e.touches[0] : e;
  const r = rect();
  pointer.targetX = (t.clientX - r.left) / r.width;
  pointer.targetY = (t.clientY - r.top) / r.height;
  if (e.touches) e.preventDefault();
};
const onUp = () => { pointer.down = false; };

canvasEl.addEventListener('touchstart', onDown, { passive: false });
canvasEl.addEventListener('touchmove', onMove, { passive: false });
canvasEl.addEventListener('touchend', onUp);
canvasEl.addEventListener('touchcancel', onUp);
canvasEl.addEventListener('mousedown', onDown);
canvasEl.addEventListener('mousemove', onMove);
canvasEl.addEventListener('mouseup', onUp);
canvasEl.addEventListener('mouseleave', onUp);

// ---------- 主循环 ----------
let startTime = performance.now();
function loop(now) {
  const t = (now - startTime) / 1000;
  pointer.x += (pointer.targetX - pointer.x) * 0.08;
  pointer.y += (pointer.targetY - pointer.y) * 0.08;

  const u = material.uniforms;
  u.uTime.value = t;
  u.uMouse.value.set(pointer.x, pointer.y);

  renderer.render(scene, camera);
  requestAnimationFrame(loop);
}

// ---------- 按钮 ----------
const mEl = document.getElementById('m');

const SCHEMES = [
  { name: 'Gargantua',  // 星际穿越里那颗
    colorDiskA: '#ffe0a0', colorDiskB: '#ff8c1a', colorStar: '#ffffff',
    background: '#000000', diskBright: 1.3, hueShift: 0.0, spin: 0.15 },
  { name: '蓝巨星',
    colorDiskA: '#ffffff', colorDiskB: '#5b9bff', colorStar: '#d8e8ff',
    background: '#000010', diskBright: 1.4, hueShift: 0.0, spin: 0.2 },
  { name: '紫罗兰',
    colorDiskA: '#ffd0ff', colorDiskB: '#8a2bff', colorStar: '#ffffff',
    background: '#05000f', diskBright: 1.2, hueShift: 0.0, spin: 0.12 },
  { name: '翡翠',
    colorDiskA: '#eafff0', colorDiskB: '#12b76a', colorStar: '#e0fff0',
    background: '#000a05', diskBright: 1.3, hueShift: 0.0, spin: 0.1 },
  { name: '深红',
    colorDiskA: '#ffdada', colorDiskB: '#a01224', colorStar: '#ff9090',
    background: '#0a0000', diskBright: 1.3, hueShift: 0.0, spin: 0.18 }
];
let schemeIdx = 0;

function applyScheme(s) {
  CFG.colorDiskA = s.colorDiskA;
  CFG.colorDiskB = s.colorDiskB;
  CFG.colorStar = s.colorStar;
  CFG.background = s.background;
  CFG.diskBright = s.diskBright;
  CFG.hueShift = s.hueShift;
  CFG.spin = s.spin;

  const u = material.uniforms;
  u.uColorDiskA.value.set(CFG.colorDiskA);
  u.uColorDiskB.value.set(CFG.colorDiskB);
  u.uColorStar.value.set(CFG.colorStar);
  u.uBackground.value.set(CFG.background);
  u.uDiskBright.value = CFG.diskBright;
  u.uHueShift.value = CFG.hueShift;
  u.uSpin.value = CFG.spin;
}

document.getElementById('btn-reset').addEventListener('click', () => {
  startTime = performance.now();
  pointer.targetX = 0.5;
  pointer.targetY = 0.5;
});

document.getElementById('btn-change').addEventListener('click', () => {
  schemeIdx = (schemeIdx + 1) % SCHEMES.length;
  applyScheme(SCHEMES[schemeIdx]);
  mEl.textContent = SCHEMES[schemeIdx].name;
});

// ---------- 启动 ----------
window.addEventListener('resize', resize);
window.addEventListener('orientationchange', () => setTimeout(resize, 200));

applyScheme(SCHEMES[0]);
mEl.textContent = SCHEMES[0].name;
requestAnimationFrame(loop);
</script>
</body>
</html>