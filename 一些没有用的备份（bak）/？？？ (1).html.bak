<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8">
<title>3D Model</title>
<style>
  html,body{margin:0;height:100%;overflow:hidden;background:#111;}
  canvas{display:block;}
</style>
</head>
<body>
<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
    "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
  }
}
</script>
<script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x111111);

const camera = new THREE.PerspectiveCamera(45, innerWidth/innerHeight, 0.1, 1000);
camera.position.set(4, 3, 6);

const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(innerWidth, innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
document.body.appendChild(renderer.domElement);

const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;
controls.dampingFactor = 0.08;
controls.autoRotate = true;
controls.autoRotateSpeed = 1.5;
controls.target.set(0, 0.5, 0);

// Lights
const hemi = new THREE.HemisphereLight(0xffffff, 0x333333, 0.6);
scene.add(hemi);

const key = new THREE.DirectionalLight(0xfff2e0, 2.2);
key.position.set(5, 8, 5);
key.castShadow = true;
key.shadow.mapSize.set(2048, 2048);
key.shadow.camera.near = 0.5;
key.shadow.camera.far = 30;
key.shadow.camera.left = -6;
key.shadow.camera.right = 6;
key.shadow.camera.top = 6;
key.shadow.camera.bottom = -6;
key.shadow.bias = -0.0005;
scene.add(key);

const fill = new THREE.DirectionalLight(0x88aaff, 0.7);
fill.position.set(-6, 3, -4);
scene.add(fill);

const rim = new THREE.DirectionalLight(0xffffff, 1.2);
rim.position.set(0, 4, -8);
scene.add(rim);

// Material
const skinMat = new THREE.MeshPhysicalMaterial({
  color: 0xc88a6a,
  roughness: 0.45,
  metalness: 0.0,
  clearcoat: 0.35,
  clearcoatRoughness: 0.5,
  sheen: 0.4,
  sheenColor: new THREE.Color(0xffb090),
  sheenRoughness: 0.6,
  side: THREE.DoubleSide
});

const veinMat = new THREE.MeshPhysicalMaterial({
  color: 0xa06050,
  roughness: 0.55,
  metalness: 0.0,
  clearcoat: 0.2
});

const headMat = new THREE.MeshPhysicalMaterial({
  color: 0xd49a78,
  roughness: 0.35,
  clearcoat: 0.6,
  clearcoatRoughness: 0.3,
  sheen: 0.6,
  sheenColor: new THREE.Color(0xffc0a0)
});

const group = new THREE.Group();
scene.add(group);

// --- Shaft ---
const shaftCurve = new THREE.CatmullRomCurve3([
  new THREE.Vector3(0, -0.2, 0),
  new THREE.Vector3(0.05, 1.0, 0.02),
  new THREE.Vector3(0.02, 2.0, -0.02),
  new THREE.Vector3(-0.03, 2.8, 0.01)
]);

const shaftGeo = new THREE.TubeGeometry(shaftCurve, 64, 0.42, 32, false);
const shaft = new THREE.Mesh(shaftGeo, skinMat);
shaft.castShadow = true;
shaft.receiveShadow = true;
group.add(shaft);

// Taper the shaft toward base and tip using vertex displacement
const pos = shaftGeo.attributes.position;
const v = new THREE.Vector3();
for (let i = 0; i < pos.count; i++) {
  v.fromBufferAttribute(pos, i);
  const t = (v.y + 0.2) / 3.0; // 0 at base, 1 at tip
  const taper = 0.55 + 0.65 * Math.sin(Math.min(t, 1.0) * Math.PI * 0.9);
  const center = shaftCurve.getPointAt(Math.min(Math.max(t, 0), 1));
  v.x = center.x + (v.x - center.x) * taper;
  v.z = center.z + (v.z - center.z) * taper;
  pos.setXYZ(i, v.x, v.y, v.z);
}
shaftGeo.computeVertexNormals();

// --- Glans (head) ---
const glansGeo = new THREE.SphereGeometry(0.55, 48, 48);
const gpos = glansGeo.attributes.position;
const gv = new THREE.Vector3();
for (let i = 0; i < gpos.count; i++) {
  gv.fromBufferAttribute(gpos, i);
  // bell shape: wider at base of glans, rounded tip
  const yNorm = (gv.y / 0.55 + 1) / 2; // 0 bottom, 1 top
  const bell = 0.85 + 0.45 * Math.sin(yNorm * Math.PI * 0.85);
  gv.x *= bell;
  gv.z *= bell * 0.92;
  // flatten underside slightly
  if (gv.z < 0) gv.z *= 0.88;
  gpos.setXYZ(i, gv.x, gv.y, gv.z);
}
glansGeo.computeVertexNormals();
const glans = new THREE.Mesh(glansGeo, headMat);
glans.position.set(-0.03, 3.15, 0.01);
glans.scale.set(1, 1.15, 1);
glans.castShadow = true;
glans.receiveShadow = true;
group.add(glans);

// Corona ridge (rim under glans)
const coronaGeo = new THREE.TorusGeometry(0.52, 0.06, 16, 48);
const corona = new THREE.Mesh(coronaGeo, skinMat);
corona.position.set(-0.03, 2.85, 0.01);
corona.rotation.x = Math.PI / 2;
corona.scale.set(1, 0.9, 1);
corona.castShadow = true;
group.add(corona);

// Frenulum (small fold on underside)
const frenGeo = new THREE.SphereGeometry(0.12, 16, 16);
const fren = new THREE.Mesh(frenGeo, skinMat);
fren.position.set(-0.03, 2.75, -0.32);
fren.scale.set(1, 1.6, 0.6);
fren.castShadow = true;
group.add(fren);

// Meatus (tip slit)
const meatusGeo = new THREE.SphereGeometry(0.06, 16, 16);
const meatusMat = new THREE.MeshPhysicalMaterial({
  color: 0x5a2020,
  roughness: 0.8,
  metalness: 0.0
});
const meatus = new THREE.Mesh(meatusGeo, meatusMat);
meatus.position.set(-0.03, 3.65, 0.01);
meatus.scale.set(0.5, 0.9, 1.2);
group.add(meatus);

// --- Scrotum ---
const scrotumGeo = new THREE.SphereGeometry(0.85, 48, 48);
const spos = scrotumGeo.attributes.position;
const sv = new THREE.Vector3();
for (let i = 0; i < spos.count; i++) {
  sv.fromBufferAttribute(spos, i);
  const ny = sv.y / 0.85;
  // two lobes
  const lobe = Math.sin(ny * Math.PI) * 0.25;
  sv.x += Math.sign(sv.x) * lobe * 0.3;
  sv.z *= 0.85;
  sv.y *= 1.1;
  spos.setXYZ(i, sv.x, sv.y, sv.z);
}
scrotumGeo.computeVertexNormals();
const scrotum = new THREE.Mesh(scrotumGeo, skinMat);
scrotum.position.set(0, -0.55, 0.05);
scrotum.scale.set(1.15, 0.95, 0.9);
scrotum.castShadow = true;
scrotum.receiveShadow = true;
group.add(scrotum);

// Seam line on scrotum
const seamPts = [];
for (let i = 0; i <= 40; i++) {
  const a = (i / 40) * Math.PI * 2;
  seamPts.push(new THREE.Vector3(
    0,
    -0.55 + Math.cos(a) * 0.78,
    0.05 + Math.sin(a) * 0.68
  ));
}
const seamCurve = new THREE.CatmullRomCurve3(seamPts, true);
const seamGeo = new THREE.TubeGeometry(seamCurve, 64, 0.025, 8, true);
const seam = new THREE.Mesh(seamGeo, veinMat);
seam.castShadow = true;
group.add(seam);

// --- Veins on shaft ---
function addVein(points, radius = 0.035) {
  const curve = new THREE.CatmullRomCurve3(points);
  const geo = new THREE.TubeGeometry(curve, 64, radius, 8, false);
  const mesh = new THREE.Mesh(geo, veinMat);
  mesh.castShadow = true;
  group.add(mesh);
}

addVein([
  new THREE.Vector3(0.18, 0.3, 0.28),
  new THREE.Vector3(0.32, 1.0, 0.30),
  new THREE.Vector3(0.38, 1.7, 0.22),
  new THREE.Vector3(0.30, 2.3, 0.12),
  new THREE.Vector3(0.15, 2.6, 0.05)
], 0.04);

addVein([
  new THREE.Vector3(-0.2, 0.5, 0.25),
  new THREE.Vector3(-0.35, 1.2, 0.28),
  new THREE.Vector3(-0.32, 1.9, 0.18),
  new THREE.Vector3(-0.15, 2.5, 0.08)
], 0.035);

addVein([
  new THREE.Vector3(0.25, 0.6, -0.2),
  new THREE.Vector3(0.34, 1.3, -0.25),
  new THREE.Vector3(0.28, 2.0, -0.18),
  new THREE.Vector3(0.12, 2.5, -0.08)
], 0.03);

addVein([
  new THREE.Vector3(-0.15, 0.8, -0.28),
  new THREE.Vector3(-0.28, 1.5, -0.30),
  new THREE.Vector3(-0.22, 2.2, -0.18)
], 0.028);

// Small branch veins
addVein([
  new THREE.Vector3(0.3, 1.1, 0.28),
  new THREE.Vector3(0.22, 1.4, 0.35),
  new THREE.Vector3(0.08, 1.6, 0.38)
], 0.018);

addVein([
  new THREE.Vector3(-0.32, 1.3, 0.26),
  new THREE.Vector3(-0.25, 1.6, 0.32),
  new THREE.Vector3(-0.1, 1.8, 0.35)
], 0.015);

// Texture detail: slight bumps via small spheres on shaft surface
const bumpGeo = new THREE.SphereGeometry(0.05, 8, 8);
const bumpMat = skinMat;
for (let i = 0; i < 60; i++) {
  const t = 0.1 + Math.random() * 0.8;
  const angle = Math.random() * Math.PI * 2;
  const center = shaftCurve.getPointAt(t);
  const taper = 0.55 + 0.65 * Math.sin(t * Math.PI * 0.9);
  const r = 0.42 * taper * 0.98;
  const bx = center.x + Math.cos(angle) * r;
  const bz = center.z + Math.sin(angle) * r;
  const bump = new THREE.Mesh(bumpGeo, bumpMat);
  bump.position.set(bx, center.y, bz);
  bump.scale.setScalar(0.5 + Math.random() * 0.8);
  bump.castShadow = true;
  group.add(bump);
}

// Ground (subtle shadow catcher)
const groundGeo = new THREE.CircleGeometry(8, 64);
const groundMat = new THREE.MeshStandardMaterial({
  color: 0x0a0a0a,
  roughness: 1.0,
  metalness: 0.0
});
const ground = new THREE.Mesh(groundGeo, groundMat);
ground.rotation.x = -Math.PI / 2;
ground.position.y = -1.5;
ground.receiveShadow = true;
scene.add(ground);

// Animate
function animate() {
  requestAnimationFrame(animate);
  controls.update();
  renderer.render(scene, camera);
}
animate();

addEventListener('resize', () => {
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});
</script>
</body>
</html>