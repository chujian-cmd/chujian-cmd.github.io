<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>流体烟雾交互壁纸</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #000;
        }
        canvas {
            display: block;
            width: 100vw;
            height: 100vh;
        }
        .hint {
            position: absolute;
            bottom: 30px;
            width: 100%;
            text-align: center;
            color: rgba(255, 255, 255, 0.4);
            font-family: sans-serif;
            pointer-events: none;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <canvas id="fluid"></canvas>
    <div class="hint">滑动屏幕产生烟雾</div>

    <!-- 引入 WebGL 流体模拟核心库 -->
    <script src="https://cdn.jsdelivr.net/npm/webgl-fluid@0.3/dist/webgl-fluid.umd.js"></script>

    <script>
        // 等待库加载完成
        window.addEventListener('load', () => {
            const canvas = document.getElementById('fluid');
            
            // 初始化流体模拟
            WebGLFluid(canvas, {
                // --- 核心物理参数 ---
                SIM_RESOLUTION: 128,      // 模拟分辨率（越低越卡，但烟雾细节越好）
                DYE_RESOLUTION: 1024,     // 渲染分辨率（越高越清晰）
                DENSITY_DISSIPATION: 0.98, // 烟雾消散速度 (越接近1消散越慢)
                VELOCITY_DISSIPATION: 0.99,// 速度消散 (水流阻力)
                PRESSURE: 0.8,            // 压力
                CURL: 30,                 // 涡度 (数值越大，烟雾旋转和推挤感越强，像真烟雾)
                
                // --- 外观参数 ---
                SPLAT_RADIUS: 0.25,       // 手指按下的初始烟雾大小
                SPLAT_FORCE: 6000,        // 手指滑动的推力 (推动其他烟雾的力度)
                SHADING: true,            // 开启 3D 光影效果 (让烟雾有体积感)
                COLORFUL: true,           // 开启彩色
                COLOR_UPDATE_SPEED: 10,   // 颜色变化速度
                BACK_COLOR: { r: 13, g: 4, b: 16 }, // 底色，设置为你截图中的深紫黑
                
                // --- 颜色设置 ---
                // 覆盖默认的彩虹色，自定义紫红色调
                COLOR_PALETTE: [
                    { r: 1.0, g: 0.1, b: 0.6 }, // 品红
                    { r: 0.8, g: 0.0, b: 0.5 }, // 深紫红
                    { r: 1.0, g: 0.4, b: 0.8 }, // 浅粉紫
                    { r: 0.5, g: 0.0, b: 0.4 }  // 暗紫
                ],
                
                // --- 交互设置 ---
                PAUSED: false,            // 是否暂停
                BLOOM: true,              // 开启泛光 (让颜色更亮)
                BLOOM_INTENSITY: 0.8,     // 泛光强度
                BLOOM_THRESHOLD: 0.6,     // 泛光阈值
                SUNRAYS: true,            // 开启阳光射线效果
                SUNRAYS_WEIGHT: 1.0
            });
        });
    </script>
</body>
</html>