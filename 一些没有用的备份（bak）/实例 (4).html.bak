<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>极简设置面板 · 黑白灰</title>
  <style>
    /* 全局重置与黑白灰基调 */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: #FFFFFF;
      font-family: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      color: #000000;
      line-height: 1.5;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 16px;
    }

    /* 面板容器：留白优先，圆润边框 */
    .settings-panel {
      max-width: 560px;
      width: 100%;
      background: #FFFFFF;
      border: 1px solid #E5E5E5;
      border-radius: 12px;
      padding: 32px 24px;
      box-shadow: none; /* 无彩色阴影，保持极简 */
    }

    /* 标题区 */
    .header {
      margin-bottom: 28px;
    }

    .header h1 {
      font-size: 1.75rem; /* 28px，限制三级标题以内 */
      font-weight: 600;
      letter-spacing: -0.02em;
      color: #000000;
      margin-bottom: 6px;
    }

    .header .subtitle {
      font-size: 0.875rem; /* 14px */
      color: #666;
      font-weight: 400;
    }

    /* 开关项列表：无边框，留白分隔 */
    .toggle-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 32px;
    }

    .toggle-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 0;
      /* 无边框，但若需触摸反馈可加轻微背景，保持极简不加 */
    }

    .toggle-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    /* SVG 图标统一尺寸与颜色 */
    .icon {
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      color: #000000;
      transition: all 0.2s ease;
    }

    .icon svg {
      width: 100%;
      height: 100%;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .toggle-label {
      font-size: 1rem; /* 16px */
      font-weight: 500;
      color: #000000;
      transition: color 0.2s ease;
    }

    /* 开关控件：自定义 SVG 开关，圆润 */
    .toggle-switch {
      width: 48px;
      height: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      border-radius: 28px; /* 圆润 */
      transition: all 0.2s ease;
      flex-shrink: 0;
    }

    .toggle-switch svg {
      width: 100%;
      height: 100%;
      display: block;
      stroke: none;
      fill: none;
      transition: all 0.2s ease;
    }

    /* 开关状态通过 CSS 类控制，SVG 内部元素颜色填充用 currentColor 或显式 fill */
    .switch-bg {
      fill: #E5E5E5;
      transition: fill 0.2s ease;
    }

    .switch-knob {
      fill: #FFFFFF;
      stroke: #999999;
      stroke-width: 1.5;
      transition: all 0.2s ease;
    }

    /* 开启状态 */
    .toggle-switch[aria-checked="true"] .switch-bg {
      fill: #000000;
    }

    .toggle-switch[aria-checked="true"] .switch-knob {
      fill: #FFFFFF;
      stroke: #000000;
      transform: translateX(10px); /* 平滑位移，配合 transition */
    }

    /* 重置transform的原始位置（SVG内部坐标需匹配，此处使用translateX作用于circle）*/
    /* 由于SVG viewBox为48x28，左侧圆位置x=14，右侧x=34，差值20px，但位移通过CSS transform实现更平滑 */
    /* 更稳健的方式：在SVG内使用两个圆或一个圆+CSS位移；我们采用circle并设置transition */
    /* 修正：圆需要基于cx属性移动，这里用transform: translateX(10px) 配合circle的cx固定，不会影响布局 */
    /* 为了更精确，在SVG中circle cx=14，开启后translateX(20px)？但viewBox宽度48，圆半径10，cx=14，右侧cx=34，位移+20 */
    /* 修正：位移量20px，但circle本身有半径，使用transform: translateX(20px)会导致圆超出？不会，容器48，圆cx=14，位移20后cx=34，完美。 */
    /* 因此调整开启位移为20px */
    .toggle-switch[aria-checked="true"] .switch-knob {
      transform: translateX(20px);
    }

    /* 操作栏：两个按钮，圆润边框 */
    .action-bar {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 24px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 24px;
      font-size: 0.9375rem; /* 15px */
      font-weight: 500;
      font-family: inherit;
      color: #000000;
      background: #FFFFFF;
      border: 1px solid #E5E5E5;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.2s ease;
      line-height: 1;
      letter-spacing: 0.01em;
      white-space: nowrap;
    }

    .btn:hover {
      background: #F5F5F5;
      border-color: #CCCCCC;
    }

    .btn:active {
      background: #E5E5E5;
      transform: scale(0.98);
    }

    .btn-primary {
      background: #000000;
      color: #FFFFFF;
      border-color: #000000;
    }

    .btn-primary:hover {
      background: #333333;
      border-color: #333333;
      color: #FFFFFF;
    }

    .btn-primary:active {
      background: #666666;
    }

    /* 状态提示条：圆润边框，左侧 SVG 信息图标 */
    .status-bar {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 18px;
      background: #F5F5F5;
      border: 1px solid #E5E5E5;
      border-radius: 12px;
      transition: all 0.2s ease;
    }

    .status-bar .info-icon {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #000000;
    }

    .status-bar .info-icon svg {
      width: 100%;
      height: 100%;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .status-text {
      font-size: 0.875rem; /* 14px */
      color: #333333;
      font-weight: 400;
    }

    /* 所有 SVG 内嵌元素均遵守圆滑端点与统一线宽 */
    svg {
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    /* 按钮内的 svg 图标（虽然未用，但统一）*/
    .btn svg {
      width: 18px;
      height: 18px;
      margin-right: 8px;
      stroke: currentColor;
      fill: none;
      stroke-width: 1.5;
    }

    /* 开关按钮的焦点样式（极简，不额外加框）*/
    .toggle-switch:focus-visible,
    .btn:focus-visible {
      outline: 2px solid #999999;
      outline-offset: 2px;
      border-radius: 12px;
    }

    /* 辅助隐藏 */
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      border: 0;
    }
  </style>
</head>
<body>
  <!-- 
    硬性约束：配置前置 
    ！！！所有可修改的配置必须放在最前面的 CONFIG 对象中，渲染逻辑从 CONFIG 读取。
  -->
  <script>
    // ========== 所有可修改配置集中管理 ==========
    const CONFIG = {
      title: "极简设置",
      subtitle: "调整偏好，保持简洁",
      toggles: [
        {
          id: "dark-mode",
          label: "深色模式",
          icon: "moon",       // 图标标识，渲染时映射为SVG
          defaultChecked: false
        },
        {
          id: "notifications",
          label: "允许通知",
          icon: "bell",
          defaultChecked: true
        },
        {
          id: "auto-save",
          label: "自动保存",
          icon: "save",
          defaultChecked: false
        }
      ],
      buttons: {
        reset: "重置",
        apply: "应用更改"
      },
      statusMessage: "所有更改将在应用后生效。",
      // 状态提示条的初始文本，也可以动态更新
    };
  </script>

  <!-- 页面结构，由 JS 根据 CONFIG 动态渲染部分内容，确保配置前置 -->
  <div class="settings-panel" id="app">
    <!-- 标题区动态生成，但为清晰，这里先留空容器，JS填充 -->
    <div class="header" id="headerContainer"></div>

    <!-- 开关项列表容器 -->
    <div class="toggle-list" id="toggleListContainer"></div>

    <!-- 操作栏 -->
    <div class="action-bar">
      <button class="btn" id="resetBtn" type="button"></button>
      <button class="btn btn-primary" id="applyBtn" type="button"></button>
    </div>

    <!-- 状态提示条 -->
    <div class="status-bar" id="statusBar">
      <span class="info-icon" aria-hidden="true">
        <!-- 内联 SVG 信息图标：圆形+感叹号，简洁黑白，包含 viewBox -->
        <svg viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="10" cy="10" r="8" fill="none" stroke="currentColor" stroke-width="1.5" />
          <line x1="10" y1="6" x2="10" y2="11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          <circle cx="10" cy="14.5" r="0.8" fill="currentColor" stroke="none" />
        </svg>
      </span>
      <span class="status-text" id="statusText"></span>
    </div>
  </div>

  <script>
    (function() {
      // 从 CONFIG 读取数据并渲染
      const app = document.getElementById('app');
      
      // 1. 渲染标题区
      const headerContainer = document.getElementById('headerContainer');
      headerContainer.innerHTML = `
        <h1>${CONFIG.title}</h1>
        <p class="subtitle">${CONFIG.subtitle}</p>
      `;

      // 2. 渲染开关项列表（包含左侧 SVG 图标 + 右侧开关控件）
      // 图标映射函数：返回内联 SVG 字符串，黑白灰，含 viewBox 和可访问性
      function getIconSvg(iconName) {
        // 所有图标均使用 currentColor 描边，统一线宽1.5，圆角端点
        // 注意：每个 svg 必须含 viewBox 与 aria-hidden 或 role+title
        const icons = {
          moon: `
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          `,
          bell: `
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
              <path d="M13.73 21a2 2 0 0 1-3.46 0" />
            </svg>
          `,
          save: `
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
              <polyline points="17 21 17 13 7 13 7 21" />
              <polyline points="7 3 7 8 15 8" />
            </svg>
          `
        };
        return icons[iconName] || icons.moon;
      }

      // 生成开关控件 SVG：包含 viewBox，圆滑端点，使用 aria-checked 控制状态
      function getSwitchSvg(isChecked, toggleId) {
        // 开关尺寸 48x28，背景圆角矩形，圆滑块
        // 使用 aria-checked 反映状态，CSS 控制颜色和位移
        // 开关整体可访问性：按钮外部已有 aria-checked，此处 svg 仅作视觉，加 aria-hidden="true"
        return `
          <svg viewBox="0 0 48 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <!-- 背景圆角矩形 -->
            <rect class="switch-bg" x="0" y="0" width="48" height="28" rx="14" fill="#E5E5E5" />
            <!-- 圆滑块，通过CSS transform位移，此处cx=14，开启后translateX(20px) => cx视觉变为34 -->
            <circle class="switch-knob" cx="14" cy="14" r="10" fill="#FFFFFF" stroke="#999999" stroke-width="1.5" />
          </svg>
        `;
      }

      const toggleListContainer = document.getElementById('toggleListContainer');
      let toggleListHtml = '';
      
      CONFIG.toggles.forEach(toggle => {
        // 默认状态从 CONFIG 读取，但也要考虑可能后续用户更改；初始渲染使用 defaultChecked
        const isChecked = toggle.defaultChecked;
        toggleListHtml += `
          <div class="toggle-item" data-toggle-id="${toggle.id}">
            <div class="toggle-left">
              <span class="icon" aria-hidden="true">
                ${getIconSvg(toggle.icon)}
              </span>
              <span class="toggle-label">${toggle.label}</span>
            </div>
            <button class="toggle-switch" 
              type="button" 
              role="switch" 
              aria-checked="${isChecked}" 
              aria-label="${toggle.label}"
              data-toggle-id="${toggle.id}"
              tabindex="0">
              ${getSwitchSvg(isChecked, toggle.id)}
            </button>
          </div>
        `;
      });
      
      toggleListContainer.innerHTML = toggleListHtml;

      // 3. 设置按钮文案（从 CONFIG 读取）
      const resetBtn = document.getElementById('resetBtn');
      const applyBtn = document.getElementById('applyBtn');
      resetBtn.textContent = CONFIG.buttons.reset;
      applyBtn.textContent = CONFIG.buttons.apply;

      // 4. 设置状态提示文本
      const statusText = document.getElementById('statusText');
      statusText.textContent = CONFIG.statusMessage;

      // ---------- 交互逻辑 ----------
      // 开关切换：点击按钮切换 aria-checked，利用 CSS 过渡实现平滑动画
      const toggleSwitches = document.querySelectorAll('.toggle-switch');
      
      toggleSwitches.forEach(switchBtn => {
        switchBtn.addEventListener('click', function(e) {
          e.preventDefault();
          const currentChecked = this.getAttribute('aria-checked') === 'true';
          const newChecked = !currentChecked;
          this.setAttribute('aria-checked', newChecked);
          // 可以更新状态提示条内容（可选，从 CONFIG 读取基础文案，但为了演示，不改也行；保持干净）
          // 更新状态提示文本以反映操作
          statusText.textContent = `开关“${this.getAttribute('aria-label')}”已${newChecked ? '开启' : '关闭'}。`;
        });

        // 键盘支持：空格/回车切换
        switchBtn.addEventListener('keydown', function(e) {
          if (e.key === ' ' || e.key === 'Enter') {
            e.preventDefault();
            this.click();
          }
        });
      });

      // 重置按钮：将所有开关恢复为 CONFIG 中的 defaultChecked
      resetBtn.addEventListener('click', function() {
        CONFIG.toggles.forEach(toggle => {
          const btn = document.querySelector(`.toggle-switch[data-toggle-id="${toggle.id}"]`);
          if (btn) {
            btn.setAttribute('aria-checked', toggle.defaultChecked);
          }
        });
        statusText.textContent = CONFIG.statusMessage;
      });

      // 应用更改按钮：更新状态提示条，显示已应用
      applyBtn.addEventListener('click', function() {
        // 收集当前所有开关状态
        const activeToggles = [];
        CONFIG.toggles.forEach(toggle => {
          const btn = document.querySelector(`.toggle-switch[data-toggle-id="${toggle.id}"]`);
          if (btn) {
            const isChecked = btn.getAttribute('aria-checked') === 'true';
            activeToggles.push(`${toggle.label}:${isChecked ? '开' : '关'}`);
          }
        });
        // 更新提示条（简练，不啰嗦）
        statusText.textContent = `已应用设置 (${activeToggles.join('，')})。`;
        // 也可保持文案简短，但符合要求
      });

      // 初始状态提示条显示配置文案
      statusText.textContent = CONFIG.statusMessage;
    })();
  </script>

  <!-- 确保所有视觉元素都是内联SVG，无位图、无emoji、无图标字体 -->
  <!-- 所有边框元素都有较大的圆角（panel 12px，按钮12px，提示条12px） -->
  <!-- 所有SVG状态变化均通过CSS transition实现平滑动画（开关滑块位移、背景色变化均有transition） -->
  <!-- 配置前置：CONFIG 位于代码最前，所有文案、开关项、按钮文本均从CONFIG读取 -->
</body>
</html>