<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LaTeX → HTML 图案转换器</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background: #0f172a;
            font-family: 'Inter', -apple-system, 'Segoe UI', Roboto, sans-serif;
            color: #e2e8f0;
            padding: 20px;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .container {
            max-width: 1000px;
            width: 100%;
            background: #1e293b;
            border-radius: 20px;
            padding: 30px;
            border: 1px solid #334155;
        }
        h1 {
            text-align: center;
            font-size: 24px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }
        h1 small {
            font-size: 14px;
            font-weight: 400;
            background: #10b981;
            padding: 2px 14px;
            border-radius: 40px;
            color: white;
        }
        .row {
            display: flex;
            gap: 16px;
            flex-wrap: wrap;
        }
        .col {
            flex: 1;
            min-width: 300px;
        }
        textarea {
            width: 100%;
            height: 280px;
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 12px;
            padding: 14px;
            font-family: 'JetBrains Mono', monospace;
            font-size: 13px;
            color: #e2e8f0;
            resize: vertical;
            outline: none;
            line-height: 1.6;
        }
        textarea:focus {
            border-color: #3b82f6;
        }
        .btn-group {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin: 12px 0;
        }
        .btn {
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: 0.15s;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .btn-primary { background: #3b82f6; color: white; }
        .btn-primary:hover { background: #2563eb; }
        .btn-success { background: #10b981; color: white; }
        .btn-success:hover { background: #059669; }
        .btn-outline { background: transparent; border: 1px solid #475569; color: #94a3b8; }
        .btn-outline:hover { background: #334155; color: #e2e8f0; }
        .preview {
            background: #0f172a;
            border-radius: 12px;
            padding: 20px;
            min-height: 200px;
            border: 1px solid #334155;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: auto;
            position: relative;
        }
        .preview canvas {
            display: block;
            image-rendering: pixelated;
        }
        .empty-hint {
            color: #64748b;
            font-style: italic;
        }
        .examples {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin: 8px 0;
        }
        .examples .badge {
            background: #334155;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 12px;
            cursor: pointer;
            border: 1px solid #475569;
            transition: 0.15s;
            color: #94a3b8;
        }
        .examples .badge:hover {
            background: #475569;
            color: #e2e8f0;
        }
        .stats {
            font-size: 12px;
            color: #64748b;
            margin-top: 8px;
            text-align: center;
        }
        .legend {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            justify-content: center;
            margin-top: 10px;
            font-size: 12px;
            color: #94a3b8;
        }
        .legend-item {
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .legend-color {
            width: 20px;
            height: 20px;
            border-radius: 4px;
            border: 1px solid #475569;
        }
    </style>
</head>
<body>
<div class="container">
    <h1>
        📐 LaTeX → HTML 转换器
        <small>直接渲染，无需MathJax</small>
    </h1>

    <div class="row">
        <div class="col">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                <span style="font-size:14px;color:#94a3b8;">📝 LaTeX 代码（\rlap 拼图）</span>
                <span style="font-size:12px;color:#64748b;">支持 \rlap + \raisebox + \rule</span>
            </div>
            <textarea id="latexInput" spellcheck="false">\begin{array}{l}
\rlap{\kern{7.0em}\raisebox{7.0em}{\textcolor{#2d5a27}{\rule{0.8em}{0.8em}}}}{}
\rlap{\kern{6.2em}\raisebox{6.2em}{\textcolor{#3a7a33}{\rule{0.8em}{0.8em}}}}{}
\rlap{\kern{7.8em}\raisebox{6.2em}{\textcolor{#3a7a33}{\rule{0.8em}{0.8em}}}}{}
\rlap{\kern{5.4em}\raisebox{5.4em}{\textcolor{#4a8a3d}{\rule{0.8em}{0.8em}}}}{}
\rlap{\kern{7.0em}\raisebox{5.4em}{\textcolor{#4a8a3d}{\rule{0.8em}{0.8em}}}}{}
\rlap{\kern{8.6em}\raisebox{5.4em}{\textcolor{#4a8a3d}{\rule{0.8em}{0.8em}}}}{}
\rlap{\kern{4.6em}\raisebox{4.6em}{\textcolor{#5a9a4d}{\rule{0.8em}{0.8em}}}}{}
\rlap{\kern{6.2em}\raisebox{4.6em}{\textcolor{#5a9a4d}{\rule{0.8em}{0.8em}}}}{}
\rlap{\kern{7.8em}\raisebox{4.6em}{\textcolor{#5a9a4d}{\rule{0.8em}{0.8em}}}}{}
\rlap{\kern{9.4em}\raisebox{4.6em}{\textcolor{#5a9a4d}{\rule{0.8em}{0.8em}}}}{}
\rlap{\kern{3.8em}\raisebox{3.8em}{\textcolor{#6aaa5d}{\rule{0.8em}{0.8em}}}}{}
\rlap{\kern{5.4em}\raisebox{3.8em}{\textcolor{#6aaa5d}{\rule{0.8em}{0.8em}}}}{}
\rlap{\kern{7.0em}\raisebox{3.8em}{\textcolor{#6aaa5d}{\rule{0.8em}{0.8em}}}}{}
\rlap{\kern{8.6em}\raisebox{3.8em}{\textcolor{#6aaa5d}{\rule{0.8em}{0.8em}}}}{}
\rlap{\kern{10.2em}\raisebox{3.8em}{\textcolor{#6aaa5d}{\rule{0.8em}{0.8em}}}}{}
\rlap{\kern{6.2em}\raisebox{2.5em}{\textcolor{#8b5a2b}{\rule{0.8em}{1.2em}}}}{}
\rlap{\kern{7.8em}\raisebox{2.5em}{\textcolor{#8b5a2b}{\rule{0.8em}{1.2em}}}}{}
\rule{14em}{0pt}\rule{0pt}{8.5em}
\end{array}</textarea>

            <div class="btn-group">
                <button class="btn btn-primary" onclick="convert()">▶ 转换</button>
                <button class="btn btn-outline" onclick="document.getElementById('latexInput').value='';convert();">🗑️ 清空</button>
            </div>

            <div class="examples">
                <span style="color:#64748b;font-size:13px;">示例：</span>
                <span class="badge" onclick="loadExample('tree')">🎄 圣诞树</span>
                <span class="badge" onclick="loadExample('heart')">❤️ 爱心</span>
                <span class="badge" onclick="loadExample('diamond')">💎 菱形</span>
                <span class="badge" onclick="loadExample('smiley')">😊 笑脸</span>
                <span class="badge" onclick="loadExample('flag')">🏴 旗帜</span>
            </div>
        </div>

        <div class="col">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                <span style="font-size:14px;color:#94a3b8;">🖼️ 渲染结果</span>
                <span style="font-size:12px;color:#64748b;" id="pixelCount">0 个方块</span>
            </div>
            <div class="preview" id="preview">
                <span class="empty-hint">点击「转换」查看图案</span>
            </div>
            <div class="legend" id="legend"></div>
            <div class="stats">💡 直接解析 LaTeX 命令，无需加载 MathJax</div>
        </div>
    </div>
</div>

<script>
    // ============================================================
    // 核心：LaTeX \rlap 拼图解析器 → HTML Canvas
    // ============================================================

    function parseLatexRlap(text) {
        // 提取 \rlap{...} 中的内容
        const blocks = [];
        const regex = /\\rlap\{([^}]*)\}/g;
        let match;
        while ((match = regex.exec(text)) !== null) {
            const content = match[1];
            // 提取 \kern{Xem}
            const kernMatch = content.match(/\\kern\{([^}]*)\}/);
            const raiseMatch = content.match(/\\raisebox\{([^}]*)\}/);
            const colorMatch = content.match(/\\textcolor\{([^}]*)\}/);
            const ruleMatch = content.match(/\\rule\{([^}]*)\}\{([^}]*)\}/);

            if (kernMatch && raiseMatch && colorMatch && ruleMatch) {
                blocks.push({
                    x: parseFloat(kernMatch[1]),
                    y: parseFloat(raiseMatch[1]),
                    color: colorMatch[1],
                    w: parseFloat(ruleMatch[1]),
                    h: parseFloat(ruleMatch[2])
                });
            }
        }
        return blocks;
    }

    function convert() {
        const input = document.getElementById('latexInput').value;
        const preview = document.getElementById('preview');
        const pixelCount = document.getElementById('pixelCount');
        const legend = document.getElementById('legend');

        // 提取所有 \rlap 块
        const blocks = parseLatexRlap(input);

        if (blocks.length === 0) {
            preview.innerHTML = `<span class="empty-hint">⚠️ 未找到有效的 \rlap 命令，请检查 LaTeX 代码</span>`;
            pixelCount.textContent = '0 个方块';
            legend.innerHTML = '';
            return;
        }

        // 计算边界
        let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
        blocks.forEach(b => {
            if (b.x < minX) minX = b.x;
            if (b.x + b.w > maxX) maxX = b.x + b.w;
            if (b.y < minY) minY = b.y;
            if (b.y + b.h > maxY) maxY = b.y + b.h;
        });

        // 添加边距
        const padding = 0.5;
        minX -= padding;
        maxX += padding;
        minY -= padding;
        maxY += padding;

        const rangeX = maxX - minX;
        const rangeY = maxY - minY;

        // 计算 Canvas 尺寸（保持比例，像素级渲染）
        const maxSize = 600;
        const scale = Math.min(maxSize / rangeX, maxSize / rangeY, 40);
        const canvasW = Math.ceil(rangeX * scale);
        const canvasH = Math.ceil(rangeY * scale);

        const canvas = document.createElement('canvas');
        canvas.width = canvasW;
        canvas.height = canvasH;
        const ctx = canvas.getContext('2d');

        // 清空（透明背景）
        ctx.clearRect(0, 0, canvasW, canvasH);

        // 绘制每个方块（从下到上，y 坐标翻转）
        blocks.forEach(b => {
            const x = (b.x - minX) * scale;
            const y = (maxY - (b.y + b.h)) * scale;
            const w = b.w * scale;
            const h = b.h * scale;

            // 解析颜色
            let color = b.color;
            if (color.startsWith('#')) {
                // 已经是十六进制
            } else if (color.match(/^[0-9a-fA-F]{6}$/)) {
                color = '#' + color;
            } else {
                // 尝试常见颜色名
                const colorMap = {
                    'red': '#ff0000', 'green': '#00ff00', 'blue': '#0000ff',
                    'black': '#000000', 'white': '#ffffff', 'brown': '#8b4513',
                    'yellow': '#ffff00', 'orange': '#ff8800', 'purple': '#8800ff',
                    'pink': '#ff69b4', 'gray': '#808080'
                };
                color = colorMap[color.toLowerCase()] || '#ff00ff';
            }

            ctx.fillStyle = color;
            ctx.fillRect(x, y, w, h);
            // 添加细边框（可选）
            // ctx.strokeStyle = 'rgba(255,255,255,0.1)';
            // ctx.lineWidth = 0.5;
            // ctx.strokeRect(x, y, w, h);
        });

        // 显示
        preview.innerHTML = '';
        preview.appendChild(canvas);

        pixelCount.textContent = blocks.length + ' 个方块';

        // 图例
        const colorSet = new Set();
        blocks.forEach(b => colorSet.add(b.color));
        let legendHTML = '';
        colorSet.forEach(c => {
            let displayColor = c;
            if (c.startsWith('#')) displayColor = c;
            else if (c.match(/^[0-9a-fA-F]{6}$/)) displayColor = '#' + c;
            else displayColor = c;
            legendHTML += `<span class="legend-item">
                <span class="legend-color" style="background:${displayColor};"></span>
                ${c}
            </span>`;
        });
        legend.innerHTML = legendHTML;
    }

    // ============================================================
    // 示例加载
    // ============================================================

    const EXAMPLES = {
        tree: `\\begin{array}{l}
\\rlap{\\kern{7.0em}\\raisebox{7.0em}{\\textcolor{#2d5a27}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{6.2em}\\raisebox{6.2em}{\\textcolor{#3a7a33}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{7.8em}\\raisebox{6.2em}{\\textcolor{#3a7a33}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{5.4em}\\raisebox{5.4em}{\\textcolor{#4a8a3d}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{7.0em}\\raisebox{5.4em}{\\textcolor{#4a8a3d}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{8.6em}\\raisebox{5.4em}{\\textcolor{#4a8a3d}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{4.6em}\\raisebox{4.6em}{\\textcolor{#5a9a4d}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{6.2em}\\raisebox{4.6em}{\\textcolor{#5a9a4d}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{7.8em}\\raisebox{4.6em}{\\textcolor{#5a9a4d}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{9.4em}\\raisebox{4.6em}{\\textcolor{#5a9a4d}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{3.8em}\\raisebox{3.8em}{\\textcolor{#6aaa5d}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{5.4em}\\raisebox{3.8em}{\\textcolor{#6aaa5d}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{7.0em}\\raisebox{3.8em}{\\textcolor{#6aaa5d}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{8.6em}\\raisebox{3.8em}{\\textcolor{#6aaa5d}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{10.2em}\\raisebox{3.8em}{\\textcolor{#6aaa5d}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{6.2em}\\raisebox{2.5em}{\\textcolor{#8b5a2b}{\\rule{0.8em}{1.2em}}}}{}
\\rlap{\\kern{7.8em}\\raisebox{2.5em}{\\textcolor{#8b5a2b}{\\rule{0.8em}{1.2em}}}}{}
\\rule{14em}{0pt}\\rule{0pt}{8.5em}
\\end{array}`,

        heart: `\\begin{array}{l}
\\rlap{\\kern{4.0em}\\raisebox{7.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{6.0em}\\raisebox{7.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{3.0em}\\raisebox{6.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{5.0em}\\raisebox{6.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{7.0em}\\raisebox{6.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{2.0em}\\raisebox{5.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{4.0em}\\raisebox{5.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{6.0em}\\raisebox{5.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{8.0em}\\raisebox{5.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{1.0em}\\raisebox{4.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{3.0em}\\raisebox{4.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{5.0em}\\raisebox{4.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{7.0em}\\raisebox{4.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{9.0em}\\raisebox{4.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{2.0em}\\raisebox{3.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{4.0em}\\raisebox{3.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{6.0em}\\raisebox{3.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{8.0em}\\raisebox{3.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{3.0em}\\raisebox{2.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{5.0em}\\raisebox{2.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{7.0em}\\raisebox{2.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{4.0em}\\raisebox{1.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{6.0em}\\raisebox{1.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{5.0em}\\raisebox{0.0em}{\\textcolor{#ff1744}{\\rule{1.0em}{1.0em}}}}{}
\\rule{10em}{0pt}\\rule{0pt}{8em}
\\end{array}`,

        diamond: `\\begin{array}{l}
\\rlap{\\kern{5.0em}\\raisebox{8.0em}{\\textcolor{#ff6b6b}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{4.0em}\\raisebox{7.0em}{\\textcolor{#ffa94d}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{6.0em}\\raisebox{7.0em}{\\textcolor{#ffa94d}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{3.0em}\\raisebox{6.0em}{\\textcolor{#ffd93d}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{5.0em}\\raisebox{6.0em}{\\textcolor{#ffd93d}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{7.0em}\\raisebox{6.0em}{\\textcolor{#ffd93d}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{2.0em}\\raisebox{5.0em}{\\textcolor{#6bcb77}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{4.0em}\\raisebox{5.0em}{\\textcolor{#6bcb77}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{6.0em}\\raisebox{5.0em}{\\textcolor{#6bcb77}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{8.0em}\\raisebox{5.0em}{\\textcolor{#6bcb77}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{1.0em}\\raisebox{4.0em}{\\textcolor{#4d96ff}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{3.0em}\\raisebox{4.0em}{\\textcolor{#4d96ff}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{5.0em}\\raisebox{4.0em}{\\textcolor{#4d96ff}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{7.0em}\\raisebox{4.0em}{\\textcolor{#4d96ff}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{9.0em}\\raisebox{4.0em}{\\textcolor{#4d96ff}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{2.0em}\\raisebox{3.0em}{\\textcolor{#9b59b6}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{4.0em}\\raisebox{3.0em}{\\textcolor{#9b59b6}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{6.0em}\\raisebox{3.0em}{\\textcolor{#9b59b6}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{8.0em}\\raisebox{3.0em}{\\textcolor{#9b59b6}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{3.0em}\\raisebox{2.0em}{\\textcolor{#ff6b6b}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{5.0em}\\raisebox{2.0em}{\\textcolor{#ff6b6b}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{7.0em}\\raisebox{2.0em}{\\textcolor{#ff6b6b}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{4.0em}\\raisebox{1.0em}{\\textcolor{#ffa94d}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{6.0em}\\raisebox{1.0em}{\\textcolor{#ffa94d}{\\rule{0.8em}{0.8em}}}}{}
\\rlap{\\kern{5.0em}\\raisebox{0.0em}{\\textcolor{#ffd93d}{\\rule{0.8em}{0.8em}}}}{}
\\rule{10em}{0pt}\\rule{0pt}{9em}
\\end{array}`,

        smiley: `\\begin{array}{l}
\\rlap{\\kern{2.0em}\\raisebox{7.0em}{\\textcolor{#ffd93d}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{3.0em}\\raisebox{7.0em}{\\textcolor{#ffd93d}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{4.0em}\\raisebox{7.0em}{\\textcolor{#ffd93d}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{5.0em}\\raisebox{7.0em}{\\textcolor{#ffd93d}{\\rule{1.0em}{1.0em}}}}{}
\\rlap{\\kern{6.0em}\\raisebox{7.0em}{\\textcolor{#ffd93d}{\\rule{1.0em}{1.0em}}}}{}
