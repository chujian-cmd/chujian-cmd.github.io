<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Sync</title>
<style>
  body { margin: 0; overflow: hidden; background: #050508; touch-action: none; }
  canvas { display: block; }
</style>
</head>
<body>
<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.160.0/build/three.module.js"
  }
}
</script>
<script type="module">
import * as THREE from 'three';

const scene = new THREE.Scene();
scene.fog = new THREE.FogExp2(0x050508, 0.02);

const camera = new THREE.PerspectiveCamera(45, innerWidth / innerHeight, 0.1, 100);
camera.position.set(0, 0, 12);

const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
renderer.setSize(innerWidth, innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio, 1.5));
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.5;
document.body.appendChild(renderer.domElement);

scene.add(new THREE.AmbientLight(0x221122, 3));

const pointA = new THREE.PointLight(0xff1144, 80, 30);
pointA.position.set(0, 4, 6);
scene.add(pointA);

const pointB = new THREE.PointLight(0x1144ff, 80, 30);
pointB.position.set(0, -4, 6);
scene.add(pointB);

const pGeo = new THREE.BufferGeometry();
const N = 2000;
const pos = new Float32Array(N * 3);
const speeds = new Float32Array(N);
for (let i = 0; i < N; i++) {
  const r = 2 + Math.random() * 15;
  const th = Math.random() * Math.PI * 2;
  const ph = Math.acos(2 * Math.random() - 1);
  pos[i*3] = Math.sin(ph) * Math.cos(th) * r;
  pos[i*3+1] = Math.sin(ph) * Math.sin(th) * r * 0.5;
  pos[i*3+2] = Math.cos(ph) * r;
  speeds[i] = Math.random();
}
pGeo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
pGeo.setAttribute('aSpeed', new THREE.BufferAttribute(speeds, 1));

const pMat = new THREE.ShaderMaterial({
  transparent: true,
  depthWrite: false,
  blending: THREE.AdditiveBlending,
  uniforms: {
    uTime: { value: 0 },
    uPulse: { value: 0 },
    uColor: { value: new THREE.Color(0xff88aa) }
  },
  vertexShader: `
    uniform float uTime;
    uniform float uPulse;
    attribute float aSpeed;
    varying float vAlpha;
    void main() {
      vec3 p = position;
      float t = uTime * (0.5 + aSpeed * 2.0) * (1.0 + uPulse * 3.0);
      p.x += sin(t + aSpeed * 10.0) * (0.5 + uPulse * 2.0);
      p.y += cos(t * 1.2 + aSpeed * 5.0) * (0.5 + uPulse * 2.0);
      p.z += sin(t * 0.8) * 0.5;
      
      vec4 mv = modelViewMatrix * vec4(p, 1.0);
      gl_PointSize = (5.0 + uPulse * 15.0) * (150.0 / -mv.z) * (0.5 + aSpeed);
      vAlpha = 0.2 + 0.8 * sin(t * 2.0 + aSpeed * 20.0);
      gl_Position = projectionMatrix * mv;
    }
  `,
  fragmentShader: `
    uniform vec3 uColor;
    varying float vAlpha;
    void main() {
      vec2 c = gl_PointCoord - 0.5;
      float d = length(c);
      if (d > 0.5) discard;
      float a = smoothstep(0.5, 0.1, d);
      gl_FragColor = vec4(uColor, a * vAlpha);
    }
  `
});
const particles = new THREE.Points(pGeo, pMat);
scene.add(particles);

const sheathGeo = new THREE.TorusGeometry(1.6, 0.35, 16, 64);
const sheathMat = new THREE.MeshStandardMaterial({
  color: 0xff2255,
  emissive: 0x661122,
  emissiveIntensity: 2.0,
  roughness: 0.2,
  metalness: 0.8,
  transparent: true,
  opacity: 0.85
});
const sheath = new THREE.Mesh(sheathGeo, sheathMat);
sheath.rotation.x = Math.PI / 2;
sheath.position.z = 0;
scene.add(sheath);

const coreMat = new THREE.MeshBasicMaterial({
  color: 0x331111,
  transparent: true,
  opacity: 0.6,
  side: THREE.DoubleSide
});
const core = new THREE.Mesh(new THREE.CircleGeometry(1.3, 32), coreMat);
core.position.z = -0.1;
sheath.add(core);

const shaftGeo = new THREE.CylinderGeometry(0.45, 0.45, 8, 32, 1, false);
const shaftMat = new THREE.MeshStandardMaterial({
  color: 0xffffff,
  emissive: 0x2255ff,
  emissiveIntensity: 3.0,
  roughness: 0.1,
  metalness: 0.9
});
const shaft = new THREE.Mesh(shaftGeo, shaftMat);
shaft.rotation.x = Math.PI / 2;
shaft.position.z = 6;
scene.add(shaft);

const tipGeo = new THREE.SphereGeometry(0.45, 32, 16);
const tipMat = new THREE.MeshBasicMaterial({ color: 0xaaccff });
const tip = new THREE.Mesh(tipGeo, tipMat);
tip.position.y = -4;
shaft.add(tip);

let isTouching = false;
let pulse = 0;
let thrustDepth = 0;
let thrustVel = 0;

const onDown = () => isTouching = true;
const onUp = () => isTouching = false;

window.addEventListener('pointerdown', onDown);
window.addEventListener('pointerup', onUp);
window.addEventListener('pointercancel', onUp);
window.addEventListener('touchstart', (e) => { e.preventDefault(); isTouching = true; }, { passive: false });
window.addEventListener('touchend', (e) => { e.preventDefault(); isTouching = false; }, { passive: false });

const clock = new THREE.Clock();

function animate() {
  requestAnimationFrame(animate);
  const dt = Math.min(clock.getDelta(), 0.05);
  const time = clock.getElapsedTime();

  if (isTouching) {
    pulse = Math.min(pulse + dt * 3.0, 1.0);
    thrustVel += dt * 40.0;
    shaftMat.emissiveIntensity = 3.0 + Math.sin(time * 30.0) * 2.0;
    sheathMat.emissiveIntensity = 2.0 + Math.sin(time * 30.0) * 1.5;
    shaft.position.z = 6 - Math.min(thrustVel, 5.2);
    tipMat.color.setHex(0xffffff);
  } else {
    pulse = Math.max(pulse - dt * 1.5, 0.0);
    thrustVel = Math.max(thrustVel - dt * 8.0, 0.0);
    shaftMat.emissiveIntensity += (1.0 - shaftMat.emissiveIntensity) * dt * 5.0;
    sheathMat.emissiveIntensity += (0.5 - sheathMat.emissiveIntensity) * dt * 5.0;
    shaft.position.z += (6 - shaft.position.z) * dt * 4.0;
    tipMat.color.setHex(0xaaccff);
  }

  const targetScale = 1.0 + pulse * 0.3;
  sheath.scale.set(targetScale, targetScale, targetScale);
  sheath.rotation.z = Math.sin(time * 2.0) * 0.1;
  sheath.rotation.y = Math.cos(time * 1.5) * 0.1;

  shaft.rotation.z = Math.sin(time * 15.0) * 0.02 * pulse;

  pMat.uniforms.uTime.value = time;
  pMat.uniforms.uPulse.value = pulse;

  pointA.intensity = 80 + pulse * 200;
  pointB.intensity = 80 + pulse * 200;

  camera.position.z = 12 - pulse * 2.0;
  camera.position.x = Math.sin(time * 0.5) * 1.0 + Math.sin(time * 20.0) * 0.05 * pulse;
  camera.position.y = Math.cos(time * 0.3) * 0.5;
  camera.lookAt(0, 0, 0);

  particles.rotation.y = time * 0.05;

  renderer.render(scene, camera);
}

animate();

addEventListener('resize', () => {
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});
</script>
</body>
</html>