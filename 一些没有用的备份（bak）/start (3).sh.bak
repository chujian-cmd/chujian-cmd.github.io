#!/bin/bash

echo "=============================="
echo "  本地项目启动器"
echo "=============================="
echo "1. Holistic（人体识别）"
echo "2. 晃动工坊（图片晃动）"
echo "3. Turbowarp（Scratch 编辑器）"
echo "4. 全部启动"
echo "0. 退出"
echo "=============================="

# 强制等待用户输入
while true; do
    read -p "请输入数字 [0-4]: " choice
    case $choice in
        1|2|3|4|0) break ;;
        *) echo "请输入 0-4 之间的数字！" ;;
    esac
done

case $choice in
  1)
    echo "启动 Holistic..."
    cd /storage/emulated/0/html存放地/holistic_demo
    python -m http.server 8082
    ;;
  2)
    echo "启动 晃动工坊..."
    cd /storage/emulated/0/html存放地/晃动工坊
    python -m http.server 8083
    ;;
  3)
    echo "启动 Turbowarp..."
    cd /storage/emulated/0/html存放地/turbowarp.org
    python -m http.server 8084
    ;;
  4)
    echo "启动全部项目..."
    cd /storage/emulated/0/html存放地/holistic_demo && python -m http.server 8082 &
    cd /storage/emulated/0/html存放地/晃动工坊 && python -m http.server 8083 &
    cd /storage/emulated/0/html存放地/turbowarp.org && python -m http.server 8084 &
    echo "所有项目已在后台启动！"
    echo "访问地址："
    echo "  Holistic:  http://127.0.0.1:8082"
    echo "  晃动工坊:   http://127.0.0.1:8083"
    echo "  Turbowarp: http://127.0.0.1:8084/editor"
    ;;
  0)
    echo "退出"
    ;;
esac