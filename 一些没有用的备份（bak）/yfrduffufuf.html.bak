<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes, viewport-fit=cover">
    <title>桌案 · 文本研读 | 花园明朝 触控增强版</title>
    <style>
        /* ---------- 纯桌面视觉风格，但专为手机触摸优化 ---------- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background: #dce3ec;
            font-family: system-ui, 'Segoe UI', 'Roboto', 'Noto Sans CJK SC', -apple-system, BlinkMacSystemFont, sans-serif;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            padding: 8px;
        }

        /* 主窗口 — 桌面硬朗风格，微圆角适应手机 */
        .app-window {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: #f0f2f6;
            border-radius: 12px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1), 0 0 0 1px rgba(0, 0, 0, 0.05);
            overflow: hidden;
        }

        /* 顶部工具栏：桌面风格 + 大触摸区域 */
        .toolbar-main {
            background: #ffffff;
            border-bottom: 1px solid #cbd5e1;
            padding: 10px 16px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 12px;
            row-gap: 12px;
            flex-shrink: 0;
        }

        /* 左部标识 + 文件区 */
        .brand {
            display: flex;
            align-items: baseline;
            gap: 12px;
            background: #f8fafc;
            padding-right: 14px;
            border-right: 1px solid #e2e8f0;
        }

        .brand h2 {
            font-size: 1.2rem;
            font-weight: 550;
            color: #0f172a;
            letter-spacing: -0.2px;
            white-space: nowrap;
        }

        .brand .badge {
            font-size: 0.7rem;
            background: #eef2ff;
            padding: 4px 10px;
            border-radius: 30px;
            color: #1e3a8a;
            font-weight: 500;
        }

        /* 文件控件 (触摸友好) */
        .file-zone {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .file-label {
            background: #f1f5f9;
            border: 1px solid #cbd5e1;
            border-radius: 32px;
            padding: 8px 18px;
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            transition: 0.1s;
            touch-action: manipulation;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .file-label:active {
            background: #e2e8f0;
        }

        input[type="file"] {
            display: none;
        }

        #fileStatus {
            font-size: 0.8rem;
            color: #2c3e66;
            background: #eef2ff;
            padding: 5px 12px;
            border-radius: 32px;
            white-space: nowrap;
        }

        /* 分页控制组 — 大按钮，触摸区域44x44以上 */
        .ctrl-group {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            background: #ffffffec;
            padding: 4px 12px;
            border-radius: 48px;
            border: 1px solid #e2e8f0;
        }

        button, .ctrl-group select, .ctrl-group input {
            background: white;
            border: 1px solid #cbd5e1;
            padding: 8px 14px;
            border-radius: 32px;
            font-size: 0.85rem;
            font-weight: 500;
            font-family: inherit;
            cursor: pointer;
            transition: 0.08s linear;
            touch-action: manipulation;
            min-width: 44px;
            text-align: center;
        }

        button:active {
            background: #d9e2ef;
            transform: scale(0.96);
        }

        .ctrl-group input {
            width: 68px;
            text-align: center;
            padding: 8px 4px;
        }

        .page-info {
            background: #eef2ff;
            border-radius: 32px;
            padding: 6px 14px;
            font-size: 0.85rem;
            font-weight: 500;
            white-space: nowrap;
        }

        /* 缩放 + 查找 + 复制 区（紧凑但可点） */
        .action-group {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
            background: #ffffffec;
            padding: 4px 14px;
            border-radius: 48px;
            border: 1px solid #e2e8f0;
        }

        .scale-slider {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .scale-slider input {
            width: 130px;
            cursor: pointer;
        }

        .search-box {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #fefce8;
           