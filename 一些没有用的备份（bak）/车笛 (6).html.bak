<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>车笛合成器 · 纯黑白 · SVG</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            background: #fff;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
            display: flex; justify-content: center; align-items: center;
            min-height: 100vh; padding: 1.5rem; color: #000;
        }
        .app {
            max-width: 800px; width: 100%;
            border: 2px solid #000; border-radius: 2rem;
            padding: 2rem 1.5rem 1.8rem;
            background: #fff; box-shadow: 0 8px 0 #000;
        }
        h1 {
            font-size: 1.8rem; font-weight: 600; text-align: center;
            border-bottom: 2px solid #000; padding-bottom: 1rem;
            margin-bottom: 2rem; text-transform: uppercase;
        }
        .grid {
            display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 1rem; margin-bottom: 2.2rem;
        }
        .car-btn {
            background: #fff; border: 2px solid #000; border-radius: 1.5rem;
            padding: 1.2rem 0.5rem; display: flex; flex-direction: column;
            align-items: center; justify-content: center; gap: 0.75rem;
            cursor: pointer; box-shadow: 0 4px 0 #000;
            color: #000; user-select: none; -webkit-tap-highlight-color: transparent;
            transition: all 0.05s ease-in-out;
        }
        .car-btn svg {
            width: 48px; height: 48px; stroke: #000; fill: none;
            stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round;
        }
        .car-btn span {
            font-size: 0.9rem; text-transform: uppercase;
            letter-spacing: 0.5px; font-weight: 600;
        }
        .car-btn:active {
            transform: translateY(4px); box-shadow: 0 0 0 #000;
        }
        .car-btn:focus-visible { outline: 2px solid #000; outline-offset: 3px; }

        .volume-panel {
            display: flex; align-items: center; justify-content: space-between;
            border-top: 2px solid #000; padding-top: 1.8rem;
            gap: 1.5rem; flex-wrap: wrap;
        }
        .volume-label {
            display: flex; align-items: center; gap: 0.6rem;
            font-weight: 600; text-transform: uppercase;
            font-size: 0.9rem; letter-spacing: 0.3px;
        }
        .volume-label svg {
            width: 24px; height: 24px; stroke: #000; fill: none;
            stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
        }
        .slider-container { flex: 1; min-width: 160px; display: flex; align-items: center; gap: 0.8rem; }
        input[type="range"] {
            -webkit-appearance: none; appearance: none; width: 100%; height: 6px;
            background: #fff; border: 2px solid #000; border-radius: 10px;
            outline: none; cursor: pointer;
        }
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none; appearance: none; width: 22px; height: 22px;
            background: #000; border-radius: 50%; cursor: pointer;
        }
        input[type="range"]::-moz-range-thumb {
            width: 20px; height: 20px; background: #000;
            border: 2px solid #000; border-radius: 50%; cursor: pointer;
        }
        .volume-value {
            font-weight: 600; font-size: 0.95rem; min-width: 3rem;
            text-align: right; font-variant-numeric: tabular-nums;
        }
        .status-note {
            font-size: 0.75rem; text-align: center; margin-top: 1.2rem;
            opacity: 0.65; border-top: 1px solid #ddd; padding-top: 1rem;
        }
        @media (max-width: 500px) {
            .app { padding: 1.2rem; }
            .car-btn svg { width: 36px; height: 36px; }
            .car-btn span { font-size: 0.75rem; }
            h1 { font-size: 1.4rem; }
        }
    </style>
</head>
<body>
    <div class="app">
        <h1>车笛合成器</h1>

        <div class="grid" id="carGrid">
            <button class="car-btn" data-car="sedan" aria-label="轿车喇叭">
                <svg viewBox="0 0 24 24">
                    <path d="M5 12L7 8L17 8L19 12"/>
                    <rect x="3" y="12" width="18" height="6" rx="2"/>
                    <circle cx="7.5" cy="18" r="1.5"/>
                    <circle cx="16.5" cy="18" r="1.5"/>
                </svg>
                <span>轿车</span>
            </button>

            <button class="car-btn" data-car="truck" aria-label="卡车喇叭">
                <svg viewBox="0 0 24 24">
                    <path d="M3 16L5 8L18 8L21 14L21 16L3 16Z"/>
                    <circle cx="7" cy="19" r="2"/>
                    <circle cx="17" cy="19" r="2"/>
                    <path d="M12 8L12 12"/>
                    <path d="M15 8L15 11"/>
                </svg>
                <span>卡车</span>
            </button>

            <button class="car-btn" data-car="train" aria-label="火车鸣笛">
                <svg viewBox="0 0 24 24">
                    <rect x="4" y="8" width="16" height="10" rx="1.5"/>
                    <circle cx="8" cy="18" r="1.8"/>
                    <circle cx="16" cy="18" r="1.8"/>
                    <path d="M8 8V6H16V8"/>
                    <path d="M12 4V2"/>
                    <path d="M6 12H18"/>
                </svg>
                <span>火车</span>
            </button>

            <button class="car-btn" data-car="ship" aria-label="轮船汽笛">
                <svg viewBox="0 0 24 24">
                    <path d="M3 16L5 12L19 12L21 16L3 16Z"/>
                    <path d="M12 12V8"/>
                    <path d="M9 8H15"/>
                    <circle cx="7" cy="19" r="1.5"/>
                    <circle cx="12" cy="19" r="1.5"/>
                    <circle cx="17" cy="19" r="1.5"/>
                </svg>
                <span>轮船</span>
            </button>

            <button class="car-btn" data-car="police" aria-label="警车警报">
                <svg viewBox="0 0 24 24">
                    <path d="M5 13L7 9L17 9L19 13"/>
                    <rect x="3" y="13" width="18" height="5" rx="1.5"/>
                    <circle cx="8" cy="18.5" r="1.8"/>
                    <circle cx="16" cy="18.5" r="1.8"/>
                    <path d="M12 3V7"/>
                    <path d="M10 5L14 5"/>
                </svg>
                <span>警车</span>
            </button>

            <button class="car-btn" data-car="ambulance" aria-label="救护车警报">
                <svg viewBox="0 0 24 24">
                    <rect x="3" y="9" width="18" height="8" rx="1.5"/>
                    <circle cx="7" cy="17.5" r="1.8"/>
                    <circle cx="17" cy="17.5" r="1.8"/>
                    <path d="M12 5V9"/>
                    <path d="M10 7H14"/>
                    <path d="M12 12V14"/>
                </svg>
                <span>救护车</span>
            </button>
        </div>

        <div class="volume-panel">
            <div class="volume-label">
                <svg viewBox="0 0 24 24">
                    <path d="M3 10V14H7L12 19V5L7 10H3Z"/>
                    <path d="M16 9C17.5 10.5 17.5 13.5 16 15"/>
                    <path d="M19 6C21.5 8.5 21.5 15.5 19 18"/>
                </svg>
                <span>音量</span>
            </div>
            <div class="slider-container">
                <input type="range" id="volumeSlider" min="0" max="1" step="0.01" value="0.7">
                <span class="volume-value" id="volumeValue">70%</span>
            </div>
        </div>

        <div class="status-note">点击车辆按钮 · 基于 Web Audio API 实时合成</div>
    </div>

    <script>
        (function() {
            let audioCtx = null;
            let masterGain = null;
            let currentVolume = 0.7;

            // 只负责创建 AudioContext，不负责 resume
            function getAudioContext() {
                if (audioCtx) return audioCtx;
                const AC = window.AudioContext || window.webkitAudioContext;
                if (!AC) return null;
                try {
                    audioCtx = new AC();
                    masterGain = audioCtx.createGain();
                    masterGain.gain.value = currentVolume;
                    masterGain.connect(audioCtx.destination);
                } catch (e) {
                    return null;
                }
                return audioCtx;
            }

            // 安全的包络：三角形，无中间保持段
            function playTone(freq, type, gainStart, gainEnd, startDelay, stopTime) {
                if (!audioCtx || !masterGain) return;
                const now = audioCtx.currentTime;
                const startAt = now + startDelay;
                const endAt = Math.max(startAt + 0.01, now + stopTime);

                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = type;
                osc.frequency.value = freq;

                const attack = Math.min(0.005, (endAt - startAt) * 0.3);

                gain.gain.setValueAtTime(0, startAt);
                gain.gain.linearRampToValueAtTime(gainStart, startAt + attack);
                gain.gain.linearRampToValueAtTime(gainEnd, endAt);

                osc.connect(gain);
                gain.connect(masterGain);
                osc.start(startAt);
                osc.stop(endAt + 0.02);
            }

            // 1. 轿车
            function playSedan() {
                playTone(840, 'sine', 0.6, 0.0, 0, 0.09);
                playTone(840, 'sine', 0.5, 0.0, 0.12, 0.20);
                playTone(1680, 'sine', 0.2, 0.0, 0, 0.09);
            }

            // 2. 卡车
            function playTruck() {
                playTone(220, 'square', 0.45, 0.0, 0.01, 0.12);
                playTone(220, 'square', 0.4, 0.0, 0.15, 0.26);
                playTone(110, 'sine', 0.35, 0.0, 0.01, 0.20);
                playTone(330, 'sawtooth', 0.15, 0.0, 0.02, 0.10);
            }

            // 3. 火车
            function playTrain() {
                if (!audioCtx || !masterGain) return;
                const now = audioCtx.currentTime;
                const osc1 = audioCtx.createOscillator();
                const osc2 = audioCtx.createOscillator();
                const g = audioCtx.createGain();
                osc1.type = 'sine'; osc2.type = 'sine';
                osc1.frequency.value = 180;
                osc2.frequency.value = 185;
                g.gain.setValueAtTime(0, now);
                g.gain.linearRampToValueAtTime(0.5, now + 0.1);
                g.gain.linearRampToValueAtTime(0, now + 1.0);
                osc1.connect(g); osc2.connect(g);
                g.connect(masterGain);
                osc1.start(now); osc2.start(now);
                osc1.stop(now + 1.05); osc2.stop(now + 1.05);
                playTone(360, 'sine', 0.15, 0.0, 0.05, 0.85);
            }

            // 4. 轮船
            function playShip() {
                if (!audioCtx || !masterGain) return;
                const now = audioCtx.currentTime;
                const osc1 = audioCtx.createOscillator();
                const osc2 = audioCtx.createOscillator();
                const g = audioCtx.createGain();
                osc1.type = 'sine'; osc2.type = 'sine';
                osc1.frequency.value = 110;
                osc2.frequency.value = 113;
                g.gain.setValueAtTime(0, now);
                g.gain.linearRampToValueAtTime(0.55, now + 0.2);
                g.gain.linearRampToValueAtTime(0, now + 1.5);
                osc1.connect(g); osc2.connect(g);
                g.connect(masterGain);
                osc1.start(now); osc2.start(now);
                osc1.stop(now + 1.55); osc2.stop(now + 1.55);
                playTone(220, 'sine', 0.2, 0.0, 0.2, 1.2);
            }

            // 5. 警车
            function playPolice() {
                playTone(950, 'sine', 0.5, 0.0, 0, 0.14);
                playTone(760, 'sine', 0.5, 0.0, 0.16, 0.28);
                playTone(950, 'sine', 0.5, 0.0, 0.30, 0.42);
                playTone(760, 'sine', 0.5, 0.0, 0.44, 0.56);
                playTone(980, 'square', 0.15, 0.0, 0, 0.12);
            }

            // 6. 救护车
            function playAmbulance() {
                if (!audioCtx || !masterGain) return;
                const now = audioCtx.currentTime;
                const osc = audioCtx.createOscillator();
                const g = audioCtx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(800, now);
                osc.frequency.linearRampToValueAtTime(1200, now + 0.25);
                osc.frequency.linearRampToValueAtTime(800, now + 0.5);
                osc.frequency.linearRampToValueAtTime(1200, now + 0.75);
                osc.frequency.linearRampToValueAtTime(800, now + 1.0);
                g.gain.setValueAtTime(0, now);
                g.gain.linearRampToValueAtTime(0.5, now + 0.05);
                g.gain.linearRampToValueAtTime(0, now + 1.05);
                osc.connect(g); g.connect(masterGain);
                osc.start(now); osc.stop(now + 1.1);
            }

            const soundMap = {
                sedan: playSedan, truck: playTruck, train: playTrain,
                ship: playShip, police: playPolice, ambulance: playAmbulance
            };

            // 音量
            const volumeSlider = document.getElementById('volumeSlider');
            const volumeValue = document.getElementById('volumeValue');
            function updateVolume() {
                const v = parseFloat(volumeSlider.value);
                volumeValue.textContent = Math.round(v * 100) + '%';
                currentVolume = v;
                if (masterGain && audioCtx) {
                    masterGain.gain.setTargetAtTime(v, audioCtx.currentTime, 0.02);
                }
            }
            volumeSlider.addEventListener('input', () => {
                getAudioContext();
                updateVolume();
            });
            volumeSlider.addEventListener('mousedown', () => {
                const ctx = getAudioContext();
                if (ctx && ctx.state === 'suspended') ctx.resume().catch(()=>{});
            });
            volumeSlider.addEventListener('touchstart', () => {
                const ctx = getAudioContext();
                if (ctx && ctx.state === 'suspended') ctx.resume().catch(()=>{});
            }, { passive: true });
            updateVolume();

            // ★★★ 核心修复：async + await resume 完成后再播放 ★★★
            document.getElementById('carGrid').addEventListener('click', async function(e) {
                const btn = e.target.closest('.car-btn');
                if (!btn) return;
                e.preventDefault();

                const ctx = getAudioContext();
                if (!ctx) return;

                // 等待 AudioContext 真正进入 running 状态
                if (ctx.state !== 'running') {
                    try {
                        await ctx.resume();
                    } catch (err) {
                        return;
                    }
                }
                // 再次确认
                if (ctx.state !== 'running') return;

                // 同步主音量
                if (masterGain) {
                    masterGain.gain.setTargetAtTime(currentVolume, ctx.currentTime, 0.02);
                }

                const fn = soundMap[btn.dataset.car];
                if (fn) fn();
            });

            document.getElementById('carGrid').addEventListener('touchstart', function(e) {
                if (e.target.closest('.car-btn')) e.preventDefault();
            }, { passive: false });

            // 页面加载时预创建 AudioContext（保持 suspended）
            getAudioContext();
        })();
    </script>
</body>
</html>