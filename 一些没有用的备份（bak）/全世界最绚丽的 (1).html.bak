<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>全世界最复杂、最绚丽的 ^_^</title>
  <style>
    /* 全局重置与基础样式 */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #000;
      overflow: hidden;
      font-family: 'Arial Black', 'Impact', 'Montserrat', sans-serif;
      color: white;
      width: 100vw;
      height: 100vh;
      position: relative;
      cursor: crosshair;
    }

    /* 主画布 - 背景粒子与光效层 */
    #canvas-container {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    canvas {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
    }

    /* 中央文字光环 - 多层复杂效果 */
    .central-aura {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      z-index: 100;
      pointer-events: none;
      text-align: center;
      filter: drop-shadow(0 0 30px rgba(0, 255, 255, 0.8)) drop-shadow(0 0 60px rgba(255, 0, 255, 0.6));
      animation: auraPulse 3s infinite alternate ease-in-out;
    }

    .main-text {
      font-size: clamp(4rem, 15vw, 12rem);
      font-weight: 900;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      background: linear-gradient(45deg, #ff00c8, #00ffff, #ffaa00, #ff00c8);
      background-size: 400% 400%;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: gradientShift 4s infinite linear, floatText 2s infinite alternate ease-in-out;
      text-shadow: 0 0 20px rgba(0, 255, 255, 0.5), 0 0 40px rgba(255, 0, 255, 0.3);
      position: relative;
      display: inline-block;
      transform-style: preserve-3d;
    }

    /* 多层叠加文字制造复杂光晕 */
    .main-text::before,
    .main-text::after {
      content: '^_^';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: inherit;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      opacity: 0.7;
      z-index: -1;
      filter: blur(8px);
    }

    .main-text::before {
      transform: translate(-2px, -2px);
      background: linear-gradient(45deg, #ff00ff, #00ffff);
      animation: glitchOffset 0.3s infinite alternate;
    }

    .main-text::after {
      transform: translate(2px, 2px);
      background: linear-gradient(45deg, #ffff00, #ff00ff);
      animation: glitchOffset 0.2s infinite alternate-reverse;
    }

    /* 旋转光环围绕文字 */
    .orbit-ring {
      position: fixed;
      top: 50%;
      left: 50%;
      width: 70vmin;
      height: 70vmin;
      border-radius: 50%;
      transform: translate(-50%, -50%);
      border: 2px dashed rgba(0, 255, 255, 0.4);
      box-shadow: 0 0 80px rgba(0, 255, 255, 0.3), inset 0 0 80px rgba(255, 0, 255, 0.2);
      animation: rotateRing 20s infinite linear;
      pointer-events: none;
      z-index: 50;
    }

    .orbit-ring2 {
      width: 90vmin;
      height: 90vmin;
      border: 1px solid rgba(255, 0, 255, 0.3);
      animation: rotateRing 30s infinite reverse linear;
      box-shadow: 0 0 120px rgba(255, 0, 255, 0.2);
    }

    .orbit-ring3 {
      width: 50vmin;
      height: 50vmin;
      border: 3px dotted rgba(255, 255, 0, 0.5);
      animation: rotateRing 15s infinite linear;
      box-shadow: 0 0 60px rgba(255, 255, 0, 0.4);
    }

    /* 浮动光球粒子 (纯CSS) */
    .particle-field {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 2;
      pointer-events: none;
      overflow: hidden;
    }

    .particle {
      position: absolute;
      width: 6px;
      height: 6px;
      background: radial-gradient(circle, #fff, #0ff);
      border-radius: 50%;
      filter: blur(1px);
      opacity: 0.7;
      animation: floatParticle 8s infinite ease-in-out;
      box-shadow: 0 0 20px cyan, 0 0 40px magenta;
    }

    /* 动态网格背景 (使用线性渐变和动画) */
    .grid-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: 
        linear-gradient(rgba(0, 255, 255, 0.1) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 0, 255, 0.1) 1px, transparent 1px);
      background-size: 40px 40px;
      z-index: 0;
      animation: gridPulse 5s infinite alternate;
      pointer-events: none;
    }

    /* 扫描线效果 */
    .scanlines {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(to bottom, transparent 50%, rgba(0, 0, 0, 0.3) 50%);
      background-size: 100% 4px;
      z-index: 200;
      pointer-events: none;
      opacity: 0.4;
      mix-blend-mode: overlay;
      animation: scanlineMove 0.5s infinite linear;
    }

    /* 噪点叠加 (通过base64或动画) */
    .noise-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: url('data:image/svg+xml;base64,');
      z-index: 150;
      pointer-events: none;
      opacity: 0.3;
      animation: noiseShift 0.2s infinite;
    }

    /* 底部流动光条 */
    .light-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, transparent, cyan, magenta, yellow, cyan, transparent);
      background-size: 300% 100%;
      z-index: 300;
      animation: barFlow 3s infinite linear;
      box-shadow: 0 0 30px cyan, 0 0 60px magenta;
      pointer-events: none;
    }

    /* 动画定义 */
    @keyframes auraPulse {
      0% { transform: translate(-50%, -50%) scale(1); filter: drop-shadow(0 0 30px cyan) drop-shadow(0 0 60px magenta); }
      100% { transform: translate(-50%, -50%) scale(1.05); filter: drop-shadow(0 0 50px magenta) drop-shadow(0 0 90px cyan); }
    }

    @keyframes gradientShift {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }

    @keyframes floatText {
      0% { transform: translateY(0) rotateX(0deg) rotateY(0deg); }
      100% { transform: translateY(-15px) rotateX(5deg) rotateY(5deg); }
    }

    @keyframes glitchOffset {
      0% { transform: translate(-3px, -2px); opacity: 0.5; }
      100% { transform: translate(3px, 2px); opacity: 0.8; }
    }

    @keyframes rotateRing {
      0% { transform: translate(-50%, -50%) rotate(0deg); }
      100% { transform: translate(-50%, -50%) rotate(360deg); }
    }

    @keyframes floatParticle {
      0% { transform: translateY(0) translateX(0) scale(1); opacity: 0.3; }
      25% { transform: translateY(-30px) translateX(20px) scale(1.5); opacity: 1; }
      50% { transform: translateY(-60px) translateX(-20px) scale(0.8); opacity: 0.8; }
      75% { transform: translateY(-30px) translateX(-40px) scale(1.2); opacity: 0.5; }
      100% { transform: translateY(0) translateX(0) scale(1); opacity: 0.3; }
    }

    @keyframes gridPulse {
      0% { opacity: 0.2; background-size: 40px 40px; }
      100% { opacity: 0.6; background-size: 60px 60px; }
    }

    @keyframes scanlineMove {
      0% { background-position: 0 0; }
      100% { background-position: 0 10px; }
    }

    @keyframes noiseShift {
      0% { transform: translate(0, 0); }
      100% { transform: translate(5%, 5%); }
    }

    @keyframes barFlow {
      0% { background-position: 0% 0; }
      100% { background-position: 300% 0; }
    }

    /* 响应式调整 */
    @media (max-width: 768px) {
      .main-text {
        letter-spacing: 0.1em;
      }
      .orbit-ring {
        width: 90vmin;
        height: 90vmin;
      }
      .orbit-ring2 {
        width: 110vmin;
        height: 110vmin;
      }
      .orbit-ring3 {
        width: 70vmin;
        height: 70vmin;
      }
    }
  </style>
</head>
<body>
  <!-- 动态网格背景 -->
  <div class="grid-overlay"></div>

  <!-- 粒子容器 (JavaScript会动态添加更多粒子) -->
  <div class="particle-field" id="particle-field"></div>

  <!-- 主画布容器 (用于复杂的Canvas动画: 粒子网络、光流、波形等) -->
  <div id="canvas-container">
    <canvas id="main-canvas"></canvas>
  </div>

  <!-- 中央文字光环 -->
  <div class="central-aura">
    <div class="main-text">^_^</div>
  </div>

  <!-- 旋转光环 -->
  <div class="orbit-ring"></div>
  <div class="orbit-ring orbit-ring2"></div>
  <div class="orbit-ring orbit-ring3"></div>

  <!-- 扫描线和噪点效果 -->
  <div class="scanlines"></div>
  <div class="noise-overlay"></div>

  <!-- 底部光条 -->
  <div class="light-bar"></div>

  <script>
    (function() {
      // ---------- 1. Canvas 复杂粒子网络 + 光流效果 ----------
      const canvas = document.getElementById('main-canvas');
      const ctx = canvas.getContext('2d');
      let width, height;
      let particles = [];
      const PARTICLE_COUNT = 180;
      const MAX_DISTANCE = 200;
      const mouse = { x: null, y: null, radius: 180 };

      // 鼠标移动追踪
      window.addEventListener('mousemove', (e) => {
        mouse.x = e.clientX;
        mouse.y = e.clientY;
      });

      window.addEventListener('mouseout', () => {
        mouse.x = null;
        mouse.y = null;
      });

      // 尺寸调整
      function resizeCanvas() {
        width = window.innerWidth;
        height = window.innerHeight;
        canvas.width = width;
        canvas.height = height;
        // 重新初始化粒子位置
        initParticles();
      }

      // 粒子类
      class Particle {
        constructor() {
          this.x = Math.random() * width;
          this.y = Math.random() * height;
          this.vx = (Math.random() - 0.5) * 1.8;
          this.vy = (Math.random() - 0.5) * 1.8;
          this.size = Math.random() * 3 + 2;
          // 随机颜色: 青色到洋红到黄色
          const hue = Math.random() * 360;
          this.color = `hsl(${hue}, 100%, 65%)`;
          this.originalColor = this.color;
          // 脉动相位
          this.phase = Math.random() * Math.PI * 2;
        }

        update() {
          // 边界反弹
          if (this.x < 0 || this.x > width) this.vx *= -1;
          if (this.y < 0 || this.y > height) this.vy *= -1;

          // 移动
          this.x += this.vx;
          this.y += this.vy;

          // 鼠标交互
          if (mouse.x !== null && mouse.y !== null) {
            const dx = this.x - mouse.x;
            const dy = this.y - mouse.y;
            const dist = Math.sqrt(dx * dx + dy * dy);
            if (dist < mouse.radius) {
              // 推离效果
              const angle = Math.atan2(dy, dx);
              const force = (mouse.radius - dist) / mouse.radius;
              const pushX = Math.cos(angle) * force * 4;
              const pushY = Math.sin(angle) * force * 4;
              this.x += pushX;
              this.y += pushY;
            }
          }

          // 脉动大小
          this.phase += 0.02;
          this.currentSize = this.size + Math.sin(this.phase) * 1.5;
        }

        draw() {
          ctx.beginPath();
          ctx.arc(this.x, this.y, this.currentSize, 0, Math.PI * 2);
          // 发光效果
          ctx.shadowColor = this.color;
          ctx.shadowBlur = 15;
          ctx.fillStyle = this.color;
          ctx.fill();
          // 重置阴影避免影响连线
          ctx.shadowBlur = 0;
        }
      }

      function initParticles() {
        particles = [];
        for (let i = 0; i < PARTICLE_COUNT; i++) {
          particles.push(new Particle());
        }
      }

      // 绘制连线 (基于距离，颜色渐变)
      function drawLines() {
        for (let i = 0; i < particles.length; i++) {
          for (let j = i + 1; j < particles.length; j++) {
            const p1 = particles[i];
            const p2 = particles[j];
            const dx = p1.x - p2.x;
            const dy = p1.y - p2.y;
            const distance = Math.sqrt(dx * dx + dy * dy);

            if (distance < MAX_DISTANCE) {
              // 距离越近越亮，颜色混合
              const opacity = 1 - (distance / MAX_DISTANCE);
              // 使用两个粒子的颜色混合？为了简单，使用青-品红的渐变
              const gradient = ctx.createLinearGradient(p1.x, p1.y, p2.x, p2.y);
              gradient.addColorStop(0, `rgba(0, 255, 255, ${opacity * 0.8})`);
              gradient.addColorStop(0.5, `rgba(255, 0, 255, ${opacity * 0.6})`);
              gradient.addColorStop(1, `rgba(255, 255, 0, ${opacity * 0.8})`);
              
              ctx.beginPath();
              ctx.moveTo(p1.x, p1.y);
              ctx.lineTo(p2.x, p2.y);
              ctx.strokeStyle = gradient;
              ctx.lineWidth = 1.2;
              ctx.shadowBlur = 0;
              ctx.stroke();
            }
          }
        }
      }

      // 绘制动态光流/波形 (额外复杂效果)
      let time = 0;
      function drawWaves() {
        time += 0.01;
        const waveCount = 5;
        for (let w = 0; w < waveCount; w++) {
          ctx.beginPath();
          const amplitude = 60 + w * 20;
          const frequency = 0.002 + w * 0.001;
          const yOffset = height / 2 + Math.sin(time + w) * 80;
          
          for (let x = 0; x < width; x += 5) {
            const y = yOffset + Math.sin(x * frequency + time * 2 + w) * amplitude * Math.sin(time * 0.5 + w);
            if (x === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          }
          
          const hue = (time * 30 + w * 60) % 360;
          ctx.strokeStyle = `hsla(${hue}, 100%, 60%, 0.3)`;
          ctx.lineWidth = 2 + w * 0.5;
          ctx.shadowBlur = 20;
          ctx.shadowColor = `hsl(${hue}, 100%, 50%)`;
          ctx.stroke();
        }
        ctx.shadowBlur = 0;
      }

      // 鼠标位置绘制光晕圆环
      function drawMouseGlow() {
        if (mouse.x !== null && mouse.y !== null) {
          const gradient = ctx.createRadialGradient(mouse.x, mouse.y, 0, mouse.x, mouse.y, mouse.radius);
          gradient.addColorStop(0, 'rgba(0, 255, 255, 0.3)');
          gradient.addColorStop(0.5, 'rgba(255, 0, 255, 0.15)');
          gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');
          
          ctx.beginPath();
          ctx.arc(mouse.x, mouse.y, mouse.radius, 0, Math.PI * 2);
          ctx.fillStyle = gradient;
          ctx.fill();
          
          // 额外的小圆环
          ctx.beginPath();
          ctx.arc(mouse.x, mouse.y, mouse.radius * 0.3, 0, Math.PI * 2);
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.5)';
          ctx.lineWidth = 2;
          ctx.shadowBlur = 30;
          ctx.shadowColor = 'cyan';
          ctx.stroke();
          ctx.shadowBlur = 0;
        }
      }

      // 主动画循环
      function animate() {
        // 使用半透明黑色制造拖尾效果
        ctx.fillStyle = 'rgba(0, 0, 0, 0.15)';
        ctx.fillRect(0, 0, width, height);
        
        // 绘制动态光波
        drawWaves();
        
        // 更新并绘制粒子
        particles.forEach(p => {
          p.update();
          p.draw();
        });
        
        // 绘制粒子之间的连线
        drawLines();
        
        // 绘制鼠标光晕
        drawMouseGlow();
        
        // 绘制额外的中心能量环 (让中心更亮)
        const centerX = width / 2;
        const centerY = height / 2;
        const pulse = Math.sin(time * 3) * 20;
        const radialGrad = ctx.createRadialGradient(centerX, centerY, 50, centerX, centerY, 300 + pulse);
        radialGrad.addColorStop(0, 'rgba(0, 255, 255, 0.15)');
        radialGrad.addColorStop(0.7, 'rgba(255, 0, 255, 0.08)');
        radialGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.beginPath();
        ctx.arc(centerX, centerY, 350 + pulse, 0, Math.PI * 2);
        ctx.fillStyle = radialGrad;
        ctx.fill();
        
        requestAnimationFrame(animate);
      }

      // 初始化并开始
      window.addEventListener('resize', resizeCanvas);
      resizeCanvas();
      animate();

      // ---------- 2. 额外CSS粒子生成 (动态添加span) ----------
      const particleField = document.getElementById('particle-field');
      const CSS_PARTICLE_COUNT = 60;
      for (let i = 0; i < CSS_PARTICLE_COUNT; i++) {
        const particle = document.createElement('div');
        particle.classList.add('particle');
        // 随机位置、大小、动画延迟、持续时间
        const size = Math.random() * 8 + 2;
        particle.style.width = size + 'px';
        particle.style.height = size + 'px';
        particle.style.left = Math.random() * 100 + '%';
        particle.style.top = Math.random() * 100 + '%';
        particle.style.animationDelay = Math.random() * 8 + 's';
        particle.style.animationDuration = (Math.random() * 5 + 5) + 's';
        // 随机颜色
        const colors = ['cyan', 'magenta', 'yellow', 'white', '#00ffff', '#ff00ff'];
        const color = colors[Math.floor(Math.random() * colors.length)];
        particle.style.background = `radial-gradient(circle, #fff, ${color})`;
        particle.style.boxShadow = `0 0 20px ${color}, 0 0 40px ${color}`;
        particleField.appendChild(particle);
      }

      // ---------- 3. 鼠标交互添加小星星粒子 (点击效果) ----------
      window.addEventListener('click', (e) => {
        // 在点击位置生成几个快速的闪光粒子
        for (let i = 0; i < 12; i++) {
          const spark = document.createElement('div');
          spark.style.position = 'fixed';
          spark.style.width = '8px';
          spark.style.height = '8px';
          spark.style.borderRadius = '50%';
          spark.style.background = `hsl(${Math.random() * 360}, 100%, 70%)`;
          spark.style.left = e.clientX + 'px';
          spark.style.top = e.clientY + 'px';
          spark.style.pointerEvents = 'none';
          spark.style.zIndex = '999';
          spark.style.boxShadow = '0 0 30px currentColor';
          spark.style.transition = 'transform 0.8s ease-out, opacity 0.8s ease-out';
          document.body.appendChild(spark);
          
          // 随机方向移动
          const angle = Math.random() * Math.PI * 2;
          const distance = Math.random() * 100 + 50;
          const tx = Math.cos(angle) * distance;
          const ty = Math.sin(angle) * distance;
          
          requestAnimationFrame(() => {
            spark.style.transform = `translate(${tx}px, ${ty}px) scale(0)`;
            spark.style.opacity = '0';
          });
          
          // 清理
          setTimeout(() => {
            spark.remove();
          }, 1000);
        }
      });

      // 添加一点键盘交互彩蛋：按任意键改变背景色相 (轻微)
      window.addEventListener('keydown', (e) => {
        // 不干扰，只是增加一点动态感
        document.body.style.filter = `hue-rotate(${Math.random() * 30}deg)`;
        setTimeout(() => {
          document.body.style.filter = '';
        }, 300);
      });

      // 页面加载完成后，添加一个起始的闪光效果
      window.addEventListener('load', () => {
        document.body.style.opacity = '0';
        setTimeout(() => {
          document.body.style.transition = 'opacity 1.5s';
          document.body.style.opacity = '1';
        }, 100);
      });
    })();
  </script>
</body>
</html>