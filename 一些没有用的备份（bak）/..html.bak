<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>3D 绿色 01 代码 · 纯净视角</title>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            background-color: black;
            font-family: 'Courier New', monospace;
            touch-action: none; /* 阻止触摸滚动/缩放，保留手势控制 */
        }
        canvas {
            display: block;
            width: 100vw;
            height: 100vh;
            background: black;
        }
        /* 完全无提示，无多余元素 */
    </style>
</head>
<body>
    <canvas id="codefield"></canvas>

    <script>
        (function() {
            const canvas = document.getElementById('codefield');
            const ctx = canvas.getContext('2d');

            // ---------- 尺寸适配 ----------
            let width, height;
            function resize() {
                width = window.innerWidth;
                height = window.innerHeight;
                canvas.width = width;
                canvas.height = height;
            }
            window.addEventListener('resize', resize);
            resize();

            // ---------- 01 代码粒子参数 ----------
            const PARTICLE_COUNT = 1200;          // 数量适中，移动端流畅
            const SPREAD = 1200;                  // 分布半径
            const MIN_SIZE = 5;                 // 字体最小尺寸（相对于投影后的缩放）
            const MAX_SIZE = 10;                 // 字体最大尺寸

            // 数字纹理缓存：预渲染 '0' 和 '1' 的离屏 canvas，提升性能
            const digitTextures = {};
            function createDigitTexture(digit) {
                const off = document.createElement('canvas');
                off.width = 64;
                off.height = 64;
                const octx = off.getContext('2d');
                
                octx.clearRect(0, 0, 64, 64);
                octx.font = 'bold 52px "Courier New", monospace';
                octx.textAlign = 'center';
                octx.textBaseline = 'middle';
                octx.fillStyle = '#00ff00';
                octx.shadowColor = '#00ff00';
                octx.shadowBlur = 15;
                octx.fillText(digit, 32, 32);
                octx.shadowBlur = 25;
                octx.fillText(digit, 32, 32);
                
                return off;
            }
            digitTextures['0'] = createDigitTexture('0');
            digitTextures['1'] = createDigitTexture('1');

            // 粒子数据：每个粒子包含 3D 坐标 (x,y,z)、大小、数字类型、闪烁参数
            const particles = [];
            for (let i = 0; i < PARTICLE_COUNT; i++) {
                // 在球壳内均匀分布，产生深度感
                const radius = SPREAD * (0.3 + 0.7 * Math.random()); // 从近到远
                const theta = Math.random() * Math.PI * 2;
                const phi = Math.acos(2 * Math.random() - 1);

                const x = radius * Math.sin(phi) * Math.cos(theta);
                const y = radius * Math.sin(phi) * Math.sin(theta);
                const z = radius * Math.cos(phi);

                // 随机大小，远处的粒子稍微小一点
                const baseSize = MIN_SIZE + Math.random() * (MAX_SIZE - MIN_SIZE);
                const distanceFactor = 0.6 + 0.4 * (radius / SPREAD);
                const size = baseSize * distanceFactor * (1 - 0.3 * (radius / SPREAD));

                // 随机选择数字 '0' 或 '1'，0 稍多一点
                const digit = Math.random() < 0.55 ? '0' : '1';

                particles.push({
                    x, y, z,
                    size: Math.max(0.6, size),
                    digit: digit,
                    // 用于微动态闪烁
                    twinkleSpeed: 0.5 + Math.random() * 1.5,
                    twinkleOffset: Math.random() * 100,
                    // 颜色微调（绿色色相轻微变化）
                    g: 0.8 + Math.random() * 0.4
                });
            }

            // ---------- 视角控制 ----------
            // 使用球坐标旋转：水平角 (azimuth) 和 仰角 (pitch)
            let azimuth = 0;      // 水平旋转 (弧度)
            let pitch = 0.2;      // 垂直旋转 (弧度)，初始稍微仰视

            // 触摸/鼠标拖拽状态
            let isDragging = false;
            let lastX = 0, lastY = 0;

            // 设备方向 (陀螺仪)
            let beta = 0;         // 前后倾斜 (-180 ~ 180)
            let gamma = 0;        // 左右倾斜 (-90 ~ 90)
            let isDeviceOrientationSupported = false;
            let deviceOrientationInitialized = false;

            // 平滑系数 (使陀螺仪变化更柔和)
            const SMOOTH_FACTOR = 0.12;

            // 基准值（首次收到陀螺仪数据时记录，实现相对视角）
            let baseBeta = null;
            let baseGamma = null;

            // ---------- 鼠标/触摸事件绑定 ----------
            function getEventPos(e) {
                if (e.touches) {
                    return { x: e.touches[0].clientX, y: e.touches[0].clientY };
                }
                return { x: e.clientX, y: e.clientY };
            }

            function onPointerDown(e) {
                isDragging = true;
                const pos = getEventPos(e);
                lastX = pos.x;
                lastY = pos.y;
                window.ignoreGyro = true;
            }

            function onPointerMove(e) {
                if (!isDragging) return;
                e.preventDefault(); // 防止滚动

                const pos = getEventPos(e);
                const dx = pos.x - lastX;
                const dy = pos.y - lastY;

                // 灵敏度
                const sensitivity = 0.006;
                azimuth -= dx * sensitivity;
                pitch += dy * sensitivity;

                // 限制 pitch 范围避免翻转
                pitch = Math.max(-1.2, Math.min(1.2, pitch));

                lastX = pos.x;
                lastY = pos.y;
            }

            function onPointerUp(e) {
                if (isDragging) {
                    isDragging = false;
                    // 松开后允许陀螺仪控制
                    window.ignoreGyro = false;
                }
            }

            // 鼠标事件
            canvas.addEventListener('mousedown', onPointerDown);
            window.addEventListener('mousemove', onPointerMove);
            window.addEventListener('mouseup', onPointerUp);

            // 触摸事件
            canvas.addEventListener('touchstart', onPointerDown, { passive: false });
            window.addEventListener('touchmove', onPointerMove, { passive: false });
            window.addEventListener('touchend', onPointerUp, { passive: false });
            window.addEventListener('touchcancel', onPointerUp, { passive: false });

            // 防止右键菜单
            canvas.addEventListener('contextmenu', (e) => e.preventDefault());

            // ---------- 设备方向 (陀螺仪) ----------
            function handleDeviceOrientation(event) {
                if (window.ignoreGyro) return;

                // 获取 beta (前后倾斜) 和 gamma (左右倾斜)
                let b = event.beta;    // -180 ~ 180, 前后
                let g = event.gamma;   // -90 ~ 90, 左右

                if (b === null || g === null) return;

                // 首次收到数据时记录基准值（实现相对视角）
                if (baseBeta === null) {
                    baseBeta = b;
                    baseGamma = g;
                }

                // 计算相对于基准值的偏移量
                b = b - baseBeta;
                g = g - baseGamma;

                // 限制范围
                b = Math.max(-90, Math.min(90, b));
                g = Math.max(-90, Math.min(90, g));

                // 将设备方向映射到 azimuth 和 pitch
                // gamma: 左右倾斜 => 水平旋转 (azimuth)
                // beta: 前后倾斜 => 垂直旋转 (pitch)
                const targetAzimuth = (g / 90) * Math.PI * 0.8; 
                const targetPitch = (b / 90) * 0.9; 

                // 平滑更新 (避免突兀)
                azimuth += (targetAzimuth - azimuth) * SMOOTH_FACTOR;
                pitch += (targetPitch - pitch) * SMOOTH_FACTOR;

                // 限制 pitch
                pitch = Math.max(-1.2, Math.min(1.2, pitch));
            }

            // 检测是否支持 DeviceOrientation
            if (window.DeviceOrientationEvent) {
                // 对于 iOS 13+ 需要请求权限
                if (typeof DeviceOrientationEvent.requestPermission === 'function') {
                    // 需要用户手势触发，这里监听一次点击
                    const requestPermission = () => {
                        DeviceOrientationEvent.requestPermission()
                            .then(state => {
                                if (state === 'granted') {
                                    window.addEventListener('deviceorientation', handleDeviceOrientation);
                                    isDeviceOrientationSupported = true;
                                }
                            })
                            .catch(() => {});
                    };
                    window.addEventListener('click', requestPermission, { once: true });
                    window.addEventListener('touchstart', requestPermission, { once: true });
                } else {
                    // 非 iOS 或旧版本
                    window.addEventListener('deviceorientation', handleDeviceOrientation);
                    isDeviceOrientationSupported = true;
                }
            }

            // ---------- 渲染 ----------
            let lastTime = performance.now();
            
            function draw(now) {
                const deltaTime = (now - lastTime) / 1000;
                lastTime = now;
                const time = now * 0.001; // 秒为单位

                ctx.clearRect(0, 0, width, height);

                // 计算旋转矩阵
                const cosA = Math.cos(azimuth);
                const sinA = Math.sin(azimuth);
                const cosP = Math.cos(pitch);
                const sinP = Math.sin(pitch);

                // 投影参数
                const focalLength = 500;  // 类似焦距，控制透视强度

                // 遍历所有粒子
                for (let i = 0; i < particles.length; i++) {
                    const p = particles[i];
                    // 原始坐标
                    let x = p.x;
                    let y = p.y;
                    let z = p.z;

                    // 应用旋转：先绕 Y 轴 (azimuth)，再绕 X 轴 (pitch)
                    // 绕 Y 轴旋转
                    let x1 = x * cosA - z * sinA;
                    let z1 = x * sinA + z * cosA;
                    let y1 = y;

                    // 绕 X 轴旋转 (pitch)
                    let y2 = y1 * cosP - z1 * sinP;
                    let z2 = y1 * sinP + z1 * cosP;
                    let x2 = x1;

                    // 透视投影
                    if (z2 < 10) z2 = 10; // 避免除以零或过近
                    const scale = focalLength / z2;
                    const screenX = width / 2 + x2 * scale;
                    const screenY = height / 2 - y2 * scale; // Y轴翻转

                    // 根据距离调整大小 (z2 越大越远，粒子越小)
                    const sizeFactor = Math.max(0.3, Math.min(1.8, 500 / z2));
                    const finalSize = p.size * sizeFactor * 0.8;

                    // 裁剪：只绘制在屏幕内的粒子 (优化性能)
                    if (screenX < -50 || screenX > width + 50 || screenY < -50 || screenY > height + 50) continue;

                    // 计算透明度（远处稍暗，并加入闪烁效果）
                    const baseAlpha = Math.min(1, 0.7 + 0.3 * (z2 / SPREAD));
                    const twinkle = 0.85 + 0.15 * Math.sin(time * p.twinkleSpeed * 3 + p.twinkleOffset);
                    const alpha = baseAlpha * twinkle;

                    // 获取对应的数字纹理
                    const texture = digitTextures[p.digit];
                    
                    // 绘制数字（使用离屏 canvas 作为纹理）
                    const drawSize = Math.max(2, finalSize * 6); // 调整大小比例
                    ctx.globalAlpha = alpha;
                    ctx.drawImage(
                        texture, 
                        screenX - drawSize / 2, 
                        screenY - drawSize / 2, 
                        drawSize, 
                        drawSize
                    );
                }
                
                ctx.globalAlpha = 1.0;

                requestAnimationFrame(draw);
            }

            requestAnimationFrame(draw);

            // 窗口尺寸变化重置
            window.addEventListener('resize', () => {
                resize();
            });

            console.log('3D 绿色 01 代码已启动 · 纯净无提示');
        })();
    </script>
</body>
</html>