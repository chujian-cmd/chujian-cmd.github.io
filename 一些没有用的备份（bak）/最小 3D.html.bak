<script type=module>import*as T from'https://esm.run/three';import{OrbitControls as O}from'https://esm.run/three/examples/jsm/controls/OrbitControls';let r=new T.WebGLRenderer,s=new T.Scene,c=new T.PerspectiveCamera(50,innerWidth/innerHeight,.1,99),g=new T.BoxGeometry;r.setSize(innerWidth,innerHeight),document.body.append(r.domElement),s.background=new T.Color(0x222),s.add(new T.Mesh(g,new T.MeshBasicMaterial({color:0x4a8})),new T.LineSegments(new T.EdgesGeometry(g))),c.position.z=3,new O(c,r.domElement),r.setAnimationLoop(_=>r.render(s,c))</script>