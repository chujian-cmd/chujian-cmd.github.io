<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <!-- 强制锁定亮色模式，避免手机强改反色 -->
  <meta name="color-scheme" content="light only">
  <title>极简设置面板</title>
  <style>
    :root {
      color-scheme: light only;
      forced-color-adjust: none;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: #FFFFFF;
      font-family: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      color: #000000;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 16px;
      line-height: 1.5;
    }

    .panel {
      max-width: 480px;
      width: 100%;
      background-color: #FFFFFF;
      border: 1px solid #E5E5E5;
      border-radius: 4px;
      padding: 24px 20px 20px 20px;
    }

    .header {
      margin-bottom: 24px;
    }

    .title {
      font-size: 20px;
      font-weight: 600;
      color: #000000;
      margin-bottom: 6px;
    }

    .subtitle {
      font-size: 14px;
      color: #666666;
    }

    .settings-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 28px;
    }

    .setting-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 0;
      border-bottom: 1px solid #E5E5E5;
    }

    .setting-item:last-child {
      border-bottom: none;
    }

    .setting-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .icon-wrapper {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      color: #000000;
    }

    .icon-wrapper svg {
      width: 22px;
      height: 22px;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .setting-label {
      font-size: 15px;
      font-weight: 500;
      color: #000000;
    }

    .switch {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      width: 48px;
      height: 28px;
      flex-shrink: 0;
    }

    .switch svg {
      width: 48px;
      height: 28px;
      display: block;
    }

    .actions {
      display: flex;
      gap: 12px;
      margin-bottom: 20px;
    }

    .btn {
      flex: 1;
      padding: 10px 16px;
      font-size: 14px;
      font-weight: 500;
      font-family: inherit;
      border-radius: 4px;
      border: 1px solid #E5E5E5;
      background: #FFFFFF;
      color: #000000;
      cursor: pointer;
      transition: all 0.1s ease;
    }

    .btn-primary {
      background: #000000;
      color: #FFFFFF;
      border-color: #000000;
    }

    .btn-primary:active {
      background: #333333;
    }

    .btn-secondary:active {
      background: #F5F5F5;
    }

    .status-bar {
      display: flex;
      align-items: center;
      gap: 12px;
      background-color: #F5F5F5;
      border: 1px solid #E5E5E5;
      border-radius: 4px;
      padding: 12px 14px;
      font-size: 14px;
      color: #333333;
    }

    .status-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 20px;
      height: 20px;
      flex-shrink: 0;
      color: #000000;
    }

    .status-icon svg {
      width: 20px;
      height: 20px;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
    }
  </style>
</head>
<body>

<div class="panel" id="app-panel">
  <!-- 页面主体将由脚本根据 CONFIG 注入 -->
  <div id="app-root"></div>
</div>

<script>
  // ==================== 统一配置对象 ====================
  const CONFIG = {
    title: "极简设置",
    subtitle: "管理面板偏好与通知",
    
    switches: [
      { id: "sync", label: "自动同步", iconType: "sync", initialOn: true },
      { id: "notifications", label: "通知提醒", iconType: "bell", initialOn: false },
      { id: "darkmode", label: "深色模式预览", iconType: "moon", initialOn: false }
    ],

    primaryButtonText: "应用更改",
    secondaryButtonText: "重置",
    
    statusIconType: "info",
    statusText: "所有设置已保存至本地",
    
    style: {
      strokeWidth: 1.5
    }
  };

  // ==================== 渲染与交互逻辑 ====================
  // 定义 SVG 图标生成函数（防止模板字符串语法错误导致崩溃）
  function getIconSvg(type) {
    const sw = CONFIG.style.strokeWidth;
    const common = 'fill="none" stroke="currentColor" stroke-width="' + sw + '" stroke-linecap="round" stroke-linejoin="round"';
    if (type === 'sync') {
      return '<svg viewBox="0 0 24 24" aria-hidden="true" ' + common + '><path d="M21 12a9 9 0 0 1-9 9m9-9a9 9 0 0 0-9-9m9 9h-3m-6 9a9 9 0 0 1-9-9m9 9v-3m-9-6a9 9 0 0 1 9-9m-9 9h3"/></svg>';
    } else if (type === 'bell') {
      return '<svg viewBox="0 0 24 24" aria-hidden="true" ' + common + '><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>';
    } else if (type === 'moon') {
      return '<svg viewBox="0 0 24 24" aria-hidden="true" ' + common + '><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';
    } else {
      return '<svg viewBox="0 0 24 24" aria-hidden="true" ' + common + '><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>';
    }
  }

  function getSwitchSvg(isOn) {
    const sw = CONFIG.style.strokeWidth;
    const trackFill = isOn ? '#000000' : '#FFFFFF';
    const knobFill = isOn ? '#FFFFFF' : '#000000';
    const knobCx = isOn ? 34 : 14;
    return '<svg viewBox="0 0 48 28" aria-hidden="true"><rect x="0" y="0" width="48" height="28" rx="14" fill="' + trackFill + '" stroke="#000000" stroke-width="' + sw + '" /><circle cx="' + knobCx + '" cy="14" r="10" fill="' + knobFill + '" /></svg>';
  }

  // 页面加载完成后执行渲染
  document.addEventListener('DOMContentLoaded', function() {
    var root = document.getElementById('app-root');
    if (!root) return;

    var html = '';

    // 1. 标题区
    html += '<div class="header">';
    html += '<div class="title">' + CONFIG.title + '</div>';
    html += '<div class="subtitle">' + CONFIG.subtitle + '</div>';
    html += '</div>';

    // 2. 开关列表区
    html += '<div class="settings-list">';
    for (var i = 0; i < CONFIG.switches.length; i++) {
      var swItem = CONFIG.switches[i];
      var isOn = swItem.initialOn;
      html += '<div class="setting-item" data-switch-id="' + swItem.id + '" data-state="' + isOn + '">';
      html += '  <div class="setting-left">';
      html += '    <div class="icon-wrapper">' + getIconSvg(swItem.iconType) + '</div>';
      html += '    <span class="setting-label">' + swItem.label + '</span>';
      html += '  </div>';
      html += '  <div class="switch" role="switch" aria-checked="' + isOn + '" aria-label="' + swItem.label + '" tabindex="0" data-switch-index="' + i + '">';
      html += getSwitchSvg(isOn);
      html += '  </div>';
      html += '</div>';
    }
    html += '</div>';

    // 3. 操作栏
    html += '<div class="actions">';
    html += '<button class="btn btn-secondary" id="secondaryBtn">' + CONFIG.secondaryButtonText + '</button>';
    html += '<button class="btn btn-primary" id="primaryBtn">' + CONFIG.primaryButtonText + '</button>';
    html += '</div>';

    // 4. 状态提示条
    html += '<div class="status-bar" id="statusBar">';
    html += '<div class="status-icon">' + getIconSvg(CONFIG.statusIconType) + '</div>';
    html += '<span class="status-text" id="statusText">' + CONFIG.statusText + '</span>';
    html += '</div>';

    // 注入 DOM
    root.innerHTML = html;

    // --- 交互逻辑 ---
    function setStatus(msg) {
      var statusTextEl = document.getElementById('statusText');
      if (statusTextEl) statusTextEl.textContent = msg;
    }

    function updateSwitchElement(switchElement, newState) {
      var settingItem = switchElement.closest('.setting-item');
      if (!settingItem) return;
      switchElement.innerHTML = getSwitchSvg(newState);
      switchElement.setAttribute('aria-checked', newState);
      settingItem.dataset.state = newState;
    }

    // 绑定开关
    var allSwitches = document.querySelectorAll('.switch');
    for (var j = 0; j < allSwitches.length; j++) {
      (function(index) {
        var switchEl = allSwitches[index];
        switchEl.addEventListener('click', function(e) {
          e.stopPropagation();
          var settingItem = switchEl.closest('.setting-item');
          var currentState = settingItem.dataset.state === 'true';
          var newState = !currentState;
          updateSwitchElement(switchEl, newState);
          setStatus('设置 "' + (CONFIG.switches[index] ? CONFIG.switches[index].label : '选项') + '" 已' + (newState ? '开启' : '关闭'));
        });

        switchEl.addEventListener('keydown', function(e) {
          if (e.key === ' ' || e.key === 'Enter') {
            e.preventDefault();
            switchEl.click();
          }
        });
      })(j);
    }

    // 绑定按钮
    var secondaryBtn = document.getElementById('secondaryBtn');
    if (secondaryBtn) {
      secondaryBtn.addEventListener('click', function() {
        for (var k = 0; k < CONFIG.switches.length; k++) {
          var switchEl = document.querySelector('.switch[data-switch-index="' + k + '"]');
          if (switchEl) {
            var settingItem = switchEl.closest('.setting-item');
            if (settingItem) {
              settingItem.dataset.state = CONFIG.switches[k].initialOn;
              updateSwitchElement(switchEl, CONFIG.switches[k].initialOn);
            }
          }
        }
        setStatus("设置已重置为默认值");
      });
    }

    var primaryBtn = document.getElementById('primaryBtn');
    if (primaryBtn) {
      primaryBtn.addEventListener('click', function() {
        setStatus("更改已应用。所有设置已保存。");
      });
    }
  });
</script>

</body>
</html>