<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>指针拖拽测试</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { overflow: hidden; background: #000; color: #fff; font-family: sans-serif; }

        /* 顶部滑动容器 */
        #pages {
            display: flex;
            width: 100vw;
            height: 100vh;
            overflow-x: auto;
            overflow-y: hidden;
            /* 开启吸附，让松手后能自动对齐 */
            scroll-snap-type: x mandatory;
            scroll-behavior: smooth;
            scrollbar-width: none; 
        }
        #pages::-webkit-scrollbar { display: none; }

        /* 每一页 */
        .page {
            flex: 0 0 100vw;
            width: 100vw;
            height: 100vh;
            scroll-snap-align: center;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 40px;
            font-weight: bold;
        }
        .page:nth-child(1) { background: linear-gradient(135deg, #ff4757, #ff6b81); }
        .page:nth-child(2) { background: linear-gradient(135deg, #2ed573, #7bed9f); }
        .page:nth-child(3) { background: linear-gradient(135deg, #1e90ff, #70a1ff); }

        /* 底部控制条大容器 */
        #control-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 80px;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 10;
            
            /* 关键防御：禁用所有浏览器默认手势 */
            touch-action: none; 
            user-select: none;
            -webkit-user-select: none;
        }

        /* 真实的圆点容器 */
        #dots-track {
            display: flex;
            gap: 15px;
            padding: 15px 25px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 30px;
            backdrop-filter: blur(10px);
            cursor: grab;
        }
        #dots-track:active { cursor: grabbing; }

        .dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transition: transform 0.2s, background 0.2s;
        }
        .dot.active {
            background: #fff;
            transform: scale(1.3);
        }

        /* 拖拽时强制取消吸附，保证跟手 */
        #pages.is-dragging {
            scroll-snap-type: none;
            scroll-behavior: auto;
        }
    </style>
</head>
<body>

    <!-- 顶部页面 -->
    <div id="pages">
        <div class="page">Page 1</div>
        <div class="page">Page 2</div>
        <div class="page">Page 3</div>
    </div>

    <!-- 底部控制条 -->
    <div id="control-bar">
        <div id="dots-track">
            <div class="dot active"></div>
            <div class="dot"></div>
            <div class="dot"></div>
        </div>
    </div>

    <script>
        const pages = document.getElementById('pages');
        const dotsTrack = document.getElementById('dots-track');
        const dots = document.querySelectorAll('.dot');
        const pageCount = dots.length;
        const pageWidth = window.innerWidth;

        let isDragging = false;
        let startX = 0;
        let startScrollLeft = 0;
        let hasMoved = false;

        // 1. 按下鼠标/手指
        dotsTrack.addEventListener('pointerdown', (e) => {
            isDragging = true;
            hasMoved = false;
            startX = e.clientX;
            startScrollLeft = pages.scrollLeft;
            
            // 冻结吸附效果
            pages.classList.add('is-dragging');
            
            // 核心：锁死指针事件，防止被浏览器原生滚动抢走
            dotsTrack.setPointerCapture(e.pointerId);
            
            e.preventDefault();
            e.stopPropagation();
            console.log('Pointer Down, Captured.');
        });

        // 2. 拖动中
        dotsTrack.addEventListener('pointermove', (e) => {
            if (!isDragging) return;
            
            const walk = e.clientX - startX;
            if (Math.abs(walk) > 5) hasMoved = true;

            // 直接控制滚动条位置，系数设为 1.2 增加一点灵敏度
            pages.scrollLeft = startScrollLeft - (walk * 1.2);
            
            e.preventDefault();
            e.stopPropagation();
        });

        // 3. 松手结束
        const handleDragEnd = (e) => {
            if (!isDragging) return;
            isDragging = false;
            
            if (dotsTrack.hasPointerCapture(e.pointerId)) {
                dotsTrack.releasePointerCapture(e.pointerId);
            }
            
            pages.classList.remove('is-dragging');

            // 计算最靠近的页面
            let targetIndex = Math.round(pages.scrollLeft / pageWidth);
            // 限制范围
            targetIndex = Math.max(0, Math.min(targetIndex, pageCount - 1));

            // 平滑滚动过去
            pages.scrollTo({ left: targetIndex * pageWidth, behavior: 'smooth' });
            
            // 如果没发生拖拽（纯点击），则判定点到了哪个圆点
            if (!hasMoved) {
                handleDotClick(e.clientX);
            }
            
            e.preventDefault();
            e.stopPropagation();
            console.log('Pointer Up, Released.');
        };

        dotsTrack.addEventListener('pointerup', handleDragEnd);
        dotsTrack.addEventListener('pointercancel', handleDragEnd);

        // 4. 点击圆点判定
        function handleDotClick(clientX) {
            const rect = dotsTrack.getBoundingClientRect();
            const clickX = clientX - rect.left;
            
            const dotWidth = 12;
            const gap = 15;
            const paddingLeft = 25; // track 的 padding-left
            
            for (let i = 0; i < pageCount; i++) {
                const dotStart = paddingLeft + i * (dotWidth + gap);
                const dotEnd = dotStart + dotWidth;
                // 扩大点击判定范围
                if (clickX >= dotStart - gap/2 && clickX <= dotEnd + gap/2) {
                    pages.scrollTo({ left: i * pageWidth, behavior: 'smooth' });
                    break;
                }
            }
        }

        // 5. 监听滚动，更新圆点状态（原生滑动也会触发）
        pages.addEventListener('scroll', () => {
            const index = Math.round(pages.scrollLeft / pageWidth);
            dots.forEach((dot, i) => {
                if (i === index) dot.classList.add('active');
                else dot.classList.remove('active');
            });
        });

        // 处理窗口缩放
        window.addEventListener('resize', () => {
            location.reload();
        });
    </script>
</body>
</html>