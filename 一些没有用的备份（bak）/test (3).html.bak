<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>3D 房间测试 3</title>
<style>
  html, body {
    margin: 0; padding: 0; width: 100%; height: 100%;
    background: #000; overflow: hidden;
    touch-action: none;
    -webkit-user-select: none; user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  #app { position: relative; width: 100%; height: 100%; background: #000; }
  canvas { display: block; width: 100%; height: 100%; touch-action: none; }
</style>
</head>
<body>
<div id="app">
  <canvas id="scene"></canvas>
</div>

<script>
// ===== 3D 向量工具 =====
const V = {
  add: (a, b) => [a[0]+b[0], a[1]+b[1], a[2]+b[2]],
  sub: (a, b) => [a[0]-b[0], a[1]-b[1], a[2]-b[2]],
  scale: (a, s) => [a[0]*s, a[1]*s, a[2]*s],
  dot: (a, b) => a[0]*b[0] + a[1]*b[1] + a[2]*b[2],
  cross: (a, b) => [
    a[1]*b[2] - a[2]*b[1],
    a[2]*b[0] - a[0]*b[2],
    a[0]*b[1] - a[1]*b[0]
  ],
  norm: (a) => {
    const l = Math.hypot(a[0], a[1], a[2]) || 1;
    return [a[0]/l, a[1]/l, a[2]/l];
  }
};

// ===== 摄像机 =====
const camera = {
  pos: [0, 1.6, 4.5],
  yaw: 0,
  pitch: -0.05,
  fov: Math.PI / 3
};

// ===== 房间 =====
const ROOM = { width: 8, height: 3.2, depth: 10 };
// 内表面 x: ±4, y: 0 ~ 3.2, z: ±5

const canvas = document.getElementById('scene');
const ctx = canvas.getContext('2d');

// ===== 视图基向量 =====
function getViewBasis() {
  const cy = Math.cos(camera.yaw), sy = Math.sin(camera.yaw);
  const cp = Math.cos(camera.pitch), sp = Math.sin(camera.pitch);
  const forward = V.norm([sy * cp, sp, -cy * cp]);
  const worldUp = [0, 1, 0];
  let right = V.cross(forward, worldUp);
  if (Math.hypot(right[0], right[1], right[2]) < 1e-6) right = [1, 0, 0];
  right = V.norm(right);
  const up = V.norm(V.cross(right, forward));
  return { forward, right, up };
}

// ===== 射线与房间求交 =====
// 返回 { name, normal } 或 null
// 用 slab 方法对房间的 5 个内表面求最近交点
function raycastRoom(origin, dir) {
  const hx = ROOM.width / 2;    // 4
  const hz = ROOM.depth / 2;    // 5
  const top = ROOM.height;      // 3.2

  let bestT = Infinity;
  let bestName = null;
  let bestNormal = null;

  // 计算沿某个轴到达平面所需的 t，若 >0 且落在面内则接受
  function testPlane(t, name, normal, inBounds) {
    if (t > 1e-4 && t < bestT && inBounds) {
      bestT = t;
      bestName = name;
      bestNormal = normal;
    }
  }

  // 后墙 z = -hz, 内表面法线朝 +z
  if (dir[2] !== 0) {
    const t = (-hz - origin[2]) / dir[2];
    const x = origin[0] + dir[0] * t;
    const y = origin[1] + dir[1] * t;
    testPlane(t, '墙', [0, 0, 1], x >= -hx && x <= hx && y >= 0 && y <= top);
  }
  // 前墙 z = +hz, 法线朝 -z
  if (dir[2] !== 0) {
    const t = (hz - origin[2]) / dir[2];
    const x = origin[0] + dir[0] * t;
    const y = origin[1] + dir[1] * t;
    testPlane(t, '墙', [0, 0, -1], x >= -hx && x <= hx && y >= 0 && y <= top);
  }
  // 左墙 x = -hx, 法线朝 +x
  if (dir[0] !== 0) {
    const t = (-hx - origin[0]) / dir[0];
    const y = origin[1] + dir[1] * t;
    const z = origin[2] + dir[2] * t;
    testPlane(t, '墙', [1, 0, 0], z >= -hz && z <= hz && y >= 0 && y <= top);
  }
  // 右墙 x = +hx, 法线朝 -x
  if (dir[0] !== 0) {
    const t = (hx - origin[0]) / dir[0];
    const y = origin[1] + dir[1] * t;
    const z = origin[2] + dir[2] * t;
    testPlane(t, '墙', [-1, 0, 0], z >= -hz && z <= hz && y >= 0 && y <= top);
  }
  // 地面 y = 0, 法线朝 +y
  if (dir[1] !== 0) {
    const t = (0 - origin[1]) / dir[1];
    const x = origin[0] + dir[0] * t;
    const z = origin[2] + dir[2] * t;
    testPlane(t, '地', [0, 1, 0], x >= -hx && x <= hx && z >= -hz && z <= hz);
  }

  if (bestName === null) return null;
  return { name: bestName, normal: bestNormal, t: bestT };
}

// ===== 渲染参数 =====
const CELL_SIZE = 22;        // 每个字格子的屏幕像素大小（固定）
const FONT_RATIO = 0.9;      // 字号相对格子大小
const PLACEHOLDER = '·';     // 没打到东西时的占位符

function grayStr(g) {
  const v = Math.max(0, Math.min(255, Math.round(g)));
  return `rgb(${v},${v},${v})`;
}

// ===== 主渲染 =====
let dpr = Math.min(window.devicePixelRatio || 1, 2);
let cssW = 0, cssH = 0;

function resize() {
  dpr = Math.min(window.devicePixelRatio || 1, 2);
  cssW = window.innerWidth;
  cssH = window.innerHeight;
  canvas.width = Math.floor(cssW * dpr);
  canvas.height = Math.floor(cssH * dpr);
  canvas.style.width = cssW + 'px';
  canvas.style.height = cssH + 'px';
}
window.addEventListener('resize', resize);
window.addEventListener('orientationchange', () => setTimeout(resize, 100));
resize();

function render() {
  const basis = getViewBasis();

  // 背景纯黑
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.fillStyle = '#000';
  ctx.fillRect(0, 0, cssW, cssH);

  const f = (cssH / 2) / Math.tan(camera.fov / 2);

  // 网格覆盖整屏，格子居中分布
  const cols = Math.ceil(cssW / CELL_SIZE);
  const rows = Math.ceil(cssH / CELL_SIZE);
  const offsetX = (cssW - cols * CELL_SIZE) / 2 + CELL_SIZE / 2;
  const offsetY = (cssH - rows * CELL_SIZE) / 2 + CELL_SIZE / 2;

  const fontSize = CELL_SIZE * FONT_RATIO;
  ctx.font = `700 ${fontSize}px "PingFang SC","Microsoft YaHei","Noto Sans SC",sans-serif`;
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';

  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      const sx = offsetX + c * CELL_SIZE;
      const sy = offsetY + r * CELL_SIZE;

      // 屏幕坐标 -> 相机空间方向
      const camX = (sx - cssW / 2) / f;
      const camY = -(sy - cssH / 2) / f;
      const camZ = 1;

      // 相机空间方向转到世界空间
      const dir = V.norm([
        basis.right[0] * camX + basis.up[0] * camY + basis.forward[0] * camZ,
        basis.right[1] * camX + basis.up[1] * camY + basis.forward[1] * camZ,
        basis.right[2] * camX + basis.up[2] * camY + basis.forward[2] * camZ
      ]);

      const hit = raycastRoom(camera.pos, dir);

      if (!hit) {
        // 没打到东西：占位符，暗灰
        ctx.fillStyle = grayStr(60);
        ctx.fillText(PLACEHOLDER, sx, sy);
        continue;
      }

      // 朝向：法线与射线方向夹角。正对 => -dot 接近 1
      const facing = Math.max(0, -V.dot(hit.normal, dir)); // 0..1
      // 距离衰减一点点，让远处稍暗（可选）
      const dist = hit.t;
      const fog = 1 / (1 + dist * 0.06);

      // 亮度
      const lum = Math.pow(facing, 0.7) * fog; // 0..~1

      // 字色：亮的字，背景暗（这里背景就用纯黑）
      const textGray = 40 + lum * 215;        // 40 ~ 255
      ctx.fillStyle = grayStr(textGray);
      ctx.fillText(hit.name, sx, sy);
    }
  }
}

// ===== 渲染循环 =====
function frame() {
  render();
  requestAnimationFrame(frame);
}
frame();

// ===== 键盘 =====
let keys = {};
window.addEventListener('keydown', e => keys[e.key.toLowerCase()] = true);
window.addEventListener('keyup', e => keys[e.key.toLowerCase()] = false);

// ===== 鼠标拖动旋转 =====
let dragging = false;
let lastX = 0, lastY = 0;
canvas.addEventListener('mousedown', e => { dragging = true; lastX = e.clientX; lastY = e.clientY; });
window.addEventListener('mouseup', () => dragging = false);
window.addEventListener('mousemove', e => {
  if (!dragging) return;
  const dx = e.clientX - lastX, dy = e.clientY - lastY;
  lastX = e.clientX; lastY = e.clientY;
  camera.yaw += dx * 0.005;
  camera.pitch -= dy * 0.005;
  camera.pitch = Math.max(-1.2, Math.min(1.2, camera.pitch));
});

// ===== 触摸拖动旋转 =====
let touchId = null, touchLastX = 0, touchLastY = 0;
canvas.addEventListener('touchstart', e => {
  if (e.touches.length !== 1) return;
  const t = e.touches[0];
  touchId = t.identifier;
  touchLastX = t.clientX;
  touchLastY = t.clientY;
}, { passive: false });
canvas.addEventListener('touchmove', e => {
  if (touchId === null) return;
  let t = null;
  for (const touch of e.touches) if (touch.identifier === touchId) { t = touch; break; }
  if (!t) return;
  const dx = t.clientX - touchLastX, dy = t.clientY - touchLastY;
  touchLastX = t.clientX; touchLastY = t.clientY;
  camera.yaw += dx * 0.005;
  camera.pitch -= dy * 0.005;
  camera.pitch = Math.max(-1.2, Math.min(1.2, camera.pitch));
  e.preventDefault();
}, { passive: false });
canvas.addEventListener('touchend', e => {
  for (const touch of e.changedTouches) if (touch.identifier === touchId) { touchId = null; break; }
}, { passive: false });
canvas.addEventListener('touchcancel', () => { touchId = null; }, { passive: false });

// ===== 移动 =====
let last = performance.now();
function update(now) {
  const dt = Math.min(0.05, (now - last) / 1000);
  last = now;

  const speed = 2.5;
  const basis = getViewBasis();
  const flatForward = V.norm([basis.forward[0], 0, basis.forward[2]]);
  const flatRight = V.norm([basis.right[0], 0, basis.right[2]]);

  if (keys['w']) camera.pos = V.add(camera.pos, V.scale(flatForward, speed * dt));
  if (keys['s']) camera.pos = V.add(camera.pos, V.scale(flatForward, -speed * dt));
  if (keys['a']) camera.pos = V.add(camera.pos, V.scale(flatRight, -speed * dt));
  if (keys['d']) camera.pos = V.add(camera.pos, V.scale(flatRight, speed * dt));

  camera.pos[0] = Math.max(-ROOM.width/2 + 0.3, Math.min(ROOM.width/2 - 0.3, camera.pos[0]));
  camera.pos[2] = Math.max(-ROOM.depth/2 + 0.3, Math.min(ROOM.depth/2 - 0.3, camera.pos[2]));

  requestAnimationFrame(update);
}
requestAnimationFrame(update);
</script>
</body>
</html>