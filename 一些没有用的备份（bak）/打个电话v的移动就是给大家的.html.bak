<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes, viewport-fit=cover">
  <title>像素 · LaTeX 拼图生成器</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      background: #0d0d0f;
      font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 16px;
      margin: 0;
      color: #f0f0f5;
    }
    .glass-panel {
      max-width: 460px;
      width: 100%;
      background: #18181b;
      border-radius: 36px;
      padding: 24px 20px 28px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .header {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 6px;
    }
    .header-icon {
      font-size: 24px;
      background: linear-gradient(135deg, #4f46e5, #7c3aed);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    h1 {
      font-size: 1.6rem;
      font-weight: 600;
      letter-spacing: -0.3px;
      background: linear-gradient(to right, #ffffff, #d4d4d8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .subtitle {
      font-size: 0.9rem;
      color: #a1a1aa;
      margin-bottom: 22px;
      font-weight: 400;
      border-left: 2px solid #4f46e5;
      padding-left: 12px;
    }
    .file-area {
      background: #1f1f23;
      border-radius: 20px;
      padding: 12px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 18px;
      border: 1px solid #2e2e36;
      transition: border 0.2s;
    }
    .file-area:hover {
      border-color: #4f46e5;
    }
    .file-btn {
      background: #2e2e36;
      border: none;
      color: #e4e4e7;
      font-weight: 500;
      font-size: 0.9rem;
      padding: 8px 16px;
      border-radius: 30px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s;
      white-space: nowrap;
    }
    .file-btn:hover {
      background: #3f3f48;
    }
    .file-name {
      color: #c0c0cc;
      font-size: 0.9rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 160px;
    }
    #file-input {
      display: none;
    }
    .control-row {
      display: flex;
      gap: 12px;
      margin-bottom: 18px;
      align-items: center;
    }
    .pixel-box {
      background: #1f1f23;
      border-radius: 20px;
      padding: 8px 14px;
      display: flex;
      align-items: center;
      gap: 6px;
      flex: 1;
      border: 1px solid #2e2e36;
    }
    .pixel-box input {
      background: transparent;
      border: none;
      color: #ffffff;
      font-size: 1rem;
      font-weight: 500;
      width: 48px;
      text-align: center;
      outline: none;
    }
    .pixel-box span {
      color: #8e8e93;
      font-size: 0.9rem;
    }
    .mode-box {
      background: #1f1f23;
      border-radius: 20px;
      padding: 8px 12px;
      flex: 1.4;
      border: 1px solid #2e2e36;
      display: flex;
      align-items: center;
    }
    .mode-box select {
      background: transparent;
      border: none;
      color: #f0f0f5;
      width: 100%;
      font-size: 0.9rem;
      font-weight: 500;
      outline: none;
      cursor: pointer;
      appearance: none;
      background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="%23a1a1aa" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>');
      background-repeat: no-repeat;
      background-position: right 2px center;
      background-size: 16px;
    }
    .canvas-wrapper {
      background: #0f0f12;
      border-radius: 28px;
      padding: 8px;
      margin-bottom: 18px;
      border: 1px solid #2a2a30;
      box-shadow: inset 0 0 12px rgba(0,0,0,0.6);
    }
    .canvas-container {
      width: 100%;
      aspect-ratio: 1 / 1;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #0b0b0e;
      border-radius: 20px;
      overflow: hidden;
    }
    #preview-canvas {
      width: 100%;
      height: 100%;
      image-rendering: pixelated;
      display: block;
    }
    .code-preview-container {
      background: #0f0f12;
      border-radius: 20px;
      margin-bottom: 18px;
      border: 1px solid #2e2e36;
      display: none;
      flex-direction: column;
      overflow: hidden;
    }
    .code-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 14px;
      background: #1c1c20;
      border-bottom: 1px solid #2e2e36;
    }
    .code-header span {
      font-size: 0.8rem;
      color: #a0a0b0;
    }
    .copy-btn {
      background: linear-gradient(135deg, #4f46e5, #7c3aed);
      border: none;
      color: white;
      font-size: 0.75rem;
      font-weight: 600;
      padding: 6px 14px;
      border-radius: 20px;
      cursor: pointer;
      box-shadow: 0 4px 10px rgba(79, 70, 229, 0.3);
    }
    .copy-btn:active {
      transform: scale(0.95);
    }
    #latex-code-area {
      padding: 14px;
      margin: 0;
      font-family: 'Courier New', monospace;
      font-size: 0.7rem;
      line-height: 1.5;
      color: #cfcfe0;
      max-height: 260px;
      overflow-y: auto;
      white-space: pre-wrap;
      word-break: break-all;
      background: #0a0a0d;
    }
    .action-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-top: 6px;
    }
    .action-btn {
      background: #22222b;
      border: 1px solid #31313a;
      border-radius: 24px;
      padding: 14px 0;
      color: #e4e4e7;
      font-weight: 600;
      font-size: 0.95rem;
      cursor: pointer;
      transition: all 0.2s;
    }
    .action-btn.primary {
      background: #4f46e5;
      border: 1px solid #6366f1;
      color: white;
      box-shadow: 0 8px 18px -6px #4f46e5;
    }
    .action-btn:active {
      transform: translateY(1px);
    }
    .status-badge {
      text-align: center;
      margin-top: 16px;
      font-size: 0.8rem;
      color: #7f7f8c;
      background: #1a1a1f;
      padding: 8px 12px;
      border-radius: 30px;
      width: fit-content;
      margin-left: auto;
      margin-right: auto;
    }
  </style>
</head>
<body>
<div class="glass-panel">
  <div class="header">
    <span class="header-icon">◈</span>
    <h1>像素·LaTeX拼图</h1>
  </div>
  <div class="subtitle">图片 → TikZ 像素艺术</div>

  <div class="file-area">
    <button class="file-btn" id="trigger-file-btn">
      <span>📁</span> 选择图片
    </button>
    <span class="file-name" id="file-name-display">未选择</span>
    <input type="file" id="file-input" accept="image/*">
  </div>

  <div class="control-row">
    <div class="pixel-box">
      <input type="number" id="pixel-size" value="24" min="4" max="64" step="1">
      <span>像素</span>
    </div>
    <div class="mode-box">
      <select id="output-mode">
        <option value="tikz_rgb">TikZ RGB 语法</option>
        <option value="latex_color">LaTeX 颜色定义</option>
      </select>
    </div>
  </div>

  <div class="canvas-wrapper">
    <div class="canvas-container">
      <canvas id="preview-canvas"></canvas>
    </div>
  </div>

  <div class="code-preview-container" id="code-preview-box">
    <div class="code-header">
      <span>📋 LaTeX 源码</span>
      <button class="copy-btn" id="copy-code-btn">复制代码</button>
    </div>
    <pre id="latex-code-area"></pre>
  </div>

  <div class="action-grid">
    <button class="action-btn primary" id="generate-btn">⚡ 生成代码</button>
    <button class="action-btn" id="download-btn">⬇️ 下载 .tex</button>
  </div>

  <div class="status-badge" id="status-text">等待图片导入</div>
</div>

<script>
  // 不使用 IIFE，保持作用域干净
  const fileInput = document.getElementById('file-input');
  const fileNameDisplay = document.getElementById('file-name-display');
  const canvas = document.getElementById('preview-canvas');
  const ctx = canvas.getContext('2d');
  const statusText = document.getElementById('status-text');
  const pixelSizeInput = document.getElementById('pixel-size');
  const modeSelect = document.getElementById('output-mode');
  const codePreviewBox = document.getElementById('code-preview-box');
  const latexCodeArea = document.getElementById('latex-code-area');
  
  let currentImage = null;
  let latexCodeCache = null;

  function setStatus(msg, isGood = true) {
    statusText.textContent = msg;
    statusText.style.color = isGood ? '#a0a0b8' : '#f87171';
  }

  function drawPlaceholder() {
    canvas.width = 240;
    canvas.height = 240;
    ctx.fillStyle = '#1a1a1e';
    ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.fillStyle = '#3a3a40';
    ctx.font = '14px system-ui';
    ctx.textAlign = 'center';
    ctx.fillText('无图片', canvas.width/2, canvas.height/2);
  }

  function previewImage() {
    if (!currentImage) {
      drawPlaceholder();
      return;
    }
    const gridSize = parseInt(pixelSizeInput.value, 10);
    if (isNaN(gridSize) || gridSize < 2) return;
    
    canvas.width = gridSize * 10;
    canvas.height = gridSize * 10;
    ctx.imageSmoothingEnabled = false;
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    ctx.drawImage(currentImage, 0, 0, canvas.width, canvas.height);
  }

  // 文件选择
  document.getElementById('trigger-file-btn').addEventListener('click', function() {
    fileInput.click();
  });

  fileInput.addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (!file) return;
    
    fileNameDisplay.textContent = file.name.length > 18 ? file.name.substring(0, 16) + '…' : file.name;
    
    const reader = new FileReader();
    reader.onload = function(ev) {
      const img = new Image();
      img.onload = function() {
        currentImage = img;
        previewImage();
        setStatus('图片已加载，点击生成代码');
        codePreviewBox.style.display = 'none';
        latexCodeCache = null;
      };
      img.onerror = function() {
        setStatus('图片加载失败', false);
      };
      img.src = ev.target.result;
    };
    reader.readAsDataURL(file);
    fileInput.value = '';
  });

  // 像素变化
  pixelSizeInput.addEventListener('input', function() {
    previewImage();
    codePreviewBox.style.display = 'none';
    latexCodeCache = null;
    if (currentImage) setStatus('像素尺寸已更新');
  });

  // 核心生成函数 - 返回纯文本字符串
  function buildLatexCode() {
    if (!currentImage) return null;
    
    const gridSize = parseInt(pixelSizeInput.value, 10);
    if (isNaN(gridSize) || gridSize < 2) return null;
    
    const mode = modeSelect.value;
    
    // 使用离屏canvas提取像素
    const offCanvas = document.createElement('canvas');
    offCanvas.width = gridSize;
    offCanvas.height = gridSize;
    const offCtx = offCanvas.getContext('2d');
    offCtx.drawImage(currentImage, 0, 0, gridSize, gridSize);
    const imageData = offCtx.getImageData(0, 0, gridSize, gridSize);
    const data = imageData.data;
    
    let lines = [];
    
    if (mode === 'tikz_rgb') {
      lines.push('\\documentclass[tikz,border=10pt]{standalone}');
      lines.push('\\begin{document}');
      lines.push('\\begin{tikzpicture}[scale=0.5]');
      for (let y = 0; y < gridSize; y++) {
        for (let x = 0; x < gridSize; x++) {
          const idx = (y * gridSize + x) * 4;
          const r = (data[idx] / 255).toFixed(3);
          const g = (data[idx + 1] / 255).toFixed(3);
          const b = (data[idx + 2] / 255).toFixed(3);
          lines.push(`  \\fill[rgb={${r},${g},${b}}] (${x}, ${gridSize - 1 - y}) rectangle ++(1,1);`);
        }
      }
      lines.push('\\end{tikzpicture}');
      lines.push('\\end{document}');
    } else if (mode === 'latex_color') {
      const colorMap = new Map();
      const colorDefs = [];
      const fillCommands = [];
      for (let y = 0; y < gridSize; y++) {
        for (let x = 0; x < gridSize; x++) {
          const idx = (y * gridSize + x) * 4;
          const r = data[idx], g = data[idx + 1], b = data[idx + 2];
          const key = `${r}_${g}_${b}`;
          if (!colorMap.has(key)) {
            colorMap.set(key, `col_${key}`);
            colorDefs.push(`\\definecolor{col_${key}}{RGB}{${r},${g},${b}}`);
          }
          fillCommands.push(`  \\fill[col_${key}] (${x}, ${gridSize - 1 - y}) rectangle ++(1,1);`);
        }
      }
      lines.push('\\documentclass[tikz,border=10pt]{standalone}');
      lines.push('\\usepackage{xcolor}');
      lines.push('\\begin{document}');
      lines.push('\\begin{tikzpicture}[scale=0.5]');
      lines.push(...colorDefs);
      lines.push(...fillCommands);
      lines.push('\\end{tikzpicture}');
      lines.push('\\end{document}');
    }
    
    return lines.join('\n');
  }

  // 生成并显示
  function generateAndShow() {
    if (!currentImage) {
      setStatus('请先选择一张图片', false);
      return;
    }
    
    const code = buildLatexCode();
    if (!code) {
      setStatus('生成失败，请检查像素设置', false);
      return;
    }
    
    latexCodeCache = code;
    latexCodeArea.textContent = code;
    codePreviewBox.style.display = 'flex';
    setStatus(`✓ 代码已生成 (${pixelSizeInput.value}×${pixelSizeInput.value})`);
  }

  // 复制代码
  function copyCodeFromArea() {
    if (!latexCodeCache) {
      setStatus('没有可复制的代码，请先生成', false);
      return;
    }
    
    // 使用 Clipboard API
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(latexCodeCache).then(() => {
        setStatus('✅ 代码已复制到剪贴板');
      }).catch(() => {
        fallbackCopy();
      });
    } else {
      fallbackCopy();
    }
    
    function fallbackCopy() {
      const textarea = document.createElement('textarea');
      textarea.value = latexCodeCache;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.select();
      try {
        document.execCommand('copy');
        setStatus('✅ 已复制');
      } catch (err) {
        setStatus('复制失败，请手动选择代码', false);
      }
      document.body.removeChild(textarea);
    }
  }

  // 下载文件 - 最可靠的方式
  function downloadLatex() {
    // 确保有代码
    if (!latexCodeCache) {
      if (!currentImage) {
        setStatus('请先选择图片并生成代码', false);
        return;
      }
      const code = buildLatexCode();
      if (!code) {
        setStatus('无法生成代码', false);
        return;
      }
      latexCodeCache = code;
      latexCodeArea.textContent = code;
      codePreviewBox.style.display = 'flex';
    }
    
    // 方法：创建临时链接直接下载文本
    const filename = `pixel_art_${pixelSizeInput.value}x${pixelSizeInput.value}.tex`;
    const blob = new Blob([latexCodeCache], { type: 'text/plain;charset=utf-8' });
    
    // 使用 URL.createObjectURL
    const url = window.URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = filename;
    
    // 添加到文档、点击、移除
    document.body.appendChild(link);
    link.click();
    
    // 延迟清理，确保下载开始
    setTimeout(() => {
      document.body.removeChild(link);
      window.URL.revokeObjectURL(url);
    }, 100);
    
    setStatus('📁 文件下载中...');
  }

  // 事件绑定
  document.getElementById('generate-btn').addEventListener('click', generateAndShow);
  document.getElementById('copy-code-btn').addEventListener('click', copyCodeFromArea);
  document.getElementById('download-btn').addEventListener('click', downloadLatex);

  // 初始化
  drawPlaceholder();
</script>
</body>
</html>