<!DOCTYPE html>
<html>
<head><meta charset="UTF-8"><title>测试</title></head>
<body style="margin:0;background:#111">
  <img id="img" style="max-width:100vw;max-height:100vh" />
  <script>
    const base64Data = "";
    const img = document.getElementById('img');
    img.src = 'data:image/png;base64,' + base64Data;
    img.onload = () => alert('图片加载成功！尺寸：' + img.naturalWidth + 'x' + img.naturalHeight);
    img.onerror = () => alert('图片加载失败！Base64 数据有问题');
  </script>
</body>
</html>