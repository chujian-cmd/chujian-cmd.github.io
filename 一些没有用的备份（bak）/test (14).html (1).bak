<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>3D 房间 - 红苹果</title>
<style>
  html, body {
    margin: 0; padding: 0; width: 100%; height: 100%;
    background: #000; overflow: hidden;
    touch-action: none;
    -webkit-user-select: none; user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  #app { position: relative; width: 100%; height: 100%; background: #000; }
  canvas { 
    display: block; width: 100%; height: 100%; touch-action: none;
    image-rendering: -moz-crisp-edges;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
    image-rendering: pixelated;
  }
</style>
</head>
<body>
<div id="app">
  <canvas id="scene"></canvas>
</div>

<script>
var canvas = document.getElementById('scene');
var ctx = canvas.getContext('2d', { alpha: false });

var camera = { pos: [0, 1.6, 4.5], yaw: 0, pitch: -0.08, fov: Math.PI / 3 };
var hx = 4, hz = 5, top = 3.2;

// ===== 场景物体 =====
var objects = [];
// 桌子
objects.push({ name: '桌', type: 'mono', min: [-0.9, 0, -0.55], max: [0.9, 0.78, 0.55] });

// 椅子
function addChair(cx, cz, facing) {
  var sh = 0.24, seatH = 0.45, backT = 0.08, backH = 0.95;
  objects.push({ name: '椅', type: 'mono', min: [cx - sh, 0, cz - sh], max: [cx + sh, seatH, cz + sh] });
  if (facing === 'N') objects.push({ name: '椅', type: 'mono', min: [cx - sh, seatH, cz - sh - backT], max: [cx + sh, backH, cz - sh] });
  else if (facing === 'S') objects.push({ name: '椅', type: 'mono', min: [cx - sh, seatH, cz + sh], max: [cx + sh, backH, cz + sh + backT] });
  else if (facing === 'W') objects.push({ name: '椅', type: 'mono', min: [cx - sh - backT, seatH, cz - sh], max: [cx - sh, backH, cz + sh] });
  else if (facing === 'E') objects.push({ name: '椅', type: 'mono', min: [cx + sh, seatH, cz - sh], max: [cx + sh + backT, backH, cz + sh] });
}
addChair(0, -1.15, 'N');
addChair(0,  1.15, 'S');
addChair(-1.35, 0, 'W');
addChair( 1.35, 0, 'E');

// ★ 苹果（彩色） ★
// 苹果本体：放在桌面上，高度 0.78
objects.push({ name: '苹', type: 'color', color: [255, 40, 40], min: [-0.1, 0.78, -0.1], max: [0.1, 0.98, 0.1] });
// 苹果柄：稍微高出一点，绿色
objects.push({ name: '柄', type: 'color', color: [100, 255, 80], min: [-0.02, 0.98, -0.02], max: [0.02, 1.05, 0.02] });

// ===== 物理碰撞 =====
var colliders = [];
colliders.push({ minX: -0.9, maxX: 0.9, minZ: -0.55, maxZ: 0.55 });
colliders.push({ minX: -0.24, maxX: 0.24, minZ: -1.39, maxZ: -0.91 });
colliders.push({ minX: -0.24, maxX: 0.24, minZ: 0.91, maxZ: 1.39 });
colliders.push({ minX: -1.59, maxX: -1.11, minZ: -0.24, maxZ: 0.24 });
colliders.push({ minX: 1.11, maxX: 1.59, minZ: -0.24, maxZ: 0.24 });

// ===== 尺寸与网格 =====
var dpr = Math.min(window.devicePixelRatio || 1, 2);
var cssW = 0, cssH = 0;

function resize() {
  cssW = window.innerWidth;
  cssH = window.innerHeight;
  canvas.width = Math.floor(cssW * dpr);
  canvas.height = Math.floor(cssH * dpr);
  canvas.style.width = cssW + 'px';
  canvas.style.height = cssH + 'px';
  buildGrid();
}
window.addEventListener('resize', resize);

var CELL_SIZE = 12;
var FONT_SIZE = 10;
var PLACEHOLDER = '·';
var cols = 0, rows = 0, offsetX = 0, offsetY = 0;

function buildGrid() {
  cols = Math.ceil(cssW / CELL_SIZE);
  rows = Math.ceil(cssH / CELL_SIZE);
  offsetX = (cssW - cols * CELL_SIZE) / 2 + CELL_SIZE / 2;
  offsetY = (cssH - rows * CELL_SIZE) / 2 + CELL_SIZE / 2;
}

// ===== 摇杆 =====
var joystick = { active: false, originX: 0, originY: 0, knobX: 0, knobY: 0, nx: 0, ny: 0, maxR: 50, outerR: 72, knobR: 22 };

// ===== 渲染 =====
function render() {
  var cy = Math.cos(camera.yaw), sy = Math.sin(camera.yaw);
  var cp = Math.cos(camera.pitch), sp = Math.sin(camera.pitch);
  
  var fwX = sy*cp, fwY = sp, fwZ = -cy*cp;
  var fwL = Math.sqrt(fwX*fwX + fwY*fwY + fwZ*fwZ);
  fwX /= fwL; fwY /= fwL; fwZ /= fwL;

  var rtX = fwY*0 - fwZ*1, rtY = fwZ*0 - fwX*0, rtZ = fwX*1 - fwY*0;
  var rtL = Math.sqrt(rtX*rtX + rtY*rtY + rtZ*rtZ);
  if (rtL < 1e-6) { rtX = 1; rtY = 0; rtZ = 0; } else { rtX /= rtL; rtY /= rtL; rtZ /= rtL; }

  var upX = rtY*fwZ - rtZ*fwY, upY = rtZ*fwX - rtX*fwZ, upZ = rtX*fwY - rtY*fwX;

  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.fillStyle = '#000';
  ctx.fillRect(0, 0, cssW, cssH);

  var f = (cssH / 2) / Math.tan(camera.fov / 2);
  var cx = cssW / 2, cyScreen = cssH / 2;
  var ox = camera.pos[0], oy = camera.pos[1], oz = camera.pos[2];

  ctx.font = 'bold ' + FONT_SIZE + 'px sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  ctx.imageSmoothingEnabled = false;

  var objLen = objects.length;

  for (var r = 0; r < rows; r++) {
    var syScreen = offsetY + r * CELL_SIZE;
    var camY = -(syScreen - cyScreen) / f;
    
    for (var c = 0; c < cols; c++) {
      var sx = offsetX + c * CELL_SIZE;
      var camX = (sx - cx) / f;
      
      var dx = rtX*camX + upX*camY + fwX;
      var dy = rtY*camX + upY*camY + fwY;
      var dz = rtZ*camX + upZ*camY + fwZ;
      var dLen = Math.sqrt(dx*dx + dy*dy + dz*dz);
      dx /= dLen; dy /= dLen; dz /= dLen;

      var bestT = 1e9, bestName = null, nX = 0, nY = 0, nZ = 0, isColor = false, colR = 0, colG = 0, colB = 0;

      // 房间求交
      if (dz !== 0) {
        var t = (-hz - oz) / dz;
        var tx = ox + dx*t, ty = oy + dy*t;
        if (t > 0.001 && t < bestT && tx>=-hx && tx<=hx && ty>=0 && ty<=top) { bestT = t; bestName = '墙'; nX=0; nY=0; nZ=1; isColor = false; }
        t = (hz - oz) / dz;
        tx = ox + dx*t; ty = oy + dy*t;
        if (t > 0.001 && t < bestT && tx>=-hx && tx<=hx && ty>=0 && ty<=top) { bestT = t; bestName = '墙'; nX=0; nY=0; nZ=-1; isColor = false; }
      }
      if (dx !== 0) {
        var t = (-hx - ox) / dx;
        var ty = oy + dy*t, tz = oz + dz*t;
        if (t > 0.001 && t < bestT && tz>=-hz && tz<=hz && ty>=0 && ty<=top) { bestT = t; bestName = '墙'; nX=1; nY=0; nZ=0; isColor = false; }
        t = (hx - ox) / dx;
        ty = oy + dy*t; tz = oz + dz*t;
        if (t > 0.001 && t < bestT && tz>=-hz && tz<=hz && ty>=0 && ty<=top) { bestT = t; bestName = '墙'; nX=-1; nY=0; nZ=0; isColor = false; }
      }
      if (dy !== 0) {
        var t = (0 - oy) / dy;
        var tx = ox + dx*t, tz = oz + dz*t;
        if (t > 0.001 && t < bestT && tx>=-hx && tx<=hx && tz>=-hz && tz<=hz) { bestT = t; bestName = '地'; nX=0; nY=1; nZ=0; isColor = false; }
      }

      // 物体求交
      for (var i = 0; i < objLen; i++) {
        var obj = objects[i];
        var tmin = -1e9, tmax = 1e9, tnx = 0, tny = 0, tnz = 0;
        
        if (Math.abs(dx) < 1e-6) { if (ox < obj.min[0] || ox > obj.max[0]) continue; }
        else {
          var t1 = (obj.min[0] - ox) / dx, t2 = (obj.max[0] - ox) / dx, n1 = -1;
          if (t1 > t2) { var tmp = t1; t1 = t2; t2 = tmp; n1 = 1; }
          if (t1 > tmin) { tmin = t1; tnx = n1; tny = 0; tnz = 0; }
          if (t2 < tmax) tmax = t2;
          if (tmin > tmax) continue;
        }
        if (Math.abs(dy) < 1e-6) { if (oy < obj.min[1] || oy > obj.max[1]) continue; }
        else {
          var t1 = (obj.min[1] - oy) / dy, t2 = (obj.max[1] - oy) / dy, n1 = -1;
          if (t1 > t2) { var tmp = t1; t1 = t2; t2 = tmp; n1 = 1; }
          if (t1 > tmin) { tmin = t1; tnx = 0; tny = n1; tnz = 0; }
          if (t2 < tmax) tmax = t2;
          if (tmin > tmax) continue;
        }
        if (Math.abs(dz) < 1e-6) { if (oz < obj.min[2] || oz > obj.max[2]) continue; }
        else {
          var t1 = (obj.min[2] - oz) / dz, t2 = (obj.max[2] - oz) / dz, n1 = -1;
          if (t1 > t2) { var tmp = t1; t1 = t2; t2 = tmp; n1 = 1; }
          if (t1 > tmin) { tmin = t1; tnx = 0; tny = 0; tnz = n1; }
          if (t2 < tmax) tmax = t2;
          if (tmin > tmax) continue;
        }
        
        if (tmax < 0) continue;
        var tHit = tmin > 0.001 ? tmin : tmax;
        if (tHit <= 0.001) continue;
        
        if (tHit < bestT) {
          bestT = tHit; bestName = obj.name;
          nX = tnx; nY = tny; nZ = tnz;
          if (obj.type === 'color') {
            isColor = true;
            colR = obj.color[0]; colG = obj.color[1]; colB = obj.color[2];
          } else {
            isColor = false;
          }
        }
      }

      // 绘制
      if (bestName === null) {
        ctx.fillStyle = 'rgb(80, 80, 80)';
        ctx.fillText(PLACEHOLDER, sx, syScreen);
      } else {
        var facing = -(nX*dx + nY*dy + nZ*dz);
        if (facing < 0) facing = 0;
        var fog = 1 / (1 + bestT * 0.06);
        var lum = Math.pow(facing, 0.7) * fog;
        
        if (isColor) {
          // ★ 彩色物体渲染 ★
          // 亮度量化到 8 阶
          var step = Math.floor(lum * 8) / 8; 
          // 把颜色乘以亮度
          var rr = Math.floor(colR * step);
          var gg = Math.floor(colG * step);
          var bb = Math.floor(colB * step);
          // 保持像素风的纯色
          ctx.fillStyle = 'rgb(' + rr + ',' + gg + ',' + bb + ')';
        } else {
          // 黑白像素
          var step = Math.floor(lum * 8) / 8; 
          var gray = Math.floor(40 + step * 215);
          ctx.fillStyle = 'rgb(' + gray + ',' + gray + ',' + gray + ')';
        }
        
        ctx.fillText(bestName, sx, syScreen);
      }
    }
  }

  // 摇杆
  if (joystick.active) {
    ctx.save();
    ctx.globalAlpha = 0.75;
    var px = 8;
    
    ctx.fillStyle = '#ffffff';
    var n = Math.ceil(joystick.outerR / px);
    var jx = Math.round(joystick.originX / px) * px;
    var jy = Math.round(joystick.originY / px) * px;
    for (var gy = -n; gy <= n; gy++) {
      for (var gx = -n; gx <= n; gx++) {
        var d = Math.sqrt(gx*gx + gy*gy);
        if (d <= joystick.outerR/px && d > (joystick.outerR-12)/px) {
          ctx.fillRect(jx + gx*px - px/2, jy + gy*px - px/2, px, px);
        }
      }
    }
    
    var kx = Math.round(joystick.knobX / px) * px;
    var ky = Math.round(joystick.knobY / px) * px;
    ctx.fillStyle = '#000000';
    n = Math.ceil(joystick.knobR / px);
    for (var gy = -n; gy <= n; gy++) {
      for (var gx = -n; gx <= n; gx++) {
        if (Math.sqrt(gx*gx + gy*gy) <= joystick.knobR/px) {
          ctx.fillRect(kx + gx*px - px/2, ky + gy*px - px/2, px, px);
        }
      }
    }
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = px;
    ctx.strokeRect(kx - joystick.knobR, ky - joystick.knobR, joystick.knobR*2, joystick.knobR*2);
    ctx.restore();
  }
}

var lastRender = 0;
function frame(now) {
  if (now - lastRender > 30) {
    render();
    lastRender = now;
  }
  requestAnimationFrame(frame);
}
resize();
requestAnimationFrame(frame);

// ===== 输入控制 =====
var keys = {};
window.addEventListener('keydown', function(e) { keys[e.key.toLowerCase()] = true; });
window.addEventListener('keyup', function(e) { keys[e.key.toLowerCase()] = false; });

var dragging = false, lastX = 0, lastY = 0;
canvas.addEventListener('mousedown', function(e) { dragging = true; lastX = e.clientX; lastY = e.clientY; });
window.addEventListener('mouseup', function() { dragging = false; });
window.addEventListener('mousemove', function(e) {
  if (!dragging) return;
  var dx = e.clientX - lastX, dy = e.clientY - lastY;
  lastX = e.clientX; lastY = e.clientY;
  camera.yaw += dx * 0.005;
  camera.pitch -= dy * 0.005;
  camera.pitch = Math.max(-1.2, Math.min(1.2, camera.pitch));
});

var joyTouchId = null, rotateActive = false, rotateLastMX = 0, rotateLastMY = 0;
canvas.addEventListener('touchstart', function(e) {
  if (e.touches.length === 1) {
    var t = e.touches[0];
    joyTouchId = t.identifier;
    joystick.active = true;
    joystick.originX = t.clientX; joystick.originY = t.clientY;
    joystick.knobX = t.clientX; joystick.knobY = t.clientY;
    joystick.nx = 0; joystick.ny = 0;
  } else if (e.touches.length === 2) {
    joystick.active = false; joyTouchId = null; rotateActive = true;
    var mx = 0, my = 0;
    for (var i = 0; i < e.touches.length; i++) { mx += e.touches[i].clientX; my += e.touches[i].clientY; }
    mx /= e.touches.length; my /= e.touches.length;
    rotateLastMX = mx; rotateLastMY = my;
  }
  e.preventDefault();
}, { passive: false });

canvas.addEventListener('touchmove', function(e) {
  if (rotateActive && e.touches.length >= 2) {
    var mx = 0, my = 0;
    for (var i = 0; i < e.touches.length; i++) { mx += e.touches[i].clientX; my += e.touches[i].clientY; }
    mx /= e.touches.length; my /= e.touches.length;
    var dx = mx - rotateLastMX, dy = my - rotateLastMY;
    rotateLastMX = mx; rotateLastMY = my;
    camera.yaw += dx * 0.005;
    camera.pitch -= dy * 0.005;
    camera.pitch = Math.max(-1.2, Math.min(1.2, camera.pitch));
  } else if (joystick.active && joyTouchId !== null) {
    var t = null;
    for (var i = 0; i < e.touches.length; i++) { if (e.touches[i].identifier === joyTouchId) { t = e.touches[i]; break; } }
    if (t) {
      var dx = t.clientX - joystick.originX;
      var dy = t.clientY - joystick.originY;
      var len = Math.sqrt(dx*dx + dy*dy);
      var maxR = joystick.maxR;
      if (len > 0.001) {
        var cl = Math.min(len, maxR);
        joystick.nx = (dx / len) * (cl / maxR);
        joystick.ny = (dy / len) * (cl / maxR);
        joystick.knobX = joystick.originX + (dx / len) * cl;
        joystick.knobY = joystick.originY + (dy / len) * cl;
      }
    }
  }
  e.preventDefault();
}, { passive: false });

canvas.addEventListener('touchend', function(e) {
  if (joyTouchId !== null) {
    var still = false;
    for (var i = 0; i < e.touches.length; i++) { if (e.touches[i].identifier === joyTouchId) { still = true; break; } }
    if (!still) { joyTouchId = null; joystick.active = false; joystick.nx = 0; joystick.ny = 0; }
  }
  if (rotateActive && e.touches.length < 2) rotateActive = false;
  e.preventDefault();
}, { passive: false });

canvas.addEventListener('touchcancel', function() {
  joystick.active = false; joyTouchId = null; rotateActive = false;
  joystick.nx = 0; joystick.ny = 0;
}, { passive: false });

// ===== 移动与碰撞 =====
var last = performance.now();
function update(now) {
  var dt = Math.min(0.05, (now - last) / 1000);
  last = now;

  var speed = 3.0;
  var cy = Math.cos(camera.yaw), sy = Math.sin(camera.yaw);
  var fwdX = sy, fwdZ = -cy;
  var rgtX = cy, rgtZ = sy;

  var mx = 0, mz = 0;
  if (keys['w']) { mx += fwdX; mz += fwdZ; }
  if (keys['s']) { mx -= fwdX; mz -= fwdZ; }
  if (keys['a']) { mx -= rgtX; mz -= rgtZ; }
  if (keys['d']) { mx += rgtX; mz += rgtZ; }

  if (joystick.active) {
    mx += fwdX * (-joystick.ny) + rgtX * joystick.nx;
    mz += fwdZ * (-joystick.ny) + rgtZ * joystick.nx;
  }

  var mLen = Math.sqrt(mx*mx + mz*mz);
  if (mLen > 1) { mx /= mLen; mz /= mLen; }

  var newX = camera.pos[0] + mx * speed * dt;
  var newZ = camera.pos[2] + mz * speed * dt;
  var radius = 0.35;

  newX = Math.max(-hx + radius, Math.min(hx - radius, newX));
  newZ = Math.max(-hz + radius, Math.min(hz - radius, newZ));

  for (var i = 0; i < colliders.length; i++) {
    var col = colliders[i];
    var closestX = Math.max(col.minX, Math.min(newX, col.maxX));
    var closestZ = Math.max(col.minZ, Math.min(newZ, col.maxZ));
    
    var distX = newX - closestX;
    var distZ = newZ - closestZ;
    var distSq = distX*distX + distZ*distZ;

    if (distSq < radius * radius) {
      var dist = Math.sqrt(distSq);
      if (dist > 0.0001) {
        newX = closestX + (distX / dist) * radius;
        newZ = closestZ + (distZ / dist) * radius;
      } else {
        var centerX = (col.minX + col.maxX) / 2;
        var centerZ = (col.minZ + col.maxZ) / 2;
        var diffX = newX - centerX;
        var diffZ = newZ - centerZ;
        var dLen = Math.sqrt(diffX*diffX + diffZ*diffZ);
        if (dLen > 0.0001) {
          newX = centerX + (diffX / dLen) * (Math.max(col.maxX - centerX, col.maxZ - centerZ) + radius);
          newZ = centerZ + (diffZ / dLen) * (Math.max(col.maxX - centerX, col.maxZ - centerZ) + radius);
        }
      }
    }
  }

  camera.pos[0] = newX;
  camera.pos[2] = newZ;

  requestAnimationFrame(update);
}
requestAnimationFrame(update);
</script>
</body>
</html>