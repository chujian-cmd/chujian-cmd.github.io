<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Base64 图片显示器</title>
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            background: #f1f5f9;
            font-family: system-ui, sans-serif;
        }
        .box {
            background: #fff;
            padding: 24px;
            border-radius: 16px;
            box-shadow: 0 10px 30px -10px rgba(0,0,0,0.15);
            text-align: center;
        }
        img {
            max-width: 100%;
            max-height: 400px;
            border-radius: 10px;
            display: block;
            background: #f8fafc;
            min-width: 200px;
            min-height: 150px;
            object-fit: contain;
        }
        .hint {
            margin-top: 12px;
            color: #64748b;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>

<div class="box">
    <img id="preview" alt="Base64 图片">
    <div class="hint">Base64 图片预览</div>
</div>

<script>
    // ============================================
    // 把这里替换成你自己的 Base64 内容
    // 格式：data:image/png;base64,xxxxxxxx
    // 或者直接写纯 Base64 字符串
    // ============================================
    const BASE64_IMAGE = "此处填入你的Base64图片内容（占位符）";

    // 如果写的是纯 Base64，自动补上前缀
    let src = BASE64_IMAGE.trim();
    if (src && !src.startsWith("data:image/")) {
        src = "data:image/png;base64," + src;
    }

    document.getElementById("preview").src = src;
</script>

</body>
</html>