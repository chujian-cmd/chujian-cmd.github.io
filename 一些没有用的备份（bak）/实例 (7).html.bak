<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <!-- 配置前置：所有可修改项集中于此 -->
  <script>
    const ICONS = {
      wifi: "M12 18.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zM5 9.5C7.5 7 10.5 6 12 6s4.5 1 7 3.5M2 6C5.5 2.5 8.5 1 12 1s6.5 1.5 10 5",
      bluetooth: "M7 8l10 8-5 4V4l5 4-10 8",
      airplane: "M3 12l18-6-6 18-4-8-8-4z",
      info: "M12 8h.01M12 12v4M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20z"
    };
    const CONFIG = {
      title: "极简设置面板",
      subtitle: "轻触开关，即刻生效",
      items: [
        { id: "wifi", label: "无线网络", icon: "wifi", default: true },
        { id: "bluetooth", label: "蓝牙", icon: "bluetooth", default: false },
        { id: "airplane", label: "飞行模式", icon: "airplane", default: false }
      ],
      buttons: { reset: "重置", apply: "应用更改" },
      status: { idle: "所有更改已保存", changed: "有未保存的更改" }
    };
  </script>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>极简设置面板</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      background: #FFFFFF;
      color: #000000;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 20px;
      font-size: 16px;
      line-height: 1.5;
    }

    /* 主卡片：不写死宽度，移动端占满 */
    .panel {
      width: 100%;
      max-width: 480px;
      margin: 0 auto;
      border: 1px solid #E5E5E5;
      border-radius: 24px;
      background: #FFFFFF;
      padding: 24px 20px 20px;
    }

    /* 标题区 */
    .header {
      margin-bottom: 28px;
      text-align: left;
    }

    h1 {
      font-size: 24px;
      font-weight: 600;
      letter-spacing: -0.3px;
      color: #000000;
      margin-bottom: 4px;
    }

    .subtitle {
      font-size: 14px;
      color: #666666;
    }

    /* 开关列表 */
    .switch-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 28px;
    }

    .switch-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 8px 12px 12px;
      border-radius: 16px;
      border: 1px solid #F5F5F5;
      background: #FFFFFF;
      transition: background 0.2s ease, border-color 0.2s ease;
    }

    .switch-item:hover {
      background: #F5F5F5;
      border-color: #E5E5E5;
    }

    .switch-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .icon-wrapper {
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #000000;
    }

    .icon-wrapper svg {
      width: 24px;
      height: 24px;
      display: block;
    }

    .switch-label {
      font-size: 16px;
      font-weight: 500;
      color: #000000;
    }

    /* SVG 开关控件：纯内联 SVG + CSS 过渡 */
    .toggle-btn {
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50px;
      transition: all 0.2s ease;
      outline: none;
    }

    .toggle-btn:focus-visible {
      outline: 2px solid #000000;
      outline-offset: 2px;
    }

    .toggle-btn svg {
      width: 48px;
      height: 28px;
      display: block;
      transition: all 0.25s ease;
    }

    /* 开关状态：通过 CSS 控制 SVG 内部元素的颜色/位移 */
    .toggle-track {
      transition: fill 0.25s ease, stroke 0.25s ease;
    }

    .toggle-thumb {
      transition: transform 0.25s ease, fill 0.25s ease;
      transform-origin: center;
    }

    /* 关闭态（默认） */
    .toggle-btn[data-state="off"] .toggle-track {
      fill: #E5E5E5;
      stroke: #CCCCCC;
    }
    .toggle-btn[data-state="off"] .toggle-thumb {
      fill: #FFFFFF;
      stroke: #999999;
      transform: translateX(0);
    }

    /* 开启态 */
    .toggle-btn[data-state="on"] .toggle-track {
      fill: #000000;
      stroke: #000000;
    }
    .toggle-btn[data-state="on"] .toggle-thumb {
      fill: #FFFFFF;
      stroke: #FFFFFF;
      transform: translateX(20px);
    }

    /* 按钮点击反馈（极其重要） */
    .toggle-btn:active {
      transform: scale(0.92);
    }

    .toggle-btn:active .toggle-thumb {
      transform: translateX(0) scale(0.95);
    }
    .toggle-btn[data-state="on"]:active .toggle-thumb {
      transform: translateX(20px) scale(0.95);
    }

    /* 操作栏 */
    .actions {
      display: flex;
      gap: 10px;
      margin-bottom: 20px;
    }

    .btn {
      flex: 1;
      padding: 14px 16px;
      border-radius: 50px;
      border: 1px solid #E5E5E5;
      background: #FFFFFF;
      color: #000000;
      font-size: 15px;
      font-weight: 500;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.2s ease;
      text-align: center;
      line-height: 1.4;
      letter-spacing: 0.2px;
    }

    /* 悬停 */
    .btn:hover {
      background: #000000;
      color: #FFFFFF;
      border-color: #000000;
    }

    /* 按下：极其明显 */
    .btn:active {
      background: #000000;
      color: #FFFFFF;
      border-color: #000000;
      transform: scale(0.96);
    }

    /* 重置按钮特殊处理：悬停反色 */
    .btn-reset:hover {
      background: #000000;
      color: #FFFFFF;
      border-color: #000000;
    }
    .btn-reset:active {
      background: #333333;
      border-color: #333333;
      transform: scale(0.96);
    }

    /* 应用按钮：默认黑底白字 */
    .btn-apply {
      background: #000000;
      color: #FFFFFF;
      border-color: #000000;
    }
    .btn-apply:hover {
      background: #FFFFFF;
      color: #000000;
      border-color: #000000;
    }
    .btn-apply:active {
      background: #FFFFFF;
      color: #000000;
      border-color: #000000;
      transform: scale(0.96);
    }

    /* 状态提示条 */
    .status-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 16px;
      border-radius: 50px;
      border: 1px solid #E5E5E5;
      background: #F5F5F5;
      transition: background 0.2s ease, border-color 0.2s ease;
    }

    .status-bar svg {
      width: 20px;
      height: 20px;
      flex-shrink: 0;
      display: block;
      color: #666666;
    }

    .status-text {
      font-size: 14px;
      color: #666666;
      transition: color 0.2s ease;
    }

    /* 状态变化（有未保存更改时） */
    .status-bar.changed {
      background: #FFFFFF;
      border-color: #CCCCCC;
    }
    .status-bar.changed .status-text {
      color: #000000;
    }
    .status-bar.changed svg {
      color: #000000;
    }

    /* 小屏适配 */
    @media (max-width: 380px) {
      .panel {
        padding: 20px 16px 16px;
        border-radius: 20px;
      }
      h1 {
        font-size: 22px;
      }
      .switch-item {
        padding: 10px 6px 10px 10px;
      }
      .actions {
        flex-direction: column;
      }
      .btn {
        padding: 12px 14px;
      }
    }
  </style>
</head>
<body>
  <main class="panel">
    <!-- 标题区 -->
    <header class="header">
      <h1>极简设置面板</h1>
      <p class="subtitle">轻触开关，即刻生效</p>
    </header>

    <!-- 开关列表 -->
    <div class="switch-list" id="switchList">
      <!-- 动态插入开关项 -->
    </div>

    <!-- 操作栏 -->
    <div class="actions">
      <button class="btn btn-reset" id="resetBtn">重置</button>
      <button class="btn btn-apply" id="applyBtn">应用更改</button>
    </div>

    <!-- 状态提示条 -->
    <div class="status-bar" id="statusBar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
           stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="8" x2="12" y2="12" />
        <line x1="12" y1="16" x2="12.01" y2="16" />
      </svg>
      <span class="status-text" id="statusText">所有更改已保存</span>
    </div>
  </main>

  <script>
    (function() {
      // 配置从 head 中读取（已在全局定义）
      const items = CONFIG.items;
      const switchList = document.getElementById('switchList');
      const statusBar = document.getElementById('statusBar');
      const statusText = document.getElementById('statusText');

      // 状态存储：当前每个开关的值
      const state = {};
      // 保存原始默认值，用于重置
      const defaults = {};

      // 生成开关项
      function renderSwitches() {
        switchList.innerHTML = '';
        items.forEach(item => {
          // 初始化状态
          const saved = localStorage.getItem('toggle_' + item.id);
          let isOn;
          if (saved !== null) {
            isOn = saved === 'true';
          } else {
            isOn = item.default;
          }
          state[item.id] = isOn;
          defaults[item.id] = item.default;

          // 创建开关项容器
          const div = document.createElement('div');
          div.className = 'switch-item';

          // 左侧：图标 + 标签
          const leftDiv = document.createElement('div');
          leftDiv.className = 'switch-left';

          const iconSpan = document.createElement('span');
          iconSpan.className = 'icon-wrapper';
          // 内联 SVG 图标
          const iconSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
          iconSvg.setAttribute('viewBox', '0 0 24 24');
          iconSvg.setAttribute('fill', 'none');
          iconSvg.setAttribute('stroke', 'currentColor');
          iconSvg.setAttribute('stroke-width', '1.5');
          iconSvg.setAttribute('stroke-linecap', 'round');
          iconSvg.setAttribute('stroke-linejoin', 'round');
          iconSvg.setAttribute('aria-hidden', 'true');

          const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          path.setAttribute('d', ICONS[item.icon] || ICONS.info);
          iconSvg.appendChild(path);
          iconSpan.appendChild(iconSvg);

          const labelSpan = document.createElement('span');
          labelSpan.className = 'switch-label';
          labelSpan.textContent = item.label;

          leftDiv.appendChild(iconSpan);
          leftDiv.appendChild(labelSpan);
          div.appendChild(leftDiv);

          // 右侧：SVG 开关按钮
          const btn = document.createElement('button');
          btn.className = 'toggle-btn';
          btn.setAttribute('data-id', item.id);
          btn.setAttribute('data-state', isOn ? 'on' : 'off');
          btn.setAttribute('aria-label', item.label + (isOn ? ' 已开启' : ' 已关闭'));
          btn.setAttribute('role', 'switch');
          btn.setAttribute('aria-checked', isOn ? 'true' : 'false');

          // SVG 开关内容
          const toggleSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
          toggleSvg.setAttribute('viewBox', '0 0 48 28');
          toggleSvg.setAttribute('aria-hidden', 'true');

          // 轨道 (圆角矩形)
          const track = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
          track.setAttribute('class', 'toggle-track');
          track.setAttribute('x', '1');
          track.setAttribute('y', '1');
          track.setAttribute('width', '46');
          track.setAttribute('height', '26');
          track.setAttribute('rx', '13');
          track.setAttribute('ry', '13');
          track.setAttribute('stroke-width', '1.5');

          // 滑块 (圆形)
          const thumb = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
          thumb.setAttribute('class', 'toggle-thumb');
          thumb.setAttribute('cx', '14');
          thumb.setAttribute('cy', '14');
          thumb.setAttribute('r', '10');
          thumb.setAttribute('stroke-width', '1.5');

          toggleSvg.appendChild(track);
          toggleSvg.appendChild(thumb);
          btn.appendChild(toggleSvg);
          div.appendChild(btn);

          switchList.appendChild(div);
        });
      }

      // 更新开关状态视觉
      function updateToggleVisual(btn, isOn) {
        btn.setAttribute('data-state', isOn ? 'on' : 'off');
        btn.setAttribute('aria-checked', isOn ? 'true' : 'false');
        const label = btn.closest('.switch-item').querySelector('.switch-label').textContent;
        btn.setAttribute('aria-label', label + (isOn ? ' 已开启' : ' 已关闭'));
      }

      // 更新状态栏
      function updateStatusBar() {
        const currentState = {};
        items.forEach(item => {
          currentState[item.id] = state[item.id];
        });
        // 检查是否有变化
        let hasChanged = false;
        items.forEach(item => {
          if (state[item.id] !== defaults[item.id]) {
            hasChanged = true;
          }
        });
        if (hasChanged) {
          statusBar.classList.add('changed');
          statusText.textContent = CONFIG.status.changed;
        } else {
          statusBar.classList.remove('changed');
          statusText.textContent = CONFIG.status.idle;
        }
      }

      // 处理开关点击
      function handleToggleClick(e) {
        const btn = e.currentTarget;
        const id = btn.getAttribute('data-id');
        const newState = !state[id];
        state[id] = newState;
        updateToggleVisual(btn, newState);
        localStorage.setItem('toggle_' + id, newState);
        updateStatusBar();
      }

      // 重置到默认值
      function handleReset() {
        items.forEach(item => {
          const btn = document.querySelector(`.toggle-btn[data-id="${item.id}"]`);
          if (!btn) return;
          const defaultVal = defaults[item.id];
          state[item.id] = defaultVal;
          updateToggleVisual(btn, defaultVal);
          localStorage.setItem('toggle_' + item.id, defaultVal);
        });
        updateStatusBar();
        // 重置后状态栏短暂反馈
        statusBar.classList.remove('changed');
        statusText.textContent = CONFIG.status.idle;
      }

      // 应用更改（模拟保存）
      function handleApply() {
        // 将当前状态同步为默认值（即已保存）
        items.forEach(item => {
          defaults[item.id] = state[item.id];
          localStorage.setItem('toggle_' + item.id, state[item.id]);
        });
        updateStatusBar();
        // 短暂提示
        statusText.textContent = "所有更改已保存";
        statusBar.classList.remove('changed');
      }

      // 初始化
      function init() {
        renderSwitches();

        // 为每个开关按钮绑定事件
        document.querySelectorAll('.toggle-btn').forEach(btn => {
          btn.addEventListener('click', handleToggleClick);
        });

        // 绑定操作按钮
        document.getElementById('resetBtn').addEventListener('click', handleReset);
        document.getElementById('applyBtn').addEventListener('click', handleApply);

        // 初始化状态栏
        updateStatusBar();
      }

      // DOM 就绪后执行
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
</body>
</html>