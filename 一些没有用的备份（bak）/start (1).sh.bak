#!/bin/bash

echo "选择要启动的项目："
echo "1. Holistic (端口 8082)"
echo "2. 晃动工坊 (端口 8083)"
echo "3. Turbowarp (端口 8084)"
echo "4. 全部启动"
read -p "请输入数字: " choice

case $choice in
  1)
    cd /storage/emulated/0/html存放地/holistic_demo
    python -m http.server 8082
    ;;
  2)
    cd /storage/emulated/0/html存放地/晃动工坊
    python -m http.server 8083
    ;;
  3)
    cd /storage/emulated/0/html存放地/turbowarp.org
    python -m http.server 8084
    ;;
  4)
    cd /storage/emulated/0/html存放地/holistic_demo
    python -m http.server 8082 &
    cd /storage/emulated/0/html存放地/晃动工坊
    python -m http.server 8083 &
    cd /storage/emulated/0/html存放地/turbowarp.org
    python -m http.server 8084 &
    echo "全部项目已启动！"
    ;;
  *)
    echo "无效选择"
    ;;
esac