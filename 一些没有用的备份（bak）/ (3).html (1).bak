<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>暗夜烟雾壁纸</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            /* 和你截图一样的极暗紫底色 */
            background-color: #0d0410; 
            touch-action: none; /* 防止手机滑动刷新页面 */
        }
        canvas {
            display: block;
            width: 100vw;
            height: 100vh;
        }
    </style>
</head>
<body>
    <canvas id="fluid-canvas"></canvas>

    <!-- 引入流体库 -->
    <script src="https://cdn.jsdelivr.net/npm/webgl-fluid@0.3/dist/webgl-fluid.umd.js"></script>

    <script>
        window.addEventListener('load', () => {
            const canvas = document.getElementById('fluid-canvas');
            
            WebGLFluid(canvas, {
                // --- 模拟质量 ---
                SIM_RESOLUTION: 128,      
                DYE_RESOLUTION: 512,      // 降低一点分辨率，让边缘产生自然的柔和感
                
                // --- 核心物理：决定烟雾质感 ---
                DENSITY_DISSIPATION: 1.2, // 消散速度：稍微调快，让烟雾不要糊成一团
                VELOCITY_DISSIPATION: 0.2,// 阻力：小阻力让烟雾能像水/烟一样被推很远
                PRESSURE: 0.8,            
                CURL: 40,                 // 涡度：调高！这是让烟雾产生卷曲、翻滚、推挤感的关键
                SPLAT_RADIUS: 0.15,       // 笔刷大小：调小一点，手指划过时更细腻
                SPLAT_FORCE: 6000,        // 推力：手指推动烟雾的力度
                SHADING: true,            // 开启光影（让烟雾有 3D 的体积感，不是平面的）
                
                // --- 外观：去花哨化 ---
                COLORFUL: false,          // 关闭随机变色
                BLOOM: false,             // 关闭发光特效（太花哨了）
                SUNRAYS: false,           // 关闭阳光射线
                BACK_COLOR: { r: 13, g: 4, b: 16 }, // 画面底色
                
                // 固定一个暗紫红色的调色板
                COLOR_PALETTE: [
                    { r: 0.6, g: 0.05, b: 0.3 }, // 暗紫红
                    { r: 0.4, g: 0.02, b: 0.2 }, // 更深
                    { r: 0.8, g: 0.1, b: 0.4 }   // 微微亮一点的品红
                ]
            });
        });
    </script>
</body>
</html>