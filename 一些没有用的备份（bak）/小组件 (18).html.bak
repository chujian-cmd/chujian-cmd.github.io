<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>动态日历 - 拖拽分页版</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: #000;
            font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", STHeiti, "Microsoft Yahei", Tahoma, Simsun, sans-serif;
            -webkit-user-select: none;
            user-select: none; 
            -webkit-touch-callout: none;
            overflow: hidden; 
        }

        .pages-container {
            display: flex;
            width: 100vw;
            height: 100vh;
            overflow-x: auto;
            overflow-y: hidden;
            scroll-snap-type: x mandatory; 
            scroll-behavior: smooth;
            scrollbar-width: none; 
        }
        .pages-container::-webkit-scrollbar { display: none; }

        .page {
            flex: 0 0 100vw;
            width: 100vw;
            height: 100vh;
            scroll-snap-align: center;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-content: center;
            gap: clamp(20px, 4vw, 40px);
            padding: 40px;
            box-sizing: border-box;
            overflow-y: auto;
            scrollbar-width: none;
        }
        .page::-webkit-scrollbar { display: none; }

        .calendar-card {
            position: relative; 
            width: 100%;
            max-width: 480px; 
            flex: 1 1 320px; 
            border-radius: 24px;
            padding: clamp(20px, 4vw, 36px) clamp(20px, 5vw, 40px);
            overflow: hidden;
            background: 
                linear-gradient(to bottom, #000000 0%, rgba(0, 0, 0, 0.8) 30%, transparent 60%),
                radial-gradient(circle at 0% 100%, rgba(0, 80, 50, 0.9) 0%, rgba(0, 40, 25, 0.4) 40%, transparent 70%),
                radial-gradient(circle at 100% 80%, rgba(60, 20, 100, 0.6) 0%, transparent 60%),
                #040408;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
            transition: transform 0.5s cubic-bezier(0.25, 0.8, 0.25, 1), opacity 0.4s ease;
            transform-origin: center center;
            z-index: 10;
            will-change: transform, opacity;
            transform: translate3d(0, 0, 0);
            backface-visibility: hidden; 
            animation: popIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
        }

        @keyframes popIn {
            0% { opacity: 0; transform: scale(0.8) translateY(20px); }
            100% { opacity: 1; transform: scale(1) translateY(0); }
        }

        .calendar-card.is-minimized {
            transform: scale(0.9) translate3d(0, 0, 0);
            opacity: 0.9;
            transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease;
        }

        .calendar-card.is-hidden {
            transform: scale(0.5) translate3d(0, 50px, 0);
            opacity: 0;
            pointer-events: none; 
            transition: transform 0.4s ease-in, opacity 0.3s ease-in;
        }

        .close-btn {
            position: absolute; 
            top: 16px;
            right: 16px;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.1);
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0;
            visibility: hidden;
            transform: scale(0.5);
            transition: transform 0.25s ease, opacity 0.25s ease;
            pointer-events: none;
            z-index: 20;
        }

        .calendar-card.is-minimized .close-btn {
            opacity: 1;
            visibility: visible;
            transform: scale(1);
            transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease;
            pointer-events: auto;
        }

        .close-btn::before {
            content: '';
            width: 12px;
            height: 2px;
            background-color: #ffffff;
            border-radius: 1px;
        }

        .global-add-btn {
            position: fixed;
            bottom: 40px;
            right: 40px;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: linear-gradient(135deg, #00ff88 0%, #00ccff 100%);
            box-shadow: 0 10px 30px rgba(0, 255, 136, 0.4);
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            opacity: 0;
            visibility: hidden;
            transform: scale(0.5) translateY(20px);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) 0.1s;
            z-index: 100;
        }

        .global-add-btn.show {
            opacity: 1;
            visibility: visible;
            transform: scale(1) translateY(0);
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 0s;
        }

        .global-add-btn::before, .global-add-btn::after {
            content: '';
            position: absolute;
            background-color: #000;
            border-radius: 2px;
        }
        .global-add-btn::before { width: 20px; height: 3px; }
        .global-add-btn::after { width: 3px; height: 20px; }

        /* --- 🌟 底部圆点控制器区域 --- */
        .pagination {
            position: fixed;
            bottom: 20px; /* 往上提一点，让操作区域更大 */
            left: 50%;
            transform: translateX(-50%);
            display: flex;
            gap: 12px;
            padding: 15px 20px; /* 增加隐形内边距，使拖拽区域更大，更容易按住 */
            z-index: 100;
            opacity: 0;
            transition: opacity 0.3s;
            pointer-events: none;
            
            /* 禁止浏览器原生手势干扰拖拽 */
            touch-action: none; 
            cursor: grab;
        }

        .pagination:active {
            cursor: grabbing;
        }

        .pagination.show {
            opacity: 1;
            pointer-events: auto;
        }

        .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            cursor: pointer;
            pointer-events: none; /* 事件交给父容器处理，防止干扰拖拽 */
        }
        .dot.active {
            background: rgba(255, 255, 255, 0.9);
            transform: scale(1.3);
        }

        /* --- 内部样式 --- */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: clamp(16px, 3vw, 30px);
        }

        .title {
            color: #ffffff;
            font-size: clamp(36px, 6vw, 54px);
            font-weight: 400;
            line-height: 1;
            letter-spacing: 1px;
        }

        .subtitle {
            color: rgba(255, 255, 255, 0.45);
            font-size: clamp(10px, 2vw, 12px);
            font-weight: 300;
            letter-spacing: 2px;
            margin-bottom: 6px;
        }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            row-gap: clamp(10px, 2vw, 16px);
            text-align: center;
        }

        .weekday {
            color: rgba(255, 255, 255, 0.35);
            font-size: clamp(12px, 2vw, 14px);
            font-weight: 300;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .day {
            color: #ffffff;
            font-size: clamp(14px, 2.5vw, 18px);
            font-weight: 300;
            width: 100%;
            max-width: 40px;
            aspect-ratio: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0 auto;
        }

        .day.active {
            border: 1px solid rgba(160, 130, 255, 0.5);
            border-radius: 50%;
            background: rgba(120, 90, 255, 0.08);
            font-weight: 400;
        }

        .calendar-card::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 3px;
            background: linear-gradient(90deg, #00ff88 0%, #00ccff 30%, #6b21a8 100%);
            box-shadow: 0 -2px 10px rgba(0, 255, 136, 0.5);
            border-bottom-left-radius: 24px;
            border-bottom-right-radius: 24px;
        }
    </style>
</head>
<body>

    <div class="pages-container" id="pagesContainer"></div>
    <div class="pagination" id="pagination"></div>
    <div class="global-add-btn" id="addBtn"></div>

    <script>
        const pagesContainer = document.getElementById('pagesContainer');
        const addBtn = document.getElementById('addBtn');
        const pagination = document.getElementById('pagination');

        let pagesData = [[]]; 
        let currentPageIndex = 0;
        let isEditingMode = false;
        
        let pressTimer = null;
        let isLongPressTriggered = false;
        let touchStartX = 0;
        let touchStartY = 0;

        function getCalendarData() {
            const today = new Date();
            const weekdaysChinese = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
            const startOfWeek = new Date(today);
            startOfWeek.setDate(today.getDate() - today.getDay());
            const days = [];
            for (let i = 0; i < 7; i++) {
                const d = new Date(startOfWeek);
                d.setDate(startOfWeek.getDate() + i);
                days.push({
                    num: d.getDate(),
                    isToday: d.getDate() === today.getDate() && d.getMonth() === today.getMonth() && d.getFullYear() === today.getFullYear()
                });
            }
            return { weekdayTitle: weekdaysChinese[today.getDay()], days };
        }

        function createCard(pageIndex) {
            const { weekdayTitle, days } = getCalendarData();
            const card = document.createElement('div');
            card.className = 'calendar-card';
            card.dataset.pageIndex = pageIndex;

            card.innerHTML = `
                <div class="close-btn"></div>
                <div class="header">
                    <div class="title">${weekdayTitle}</div>
                    <div class="subtitle">CALENDAR</div>
                </div>
                <div class="calendar-grid">
                    <div class="weekday">日</div><div class="weekday">一</div>
                    <div class="weekday">二</div><div class="weekday">三</div>
                    <div class="weekday">四</div><div class="weekday">五</div>
                    <div class="weekday">六</div>
                </div>
            `;

            const grid = card.querySelector('.calendar-grid');
            days.forEach(day => {
                const dayDiv = document.createElement('div');
                dayDiv.className = `day ${day.isToday ? 'active' : ''}`;
                dayDiv.textContent = day.num;
                grid.appendChild(dayDiv);
            });

            card.querySelector('.close-btn').addEventListener('click', (e) => {
                e.stopPropagation();
                deleteCard(card);
            });

            return card;
        }

        function renderPagination() {
            pagination.innerHTML = '';
            if (pagesData.length > 1) {
                pagination.classList.add('show');
                pagesData.forEach((_, idx) => {
                    const dot = document.createElement('div');
                    dot.className = `dot ${idx === currentPageIndex ? 'active' : ''}`;
                    pagination.appendChild(dot);
                });
            } else {
                pagination.classList.remove('show');
            }
        }

        function scrollToPage(index, animate = true) {
            if (index < 0 || index >= pagesData.length) return;
            currentPageIndex = index;
            pagesContainer.scrollTo({
                left: index * window.innerWidth,
                behavior: animate ? 'smooth' : 'auto'
            });
            renderPagination();
        }

        function addNewCard() {
            let lastPageIdx = pagesData.length - 1;
            if (pagesData[lastPageIdx].length >= 3) {
                lastPageIdx++;
                pagesData.push([]);
                const newPageDOM = document.createElement('div');
                newPageDOM.className = 'page';
                newPageDOM.dataset.index = lastPageIdx;
                pagesContainer.appendChild(newPageDOM);
            }

            const card = createCard(lastPageIdx);
            pagesData[lastPageIdx].push(card);
            pagesContainer.querySelector(`.page[data-index="${lastPageIdx}"]`).appendChild(card);

            if (isEditingMode) {
                card.classList.add('is-minimized');
            }
            scrollToPage(lastPageIdx);
        }

        function deleteCard(card) {
            card.classList.add('is-hidden');
            setTimeout(() => {
                const pageIdx = parseInt(card.dataset.pageIndex);
                card.remove();
                pagesData[pageIdx] = pagesData[pageIdx].filter(c => c !== card);

                if (pagesData[pageIdx].length === 0 && pagesData.length > 1) {
                    pagesData.splice(pageIdx, 1);
                    rebuildPagesDOM();
                    scrollToPage(Math.max(0, pageIdx - 1), false);
                } else if (document.querySelectorAll('.calendar-card').length === 0) {
                    addNewCard();
                } else {
                    scrollToPage(currentPageIndex, false);
                }
            }, 400);
        }

        function rebuildPagesDOM() {
            pagesContainer.innerHTML = '';
            pagesData.forEach((pageCards, idx) => {
                const pageDOM = document.createElement('div');
                pageDOM.className = 'page';
                pageDOM.dataset.index = idx;
                pageCards.forEach(card => {
                    card.dataset.pageIndex = idx;
                    pageDOM.appendChild(card);
                });
                pagesContainer.appendChild(pageDOM);
            });
            renderPagination();
        }

        function init() {
            pagesData = [[]];
            pagesContainer.innerHTML = '';
            const pageDOM = document.createElement('div');
            pageDOM.className = 'page';
            pageDOM.dataset.index = 0;
            pagesContainer.appendChild(pageDOM);
            addNewCard();
        }
        init();

        // 监听滚动事件（原生滑动翻页）
        pagesContainer.addEventListener('scroll', () => {
            const index = Math.round(pagesContainer.scrollLeft / window.innerWidth);
            if (index !== currentPageIndex && index >= 0 && index < pagesData.length) {
                currentPageIndex = index;
                renderPagination();
            }
        });

        window.addEventListener('resize', () => {
            pagesContainer.scrollLeft = currentPageIndex * window.innerWidth;
        });

        // --- 🌟 拖拽分页控制器逻辑 ---
        let isDragging = false;
        let dragStartX = 0;
        let startScrollLeft = 0;
        let dragThreshold = 10; // 超过 10px 算拖拽，防止误触点击
        let hasMoved = false;

        pagination.addEventListener('pointerdown', (e) => {
            if (!isEditingMode) return; // 只能在编辑模式下拖拽，或者你希望任何时候都能拖？
            // 实际上不应该限制编辑模式，任何时候点击底部都能滑动
            
            isDragging = true;
            hasMoved = false;
            dragStartX = e.clientX;
            startScrollLeft = pagesContainer.scrollLeft;
            
            // 拖拽时取消 CSS 的强制吸附，手感更顺滑
            pagesContainer.style.scrollSnapType = 'none';
            pagesContainer.style.scrollBehavior = 'auto'; // 防止原生 smooth 冲突

            pagination.setPointerCapture(e.pointerId);
            e.preventDefault(); // 阻止原生选中或文本拖拽
        });

        pagination.addEventListener('pointermove', (e) => {
            if (!isDragging) return;
            
            const walk = (e.clientX - dragStartX);
            
            // 判断是否移动了足够的距离
            if (Math.abs(walk) > dragThreshold) {
                hasMoved = true;
            }

            if (hasMoved) {
                // 灵敏度系数设为 1.5，让滑动更省力
                pagesContainer.scrollLeft = startScrollLeft - (walk * 1.5);
            }
        });

        const endDrag = (e) => {
            if (!isDragging) return;
            isDragging = false;
            
            // 恢复吸附和 smooth 属性
            pagesContainer.style.scrollSnapType = 'x mandatory';
            pagesContainer.style.scrollBehavior = 'smooth';

            // 松手时，根据当前滚动位置计算最近的页，并吸附过去
            const index = Math.round(pagesContainer.scrollLeft / window.innerWidth);
            scrollToPage(index, true);

            // 如果只是点了一下没移动，说明是点击操作
            if (!hasMoved && e.type === 'pointerup') {
                // 获取点的是哪个 dot
                // 这里通过计算点击坐标对应的 index 即可，或者简单点，给 dot 加个属性
                // 但因为我们把 pointer-events 关掉了，这里需要自己算一下
                // 更简单的做法：给原本的 dot 加个 data-index，通过元素坐标判断
            }
        };

        pagination.addEventListener('pointerup', endDrag);
        pagination.addEventListener('pointercancel', endDrag);


        // --- 重新实现点击 dots 的点击事件 (因为 pointer-events: none 了) ---
        // 由于我们在 pagination 上拦截了 pointerdown，直接监听 click 可能失效。
        // 我们可以在 endDrag 中判断：如果 !hasMoved，则说明是点击。
        // 计算点击在哪个 dot 上。
        
        pagination.addEventListener('click', (e) => {
            // 如果没有移动，算作点击
            if (!hasMoved) {
                const rect = pagination.getBoundingClientRect();
                const clickX = e.clientX - rect.left;
                const dotWidth = 10;
                const gap = 12;
                const totalWidth = pagesData.length * dotWidth + (pagesData.length - 1) * gap;
                const startX = (rect.width - totalWidth) / 2; // 居中布局的起始点

                let clickedIndex = 0;
                for (let i = 0; i < pagesData.length; i++) {
                    const dotStart = startX + i * (dotWidth + gap);
                    const dotEnd = dotStart + dotWidth;
                    // 扩大点击判定范围
                    if (clickX >= dotStart - gap/2 && clickX <= dotEnd + gap/2) {
                        clickedIndex = i;
                        break;
                    }
                }
                scrollToPage(clickedIndex);
            }
            hasMoved = false; // 重置
        });


        // --- 长按编辑逻辑 ---
        const startPress = (e) => {
            if (isEditingMode) return;
            if (e.target === addBtn || e.target.closest('.close-btn') || e.target.closest('.pagination')) return;
            
            if (e.type === 'touchstart') {
                touchStartX = e.touches[0].clientX;
                touchStartY = e.touches[0].clientY;
            } else {
                touchStartX = e.clientX;
                touchStartY = e.clientY;
            }
            isLongPressTriggered = false;
            pressTimer = setTimeout(() => {
                isLongPressTriggered = true;
                enterEditMode();
            }, 500);
        };

        const cancelPress = () => {
            if (pressTimer) {
                clearTimeout(pressTimer);
                pressTimer = null;
            }
        };

        const handleMove = (e) => {
            if (!pressTimer) return;
            let currentX, currentY;
            if (e.type === 'touchmove') {
                currentX = e.touches[0].clientX;
                currentY = e.touches[0].clientY;
            } else {
                currentX = e.clientX;
                currentY = e.clientY;
            }
            if (Math.abs(currentX - touchStartX) > 10 || Math.abs(currentY - touchStartY) > 10) {
                cancelPress();
            }
        };

        document.addEventListener('mousedown', startPress);
        document.addEventListener('touchstart', startPress, { passive: true });
        document.addEventListener('mouseup', cancelPress);
        document.addEventListener('touchend', cancelPress);
        document.addEventListener('touchcancel', cancelPress);
        document.addEventListener('mousemove', handleMove);
        document.addEventListener('touchmove', handleMove, { passive: true });
        document.addEventListener('contextmenu', (e) => e.preventDefault());

        function enterEditMode() {
            isEditingMode = true;
            addBtn.classList.add('show');
            document.querySelectorAll('.calendar-card').forEach(card => {
                card.classList.add('is-minimized');
            });
            if (navigator.vibrate) navigator.vibrate(10);
        }

        function exitEditMode() {
            isEditingMode = false;
            addBtn.classList.remove('show');
            document.querySelectorAll('.calendar-card').forEach(card => {
                card.classList.remove('is-minimized');
            });
        }

        addBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            addNewCard();
        });

        document.addEventListener('click', (e) => {
            if (isLongPressTriggered) {
                isLongPressTriggered = false;
                return;
            }
            if (isEditingMode && !e.target.closest('.calendar-card') && e.target !== addBtn && !e.target.closest('.pagination')) {
                exitEditMode();
            }
        });

        document.addEventListener('touchstart', (e) => {
            if (isLongPressTriggered) {
                isLongPressTriggered = false;
                return;
            }
            if (isEditingMode && !e.target.closest('.calendar-card') && e.target !== addBtn && !e.target.closest('.pagination')) {
                exitEditMode();
            }
        }, { passive: true });
    </script>
</body>
</html>