<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>多组件日历 - 极致丝滑版</title>
<style>
    * { 
        margin: 0; padding: 0; box-sizing: border-box; 
        -webkit-tap-highlight-color: transparent;
        user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;
    }
    
    html, body {
        width: 100%; height: 100%;
        overflow: hidden; background: #000; color: #fff;
        font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", STHeiti, "Microsoft Yahei", Tahoma, Simsun, sans-serif;
        touch-action: none; overscroll-behavior: none;
    }

    #pages-viewport {
        width: 100vw; height: 100vh;
        overflow: hidden; position: relative;
    }

    #pages-track {
        display: flex; height: 100%;
        transform: translate3d(0, 0, 0);
        will-change: transform;
    }

    /* 每一页 */
    .page {
        width: 100vw; height: 100%;
        flex-shrink: 0;
        display: flex; flex-wrap: wrap;
        justify-content: center; align-content: center;
        gap: clamp(16px, 4vw, 30px);
        padding: 40px;
        box-sizing: border-box;
        overflow-y: auto; scrollbar-width: none;
    }
    .page::-webkit-scrollbar { display: none; }

    /* --- 日历卡片样式 --- */
    .calendar-card {
        position: relative; 
        width: 100%;
        max-width: 460px; 
        flex: 1 1 300px; 
        border-radius: 24px;
        padding: clamp(20px, 4vw, 32px) clamp(20px, 5vw, 40px);
        overflow: hidden;
        background: 
            linear-gradient(to bottom, #000000 0%, rgba(0, 0, 0, 0.8) 30%, transparent 60%),
            radial-gradient(circle at 0% 100%, rgba(0, 80, 50, 0.9) 0%, rgba(0, 40, 25, 0.4) 40%, transparent 70%),
            radial-gradient(circle at 100% 80%, rgba(60, 20, 100, 0.6) 0%, transparent 60%),
            #040408;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
        
        /* 缩放与淡出动画 */
        transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), 
                    opacity 0.4s ease, box-shadow 0.3s ease;
        transform-origin: center center;
        will-change: transform, opacity;
        transform: translate3d(0, 0, 0);
        
        animation: popIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
    }

    @keyframes popIn {
        0% { opacity: 0; transform: scale(0.8) translateY(20px); }
        100% { opacity: 1; transform: scale(1) translateY(0); }
    }

    /* 编辑模式缩小 */
    .calendar-card.is-minimized {
        transform: scale(0.9) translate3d(0, 0, 0);
        opacity: 0.85;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.6);
    }

    /* 删除淡出 */
    .calendar-card.is-hidden {
        transform: scale(0.5) translate3d(0, 50px, 0);
        opacity: 0;
        pointer-events: none; 
        transition: transform 0.3s ease-in, opacity 0.3s ease-in;
    }

    .close-btn {
        position: absolute; top: 16px; right: 16px;
        width: 32px; height: 32px; border-radius: 50%;
        background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.1);
        display: flex; justify-content: center; align-items: center;
        opacity: 0; visibility: hidden; transform: scale(0.5);
        transition: all 0.3s ease; pointer-events: none; z-index: 20;
    }
    .calendar-card.is-minimized .close-btn {
        opacity: 1; visibility: visible; transform: scale(1);
        pointer-events: auto; transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .close-btn::before { content: ''; width: 12px; height: 2px; background-color: #fff; border-radius: 1px; }

    /* 卡片内部布局 */
    .header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: clamp(16px, 3vw, 24px); }
    .title { color: #fff; font-size: clamp(34px, 6vw, 54px); font-weight: 400; line-height: 1; letter-spacing: 1px; }
    .subtitle { color: rgba(255, 255, 255, 0.45); font-size: clamp(10px, 2vw, 12px); font-weight: 300; letter-spacing: 2px; margin-bottom: 6px; }
    .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); row-gap: clamp(10px, 2vw, 16px); text-align: center; }
    .weekday { color: rgba(255, 255, 255, 0.35); font-size: clamp(12px, 2vw, 14px); font-weight: 300; }
    .day { color: #fff; font-size: clamp(14px, 2.5vw, 18px); font-weight: 300; width: 100%; max-width: 40px; aspect-ratio: 1; display: flex; justify-content: center; align-items: center; margin: 0 auto; }
    .day.active { border: 1px solid rgba(160, 130, 255, 0.5); border-radius: 50%; background: rgba(120, 90, 255, 0.08); font-weight: 400; }
    
    .calendar-card::after {
        content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 3px;
        background: linear-gradient(90deg, #00ff88 0%, #00ccff 30%, #6b21a8 100%);
        box-shadow: 0 -2px 10px rgba(0, 255, 136, 0.5); border-bottom-left-radius: 24px; border-bottom-right-radius: 24px;
    }

    /* --- 底部控制条（滑块引擎） --- */
    #control-bar {
        position: fixed; bottom: 0; left: 0; width: 100%; height: 100px;
        display: flex; justify-content: center; align-items: center; z-index: 10; pointer-events: none;
    }
    #dots-track {
        position: relative; display: flex; align-items: center; gap: 24px; padding: 18px 28px;
        background: rgba(255,255,255,0.12); border-radius: 40px; backdrop-filter: blur(10px);
        pointer-events: auto; touch-action: none;
        transition: opacity 0.3s ease;
    }
    .dot { width: 12px; height: 12px; border-radius: 50%; background: rgba(255,255,255,0.35); flex-shrink: 0; }
    #slider {
        position: absolute; top: 50%; width: 22px; height: 22px; margin-top: -11px; margin-left: -11px;
        border-radius: 50%; background: #fff; box-shadow: 0 0 16px rgba(255,255,255,0.6), 0 2px 8px rgba(0,0,0,0.3);
        pointer-events: none; left: 0; transform: scale(1); will-change: left, transform;
    }
    #slider.dragging { transform: scale(1.3); }

    /* --- 浮动添加按钮 --- */
    .global-add-btn {
        position: fixed; bottom: 40px; right: 40px; width: 60px; height: 60px; border-radius: 50%;
        background: linear-gradient(135deg, #00ff88 0%, #00ccff 100%); box-shadow: 0 10px 30px rgba(0, 255, 136, 0.4);
        display: flex; justify-content: center; align-items: center;
        opacity: 0; visibility: hidden; transform: scale(0.5) translateY(20px);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) 0.1s; z-index: 100; cursor: pointer;
    }
    .global-add-btn.show { opacity: 1; visibility: visible; transform: scale(1) translateY(0); transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 0s; }
    .global-add-btn::before, .global-add-btn::after { content: ''; position: absolute; background-color: #000; border-radius: 2px; }
    .global-add-btn::before { width: 20px; height: 3px; }
    .global-add-btn::after { width: 3px; height: 20px; }
</style>
</head>
<body>

    <div id="pages-viewport">
        <div id="pages-track"></div>
    </div>

    <div class="global-add-btn" id="addBtn"></div>

    <div id="control-bar">
        <div id="dots-track">
            <!-- 圆点和滑块由 JS 生成 -->
            <div id="slider"></div>
        </div>
    </div>

<script>
(function() {
    'use strict';

    // ================= 数据与 DOM 变量 =================
    const pagesTrack = document.getElementById('pages-track');
    const dotsTrack = document.getElementById('dots-track');
    const slider = document.getElementById('slider');
    const addBtn = document.getElementById('addBtn');
    
    let pagesData = []; // 二维数组，存每一页的卡片 DOM
    let PAGE_COUNT = 0;
    let pageWidth = window.innerWidth;
    let isEditingMode = false;

    // ================= 渲染引擎参数 =================
    let progress = 0, targetProgress = 0, currentPage = 0;
    let rafId = null, dragging = false, dragSource = null;
    let startX = 0, startY = 0, startProgress = 0;
    let isPressing = false, longPressTimer = null, pressedDotIndex = -1;
    let activeTouchId = null, lastTouchTime = 0;
    let dotCenters = [], dotSpacing = 1, lastSnapped = -1;

    // ================= 日历数据生成 =================
    function getCalendarData() {
        const today = new Date();
        const weekdaysChinese = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
        const startOfWeek = new Date(today);
        startOfWeek.setDate(today.getDate() - today.getDay());
        const days = [];
        for (let i = 0; i < 7; i++) {
            const d = new Date(startOfWeek);
            d.setDate(startOfWeek.getDate() + i);
            days.push({
                num: d.getDate(),
                isToday: d.getDate() === today.getDate() && d.getMonth() === today.getMonth() && d.getFullYear() === today.getFullYear()
            });
        }
        return { weekdayTitle: weekdaysChinese[today.getDay()], days };
    }

    // 创建卡片 DOM
    function createCardElement() {
        const { weekdayTitle, days } = getCalendarData();
        const card = document.createElement('div');
        card.className = 'calendar-card';
        card.innerHTML = `
            <div class="close-btn"></div>
            <div class="header">
                <div class="title">${weekdayTitle}</div>
                <div class="subtitle">CALENDAR</div>
            </div>
            <div class="calendar-grid">
                <div class="weekday">日</div><div class="weekday">一</div>
                <div class="weekday">二</div><div class="weekday">三</div>
                <div class="weekday">四</div><div class="weekday">五</div>
                <div class="weekday">六</div>
            </div>
        `;
        const grid = card.querySelector('.calendar-grid');
        days.forEach(day => {
            const dayDiv = document.createElement('div');
            dayDiv.className = `day ${day.isToday ? 'active' : ''}`;
            dayDiv.textContent = day.num;
            grid.appendChild(dayDiv);
        });
        
        // 绑定删除按钮事件
        card.querySelector('.close-btn').addEventListener('click', (e) => {
            e.stopPropagation();
            deleteCard(card);
        });

        return card;
    }

    // ================= 核心布局刷新 =================
    function refreshLayout() {
        // 1. 清理旧 DOM
        pagesTrack.innerHTML = '';
        const oldDots = dotsTrack.querySelectorAll('.dot');
        oldDots.forEach(d => d.remove());

        PAGE_COUNT = pagesData.length;
        pagesTrack.style.width = (PAGE_COUNT * 100) + 'vw';

        // 2. 渲染新页面和卡片
        pagesData.forEach((pageCards, pageIdx) => {
            const pageDiv = document.createElement('div');
            pageDiv.className = 'page';
            pageCards.forEach(card => {
                if (isEditingMode) card.classList.add('is-minimized');
                else card.classList.remove('is-minimized');
                pageDiv.appendChild(card);
            });
            pagesTrack.appendChild(pageDiv);

            // 3. 渲染圆点 (放在滑块前面)
            const dot = document.createElement('div');
            dot.className = 'dot';
            dotsTrack.insertBefore(dot, slider);
        });

        // 4. 重新测量位置并吸附
        measure();
        
        // 确保当前页码合法
        if (currentPage >= PAGE_COUNT) currentPage = PAGE_COUNT - 1;
        settleTo(currentPage);
    }

    function measure() {
        pageWidth = window.innerWidth;
        const trackRect = dotsTrack.getBoundingClientRect();
        const dots = dotsTrack.querySelectorAll('.dot');
        dotCenters = [];
        
        dots.forEach(d => {
            const r = d.getBoundingClientRect();
            dotCenters.push(r.left - trackRect.left + r.width / 2);
        });
        
        dotSpacing = dotCenters.length > 1
            ? (dotCenters[dotCenters.length - 1] - dotCenters[0]) / (dotCenters.length - 1)
            : 1;
            
        // 如果只有一页，隐藏控制器
        if (PAGE_COUNT <= 1) {
            dotsTrack.style.opacity = '0';
            dotsTrack.style.pointerEvents = 'none';
        } else {
            dotsTrack.style.opacity = '1';
            dotsTrack.style.pointerEvents = 'auto';
        }
    }

    // ================= 渲染与平滑引擎 (来自你的代码) =================
    function renderPage(animate) {
        pagesTrack.style.transition = animate ? 'transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)' : 'none';
        pagesTrack.style.transform = 'translate3d(' + (-progress * pageWidth) + 'px, 0, 0)';
    }

    function renderSlider(animate) {
        if (PAGE_COUNT <= 1) return;
        const snapped = Math.max(0, Math.min(Math.round(progress), PAGE_COUNT - 1));
        if (!animate && snapped === lastSnapped) return;
        lastSnapped = snapped;

        const cx = dotCenters[snapped];
        const leftEase = animate ? 'left 0.6s cubic-bezier(0.25, 1, 0.5, 1)' : 'left 0.45s cubic-bezier(0.25, 1, 0.5, 1)';
        slider.style.transition = leftEase + ', transform 0.22s ease';
        slider.style.left = cx + 'px';
    }

    function lerpLoop() {
        const diff = targetProgress - progress;
        if (Math.abs(diff) < 0.0008) {
            progress = targetProgress;
            renderPage(false);
            renderSlider(false);
            rafId = null;
            return;
        }
        progress += diff * 0.18;
        renderPage(false);
        renderSlider(false);
        rafId = requestAnimationFrame(lerpLoop);
    }

    function startLerp() { if (!rafId) rafId = requestAnimationFrame(lerpLoop); }
    function stopLerp() { if (rafId) { cancelAnimationFrame(rafId); rafId = null; } }

    function settleTo(idx) {
        idx = Math.max(0, Math.min(idx, PAGE_COUNT - 1));
        currentPage = idx;
        progress = idx;
        targetProgress = idx;
        lastSnapped = idx;
        renderPage(true);
        renderSlider(true);
    }

    function nearestDotIndex(localX) {
        let best = 0, bestDist = Infinity;
        for (let i = 0; i < dotCenters.length; i++) {
            const d = Math.abs(dotCenters[i] - localX);
            if (d < bestDist) { bestDist = d; best = i; }
        }
        return best;
    }

    // ================= 手势与编辑逻辑 =================

    function clearLP() {
        if (longPressTimer) { clearTimeout(longPressTimer); longPressTimer = null; }
    }

    function enterEditMode() {
        if (isEditingMode) return;
        isEditingMode = true;
        addBtn.classList.add('show');
        document.querySelectorAll('.calendar-card').forEach(c => c.classList.add('is-minimized'));
        if (navigator.vibrate) navigator.vibrate(10);
    }

    function exitEditMode() {
        if (!isEditingMode) return;
        isEditingMode = false;
        addBtn.classList.remove('show');
        document.querySelectorAll('.calendar-card').forEach(c => c.classList.remove('is-minimized'));
    }

    function begin(x, y, source, dotIdx) {
        stopLerp();
        startX = x; startY = y;
        startProgress = progress; targetProgress = progress;
        dragSource = source; dragging = false; isPressing = true;
        pressedDotIndex = dotIdx != null ? dotIdx : -1;

        clearLP();
        // 🌟 长按 500ms 进入编辑模式
        longPressTimer = setTimeout(() => {
            if (isPressing && !dragging) {
                enterEditMode();
                pressedDotIndex = -1;
            }
        }, 500);
    }

    function move(x, y, e) {
        if (!isPressing) return;
        const dx = x - startX;
        const dy = y - startY;

        if (!dragging) {
            if (Math.abs(dx) > 8 || Math.abs(dy) > 8) clearLP(); // 移动则取消长按
            // 判定横向滑动
            if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 8) {
                dragging = true;
                pressedDotIndex = -1;
                slider.classList.add('dragging');
            }
        }

        if (!dragging) return;
        if (e && e.cancelable) e.preventDefault();

        let p;
        if (dragSource === 'page') {
            p = startProgress - dx / pageWidth;
        } else {
            p = startProgress + dx / dotSpacing;
        }

        targetProgress = Math.max(0, Math.min(p, PAGE_COUNT - 1));
        startLerp();
    }

    function end(x, y) {
        clearLP();
        if (!isPressing) return;

        if (dragging) {
            // 滑动结束，吸附到最近页
            const target = Math.round(targetProgress);
            settleTo(target);
        } else if (pressedDotIndex >= 0) {
            // 点击了底部圆点
            settleTo(pressedDotIndex);
        } else {
            // 纯点击事件
            // 判定点击：如果点击在卡片外面，且处于编辑模式，则退出
            const isClickingCard = e => e.target.closest('.calendar-card') || e.target.closest('.global-add-btn');
            if (isEditingMode && !isClickingCard({ target: document.elementFromPoint(x, y) })) {
                exitEditMode();
            }
        }

        dragging = false;
        isPressing = false;
        pressedDotIndex = -1;
        slider.classList.remove('dragging');
    }

    function cancel() {
        clearLP();
        if (!isPressing) return;
        dragging = false; isPressing = false; pressedDotIndex = -1;
        slider.classList.remove('dragging');
        stopLerp();
        settleTo(currentPage);
    }

    // ================= 添加/删除业务 =================

    function addNewCard() {
        if (pagesData.length === 0) pagesData.push([]);
        
        let lastPageIdx = pagesData.length - 1;
        // 如果最后一页满了 3 个，新建一页
        if (pagesData[lastPageIdx].length >= 3) {
            lastPageIdx++;
            pagesData.push([]);
        }

        const newCard = createCardElement();
        pagesData[lastPageIdx].push(newCard);
        
        refreshLayout();
        
        // 动画滚动到新添加的卡片所在的页
        setTimeout(() => {
            currentPage = lastPageIdx;
            settleTo(lastPageIdx);
        }, 50);
    }

    function deleteCard(card) {
        card.classList.add('is-hidden');
        
        setTimeout(() => {
            let pageIdx = -1, cardIdx = -1;
            // 找到该卡片所在的页和位置
            for (let i = 0; i < pagesData.length; i++) {
                const idx = pagesData[i].indexOf(card);
                if (idx > -1) { pageIdx = i; cardIdx = idx; break; }
            }

            if (pageIdx > -1) {
                pagesData[pageIdx].splice(cardIdx, 1);
                
                // 如果该页空了，删掉这一页
                if (pagesData[pageIdx].length === 0 && pagesData.length > 1) {
                    pagesData.splice(pageIdx, 1);
                }
                // 如果全删光了，保底留一个
                if (pagesData.length === 0) {
                    pagesData.push([]);
                }
                
                // 如果当前停留在被删的页，且页数变少了，往前退一页
                if (currentPage >= pagesData.length) {
                    currentPage = pagesData.length - 1;
                }
                
                refreshLayout();
            }
        }, 300); // 对应淡出动画时间
    }

    // ================= 事件绑定 =================

    document.addEventListener('touchstart', function(e) {
        if (activeTouchId !== null || e.touches.length !== 1) return;
        const t = e.touches[0];
        activeTouchId = t.identifier;
        lastTouchTime = Date.now();

        if (e.target.closest('#dots-track') && PAGE_COUNT > 1) {
            const rect = dotsTrack.getBoundingClientRect();
            const idx = nearestDotIndex(t.clientX - rect.left);
            begin(t.clientX, t.clientY, 'slider', idx);
        } else {
            begin(t.clientX, t.clientY, 'page', -1);
        }
    }, { passive: true });

    document.addEventListener('touchmove', function(e) {
        if (activeTouchId === null) return;
        for (let i = 0; i < e.touches.length; i++) {
            if (e.touches[i].identifier === activeTouchId) {
                move(e.touches[i].clientX, e.touches[i].clientY, e);
                break;
            }
        }
    }, { passive: false });

    document.addEventListener('touchend', function(e) {
        if (activeTouchId === null) return;
        for (let i = 0; i < e.changedTouches.length; i++) {
            if (e.changedTouches[i].identifier === activeTouchId) {
                end(e.changedTouches[i].clientX, e.changedTouches[i].clientY);
                activeTouchId = null;
                lastTouchTime = Date.now();
                break;
            }
        }
    });

    document.addEventListener('touchcancel', function() {
        activeTouchId = null;
        cancel();
    });

    // PC 鼠标兼容
    document.addEventListener('mousedown', function(e) {
        if (e.button !== 0 || Date.now() - lastTouchTime < 500) return;
        if (e.target.closest('#dots-track') && PAGE_COUNT > 1) {
            const rect = dotsTrack.getBoundingClientRect();
            const idx = nearestDotIndex(e.clientX - rect.left);
            begin(e.clientX, e.clientY, 'slider', idx);
        } else {
            begin(e.clientX, e.clientY, 'page', -1);
        }
    });

    document.addEventListener('mousemove', function(e) {
        if (!isPressing) return;
        move(e.clientX, e.clientY, e);
    });

    document.addEventListener('mouseup', function(e) {
        if (!isPressing) return;
        end(e.clientX, e.clientY);
    });

    addBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        addNewCard();
    });

    window.addEventListener('resize', function() {
        measure();
        progress = currentPage; targetProgress = currentPage; lastSnapped = currentPage;
        renderPage(false); renderSlider(false);
    });

    // ================= 初始化 =================
    function init() {
        // 初始放两页，第一页放 3 个，第二页放 1 个，方便直接测试拖拽效果
        pagesData = [
            [createCardElement(), createCardElement(), createCardElement()],
            [createCardElement()]
        ];
        refreshLayout();
    }
    
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
    window.addEventListener('load', function() {
        measure();
        renderPage(false);
        renderSlider(false);
    });

})();
</script>
</body>
</html>