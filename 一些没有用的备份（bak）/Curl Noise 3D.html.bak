<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no">
<title>涡流聚焦</title>
<style>
  html, body { margin: 0; height: 100%; overflow: hidden; background: #05060c; }
  canvas { display: block; width: 100%; height: 100%; touch-action: none; }
</style>
</head>
<body>
<canvas id="cv"></canvas>
<script>
(() => {
  const cv = document.getElementById('cv');
  const ctx = cv.getContext('2d');

  let W, H, dpr;
  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = window.innerWidth;
    H = window.innerHeight;
    cv.width = W * dpr;
    cv.height = H * dpr;
    cv.style.width = W + 'px';
    cv.style.height = H + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  resize();
  window.addEventListener('resize', resize);

  const N = 2200;
  const x = new Float32Array(N);
  const y = new Float32Array(N);
  const z = new Float32Array(N);
  const vx = new Float32Array(N);
  const vy = new Float32Array(N);
  const vz = new Float32Array(N);

  const BOX = 10;
  const CAM_DIST = 25;

  // 5 个引力点（动态移动）
  const N_ATTR = 5;
  const attr = [];
  for (let i = 0; i < N_ATTR; i++) {
    attr.push({
      x: (Math.random() - 0.5) * BOX * 1.2,
      y: (Math.random() - 0.5) * BOX * 1.2,
      z: (Math.random() - 0.5) * BOX * 1.2,
      phase: Math.random() * Math.PI * 2,
      speed: 0.15 + Math.random() * 0.3,
      amp: 2 + Math.random() * 3
    });
  }

  function resetParticle(i) {
    x[i] = (Math.random() - 0.5) * BOX * 2;
    y[i] = (Math.random() - 0.5) * BOX * 2;
    z[i] = (Math.random() - 0.5) * BOX * 2;
    vx[i] = 0; vy[i] = 0; vz[i] = 0;
  }

  for (let i = 0; i < N; i++) resetParticle(i);

  // 3D 噪声
  function noise3(x, y, z) {
    return Math.sin(x * 1.31 + y * 2.17 + z * 0.71) * 0.55
         + Math.sin(x * 2.91 - y * 0.83 + z * 1.97 + 1.7) * 0.30
         + Math.sin(x * 0.53 - y * 1.43 - z * 3.07 + 4.3) * 0.15;
  }

  const EPS = 0.15;
  const curlOut = [0, 0, 0];
  function curl3(fx, fy, fz, t) {
    const ev = t * 0.3;
    const dndx = (noise3(fx + EPS, fy, fz + ev) - noise3(fx - EPS, fy, fz + ev)) / (2 * EPS);
    const dndy = (noise3(fx, fy + EPS, fz + ev) - noise3(fx, fy - EPS, fz + ev)) / (2 * EPS);
    const dndz = (noise3(fx, fy, fz + EPS + ev) - noise3(fx, fy, fz - EPS + ev)) / (2 * EPS);
    curlOut[0] = dndy - dndz;
    curlOut[1] = dndz - dndx;
    curlOut[2] = dndx - dndy;
    return curlOut;
  }

  let startTime = performance.now();
  let yaw = 0;
  let pitch = 0.3;

  let dragging = false;
  let lastX = 0, lastY = 0;
  cv.addEventListener('mousedown', e => { dragging = true; lastX = e.clientX; lastY = e.clientY; });
  window.addEventListener('mouseup', () => { dragging = false; });
  cv.addEventListener('mousemove', e => {
    if (!dragging) return;
    yaw += (e.clientX - lastX) * 0.01;
    pitch += (e.clientY - lastY) * 0.01;
    pitch = Math.max(-1.4, Math.min(1.4, pitch));
    lastX = e.clientX; lastY = e.clientY;
  });
  cv.addEventListener('touchstart', e => {
    dragging = true;
    lastX = e.touches[0].clientX; lastY = e.touches[0].clientY;
    e.preventDefault();
  }, { passive: false });
  cv.addEventListener('touchmove', e => {
    if (!dragging) return;
    yaw += (e.touches[0].clientX - lastX) * 0.01;
    pitch += (e.touches[0].clientY - lastY) * 0.01;
    pitch = Math.max(-1.4, Math.min(1.4, pitch));
    lastX = e.touches[0].clientX; lastY = e.touches[0].clientY;
    e.preventDefault();
  }, { passive: false });
  cv.addEventListener('touchend', () => { dragging = false; });

  function loop(now) {
    const t = (now - startTime) / 1000;

    ctx.fillStyle = 'rgba(5,6,12,0.10)';
    ctx.fillRect(0, 0, W, H);

    yaw += 0.0025;

    const cosY = Math.cos(yaw), sinY = Math.sin(yaw);
    const cosX = Math.cos(pitch), sinX = Math.sin(pitch);

    // 更新引力点位置（缓慢游动）
    for (const a of attr) {
      a.x = Math.sin(t * a.speed + a.phase) * a.amp;
      a.y = Math.cos(t * a.speed * 1.3 + a.phase * 1.7) * a.amp;
      a.z = Math.sin(t * a.speed * 0.7 + a.phase * 2.3) * a.amp;
    }

    ctx.globalCompositeOperation = 'lighter';

    const NS = 0.25;
    const GRAVITY = 60;

    for (let i = 0; i < N; i++) {
      // Curl 场
      const c = curl3(x[i] * NS, y[i] * NS, z[i] * NS, t);
      let ax = c[0] * 35;
      let ay = c[1] * 35;
      let az = c[2] * 35;

      // 引力：找最近的引力点，朝它吸
      let bestDist2 = 1e9;
      let bestA = null;
      for (const a of attr) {
        const dx = a.x - x[i], dy = a.y - y[i], dz = a.z - z[i];
        const d2 = dx * dx + dy * dy + dz * dz;
        if (d2 < bestDist2) {
          bestDist2 = d2;
          bestA = a;
        }
      }
      if (bestA) {
        const dx = bestA.x - x[i];
        const dy = bestA.y - y[i];
        const dz = bestA.z - z[i];
        const d = Math.sqrt(bestDist2) + 0.5;
        const f = GRAVITY / (d * d + 5);
        ax += dx / d * f;
        ay += dy / d * f;
        az += dz / d * f;
      }

      vx[i] = (vx[i] + ax * 0.016) * 0.95;
      vy[i] = (vy[i] + ay * 0.016) * 0.95;
      vz[i] = (vz[i] + az * 0.016) * 0.95;

      let xx = x[i] + vx[i] * 0.5;
      let yy = y[i] + vy[i] * 0.5;
      let zz = z[i] + vz[i] * 0.5;

      if (xx < -BOX || xx > BOX || yy < -BOX || yy > BOX || zz < -BOX || zz > BOX) {
        resetParticle(i);
        xx = x[i]; yy = y[i]; zz = z[i];
      }

      x[i] = xx; y[i] = yy; z[i] = zz;

      // 3D 旋转
      const x1 = xx * cosY - zz * sinY;
      const z1 = xx * sinY + zz * cosY;
      const y1 = yy * cosX - z1 * sinX;
      const z2p = yy * sinX + z1 * cosX;

      const denom = CAM_DIST + z2p;
      const persp = 1.8 / denom;
      const sx = W * 0.5 + x1 * W * 0.5 * persp;
      const sy = H * 0.5 + y1 * H * 0.5 * persp;

      const depth = Math.max(0, Math.min(1, (z2p + BOX) / (BOX * 2)));
      const alpha = (1 - depth) * 0.7 + 0.2;

      const sp = Math.sqrt(vx[i] * vx[i] + vy[i] * vy[i] + vz[i] * vz[i]);
      const k = Math.max(0, Math.min(1, sp / 10));
      const r = Math.floor(91 + (255 - 91) * k);
      const g = Math.floor(224 + (107 - 224) * k);
      const b = Math.floor(255 + (214 - 255) * k);

      ctx.fillStyle = `rgba(${r},${g},${b},${alpha.toFixed(3)})`;
      ctx.fillRect(sx - 0.8, sy - 0.8, 1.6, 1.6);
    }

    ctx.globalCompositeOperation = 'source-over';
    requestAnimationFrame(loop);
  }

  requestAnimationFrame(loop);
})();
</script>
</body>
</html>