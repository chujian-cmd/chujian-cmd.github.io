<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>多组件日历 - 流体烟雾版</title>
<style>
    * { margin:0; padding:0; box-sizing:border-box;
        -webkit-tap-highlight-color:transparent;
        user-select:none; -webkit-user-select:none; -webkit-touch-callout:none; }
    html, body {
        width:100%; height:100%; overflow:hidden; background:#000; color:#fff;
        font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue",STHeiti,"Microsoft Yahei",Tahoma,Simsun,sans-serif;
        touch-action:none; overscroll-behavior:none;
    }

    #fluid-bg {
        position:fixed; inset:0; width:100vw; height:100vh;
        z-index:0; pointer-events:none; display:block; touch-action:none;
    }

    #gesture-layer {
        position:fixed; inset:0; width:100vw; height:100vh;
        z-index:1; pointer-events:auto; touch-action:none;
        background:transparent;
    }

    #pages-viewport {
        width:100vw; height:100vh; overflow:hidden; position:relative;
        touch-action:none; z-index:2; pointer-events:none;
    }
    #pages-track {
        display:flex; height:100%;
        transform:translate3d(0,0,0);
        will-change:transform;
        touch-action:none;
        contain:layout style paint;
        pointer-events:none;
    }
    .page {
        width:100vw; height:100%; flex-shrink:0;
        display:flex; flex-wrap:wrap; justify-content:center; align-content:center;
        gap:clamp(16px,4vw,30px); padding:40px; box-sizing:border-box; touch-action:none;
        pointer-events:none;
    }

    .calendar-card {
        position:relative; width:100%; max-width:460px; flex:1 1 300px; max-height:45vh;
        border-radius:24px; padding:clamp(20px,4vw,32px) clamp(20px,5vw,40px);
        overflow:hidden;
        background:
            linear-gradient(to bottom, rgba(0,0,0,.42) 0%, rgba(0,0,0,.22) 40%, rgba(0,0,0,.08) 70%),
            rgba(4,4,8,.16);
        box-shadow:0 20px 50px rgba(0,0,0,.45);
        transition:transform .45s cubic-bezier(.34,1.56,.64,1), opacity .45s ease;
        transform-origin:center center;
        will-change:transform, opacity;
        transform:translate3d(0,0,0);
        backface-visibility:hidden;
        touch-action:none;
        contain:layout paint;
        pointer-events:auto;
        z-index:3;
    }
    .animate-fade-in { animation:fadeIn .55s ease-out backwards; }
    @keyframes fadeIn { 0%{opacity:0;} 100%{opacity:1;} }
    .calendar-card.is-minimized {
        transform:scale(.9) translate3d(0,0,0); opacity:.85;
        box-shadow:0 10px 20px rgba(0,0,0,.6);
    }
    .calendar-card.is-hidden {
        opacity:0; transform:scale(.92); pointer-events:none;
        transition:opacity .22s ease, transform .22s ease;
    }
    .close-btn {
        position:absolute; top:16px; right:16px; width:32px; height:32px; border-radius:50%;
        background:rgba(255,255,255,.18); border:1px solid rgba(255,255,255,.15);
        display:flex; justify-content:center; align-items:center;
        opacity:0; visibility:hidden; transform:scale(.5);
        transition:transform .3s ease, opacity .3s ease, visibility .3s;
        will-change:transform, opacity; pointer-events:none; z-index:20;
    }
    .calendar-card.is-minimized .close-btn {
        opacity:1; visibility:visible; transform:scale(1);
        transition:transform .35s cubic-bezier(.34,1.56,.64,1), opacity .3s ease;
        pointer-events:auto;
    }
    .close-btn::before { content:''; width:12px; height:2px; background:#fff; border-radius:1px; }

    .header { display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:clamp(16px,3vw,24px); }
    .title { color:#fff; font-size:clamp(34px,6vw,54px); font-weight:400; line-height:1; letter-spacing:1px; text-shadow:0 2px 8px rgba(0,0,0,.9); }
    .subtitle { color:rgba(255,255,255,.55); font-size:clamp(10px,2vw,12px); font-weight:300; letter-spacing:2px; margin-bottom:6px; text-shadow:0 1px 4px rgba(0,0,0,.9); }
    .calendar-grid { display:grid; grid-template-columns:repeat(7,1fr); row-gap:clamp(10px,2vw,16px); text-align:center; }
    .weekday { color:rgba(255,255,255,.5); font-size:clamp(12px,2vw,14px); font-weight:300; text-shadow:0 1px 4px rgba(0,0,0,.9); }
    .day { color:#fff; font-size:clamp(14px,2.5vw,18px); font-weight:300; width:100%; max-width:40px; aspect-ratio:1; display:flex; justify-content:center; align-items:center; margin:0 auto; text-shadow:0 1px 4px rgba(0,0,0,.9); }
    .day.active { border:1px solid rgba(160,130,255,.6); border-radius:50%; background:rgba(120,90,255,.15); font-weight:400; }

    .calendar-card::after {
        content:''; position:absolute; bottom:0; left:0; width:100%; height:3px;
        background:linear-gradient(90deg,#00ff88 0%,#00ccff 30%,#6b21a8 100%);
        box-shadow:0 -2px 10px rgba(0,255,136,.5); border-bottom-left-radius:24px; border-bottom-right-radius:24px;
    }

    #control-bar {
        position:fixed; bottom:0; left:0; width:100%; height:100px;
        display:flex; justify-content:center; align-items:center; z-index:10; pointer-events:none;
    }
    #dots-track {
        position:relative; display:flex; align-items:center; gap:24px; padding:18px 28px;
        background:rgba(255,255,255,.14); border-radius:40px;
        pointer-events:auto; touch-action:none; transition:opacity .3s ease;
    }
    .dot {
        width:12px; height:12px; border-radius:50%; background:rgba(255,255,255,.4); flex-shrink:0;
        transition:transform .3s cubic-bezier(.34,1.56,.64,1), opacity .3s;
        will-change:transform, opacity;
    }
    .dot.is-shrink { transform:scale(0); opacity:0; }

    #slider {
        position:absolute; top:50%; left:0;
        width:22px; height:22px; margin-top:-11px; margin-left:-11px;
        border-radius:50%; background:#fff;
        box-shadow:0 0 16px rgba(255,255,255,.6), 0 2px 8px rgba(0,0,0,.3);
        pointer-events:none;
        transform:translate3d(0,0,0) scale(1);
        will-change:transform;
        transition:transform .22s ease;
    }
    #slider.dragging { transition:none; }
    #slider.dragging .inner { transform:scale(1.3); }
    #slider .inner {
        width:100%; height:100%; border-radius:50%; background:#fff;
        transition:transform .22s ease;
    }

    .global-add-btn {
        position:fixed; bottom:40px; right:40px; width:60px; height:60px; border-radius:50%;
        background:linear-gradient(135deg,#00ff88 0%,#00ccff 100%);
        box-shadow:0 10px 30px rgba(0,255,136,.4);
        display:flex; justify-content:center; align-items:center;
        opacity:0; visibility:hidden; transform:scale(.5) translateY(20px);
        transition:transform .3s cubic-bezier(.4,0,.2,1) .1s, opacity .3s ease .1s, visibility .3s ease .1s;
        will-change:transform, opacity; z-index:100; cursor:pointer; touch-action:none;
    }
    .global-add-btn.show {
        opacity:1; visibility:visible; transform:scale(1) translateY(0);
        transition:transform .4s cubic-bezier(.34,1.56,.64,1) 0s, opacity .4s ease 0s, visibility .4s ease 0s;
    }
    .global-add-btn::before, .global-add-btn::after { content:''; position:absolute; background:#000; border-radius:2px; }
    .global-add-btn::before { width:20px; height:3px; }
    .global-add-btn::after { width:3px; height:20px; }
</style>
</head>
<body>
    <canvas id="fluid-bg"></canvas>
    <div id="gesture-layer"></div>

    <div id="pages-viewport"><div id="pages-track"></div></div>
    <div class="global-add-btn" id="addBtn"></div>
    <div id="control-bar"><div id="dots-track"><div id="slider"><div class="inner"></div></div></div></div>

    <script src="https://cdn.jsdelivr.net/npm/webgl-fluid@0.3/dist/webgl-fluid.umd.js"></script>

<script>
(function() {
    'use strict';

    const fluidCanvas = document.getElementById('fluid-bg');

    (function initFluid() {
        if (window.WebGLFluid && fluidCanvas) {
            WebGLFluid(fluidCanvas, {
                SIM_RESOLUTION: 128,
                DYE_RESOLUTION: 1024,
                DENSITY_DISSIPATION: 0.98,
                VELOCITY_DISSIPATION: 0.99,
                PRESSURE: 0.8,
                CURL: 30,
                SPLAT_RADIUS: 0.25,
                SPLAT_FORCE: 6000,
                SHADING: true,
                COLORFUL: true,
                COLOR_UPDATE_SPEED: 10,
                BACK_COLOR: { r: 13, g: 4, b: 16 },
                COLOR_PALETTE: [
                    { r: 1.0, g: 0.1, b: 0.6 },
                    { r: 0.8, g: 0.0, b: 0.5 },
                    { r: 1.0, g: 0.4, b: 0.8 },
                    { r: 0.5, g: 0.0, b: 0.4 }
                ],
                PAUSED: false,
                BLOOM: true,
                BLOOM_INTENSITY: 0.8,
                BLOOM_THRESHOLD: 0.6,
                SUNRAYS: true,
                SUNRAYS_WEIGHT: 1.0
            });
        }
    })();

    const gestureLayer = document.getElementById('gesture-layer');
    const pagesTrack = document.getElementById('pages-track');
    const dotsTrack  = document.getElementById('dots-track');
    const slider     = document.getElementById('slider');
    const addBtn     = document.getElementById('addBtn');

    let pagesData = [];
    let PAGE_COUNT = 0;
    let pageWidth = window.innerWidth;
    let isEditingMode = false;
    let wasLongPressed = false;
    let isReordering = false;

    let progress = 0, targetProgress = 0, currentPage = 0;
    let rafId = null, dragging = false, dragSource = null;
    let startX = 0, startY = 0, startProgress = 0, startTime = 0;
    let isPressing = false, longPressTimer = null, pressedDotIndex = -1;
    let activeTouchId = null, lastTouchTime = 0;

    let dotCenters = [], dotSpacing = 1;
    let lastSliderX = -1, lastShrinkIdx = -1;
    let dotEls = [];

    // ===== 流体多指输入：每根手指一个 pointerId =====
    // identifier → { pid, lastX, lastY }
    const fluidPointers = new Map();
    // 把 touch.identifier 映射到稳定的 pointerId（从 10000 起递增）
    let nextFluidPid = 10000;

    function makePointerEvent(type, pid, x, y, buttons) {
        var ev;
        try {
            ev = new PointerEvent(type, {
                pointerId: pid,
                pointerType: 'touch',
                isPrimary: false,
                clientX: x, clientY: y,
                pageX: x, pageY: y,
                screenX: x, screenY: y,
                button: 0,
                buttons: buttons,
                pressure: type === 'pointerup' ? 0 : 0.5,
                bubbles: true,
                cancelable: true,
                composed: true
            });
        } catch (err) {
            ev = null;
        }
        if (!ev) {
            var typeMap = { pointerdown: 'mousedown', pointermove: 'mousemove', pointerup: 'mouseup' };
            ev = new MouseEvent(typeMap[type] || type, {
                clientX: x, clientY: y, button: 0, buttons: buttons,
                bubbles: true, cancelable: true
            });
        }
        return ev;
    }

    function dispatchFluid(type, pid, x, y, buttons) {
        var ev = makePointerEvent(type, pid, x, y, buttons);
        try { fluidCanvas.dispatchEvent(ev); } catch (e) {}
        try { document.dispatchEvent(ev); } catch (e) {}
        try { window.dispatchEvent(ev); } catch (e) {}
        // 兼容只监听 mouse 的版本；多指时鼠标事件没有 pointerId，用坐标区分
        var mev = new MouseEvent(type === 'pointerdown' ? 'mousedown' : (type === 'pointermove' ? 'mousemove' : 'mouseup'), {
            clientX: x, clientY: y, button: 0, buttons: buttons,
            bubbles: true, cancelable: true
        });
        try { fluidCanvas.dispatchEvent(mev); } catch (e) {}
        try { document.dispatchEvent(mev); } catch (e) {}
        try { window.dispatchEvent(mev); } catch (e) {}
    }

    function fluidTouchStart(t) {
        const pid = nextFluidPid++;
        fluidPointers.set(t.identifier, { pid: pid, lastX: t.clientX, lastY: t.clientY });
        dispatchFluid('pointerdown', pid, t.clientX, t.clientY, 1);
    }

    function fluidTouchMove(t) {
        const rec = fluidPointers.get(t.identifier);
        if (!rec) return;
        if (Math.abs(t.clientX - rec.lastX) < 0.5 && Math.abs(t.clientY - rec.lastY) < 0.5) return;
        rec.lastX = t.clientX; rec.lastY = t.clientY;
        dispatchFluid('pointermove', rec.pid, t.clientX, t.clientY, 1);
    }

    function fluidTouchEnd(t) {
        const rec = fluidPointers.get(t.identifier);
        if (!rec) return;
        fluidPointers.delete(t.identifier);
        dispatchFluid('pointerup', rec.pid, t.clientX, t.clientY, 0);
    }

    function fluidMouseStart(x, y) {
        // 鼠标用固定 pid
        const pid = 1;
        fluidPointers.set('mouse', { pid: pid, lastX: x, lastY: y });
        dispatchFluid('pointerdown', pid, x, y, 1);
    }
    function fluidMouseMove(x, y) {
        const rec = fluidPointers.get('mouse');
        if (!rec) return;
        if (Math.abs(x - rec.lastX) < 0.5 && Math.abs(y - rec.lastY) < 0.5) return;
        rec.lastX = x; rec.lastY = y;
        dispatchFluid('pointermove', rec.pid, x, y, 1);
    }
    function fluidMouseEnd(x, y) {
        const rec = fluidPointers.get('mouse');
        if (!rec) return;
        fluidPointers.delete('mouse');
        dispatchFluid('pointerup', rec.pid, x, y, 0);
    }

    function getCalendarData() {
        const today = new Date();
        const weekdaysChinese = ['周日','周一','周二','周三','周四','周五','周六'];
        const startOfWeek = new Date(today);
        startOfWeek.setDate(today.getDate() - today.getDay());
        const days = [];
        for (let i = 0; i < 7; i++) {
            const d = new Date(startOfWeek);
            d.setDate(startOfWeek.getDate() + i);
            days.push({
                num: d.getDate(),
                isToday: d.getDate() === today.getDate() &&
                         d.getMonth() === today.getMonth() &&
                         d.getFullYear() === today.getFullYear()
            });
        }
        return { weekdayTitle: weekdaysChinese[today.getDay()], days };
    }

    // 卡片手势：多指时，第一根落在卡片上的手指驱动翻页/长按；
    // 所有手指都转发给流体出烟。
    function bindCardGestures(card) {
        // identifier → true（这根手指是否驱动翻页）
        const cardPointers = new Map();
        let primaryTouchId = null;

        card.addEventListener('touchstart', function(e) {
            lastTouchTime = Date.now();
            for (let i = 0; i < e.changedTouches.length; i++) {
                const t = e.changedTouches[i];
                fluidTouchStart(t);
                if (primaryTouchId === null) {
                    primaryTouchId = t.identifier;
                    cardPointers.set(t.identifier, true);
                    begin(t.clientX, t.clientY, 'page', -1);
                } else {
                    cardPointers.set(t.identifier, false);
                }
            }
        }, { passive: true });

        card.addEventListener('touchmove', function(e) {
            for (let i = 0; i < e.touches.length; i++) {
                const t = e.touches[i];
                if (!cardPointers.has(t.identifier)) continue;
                fluidTouchMove(t);
                if (cardPointers.get(t.identifier)) {
                    move(t.clientX, t.clientY, e);
                }
            }
        }, { passive: false });

        card.addEventListener('touchend', function(e) {
            for (let i = 0; i < e.changedTouches.length; i++) {
                const t = e.changedTouches[i];
                if (!cardPointers.has(t.identifier)) continue;
                fluidTouchEnd(t);
                if (cardPointers.get(t.identifier)) {
                    end(t.clientX, t.clientY, e.target);
                    primaryTouchId = null;
                }
                cardPointers.delete(t.identifier);
            }
            lastTouchTime = Date.now();
        });

        card.addEventListener('touchcancel', function(e) {
            for (let i = 0; i < e.changedTouches.length; i++) {
                const t = e.changedTouches[i];
                if (!cardPointers.has(t.identifier)) continue;
                fluidTouchEnd(t);
                if (cardPointers.get(t.identifier)) {
                    primaryTouchId = null;
                    cancel();
                }
                cardPointers.delete(t.identifier);
            }
        });

        card.addEventListener('mousedown', function(e) {
            if (e.button !== 0 || Date.now() - lastTouchTime < 500) return;
            fluidMouseStart(e.clientX, e.clientY);
            begin(e.clientX, e.clientY, 'page', -1);
        });
        card.addEventListener('mousemove', function(e) {
            fluidMouseMove(e.clientX, e.clientY);
            if (!isPressing) return;
            move(e.clientX, e.clientY, e);
        });
        card.addEventListener('mouseup', function(e) {
            fluidMouseEnd(e.clientX, e.clientY);
            if (!isPressing) return;
            end(e.clientX, e.clientY, e.target);
        });
    }

    function createCardElement(animate) {
        const { weekdayTitle, days } = getCalendarData();
        const card = document.createElement('div');
        card.className = 'calendar-card' + (animate ? ' animate-fade-in' : '');
        card.innerHTML =
            '<div class="close-btn"></div>' +
            '<div class="header"><div class="title">' + weekdayTitle + '</div>' +
            '<div class="subtitle">CALENDAR</div></div>' +
            '<div class="calendar-grid">' +
            '<div class="weekday">日</div><div class="weekday">一</div>' +
            '<div class="weekday">二</div><div class="weekday">三</div>' +
            '<div class="weekday">四</div><div class="weekday">五</div><div class="weekday">六</div>' +
            '</div>';
        const grid = card.querySelector('.calendar-grid');
        const frag = document.createDocumentFragment();
        for (let i = 0; i < days.length; i++) {
            const dayDiv = document.createElement('div');
            dayDiv.className = 'day' + (days[i].isToday ? ' active' : '');
            dayDiv.textContent = days[i].num;
            frag.appendChild(dayDiv);
        }
        grid.appendChild(frag);
        card.querySelector('.close-btn').addEventListener('click', function(e) {
            e.stopPropagation();
            deleteCard(card);
        });
        bindCardGestures(card);
        return card;
    }

    function readAllCardRects() {
        const cards = pagesTrack.querySelectorAll('.calendar-card');
        const arr = new Array(cards.length);
        for (let i = 0; i < cards.length; i++) {
            arr[i] = { el: cards[i], rect: cards[i].getBoundingClientRect() };
        }
        return arr;
    }

    function applyFlip(oldArr, excludeCard) {
        const newRects = new Array(oldArr.length);
        for (let i = 0; i < oldArr.length; i++) {
            const item = oldArr[i];
            if (item.el === excludeCard || !item.el.isConnected) continue;
            newRects[i] = item.el.getBoundingClientRect();
        }
        for (let i = 0; i < oldArr.length; i++) {
            const item = oldArr[i];
            if (item.el === excludeCard || !item.el.isConnected) continue;
            const nr = newRects[i];
            const dx = item.rect.left - nr.left;
            const dy = item.rect.top  - nr.top;
            if (Math.abs(dx) < 1 && Math.abs(dy) < 1) continue;

            const el = item.el;
            const isMin = el.classList.contains('is-minimized');
            const minSuffix = isMin ? ' scale(0.9)' : '';
            el.style.transition = 'none';
            el.style.transform = 'translate3d(' + dx + 'px,' + dy + 'px,0)' + minSuffix;
            void el.offsetWidth;
            el.style.transition = 'transform 0.4s cubic-bezier(0.34,1.56,0.64,1)';
            el.style.transform = isMin ? 'scale(0.9) translate3d(0,0,0)' : 'translate3d(0,0,0)';
            el.addEventListener('transitionend', function onEnd(ev) {
                if (ev.propertyName !== 'transform') return;
                el.removeEventListener('transitionend', onEnd);
                el.style.transition = '';
                el.style.transform = '';
            });
        }
    }

    function measure() {
        pageWidth = window.innerWidth;
        const trackRect = dotsTrack.getBoundingClientRect();
        dotCenters.length = 0;
        for (let i = 0; i < dotEls.length; i++) {
            const r = dotEls[i].getBoundingClientRect();
            dotCenters.push(r.left - trackRect.left + r.width / 2);
        }
        dotSpacing = dotCenters.length > 1
            ? (dotCenters[dotCenters.length - 1] - dotCenters[0]) / (dotCenters.length - 1)
            : 1;
        const show = PAGE_COUNT > 1;
        dotsTrack.style.opacity = show ? '1' : '0';
        dotsTrack.style.pointerEvents = show ? 'auto' : 'none';
        lastSliderX = -1;
    }

    function addNewCard() {
        if (pagesData.length === 0) pagesData.push([]);
        let lastPageIdx = pagesData.length - 1;
        const wasNewPage = pagesData[lastPageIdx].length >= 3;

        if (wasNewPage) {
            lastPageIdx++;
            pagesData.push([]);
            const newPageDOM = document.createElement('div');
            newPageDOM.className = 'page';
            pagesTrack.appendChild(newPageDOM);

            const newDot = document.createElement('div');
            newDot.className = 'dot';
            dotsTrack.insertBefore(newDot, slider);
            dotEls.push(newDot);

            PAGE_COUNT++;
            pagesTrack.style.width = (PAGE_COUNT * 100) + 'vw';
        }

        const oldRects = readAllCardRects();
        const newCard = createCardElement(true);
        pagesData[lastPageIdx].push(newCard);
        pagesTrack.children[lastPageIdx].appendChild(newCard);
        if (isEditingMode) newCard.classList.add('is-minimized');

        measure();

        if (!wasNewPage) {
            pagesTrack.style.transition = 'none';
            pagesTrack.style.transform = 'translate3d(' + (-currentPage * pageWidth) + 'px,0,0)';
            progress = currentPage; targetProgress = currentPage;
            applyFlip(oldRects, newCard);
            renderSlider(true);
        } else {
            settleTo(lastPageIdx);
        }
    }

    function deleteCard(card) {
        card.classList.add('is-hidden');
        let done = false;
        const finish = function() {
            if (done) return;
            done = true;
            doRemoveCard(card);
        };
        card.addEventListener('transitionend', function onHide(ev) {
            if (ev.propertyName !== 'opacity') return;
            card.removeEventListener('transitionend', onHide);
            finish();
        }, { once: true });
        setTimeout(finish, 320);
    }

    function doRemoveCard(card) {
        if (!card.isConnected) return;
        let pageIdx = -1, cardIdx = -1;
        for (let i = 0; i < pagesData.length; i++) {
            const idx = pagesData[i].indexOf(card);
            if (idx > -1) { pageIdx = i; cardIdx = idx; break; }
        }
        if (pageIdx === -1) return;

        const oldRects = readAllCardRects();
        card.remove();
        pagesData[pageIdx].splice(cardIdx, 1);

        const pageWillBeEmpty = pagesData[pageIdx].length === 0 && pagesData.length > 1;

        if (pageWillBeEmpty) {
            const oldTargetIdx = (pageIdx + 1 < PAGE_COUNT) ? (pageIdx + 1) : (pageIdx - 1);
            if (oldTargetIdx < 0) {
                reorderAfterEmptyPage(pageIdx, pageIdx);
                return;
            }

            isReordering = true;
            stopLerp();
            progress = currentPage;
            targetProgress = oldTargetIdx;
            renderPage();
            renderSlider(true);

            animateToThen(oldTargetIdx, function() {
                let newIdx = oldTargetIdx;
                if (pageIdx < oldTargetIdx) newIdx = oldTargetIdx - 1;
                reorderAfterEmptyPage(pageIdx, newIdx);
            });
            return;
        }

        if (pagesData.length === 0) {
            pagesData.push([]);
            const newPageDOM = document.createElement('div');
            newPageDOM.className = 'page';
            pagesTrack.appendChild(newPageDOM);
            PAGE_COUNT = 1;
            pagesTrack.style.width = '100vw';
            const newDot = document.createElement('div');
            newDot.className = 'dot';
            dotsTrack.insertBefore(newDot, slider);
            dotEls.push(newDot);
            currentPage = 0;
        }

        measure();

        pagesTrack.style.transition = 'none';
        pagesTrack.style.transform = 'translate3d(' + (-currentPage * pageWidth) + 'px,0,0)';
        progress = currentPage; targetProgress = currentPage;
        applyFlip(oldRects, null);
        renderSlider(true);
    }

    function animateToThen(targetPage, callback) {
        targetPage = Math.max(0, Math.min(targetPage, PAGE_COUNT - 1));
        targetProgress = targetPage;

        function step() {
            const diff = targetProgress - progress;
            if (Math.abs(diff) < 0.002) {
                progress = targetProgress;
                renderPage();
                renderSlider(false);
                callback();
                return;
            }
            progress += diff * 0.18;
            renderPage();
            renderSlider(false);
            requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
    }

    function reorderAfterEmptyPage(pageIdx, newIdx) {
        if (pagesTrack.children[pageIdx]) pagesTrack.children[pageIdx].remove();
        pagesData.splice(pageIdx, 1);
        if (dotEls[pageIdx]) { dotEls[pageIdx].remove(); dotEls.splice(pageIdx, 1); }
        PAGE_COUNT--;
        pagesTrack.style.width = (PAGE_COUNT * 100) + 'vw';

        if (pagesData.length === 0) {
            pagesData.push([]);
            const newPageDOM = document.createElement('div');
            newPageDOM.className = 'page';
            pagesTrack.appendChild(newPageDOM);
            PAGE_COUNT = 1;
            pagesTrack.style.width = '100vw';
            const newDot = document.createElement('div');
            newDot.className = 'dot';
            dotsTrack.insertBefore(newDot, slider);
            dotEls.push(newDot);
            currentPage = 0;
            measure();
            pagesTrack.style.transition = 'none';
            pagesTrack.style.transform = 'translate3d(0,0,0)';
            progress = 0; targetProgress = 0;
            isReordering = false;
            renderSlider(true);
            return;
        }

        currentPage = Math.max(0, Math.min(newIdx, PAGE_COUNT - 1));

        measure();

        pagesTrack.style.transition = 'none';
        pagesTrack.style.transform = 'translate3d(' + (-currentPage * pageWidth) + 'px,0,0)';
        progress = currentPage;
        targetProgress = currentPage;
        renderPage();
        renderSlider(true);

        isReordering = false;
    }

    function renderPage() {
        pagesTrack.style.transform = 'translate3d(' + (-progress * pageWidth) + 'px,0,0)';
    }

    function renderSlider(force) {
        if (PAGE_COUNT <= 1) return;
        let p = progress;
        if (p < 0) p = 0;
        if (p > PAGE_COUNT - 1) p = PAGE_COUNT - 1;
        const i1 = Math.floor(p);
        const i2 = Math.min(i1 + 1, PAGE_COUNT - 1);
        const t = p - i1;
        const cx = dotCenters[i1] + (dotCenters[i2] - dotCenters[i1]) * t;

        if (force || Math.abs(cx - lastSliderX) > 0.1) {
            lastSliderX = cx;
            slider.style.transform = 'translate3d(' + cx + 'px,0,0)';
        }

        const nearestIdx = Math.round(p);
        if (nearestIdx !== lastShrinkIdx) {
            const prev = lastShrinkIdx;
            lastShrinkIdx = nearestIdx;
            if (prev >= 0 && dotEls[prev]) dotEls[prev].classList.remove('is-shrink');
            if (dotEls[nearestIdx]) dotEls[nearestIdx].classList.add('is-shrink');
        }
    }

    function lerpLoop() {
        const diff = targetProgress - progress;
        if (Math.abs(diff) < 0.0008) {
            progress = targetProgress;
            renderPage();
            renderSlider(false);
            rafId = null;
            return;
        }
        progress += diff * 0.18;
        renderPage();
        renderSlider(false);
        rafId = requestAnimationFrame(lerpLoop);
    }

    function startLerp() { if (!rafId) rafId = requestAnimationFrame(lerpLoop); }
    function stopLerp()  { if (rafId) { cancelAnimationFrame(rafId); rafId = null; } }

    function settleTo(idx) {
        idx = Math.max(0, Math.min(idx, PAGE_COUNT - 1));
        currentPage = idx;
        targetProgress = idx;
        startLerp();
    }

    function nearestDotIndex(localX) {
        let best = 0, bestDist = Infinity;
        for (let i = 0; i < dotCenters.length; i++) {
            const d = Math.abs(dotCenters[i] - localX);
            if (d < bestDist) { bestDist = d; best = i; }
        }
        return best;
    }

    function clearLP() {
        if (longPressTimer) { clearTimeout(longPressTimer); longPressTimer = null; }
    }

    function enterEditMode() {
        if (isEditingMode) return;
        isEditingMode = true;
        wasLongPressed = true;
        requestAnimationFrame(function() {
            addBtn.classList.add('show');
            requestAnimationFrame(function() {
                const cards = pagesTrack.querySelectorAll('.calendar-card');
                for (let i = 0; i < cards.length; i++) cards[i].classList.add('is-minimized');
            });
        });
        if (navigator.vibrate) navigator.vibrate(10);
    }

    function exitEditMode() {
        if (!isEditingMode) return;
        isEditingMode = false;
        addBtn.classList.remove('show');
        const cards = pagesTrack.querySelectorAll('.calendar-card');
        for (let i = 0; i < cards.length; i++) cards[i].classList.remove('is-minimized');
    }

    function begin(x, y, source, dotIdx) {
        if (isReordering) return;
        stopLerp();
        startX = x; startY = y;
        startTime = Date.now();
        startProgress = progress;
        targetProgress = progress;
        dragSource = source; dragging = false; isPressing = true;
        pressedDotIndex = dotIdx != null ? dotIdx : -1;
        wasLongPressed = false;
        clearLP();
        longPressTimer = setTimeout(function() {
            if (isPressing && !dragging) {
                enterEditMode();
                pressedDotIndex = -1;
            }
        }, 500);
    }

    function move(x, y, e) {
        if (!isPressing) return;
        const dx = x - startX;
        const dy = y - startY;

        if (!dragging) {
            if (Math.abs(dx) > 8 || Math.abs(dy) > 8) clearLP();
            if (Math.abs(dx) > 5 && Math.abs(dx) > Math.abs(dy)) {
                dragging = true;
                pressedDotIndex = -1;
                slider.classList.add('dragging');
            }
        }
        if (!dragging) return;
        if (e && e.cancelable) e.preventDefault();

        let p;
        if (dragSource === 'page') p = startProgress - dx / pageWidth;
        else                        p = startProgress + dx / dotSpacing;

        targetProgress = Math.max(0, Math.min(p, PAGE_COUNT - 1));
        startLerp();
    }

    function end(x, y, target) {
        clearLP();
        if (!isPressing) return;

        if (wasLongPressed) {
            isPressing = false; dragging = false;
            return;
        }

        if (dragging) {
            const dx = x - startX;
            const time = Date.now() - startTime || 1;
            const velocity = dx / time;
            let t = Math.round(targetProgress);
            if (Math.abs(velocity) > 0.5) {
                if (velocity > 0 && currentPage > 0) t = currentPage - 1;
                if (velocity < 0 && currentPage < PAGE_COUNT - 1) t = currentPage + 1;
            }
            settleTo(t);
        } else if (pressedDotIndex >= 0) {
            settleTo(pressedDotIndex);
        } else if (isEditingMode && target) {
            const isClickingCard = target.closest && (target.closest('.calendar-card') || target.closest('.global-add-btn'));
            if (!isClickingCard) exitEditMode();
        }

        dragging = false;
        isPressing = false;
        pressedDotIndex = -1;
        slider.classList.remove('dragging');
    }

    function cancel() {
        clearLP();
        if (!isPressing) return;
        dragging = false; isPressing = false; pressedDotIndex = -1;
        slider.classList.remove('dragging');
        stopLerp();
        settleTo(currentPage);
    }

    // ===== 空白手势层：多指 —— 第一根驱动翻页，全部手指出烟 =====
    const gesturePointers = new Map();
    let gesturePrimaryId = null;

    gestureLayer.addEventListener('touchstart', function(e) {
        lastTouchTime = Date.now();
        for (let i = 0; i < e.changedTouches.length; i++) {
            const t = e.changedTouches[i];
            fluidTouchStart(t);
            if (gesturePrimaryId === null) {
                gesturePrimaryId = t.identifier;
                gesturePointers.set(t.identifier, true);
                begin(t.clientX, t.clientY, 'page', -1);
            } else {
                gesturePointers.set(t.identifier, false);
            }
        }
    }, { passive: true });

    gestureLayer.addEventListener('touchmove', function(e) {
        for (let i = 0; i < e.touches.length; i++) {
            const t = e.touches[i];
            if (!gesturePointers.has(t.identifier)) continue;
            fluidTouchMove(t);
            if (gesturePointers.get(t.identifier)) {
                move(t.clientX, t.clientY, e);
            }
        }
    }, { passive: false });

    gestureLayer.addEventListener('touchend', function(e) {
        for (let i = 0; i < e.changedTouches.length; i++) {
            const t = e.changedTouches[i];
            if (!gesturePointers.has(t.identifier)) continue;
            fluidTouchEnd(t);
            if (gesturePointers.get(t.identifier)) {
                if (isEditingMode && !wasLongPressed && !dragging) {
                    exitEditMode();
                }
                end(t.clientX, t.clientY, e.target);
                gesturePrimaryId = null;
            }
            gesturePointers.delete(t.identifier);
        }
        lastTouchTime = Date.now();
    });

    gestureLayer.addEventListener('touchcancel', function(e) {
        for (let i = 0; i < e.changedTouches.length; i++) {
            const t = e.changedTouches[i];
            if (!gesturePointers.has(t.identifier)) continue;
            fluidTouchEnd(t);
            if (gesturePointers.get(t.identifier)) {
                gesturePrimaryId = null;
                cancel();
            }
            gesturePointers.delete(t.identifier);
        }
    });

    gestureLayer.addEventListener('mousedown', function(e) {
        if (e.button !== 0 || Date.now() - lastTouchTime < 500) return;
        fluidMouseStart(e.clientX, e.clientY);
        begin(e.clientX, e.clientY, 'page', -1);
    });
    gestureLayer.addEventListener('mousemove', function(e) {
        fluidMouseMove(e.clientX, e.clientY);
        if (!isPressing) return;
        move(e.clientX, e.clientY, e);
    });
    gestureLayer.addEventListener('mouseup', function(e) {
        fluidMouseEnd(e.clientX, e.clientY);
        if (isEditingMode && !wasLongPressed && !dragging) exitEditMode();
        if (!isPressing) return;
        end(e.clientX, e.clientY, e.target);
    });

    // ===== 圆点：多指时只认第一根驱动翻页 =====
    const dotPointers = new Map();
    let dotPrimaryId = null;

    dotsTrack.addEventListener('touchstart', function(e) {
        if (PAGE_COUNT <= 1) return;
        lastTouchTime = Date.now();
        for (let i = 0; i < e.changedTouches.length; i++) {
            const t = e.changedTouches[i];
            if (dotPrimaryId === null) {
                dotPrimaryId = t.identifier;
                dotPointers.set(t.identifier, true);
                const rect = dotsTrack.getBoundingClientRect();
                const idx = nearestDotIndex(t.clientX - rect.left);
                begin(t.clientX, t.clientY, 'slider', idx);
            } else {
                dotPointers.set(t.identifier, false);
            }
        }
    }, { passive: true });
    dotsTrack.addEventListener('touchmove', function(e) {
        for (let i = 0; i < e.touches.length; i++) {
            const t = e.touches[i];
            if (!dotPointers.has(t.identifier)) continue;
            if (dotPointers.get(t.identifier)) {
                move(t.clientX, t.clientY, e);
            }
        }
    }, { passive: false });
    dotsTrack.addEventListener('touchend', function(e) {
        for (let i = 0; i < e.changedTouches.length; i++) {
            const t = e.changedTouches[i];
            if (!dotPointers.has(t.identifier)) continue;
            if (dotPointers.get(t.identifier)) {
                end(t.clientX, t.clientY, e.target);
                dotPrimaryId = null;
            }
            dotPointers.delete(t.identifier);
        }
        lastTouchTime = Date.now();
    });
    dotsTrack.addEventListener('touchcancel', function(e) {
        for (let i = 0; i < e.changedTouches.length; i++) {
            const t = e.changedTouches[i];
            if (!dotPointers.has(t.identifier)) continue;
            if (dotPointers.get(t.identifier)) {
                dotPrimaryId = null;
                cancel();
            }
            dotPointers.delete(t.identifier);
        }
    });

    dotsTrack.addEventListener('mousedown', function(e) {
        if (e.button !== 0 || Date.now() - lastTouchTime < 500 || PAGE_COUNT <= 1) return;
        const rect = dotsTrack.getBoundingClientRect();
        const idx = nearestDotIndex(e.clientX - rect.left);
        begin(e.clientX, e.clientY, 'slider', idx);
    });
    dotsTrack.addEventListener('mousemove', function(e) {
        if (!isPressing) return;
        move(e.clientX, e.clientY, e);
    });
    dotsTrack.addEventListener('mouseup', function(e) {
        if (!isPressing) return;
        end(e.clientX, e.clientY, e.target);
    });

    addBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        if (isReordering) return;
        addNewCard();
    });
    addBtn.addEventListener('touchstart', function(e) {
        e.stopPropagation();
    }, { passive: true });

    if (window.ResizeObserver) {
        let roTimer = null;
        const ro = new ResizeObserver(function() {
            if (isReordering) return;
            if (roTimer) cancelAnimationFrame(roTimer);
            roTimer = requestAnimationFrame(function() {
                measure();
                progress = currentPage; targetProgress = currentPage; lastShrinkIdx = -1;
                renderPage(); renderSlider(true);
            });
        });
        ro.observe(document.documentElement);
    } else {
        window.addEventListener('resize', function() {
            if (isReordering) return;
            measure();
            progress = currentPage; targetProgress = currentPage; lastShrinkIdx = -1;
            renderPage(); renderSlider(true);
        });
    }

    function init() {
        pagesTrack.innerHTML = '';
        while (dotsTrack.firstChild) {
            if (dotsTrack.firstChild === slider) break;
            dotsTrack.removeChild(dotsTrack.firstChild);
        }
        dotEls.length = 0;
        pagesData = []; PAGE_COUNT = 0; currentPage = 0;
        lastSliderX = -1; lastShrinkIdx = -1;
        isReordering = false;

        const firstPage = document.createElement('div');
        firstPage.className = 'page';
        pagesTrack.appendChild(firstPage);
        pagesData.push([]);

        const firstDot = document.createElement('div');
        firstDot.className = 'dot';
        dotsTrack.insertBefore(firstDot, slider);
        dotEls.push(firstDot);

        PAGE_COUNT = 1;
        pagesTrack.style.width = '100vw';

        addNewCard();
        addNewCard();
        addNewCard();
        addNewCard();
        settleTo(0);
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>
</body>
</html>