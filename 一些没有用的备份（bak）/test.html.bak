<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>甜瓜人</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #6b7d80;
    overflow: hidden;
  }

  /* 整个甜瓜人容器 */
  .melon {
    position: relative;
    width: 160px;
    height: 360px;
    /* 放大一点方便看 */
    transform: scale(2);
    transform-origin: center center;
  }

  /* 所有身体部件共用的绿色材质 */
  .part {
    position: absolute;
    background: #6b8e23;
    border: 4px solid #4a6318;
    /* 像素锯齿感：不用圆角，用不规则边缘 */
    border-radius: 2px;
  }

  /* ===== 头 ===== */
  .head {
    width: 80px;
    height: 72px;
    left: 40px;
    top: 0;
    border-radius: 4px;
  }

  /* 眼睛 */
  .eye {
    position: absolute;
    width: 12px;
    height: 12px;
    background: #000;
    right: 14px;
    top: 20px;
    border-radius: 2px;
  }

  /* ===== 脖子 ===== */
  .neck {
    width: 40px;
    height: 12px;
    left: 60px;
    top: 72px;
    background: #5a7a1e;
  }

  /* ===== 躯干 ===== */
  .torso {
    width: 64px;
    height: 100px;
    left: 48px;
    top: 84px;
    border-radius: 4px;
  }

  /* 躯干纹理：深色竖线 */
  .torso::before,
  .torso::after {
    content: '';
    position: absolute;
    top: 8px;
    bottom: 8px;
    width: 6px;
    background: #4a6318;
    border-radius: 2px;
  }
  .torso::before { left: 14px; }
  .torso::after  { right: 14px; }

  /* 躯干横纹 */
  .stripe {
    position: absolute;
    left: 8px;
    right: 8px;
    height: 5px;
    background: #4a6318;
    border-radius: 2px;
  }
  .stripe.s1 { top: 24px; }
  .stripe.s2 { top: 48px; }
  .stripe.s3 { top: 72px; }

  /* ===== 手臂 ===== */
  .arm {
    width: 28px;
    height: 76px;
    border-radius: 3px;
  }
  .arm.left {
    left: 8px;
    top: 88px;
    transform: rotate(8deg);
  }
  .arm.right {
    right: 8px;
    top: 88px;
    transform: rotate(-8deg);
  }

  /* ===== 胯部 ===== */
  .hip {
    width: 56px;
    height: 14px;
    left: 52px;
    top: 182px;
    background: #5a7a1e;
  }

  /* ===== 腿 ===== */
  .leg {
    width: 30px;
    height: 110px;
    border-radius: 3px;
  }
  .leg.left {
    left: 36px;
    top: 192px;
    transform: rotate(2deg);
  }
  .leg.right {
    right: 36px;
    top: 192px;
    transform: rotate(-2deg);
  }

  /* ===== 脚 ===== */
  .foot {
    width: 44px;
    height: 22px;
    border-radius: 3px;
  }
  .foot.left {
    left: 22px;
    top: 296px;
  }
  .foot.right {
    right: 22px;
    top: 296px;
  }

  /* ===== 地面阴影 ===== */
  .shadow {
    position: absolute;
    width: 130px;
    height: 16px;
    left: 15px;
    bottom: -8px;
    background: rgba(0,0,0,0.2);
    border-radius: 50%;
    filter: blur(4px);
  }

  /* ===== 像素噪点，模拟复古质感 ===== */
  .noise {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.15;
    background-image:
      radial-gradient(#4a6318 1px, transparent 1px),
      radial-gradient(#6b8e23 1px, transparent 1px);
    background-size: 8px 8px, 8px 8px;
    background-position: 0 0, 4px 4px;
  }
</style>
</head>
<body>

<div class="melon">
  <!-- 头 -->
  <div class="part head">
    <div class="eye"></div>
  </div>

  <!-- 脖子 -->
  <div class="part neck"></div>

  <!-- 躯干 -->
  <div class="part torso">
    <div class="stripe s1"></div>
    <div class="stripe s2"></div>
    <div class="stripe s3"></div>
  </div>

  <!-- 左臂 -->
  <div class="part arm left"></div>

  <!-- 右臂 -->
  <div class="part arm right"></div>

  <!-- 胯部 -->
  <div class="part hip"></div>

  <!-- 左腿 -->
  <div class="part leg left"></div>

  <!-- 右腿 -->
  <div class="part leg right"></div>

  <!-- 左脚 -->
  <div class="part foot left"></div>

  <!-- 右脚 -->
  <div class="part foot right"></div>

  <!-- 阴影 -->
  <div class="shadow"></div>

  <!-- 噪点 -->
  <div class="noise"></div>
</div>

</body>
</html>