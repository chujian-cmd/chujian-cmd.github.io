<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>虚无主义 · 动画解释</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body {
    height: 100%;
    background: #0a0a0f;
    color: #e8e6f0;
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    overflow: hidden;
  }

  /* ===== 舞台容器 ===== */
  #stage {
    position: relative;
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 20% 20%, rgba(124,92,255,0.12) 0%, transparent 45%),
      radial-gradient(circle at 80% 80%, rgba(192,132,252,0.08) 0%, transparent 45%),
      #0a0a0f;
  }

  .scene {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5rem 2rem 6rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease;
  }
  .scene.active {
    opacity: 1;
    pointer-events: auto;
  }

  /* ===== 场景内元素通用：先隐藏，JS 逐个显示 ===== */
  .el {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.16,1,0.3,1);
  }
  .el.show {
    opacity: 1;
    transform: translateY(0);
  }

  /* ===== 标题 ===== */
  .scene h1 {
    font-size: clamp(2.6rem, 9vw, 6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    text-align: center;
    line-height: 1.05;
    background: linear-gradient(135deg, #fff 0%, #c4b5fd 55%, #7c5cff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 40px rgba(124,92,255,0.3));
  }
  .scene h2 {
    font-size: clamp(1.8rem, 5vw, 3rem);
    font-weight: 700;
    text-align: center;
    color: #d8cfff;
    margin-bottom: 2rem;
    letter-spacing: -0.02em;
  }
  .scene .sub {
    font-size: clamp(0.95rem, 2.2vw, 1.3rem);
    color: #9d95b8;
    text-align: center;
    max-width: 720px;
    margin-top: 1.5rem;
  }

  /* ===== 模式A：结构树（用于"没有客观意义"） ===== */
  .tree {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
  }
  .tree .root {
    padding: 1rem 2rem;
    border-radius: 14px;
    background: linear-gradient(135deg, #7c5cff, #a78bfa);
    font-weight: 700;
    font-size: 1.15rem;
    box-shadow: 0 0 30px rgba(124,92,255,0.4);
  }
  .tree .branch {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .tree .leaf {
    padding: 0.7rem 1.3rem;
    border-radius: 10px;
    background: rgba(124,92,255,0.12);
    border: 1px solid rgba(124,92,255,0.35);
    font-size: 0.95rem;
    color: #c4b5fd;
  }
  .tree .leaf.strike {
    text-decoration: line-through;
    color: #6b6480;
    border-color: rgba(120,120,140,0.3);
    background: rgba(120,120,140,0.08);
  }

  /* ===== 模式B：三态卡片（骆驼/狮子/孩子） ===== */
  .cards3 {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1.5rem;
  }
  .card3 {
    width: 200px;
    padding: 1.6rem 1.2rem;
    border-radius: 18px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(160,140,220,0.2);
    text-align: center;
    transition: transform 0.4s cubic-bezier(0.16,1,0.3,1),
                border-color 0.4s, box-shadow 0.4s;
  }
  .card3 .icon { font-size: 2.4rem; margin-bottom: 0.6rem; }
  .card3 .name { font-weight: 700; font-size: 1.1rem; margin-bottom: 0.4rem; color: #e0d8ff; }
  .card3 .desc { font-size: 0.82rem; color: #9d95b8; line-height: 1.5; }
  .card3.highlight {
    border-color: #a78bfa;
    box-shadow: 0 0 30px rgba(124,92,255,0.35);
    transform: translateY(-6px) scale(1.03);
  }

  /* ===== 模式C：对比流水线（消极 vs 积极） ===== */
  .compare {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    justify-content: center;
    width: 100%;
    max-width: 900px;
  }
  .lane {
    flex: 1 1 320px;
    padding: 1.6rem;
    border-radius: 18px;
    border: 1px solid rgba(160,140,220,0.2);
    background: rgba(255,255,255,0.02);
  }
  .lane h3 {
    font-size: 1.1rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .lane.neg h3 { color: #f87171; }
  .lane.pos h3 { color: #4ade80; }
  .lane .step {
    padding: 0.6rem 1rem;
    border-radius: 10px;
    margin-bottom: 0.5rem;
    font-size: 0.88rem;
    background: rgba(255,255,255,0.04);
    border-left: 3px solid;
  }
  .lane.neg .step { border-color: #f87171; color: #fca5a5; }
  .lane.pos .step { border-color: #4ade80; color: #86efac; }

  /* ===== 模式D：飞包 / 节点传递（存在先于本质） ===== */
  .flow {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 1.5rem;
  }
  .node {
    padding: 1.2rem 1.6rem;
    border-radius: 14px;
    background: rgba(124,92,255,0.12);
    border: 1px solid rgba(124,92,255,0.4);
    font-weight: 600;
    text-align: center;
    min-width: 140px;
  }
  .node .tiny { display: block; font-size: 0.72rem; color: #9d95b8; font-weight: 400; margin-top: 0.3rem; }
  .arrow {
    font-size: 1.6rem;
    color: #7c5cff;
    opacity: 0;
    transform: scale(0.5);
    transition: all 0.4s cubic-bezier(0.16,1,0.3,1);
  }
  .arrow.show { opacity: 1; transform: scale(1); }

  .quote {
    margin-top: 2rem;
    font-style: italic;
    color: #b8a9e0;
    font-size: 1.05rem;
    text-align: center;
    max-width: 640px;
    border-left: 2px solid #7c5cff;
    padding-left: 1.2rem;
    text-align: left;
  }

  /* ===== 模式E：终极命题卡片 ===== */
  .big-card {
    padding: 2.5rem 3rem;
    border-radius: 24px;
    background: linear-gradient(135deg, rgba(124,92,255,0.15), rgba(192,132,252,0.08));
    border: 1px solid rgba(160,140,220,0.3);
    text-align: center;
    max-width: 700px;
    box-shadow: 0 0 60px rgba(124,92,255,0.2);
  }
  .big-card .main {
    font-size: clamp(1.4rem, 4vw, 2.2rem);
    font-weight: 700;
    color: #e0d8ff;
    line-height: 1.3;
  }

  /* ===== 底部控件 ===== */
  #controls {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    padding: 0.8rem 1.2rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    justify-content: center;
    background: linear-gradient(to top, rgba(10,10,15,0.95), transparent);
    z-index: 100;
    flex-wrap: wrap;
  }
  #controls button {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(160,140,220,0.25);
    color: #d8cfff;
    padding: 0.5rem 0.9rem;
    border-radius: 10px;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }
  #controls button:hover {
    background: rgba(124,92,255,0.2);
    border-color: #7c5cff;
  }
  #controls button:disabled { opacity: 0.35; cursor: not-allowed; }

  /* 章节 chips */
  #chips {
    position: fixed;
    top: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.5rem;
    z-index: 100;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 95vw;
  }
  .chip {
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    font-size: 0.75rem;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(160,140,220,0.2);
    color: #9d95b8;
    cursor: pointer;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .chip.active {
    background: rgba(124,92,255,0.3);
    border-color: #7c5cff;
    color: #e0d8ff;
  }

  /* 顶部进度 */
  #progress {
    position: fixed;
    top: 0; left: 0;
    height: 2px;
    background: linear-gradient(90deg, #7c5cff, #c084fc);
    width: 0%;
    z-index: 101;
    transition: width 0.1s linear;
    box-shadow: 0 0 10px rgba(124,92,255,0.6);
  }

  /* SCENE 指示 */
  #scene-indicator {
    position: fixed;
    top: 1rem;
    left: 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: #6b6480;
    z-index: 100;
    font-variant-numeric: tabular-nums;
  }

  /* 计时 */
  #timer {
    position: fixed;
    top: 1rem;
    right: 1rem;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: #6b6480;
    z-index: 100;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    .scene { padding: 5rem 1.2rem 6rem; }
    .card3 { width: 100%; max-width: 280px; }
    .big-card { padding: 1.8rem 1.5rem; }
    .quote { font-size: 0.95rem; }
  }
</style>
</head>
<body>

<div id="progress"></div>
<div id="scene-indicator">SCENE 1 / 6</div>
<div id="timer">0.0s</div>

<div id="chips">
  <div class="chip active" data-scene="0">词源</div>
  <div class="chip" data-scene="1">核心命题</div>
  <div class="chip" data-scene="2">尼采诊断</div>
  <div class="chip" data-scene="3">两种虚无</div>
  <div class="chip" data-scene="4">存在主义回应</div>
  <div class="chip" data-scene="5">结语</div>
</div>

<div id="stage">

  <!-- ===== 场景 0：词源 ===== -->
  <div class="scene active" data-index="0">
    <div class="el" id="s0-a">
      <h1>虚无主义</h1>
    </div>
    <div class="el" id="s0-b">
      <p class="sub">Nihilism · 源自拉丁语 <strong style="color:#c4b5fd">nihil</strong>，意为「什么都没有」</p>
    </div>
    <div class="el" id="s0-c">
      <p class="sub" style="margin-top:1rem; font-size:0.95rem; color:#6b6480;">
        它追问的不是「世界有没有东西」，<br>而是「这些东西有没有意义」
      </p>
    </div>
  </div>

  <!-- ===== 场景 1：核心命题 ===== -->
  <div class="scene" data-index="1">
    <h2 class="el" id="s1-title">核心命题</h2>
    <div class="tree">
      <div class="el root" id="s1-root">世界存在</div>
      <div class="branch">
        <div class="el leaf" id="s1-l1">有物理规律</div>
        <div class="el leaf" id="s1-l2">有因果关系</div>
        <div class="el leaf" id="s1-l3">能被人认识</div>
      </div>
      <div class="branch" style="margin-top:0.5rem;">
        <div class="el leaf strike" id="s1-x1">但：客观意义</div>
        <div class="el leaf strike" id="s1-x2">但：终极目的</div>
        <div class="el leaf strike" id="s1-x3">但：绝对价值</div>
      </div>
    </div>
    <div class="el" id="s1-conc">
      <p class="sub">虚无主义不否认「存在」，它否认的是「存在**为了什么**」</p>
    </div>
  </div>

  <!-- ===== 场景 2：尼采诊断 ===== -->
  <div class="scene" data-index="2">
    <h2 class="el" id="s2-title">尼采的诊断：上帝已死</h2>
    <div class="el" id="s2-sub">
      <p class="sub" style="margin-bottom:1rem;">那个曾为一切提供意义、目的与价值担保的形而上根基，崩塌了</p>
    </div>
    <div class="cards3">
      <div class="el card3" id="s2-c1">
        <div class="icon">🐪</div>
        <div class="name">骆驼</div>
        <div class="desc">背负传统价值<br>「你应该」</div>
      </div>
      <div class="el card3" id="s2-c2">
        <div class="icon">🦁</div>
        <div class="name">狮子</div>
        <div class="desc">摧毁旧价值<br>「我要」</div>
      </div>
      <div class="el card3" id="s2-c3">
        <div class="icon">👶</div>
        <div class="name">孩子</div>
        <div class="desc">创造新价值<br>「我是」</div>
      </div>
    </div>
    <div class="el" id="s2-conc">
      <p class="sub">虚无不是终点——它是价值重估的**起点**</p>
    </div>
  </div>

  <!-- ===== 场景 3：两种虚无 ===== -->
  <div class="scene" data-index="3">
    <h2 class="el" id="s3-title">两种虚无</h2>
    <div class="compare">
      <div class="el lane neg" id="s3-neg">
        <h3>⬇ 消极虚无</h3>
        <div class="step">意义崩塌 → 瘫痪</div>
        <div class="step">放弃行动与判断</div>
        <div class="step">「一切都没意义，所以无所谓」</div>
      </div>
      <div class="el lane pos" id="s3-pos">
        <h3>⬆ 积极虚无</h3>
        <div class="step">意义崩塌 → 解放</div>
        <div class="step">主动承担创造责任</div>
        <div class="step">「没有预设意义，所以我可以赋予」</div>
      </div>
    </div>
    <div class="el" id="s3-conc">
      <p class="sub">同一个前提，两种截然不同的生存姿态</p>
    </div>
  </div>

  <!-- ===== 场景 4：存在主义回应 ===== -->
  <div class="scene" data-index="4">
    <h2 class="el" id="s4-title">存在主义的回应</h2>
    <div class="flow">
      <div class="el node" id="s4-n1">
        存在
        <span class="tiny">先于</span>
      </div>
      <div class="arrow" id="s4-a1">→</div>
      <div class="el node" id="s4-n2">
        本质
        <span class="tiny">被创造</span>
      </div>
      <div class="arrow" id="s4-a2">→</div>
      <div class="el node" id="s4-n3">
        意义
        <span class="tiny">由人赋予</span>
      </div>
    </div>
    <div class="el" id="s4-q">
      <p class="quote">「人被判定为自由。一旦被抛入这个世界，他就要为自己所做的一切负责。」<br><span style="color:#7c5cff; font-style:normal; font-size:0.85rem;">—— 萨特</span></p>
    </div>
  </div>

  <!-- ===== 场景 5：结语 ===== -->
  <div class="scene" data-index="5">
    <div class="el" id="s5-card">
      <div class="big-card">
        <div class="main">
          虚无不是深渊<br>
          而是一块<br>
          <span style="color:#c4b5fd;">尚未被书写的空地</span>
        </div>
      </div>
    </div>
    <div class="el" id="s5-sub">
      <p class="sub" style="margin-top:2rem;">
        它剥夺了「现成的意义」<br>
        却把「创造意义的自由」还给了你
      </p>
    </div>
  </div>

</div>

<div id="controls">
  <button id="btn-prev">◀ 上一节</button>
  <button id="btn-play">⏸ 暂停</button>
  <button id="btn-next">下一节 ▶</button>
  <button id="btn-replay">↻ 重播本节</button>
  <button id="btn-voice">🔊 旁白开</button>
</div>

<script>
// ============================================================
// 数据：每个场景的旁白 + 元素时序
// ============================================================
const SCENES = [
  {
    // 场景 0：词源
    narration: "虚无主义，源自拉丁语 nihil，意思是「什么都没有」。它追问的不是世界有没有东西，而是这些东西，有没有意义。",
    timeline: [
      { id: 's0-a', delay: 0 },
      { id: 's0-b', delay: 1200 },
      { id: 's0-c', delay: 2600 },
    ],
    duration: 6500
  },
  {
    // 场景 1：核心命题
    narration: "虚无主义的核心命题并不复杂。它承认世界存在，有物理规律，有因果关系，也能被人认识。但它同时指出，这个世界没有客观意义，没有终极目的，也没有绝对价值。换句话说，虚无主义不否认「存在」，它否认的是「存在为了什么」。",
    timeline: [
      { id: 's1-title', delay: 0 },
      { id: 's1-root', delay: 700 },
      { id: 's1-l1', delay: 1300 },
      { id: 's1-l2', delay: 1600 },
      { id: 's1-l3', delay: 1900 },
      { id: 's1-x1', delay: 3000 },
      { id: 's1-x2', delay: 3400 },
      { id: 's1-x3', delay: 3800 },
      { id: 's1-conc', delay: 5200 },
    ],
    duration: 8000
  },
  {
    // 场景 2：尼采诊断
    narration: "尼采说，上帝已死。这不是一句无神论宣言，而是一个诊断：那个曾为一切提供意义、目的与价值担保的形而上根基，已经崩塌了。面对这个空缺，尼采在《查拉图斯特拉如是说》中给出三种精神形态：骆驼，背负传统价值；狮子，摧毁旧价值；而孩子，才是真正的创造者，他创造新的价值。虚无不是终点，它是价值重估的起点。",
    timeline: [
      { id: 's2-title', delay: 0 },
      { id: 's2-sub', delay: 1500 },
      { id: 's2-c1', delay: 2800 },
      { id: 's2-c2', delay: 3600 },
      { id: 's2-c3', delay: 4400 },
      { id: 's2-conc', delay: 6200 },
    ],
    duration: 9000
  },
  {
    // 场景 3：两种虚无
    narration: "同样是意义崩塌，却有两种截然不同的反应。消极虚无主义，止步于瘫痪，放弃行动与判断，说「一切都没意义，所以无所谓」。而积极虚无主义，把崩塌当作解放，主动承担创造的责任，说「没有预设意义，所以我可以赋予」。同一个前提，两种生存姿态。",
    timeline: [
      { id: 's3-title', delay: 0 },
      { id: 's3-neg', delay: 1000 },
      { id: 's3-pos', delay: 2200 },
      { id: 's3-conc', delay: 5200 },
    ],
    duration: 7500
  },
  {
    // 场景 4：存在主义回应
    narration: "存在主义给出了自己的回答。萨特说，存在先于本质。人不是先有一个被规定好的本质，再被生出来。人是先存在，然后通过选择与行动，创造出自己的本质，也创造出自己的意义。人被判定为自由，一旦被抛入这个世界，他就要为自己所做的一切负责。",
    timeline: [
      { id: 's4-title', delay: 0 },
      { id: 's4-n1', delay: 1200 },
      { id: 's4-a1', delay: 2200 },
      { id: 's4-n2', delay: 3000 },
      { id: 's4-a2', delay: 4000 },
      { id: 's4-n3', delay: 4800 },
      { id: 's4-q', delay: 6200 },
    ],
    duration: 8500
  },
  {
    // 场景 5：结语
    narration: "所以，虚无不是深渊，而是一块尚未被书写的空地。它剥夺了现成的意义，却把创造意义的自由，还给了你。",
    timeline: [
      { id: 's5-card', delay: 0 },
      { id: 's5-sub', delay: 3200 },
    ],
    duration: 6500
  }
];

// ============================================================
// 状态
// ============================================================
const state = {
  current: 0,
  playing: true,
  voiceOn: true,
  timers: [],
  rafId: null,
  startTime: 0,
  elapsed: 0,
  utterance: null,
  sceneStartedAt: 0
};

// ============================================================
// DOM 引用
// ============================================================
const scenes = document.querySelectorAll('.scene');
const chips = document.querySelectorAll('.chip');
const progressBar = document.getElementById('progress');
const sceneIndicator = document.getElementById('scene-indicator');
const timerEl = document.getElementById('timer');
const btnPrev = document.getElementById('btn-prev');
const btnPlay = document.getElementById('btn-play');
const btnNext = document.getElementById('btn-next');
const btnReplay = document.getElementById('btn-replay');
const btnVoice = document.getElementById('btn-voice');

// ============================================================
// 工具函数
// ============================================================
function clearTimers() {
  state.timers.forEach(t => clearTimeout(t));
  state.timers = [];
  if (state.rafId) {
    cancelAnimationFrame(state.rafId);
    state.rafId = null;
  }
  if ('speechSynthesis' in window) {
    window.speechSynthesis.cancel();
  }
}

function showEl(id, delay) {
  const t = setTimeout(() => {
    const el = document.getElementById(id);
    if (el) el.classList.add('show');
  }, delay);
  state.timers.push(t);
}

function resetScene(index) {
  const scene = scenes[index];
  scene.querySelectorAll('.el').forEach(el => el.classList.remove('show'));
  const arrow = scene.querySelector('.arrow');
  if (arrow) arrow.classList.remove('show');
}

function setActiveScene(index) {
  scenes.forEach((s, i) => {
    s.classList.toggle('active', i === index);
  });
  chips.forEach((c, i) => {
    c.classList.toggle('active', i === index);
  });
  sceneIndicator.textContent = `SCENE ${index + 1} / ${scenes.length}`;
}

// ============================================================
// 计时器（RAF）
// ============================================================
function startTimer() {
  state.sceneStartedAt = performance.now();
  const tick = () => {
    if (!state.playing) return;
    const elapsed = (performance.now() - state.sceneStartedAt) / 1000;
    timerEl.textContent = elapsed.toFixed(1) + 's';
    state.rafId = requestAnimationFrame(tick);
  };
  state.rafId = requestAnimationFrame(tick);
}

// ============================================================
// 旁白 + 场景播放
// ============================================================
function playScene(index) {
  clearTimers();
  state.current = index;
  setActiveScene(index);
  resetScene(index);

  const scene = SCENES[index];
  state.playing = true;
  btnPlay.textContent = '⏸ 暂停';

  // 元素时序
  scene.timeline.forEach(item => {
    showEl(item.id, item.delay);
  });

  // 特殊：箭头需要 show 类
  if (index === 4) {
    setTimeout(() => {
      document.getElementById('s4-a1')?.classList.add('show');
    }, 2200);
    setTimeout(() => {
      document.getElementById('s4-a2')?.classList.add('show');
    }, 4000);
  }

  // 计时器
  startTimer();

  // 旁白 + 结束驱动
  if (state.voiceOn && 'speechSynthesis' in window) {
    window.speechSynthesis.cancel();
    const utter = new SpeechSynthesisUtterance(scene.narration);
    utter.lang = 'zh-CN';
    utter.rate = 1.05;
    utter.pitch = 1.0;

    // 尝试选中文语音
    const voices = window.speechSynthesis.getVoices();
    const zhVoice = voices.find(v => v.lang.startsWith('zh'));
    if (zhVoice) utter.voice = zhVoice;

    utter.onend = () => {
      if (state.playing && state.current === index) {
        // 口播结束 → 自动推进
        nextScene();
      }
    };

    // 兜底：如果 TTS 失败，用 duration 推进
    const fallback = setTimeout(() => {
      if (state.playing && state.current === index) {
        nextScene();
      }
    }, scene.duration + 800);
    state.timers.push(fallback);

    state.utterance = utter;
    window.speechSynthesis.speak(utter);
  } else {
    // 无旁白：按 duration 推进
    const t = setTimeout(() => {
      if (state.playing && state.current === index) {
        nextScene();
      }
    }, scene.duration);
    state.timers.push(t);
  }

  // 进度条
  updateProgress(index);
}

function nextScene() {
  if (state.current < SCENES.length - 1) {
    playScene(state.current + 1);
  } else {
    // 最后一节结束
    state.playing = false;
    btnPlay.textContent = '▶ 播放';
  }
}

function prevScene() {
  if (state.current > 0) {
    playScene(state.current - 1);
  }
}

function replayScene() {
  playScene(state.current);
}

function togglePlay() {
  if (state.playing) {
    state.playing = false;
    btnPlay.textContent = '▶ 播放';
    if ('speechSynthesis' in window) window.speechSynthesis.pause();
    if (state.rafId) cancelAnimationFrame(state.rafId);
  } else {
    state.playing = true;
    btnPlay.textContent = '⏸ 暂停';
    if ('speechSynthesis' in window && window.speechSynthesis.paused) {
      window.speechSynthesis.resume();
    } else {
      // 重新计时
      state.sceneStartedAt = performance.now() - state.elapsed * 1000;
    }
    startTimer();
  }
}

function updateProgress(index) {
  const pct = ((index + 1) / SCENES.length) * 100;
  progressBar.style.width = pct + '%';
}

// ============================================================
// 事件绑定
// ============================================================
btnPrev.addEventListener('click', prevScene);
btnNext.addEventListener('click', nextScene);
btnReplay.addEventListener('click', replayScene);
btnPlay.addEventListener('click', togglePlay);

btnVoice.addEventListener('click', () => {
  state.voiceOn = !state.voiceOn;
  btnVoice.textContent = state.voiceOn ? '🔊 旁白开' : '🔇 旁白关';
  if (!state.voiceOn && 'speechSynthesis' in window) {
    window.speechSynthesis.cancel();
  }
});

chips.forEach(chip => {
  chip.addEventListener('click', () => {
    const idx = parseInt(chip.dataset.scene);
    playScene(idx);
  });
});

// 键盘控制
document.addEventListener('keydown', (e) => {
  if (e.key === 'ArrowRight') { e.preventDefault(); nextScene(); }
  else if (e.key === 'ArrowLeft') { e.preventDefault(); prevScene(); }
  else if (e.key === ' ') { e.preventDefault(); togglePlay(); }
  else if (e.key === 'r' || e.key === 'R') { replayScene(); }
  else if (e.key === 'm' || e.key === 'M') {
    btnVoice.click();
  }
});

// 预加载语音列表
if ('speechSynthesis' in window) {
  window.speechSynthesis.getVoices();
  window.speechSynthesis.onvoiceschanged = () => {
    window.speechSynthesis.getVoices();
  };
}

// ============================================================
// 启动
// ============================================================
window.addEventListener('load', () => {
  playScene(0);
});
</script>
</body>
</html>