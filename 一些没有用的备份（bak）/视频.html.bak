<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>随机抖音视频播放</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Microsoft YaHei", sans-serif;
        }
        body {
            background: #121212;
            color: #fff;
            padding: 20px;
            max-width: 500px;
            margin: 0 auto;
        }
        .container {
            background: #1e1e1e;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 0 15px rgba(0,0,0,0.3);
        }
        h2 {
            text-align: center;
            margin-bottom: 20px;
            color: #ffffff;
            font-size: 18px;
        }
        .btn {
            display: block;
            width: 100%;
            padding: 14px;
            background: #fe2c55;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            cursor: pointer;
            margin-bottom: 15px;
            transition: 0.2s;
        }
        .btn:disabled {
            background: #66101f;
            cursor: not-allowed;
        }
        .loading {
            text-align: center;
            padding: 10px;
            color: #aaa;
            display: none;
        }
        .video-box {
            width: 100%;
            border-radius: 10px;
            overflow: hidden;
            background: #000;
            margin-top: 10px;
            display: none;
        }
        video {
            width: 100%;
            display: block;
            max-height: 70vh;
        }
        .url-info {
            margin-top: 10px;
            padding: 10px;
            background: #2a2a2a;
            border-radius: 6px;
            word-break: break-all;
            color: #ccc;
            font-size: 12px;
            display: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>🎬 随机抖音视频播放器</h2>
        <button class="btn" id="getVideo">获取随机抖音视频</button>
        <div class="loading" id="loading">正在获取视频中...</div>
        <div class="video-box" id="videoBox">
            <video id="videoPlayer" controls playsinline></video>
        </div>
        <div class="url-info" id="urlInfo"></div>
    </div>

    <script>
        // 换了个现在还能用的接口
        const API_URL = "https://api.vvhan.com/api/douyin";
        const btn = document.getElementById('getVideo');
        const loading = document.getElementById('loading');
        const videoBox = document.getElementById('videoBox');
        const videoPlayer = document.getElementById('videoPlayer');
        const urlInfo = document.getElementById('urlInfo');

        btn.addEventListener('click', async () => {
            btn.disabled = true;
            btn.innerText = "获取中...";
            loading.style.display = 'block';
            videoBox.style.display = 'none';
            urlInfo.style.display = 'none';

            try {
                const res = await fetch(API_URL);
                if (!res.ok) throw new Error("请求失败");
                const data = await res.json();
                
                // 适配新接口返回格式
                if (data.url) {
                    const videoUrl = data.url;
                    videoPlayer.src = videoUrl;
                    urlInfo.innerText = "视频地址：" + videoUrl;
                    
                    videoBox.style.display = 'block';
                    urlInfo.style.display = 'block';
                    // 尝试播放（部分浏览器可能需要用户交互才能自动播放）
                    videoPlayer.play().catch(() => {});
                } else {
                    alert("获取失败：接口未返回视频地址");
                }
            } catch (err) {
                alert("请求失败：接口可能不可用或网络异常");
                console.error(err);
            } finally {
                btn.disabled = false;
                btn.innerText = "获取随机抖音视频";
                loading.style.display = 'none';
            }
        });
    </script>
</body>
</html>
