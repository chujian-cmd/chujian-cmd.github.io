#!/bin/bash

echo "=============================="
echo "  本地项目启动器 v2.0"
echo "  离线收藏家专用"
echo "=============================="
echo "1. Holistic（人体识别）8082"
echo "2. 晃动工坊（图片晃动）8084"
echo "3. Turbowarp（Scratch 编辑器）8085"
echo "4. 2048（经典小游戏）8086"
echo "5. MC Classic（网页版MC）8090"
echo "6. Eaglercraft（手机MC）8091"
echo "7. 3D Viewer（3D模型查看）8099"
echo "8. copy.sh（个人主页+生命游戏）8101"
echo "9. draw.io（绘图工具）8102"
echo "0. 停止所有服务"
echo "=============================="
echo "💡 提示：按 Ctrl+C 可停止当前运行的项目"
echo "=============================="
read -p "请输入数字 [0-9]: " choice

case $choice in
  1)
    echo "启动 Holistic..."
    cd /storage/emulated/0/holistic_demo && python -m http.server 8082
    ;;
  2)
    echo "启动 晃动工坊..."
    cd "/storage/emulated/0/html存放地/晃动工坊" && python -m http.server 8084
    ;;
  3)
    echo "启动 Turbowarp..."
    cd "/storage/emulated/0/html存放地/turbowarp.org" && python -m http.server 8085
    ;;
  4)
    echo "启动 2048..."
    cd "/storage/emulated/0/html存放地/2048" && python -m http.server 8086
    ;;
  5)
    echo "启动 MC Classic..."
    cd "/storage/emulated/0/html存放地/mc-classic/classic.minecraft.net" && python -m http.server 8090
    ;;
  6)
    echo "启动 Eaglercraft..."
    cd "/storage/emulated/0/html存放地/eaglercraft" && python -m http.server 8091
    ;;
  7)
    echo "启动 3D Viewer..."
    cd "/storage/emulated/0/html存放地/3dviewer" && python -m http.server 8099
    ;;
  8)
    echo "启动 copy.sh..."
    cd "/storage/emulated/0/html存放地/copy.sh" && python -m http.server 8101
    ;;
  9)
    echo "启动 draw.io..."
    cd "/storage/emulated/0/html存放地/drawio" && python -m http.server 8102
    ;;
  0)
    echo "停止所有服务器..."
    pkill -f "python -m http.server"
    echo "✅ 所有服务已停止"
    ;;
  *)
    echo "❌ 无效输入，请输入 0-9 之间的数字"
    ;;
esac

exit 0