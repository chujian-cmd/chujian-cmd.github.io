<script type=module>import*as T from'https://esm.run/three';with(T){let r=new WebGLRenderer,s=new Scene,c=new PerspectiveCamera;r.setSize(innerWidth,innerHeight);document.body.append(r.domElement);s.add(new Mesh(new BoxGeometry,new MeshNormalMaterial));c.position.z=3;r.setAnimationLoop(t=>{s.rotation.y=t/1e3;r.render(s,c)})}</script>