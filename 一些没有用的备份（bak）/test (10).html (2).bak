<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>全屏拖拽翻页测试</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            width: 100%; height: 100%;
            overflow: hidden;
            background: #000;
            color: #fff;
            font-family: sans-serif;
            touch-action: none;
            overscroll-behavior: none;
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
        }

        #pages-viewport {
            width: 100vw; height: 100vh;
            overflow: hidden;
            position: relative;
        }

        /* ★ 去掉 CSS transition，全部交给 JS 内联管理 */
        #pages-track {
            display: flex;
            height: 100%;
            width: 300vw;
            transform: translate3d(0, 0, 0);
            will-change: transform;
            touch-action: none;
        }

        .page {
            width: 100vw; height: 100%;
            flex-shrink: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 40px;
            font-weight: bold;
            touch-action: none;
        }
        .page:nth-child(1) { background: linear-gradient(135deg, #ff4757, #ff6b81); }
        .page:nth-child(2) { background: linear-gradient(135deg, #2ed573, #7bed9f); }
        .page:nth-child(3) { background: linear-gradient(135deg, #1e90ff, #70a1ff); }

        .longpress-alert {
            position: fixed;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%) scale(0.5);
            background: rgba(0, 0, 0, 0.8);
            padding: 20px 40px;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.2);
            font-size: 20px;
            opacity: 0;
            pointer-events: none;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            z-index: 100;
        }
        .longpress-alert.show {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1);
        }

        #control-bar {
            position: fixed;
            bottom: 0; left: 0;
            width: 100%; height: 100px;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 10;
            pointer-events: none;
        }

        #dots-track {
            display: flex;
            gap: 15px;
            padding: 15px 25px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 30px;
            backdrop-filter: blur(10px);
            pointer-events: auto;
        }

        .dot {
            width: 12px; height: 12px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
            transition: transform 0.2s, background 0.2s;
            cursor: pointer;
            position: relative;
        }
        .dot::after {
            content: '';
            position: absolute;
            top: -12px; left: -12px;
            right: -12px; bottom: -12px;
        }
        .dot.active {
            background: #fff;
            transform: scale(1.3);
        }
    </style>
</head>
<body>

    <div id="pages-viewport">
        <div id="pages-track">
            <div class="page">Page 1</div>
            <div class="page">Page 2</div>
            <div class="page">Page 3</div>
        </div>
    </div>

    <div class="longpress-alert" id="alertBox">触发长按！</div>

    <div id="control-bar">
        <div id="dots-track">
            <div class="dot active"></div>
            <div class="dot"></div>
            <div class="dot"></div>
        </div>
    </div>

    <script>
    (function() {
        'use strict';

        var track = document.getElementById('pages-track');
        var dots = document.querySelectorAll('.dot');
        var alertBox = document.getElementById('alertBox');
        var PAGE_COUNT = dots.length;
        var pageWidth = window.innerWidth;
        var currentPage = 0;

        var startX = 0, startY = 0;
        var startTranslate = 0;
        var dragging = false;
        var isPressing = false;
        var longPressTimer = null;
        var activeTouchId = null;
        var lastTouchTime = 0;

        track.style.width = (PAGE_COUNT * 100) + 'vw';

        /* ★ 唯一入口：所有 transform 都走这里，动画/无动画统一内联控制 */
        function applyTransform(px, animate) {
            track.style.transition = animate ? 'transform 0.35s cubic-bezier(0.25, 0.8, 0.25, 1)' : 'none';
            track.style.transform = 'translate3d(' + px + 'px, 0, 0)';
        }

        function setPage(idx, animate) {
            currentPage = Math.max(0, Math.min(idx, PAGE_COUNT - 1));
            applyTransform(-currentPage * pageWidth, animate !== false);
            dots.forEach(function(d, i) {
                d.classList.toggle('active', i === currentPage);
            });
        }

        function clearLP() {
            if (longPressTimer) { clearTimeout(longPressTimer); longPressTimer = null; }
        }

        function begin(x, y) {
            startX = x;
            startY = y;
            startTranslate = -currentPage * pageWidth;
            dragging = false;
            isPressing = true;
            clearLP();
            longPressTimer = setTimeout(function() {
                if (isPressing && !dragging) {
                    alertBox.classList.add('show');
                    if (navigator.vibrate) navigator.vibrate(50);
                }
            }, 500);
        }

        function move(x, y, e) {
            if (!isPressing) return;
            var dx = x - startX;
            var dy = y - startY;
            if (!dragging) {
                if (Math.abs(dx) > 8 || Math.abs(dy) > 8) clearLP();
                if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 8) {
                    dragging = true;
                    alertBox.classList.remove('show');
                }
            }
            if (dragging) {
                if (e && e.cancelable) e.preventDefault();
                var pos = startTranslate + dx;
                // ★ 每次移动都显式 transition: none，保证绝对跟手
                applyTransform(pos, false);
                var preview = Math.round(-pos / pageWidth);
                preview = Math.max(0, Math.min(preview, PAGE_COUNT - 1));
                dots.forEach(function(d, i) {
                    d.classList.toggle('active', i === preview);
                });
            }
        }

        function end(x) {
            clearLP();
            if (!isPressing) return;
            if (dragging) {
                var dx = x - startX;
                var finalPos = startTranslate + dx;
                var targetPage = Math.round(-finalPos / pageWidth);
                setPage(targetPage, true);
            } else {
                setPage(currentPage, true);
            }
            dragging = false;
            isPressing = false;
            setTimeout(function() { alertBox.classList.remove('show'); }, 1000);
        }

        /* ---------- 触摸 ---------- */
        document.addEventListener('touchstart', function(e) {
            if (activeTouchId !== null || e.touches.length !== 1) return;
            var target = e.target;
            if (target && target.closest && target.closest('#dots-track')) return;
            activeTouchId = e.touches[0].identifier;
            lastTouchTime = Date.now();
            begin(e.touches[0].clientX, e.touches[0].clientY);
        }, { passive: true });

        document.addEventListener('touchmove', function(e) {
            if (activeTouchId === null) return;
            for (var i = 0; i < e.touches.length; i++) {
                if (e.touches[i].identifier === activeTouchId) {
                    move(e.touches[i].clientX, e.touches[i].clientY, e);
                    break;
                }
            }
        }, { passive: false });

        document.addEventListener('touchend', function(e) {
            if (activeTouchId === null) return;
            var found = false;
            for (var i = 0; i < e.changedTouches.length; i++) {
                if (e.changedTouches[i].identifier === activeTouchId) {
                    end(e.changedTouches[i].clientX);
                    activeTouchId = null;
                    lastTouchTime = Date.now();
                    found = true;
                    break;
                }
            }
            if (!found) activeTouchId = null;
        });

        document.addEventListener('touchcancel', function() {
            clearLP();
            activeTouchId = null;
            if (isPressing) {
                if (dragging) setPage(currentPage, true);
                isPressing = false;
                dragging = false;
            }
        });

        /* ---------- 鼠标 ---------- */
        document.addEventListener('mousedown', function(e) {
            if (e.button !== 0) return;
            if (Date.now() - lastTouchTime < 500) return;
            var target = e.target;
            if (target && target.closest && target.closest('#dots-track')) return;
            begin(e.clientX, e.clientY);
        });

        document.addEventListener('mousemove', function(e) {
            if (!isPressing) return;
            move(e.clientX, e.clientY, e);
        });

        document.addEventListener('mouseup', function(e) {
            if (!isPressing) return;
            end(e.clientX);
        });

        /* ---------- 圆点：点谁就切谁，不依赖 click ---------- */
        dots.forEach(function(dot, idx) {
            function handle(e) {
                e.stopPropagation();
                e.preventDefault();
                clearLP();
                alertBox.classList.remove('show');
                isPressing = false;
                dragging = false;
                setPage(idx, true);
            }
            dot.addEventListener('touchstart', handle, { passive: false });
            dot.addEventListener('mousedown', handle);
        });

        /* ---------- resize ---------- */
        window.addEventListener('resize', function() {
            pageWidth = window.innerWidth;
            setPage(currentPage, false);
        });

        setPage(0, false);
    })();
    </script>
</body>
</html>