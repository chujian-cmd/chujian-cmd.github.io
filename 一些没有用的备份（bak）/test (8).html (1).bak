<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>3D 房间测试 4.3</title>
<style>
  html, body {
    margin: 0; padding: 0; width: 100%; height: 100%;
    background: #000; overflow: hidden;
    touch-action: none;
    -webkit-user-select: none; user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  #app { position: relative; width: 100%; height: 100%; background: #000; }
  canvas { display: block; width: 100%; height: 100%; touch-action: none; }
</style>
</head>
<body>
<div id="app">
  <canvas id="scene"></canvas>
</div>

<script>
var canvas = document.getElementById('scene');
var ctx = canvas.getContext('2d');

// ===== 基础数学 =====
function dot(a, b) { return a[0]*b[0] + a[1]*b[1] + a[2]*b[2]; }
function cross(a, b) {
  return [
    a[1]*b[2] - a[2]*b[1],
    a[2]*b[0] - a[0]*b[2],
    a[0]*b[1] - a[1]*b[0]
  ];
}
function norm(a) {
  var l = Math.sqrt(a[0]*a[0] + a[1]*a[1] + a[2]*a[2]) || 1;
  return [a[0]/l, a[1]/l, a[2]/l];
}
function addScale(v1, v2, s) {
  return [v1[0] + v2[0]*s, v1[1] + v2[1]*s, v1[2] + v2[2]*s];
}

// ===== 场景数据 =====
var camera = { pos: [0, 1.6, 4.5], yaw: 0, pitch: -0.08, fov: Math.PI / 3 };
var hx = 4, hz = 5, top = 3.2;

var objects = [];
objects.push({ name: '桌', min: [-0.9, 0, -0.55], max: [0.9, 0.78, 0.55] });

function addChair(cx, cz, facing) {
  var sh = 0.24, seatH = 0.45, backT = 0.08, backH = 0.95;
  objects.push({ name: '椅', min: [cx - sh, 0, cz - sh], max: [cx + sh, seatH, cz + sh] });
  if (facing === 'N') objects.push({ name: '椅', min: [cx - sh, seatH, cz - sh - backT], max: [cx + sh, backH, cz - sh] });
  else if (facing === 'S') objects.push({ name: '椅', min: [cx - sh, seatH, cz + sh], max: [cx + sh, backH, cz + sh + backT] });
  else if (facing === 'W') objects.push({ name: '椅', min: [cx - sh - backT, seatH, cz - sh], max: [cx - sh, backH, cz + sh] });
  else if (facing === 'E') objects.push({ name: '椅', min: [cx + sh, seatH, cz - sh], max: [cx + sh + backT, backH, cz + sh] });
}
addChair(0, -1.15, 'N');
addChair(0,  1.15, 'S');
addChair(-1.35, 0, 'W');
addChair( 1.35, 0, 'E');

// ===== 求交 =====
function raycastRoom(origin, dir) {
  var bestT = 1e9, bestName = null, bestNormal = null;
  function test(t, name, normal, ok) {
    if (t > 0.001 && t < bestT && ok) { bestT = t; bestName = name; bestNormal = normal; }
  }
  if (dir[2] !== 0) {
    var t = (-hz - origin[2]) / dir[2];
    var x = origin[0] + dir[0]*t, y = origin[1] + dir[1]*t;
    test(t, '墙', [0,0,1], x>=-hx && x<=hx && y>=0 && y<=top);
    t = (hz - origin[2]) / dir[2];
    x = origin[0] + dir[0]*t; y = origin[1] + dir[1]*t;
    test(t, '墙', [0,0,-1], x>=-hx && x<=hx && y>=0 && y<=top);
  }
  if (dir[0] !== 0) {
    t = (-hx - origin[0]) / dir[0];
    y = origin[1] + dir[1]*t;
    var z = origin[2] + dir[2]*t;
    test(t, '墙', [1,0,0], z>=-hz && z<=hz && y>=0 && y<=top);
    t = (hx - origin[0]) / dir[0];
    y = origin[1] + dir[1]*t; z = origin[2] + dir[2]*t;
    test(t, '墙', [-1,0,0], z>=-hz && z<=hz && y>=0 && y<=top);
  }
  if (dir[1] !== 0) {
    t = (0 - origin[1]) / dir[1];
    x = origin[0] + dir[0]*t; z = origin[2] + dir[2]*t;
    test(t, '地', [0,1,0], x>=-hx && x<=hx && z>=-hz && z<=hz);
  }
  if (bestName === null) return null;
  return { name: bestName, normal: bestNormal, t: bestT };
}

function rayAABB(o, d, min, max) {
  var tmin = -1e9, tmax = 1e9;
  var nx = 0, ny = 0, nz = 0;
  for (var i = 0; i < 3; i++) {
    if (Math.abs(d[i]) < 1e-6) {
      if (o[i] < min[i] || o[i] > max[i]) return null;
    } else {
      var t1 = (min[i] - o[i]) / d[i];
      var t2 = (max[i] - o[i]) / d[i];
      var n1 = -1;
      if (t1 > t2) { 
        var tmp = t1; t1 = t2; t2 = tmp; n1 = 1; 
      }
      if (t1 > tmin) {
        tmin = t1;
        nx = 0; ny = 0; nz = 0;
        if (i === 0) nx = n1;
        if (i === 1) ny = n1;
        if (i === 2) nz = n1;
      }
      if (t2 < tmax) tmax = t2;
      if (tmin > tmax) return null;
    }
  }
  if (tmax < 0) return null;
  var t = tmin > 0.001 ? tmin : tmax;
  if (t <= 0.001) return null;
  return { t: t, normal: [nx, ny, nz] };
}

function raycast(origin, dir) {
  var room = raycastRoom(origin, dir);
  var bestT = room ? room.t : 1e9;
  var bestName = room ? room.name : null;
  var bestNormal = room ? room.normal : null;
  for (var i=0; i<objects.length; i++) {
    var hit = rayAABB(origin, dir, objects[i].min, objects[i].max);
    if (hit && hit.t < bestT) {
      bestT = hit.t;
      bestName = objects[i].name;
      bestNormal = hit.normal;
    }
  }
  if (bestName === null) return null;
  return { name: bestName, normal: bestNormal, t: bestT };
}

// ===== 摇杆数据 =====
var joystick = { active: false, originX: 0, originY: 0, knobX: 0, knobY: 0, nx: 0, ny: 0, maxR: 50, outerR: 72, knobR: 22 };

// ===== 尺寸自适应 =====
var dpr = Math.min(window.devicePixelRatio || 1, 2);
var cssW = 0, cssH = 0;
function resize() {
  cssW = window.innerWidth;
  cssH = window.innerHeight;
  canvas.width = Math.floor(cssW * dpr);
  canvas.height = Math.floor(cssH * dpr);
  canvas.style.width = cssW + 'px';
  canvas.style.height = cssH + 'px';
}
window.addEventListener('resize', resize);
resize();

// ★ 密度调整在这里 ★
var CELL_SIZE = 12;      // 之前是 22，现在改为 12，密度翻倍
var FONT_RATIO = 0.85;   // 之前是 0.9，稍微调小防糊
var PLACEHOLDER = '·';

function grayStr(g) {
  var v = Math.max(0, Math.min(255, Math.round(g)));
  return 'rgb(' + v + ',' + v + ',' + v + ')';
}

// ===== 像素绘制 =====
function drawPixelRing(cx, cy, radius, pxSize, thicknessGrid, color) {
  ctx.fillStyle = color;
  var rOut = radius / pxSize, rIn = rOut - thicknessGrid;
  var n = Math.ceil(rOut);
  var ox = Math.round(cx / pxSize) * pxSize;
  var oy = Math.round(cy / pxSize) * pxSize;
  for (var gy = -n; gy <= n; gy++) {
    for (var gx = -n; gx <= n; gx++) {
      var d = Math.sqrt(gx*gx + gy*gy);
      if (d <= rOut && d > rIn) {
        ctx.fillRect(ox + gx * pxSize - pxSize/2, oy + gy * pxSize - pxSize/2, pxSize, pxSize);
      }
    }
  }
}

function drawPixelDisc(cx, cy, radius, pxSize, color) {
  ctx.fillStyle = color;
  var r = radius / pxSize;
  var n = Math.ceil(r);
  var ox = Math.round(cx / pxSize) * pxSize;
  var oy = Math.round(cy / pxSize) * pxSize;
  for (var gy = -n; gy <= n; gy++) {
    for (var gx = -n; gx <= n; gx++) {
      if (Math.sqrt(gx*gx + gy*gy) <= r) {
        ctx.fillRect(ox + gx * pxSize - pxSize/2, oy + gy * pxSize - pxSize/2, pxSize, pxSize);
      }
    }
  }
}

// ===== 渲染主循环 =====
function render() {
  var cy = Math.cos(camera.yaw), sy = Math.sin(camera.yaw);
  var cp = Math.cos(camera.pitch), sp = Math.sin(camera.pitch);
  var forward = norm([sy*cp, sp, -cy*cp]);
  var worldUp = [0,1,0];
  var right = cross(forward, worldUp);
  if (Math.sqrt(right[0]*right[0] + right[1]*right[1] + right[2]*right[2]) < 1e-6) right = [1,0,0];
  right = norm(right);
  var up = norm(cross(right, forward));

  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.fillStyle = '#000';
  ctx.fillRect(0, 0, cssW, cssH);

  var f = (cssH / 2) / Math.tan(camera.fov / 2);
  var cols = Math.ceil(cssW / CELL_SIZE);
  var rows = Math.ceil(cssH / CELL_SIZE);
  var offsetX = (cssW - cols * CELL_SIZE) / 2 + CELL_SIZE / 2;
  var offsetY = (cssH - rows * CELL_SIZE) / 2 + CELL_SIZE / 2;

  var fontSize = CELL_SIZE * FONT_RATIO;
  ctx.font = '700 ' + fontSize + 'px sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';

  for (var r = 0; r < rows; r++) {
    for (var c = 0; c < cols; c++) {
      var sx = offsetX + c * CELL_SIZE;
      var syScreen = offsetY + r * CELL_SIZE;

      var camX = (sx - cssW/2) / f;
      var camY = -(syScreen - cssH/2) / f;
      var camZ = 1;

      var dir = norm([
        right[0]*camX + up[0]*camY + forward[0]*camZ,
        right[1]*camX + up[1]*camY + forward[1]*camZ,
        right[2]*camX + up[2]*camY + forward[2]*camZ
      ]);

      var hit = raycast(camera.pos, dir);

      if (!hit) {
        ctx.fillStyle = grayStr(60);
        ctx.fillText(PLACEHOLDER, sx, syScreen);
        continue;
      }

      var facing = Math.max(0, -dot(hit.normal, dir));
      var fog = 1 / (1 + hit.t * 0.06);
      var lum = Math.pow(facing, 0.7) * fog;
      ctx.fillStyle = grayStr(40 + lum * 215);
      ctx.fillText(hit.name, sx, syScreen);
    }
  }

  if (joystick.active) {
    ctx.save();
    ctx.globalAlpha = 0.75;
    var px = 8;
    drawPixelRing(joystick.originX, joystick.originY, joystick.outerR, px, 1.5, '#ffffff');
    drawPixelDisc(joystick.knobX, joystick.knobY, joystick.knobR, px, '#000000');
    drawPixelRing(joystick.knobX, joystick.knobY, joystick.knobR, px, 1, '#ffffff');
    ctx.restore();
  }
}

function frame() {
  render();
  requestAnimationFrame(frame);
}
frame();

// ===== 输入处理 =====
var keys = {};
window.addEventListener('keydown', function(e) { keys[e.key.toLowerCase()] = true; });
window.addEventListener('keyup', function(e) { keys[e.key.toLowerCase()] = false; });

var dragging = false, lastX = 0, lastY = 0;
canvas.addEventListener('mousedown', function(e) { dragging = true; lastX = e.clientX; lastY = e.clientY; });
window.addEventListener('mouseup', function() { dragging = false; });
window.addEventListener('mousemove', function(e) {
  if (!dragging) return;
  var dx = e.clientX - lastX, dy = e.clientY - lastY;
  lastX = e.clientX; lastY = e.clientY;
  camera.yaw += dx * 0.005;
  camera.pitch -= dy * 0.005;
  camera.pitch = Math.max(-1.2, Math.min(1.2, camera.pitch));
});

var joyTouchId = null, rotateActive = false, rotateLastMX = 0, rotateLastMY = 0;

canvas.addEventListener('touchstart', function(e) {
  if (e.touches.length === 1) {
    var t = e.touches[0];
    joyTouchId = t.identifier;
    joystick.active = true;
    joystick.originX = t.clientX;
    joystick.originY = t.clientY;
    joystick.knobX = t.clientX;
    joystick.knobY = t.clientY;
    joystick.nx = 0; joystick.ny = 0;
  } else if (e.touches.length === 2) {
    joystick.active = false;
    joystick.nx = 0; joystick.ny = 0;
    joyTouchId = null;
    rotateActive = true;
    var mx = 0, my = 0;
    for (var i = 0; i < e.touches.length; i++) { mx += e.touches[i].clientX; my += e.touches[i].clientY; }
    mx /= e.touches.length; my /= e.touches.length;
    rotateLastMX = mx; rotateLastMY = my;
  }
  e.preventDefault();
}, { passive: false });

canvas.addEventListener('touchmove', function(e) {
  if (rotateActive && e.touches.length >= 2) {
    var mx = 0, my = 0;
    for (var i = 0; i < e.touches.length; i++) { mx += e.touches[i].clientX; my += e.touches[i].clientY; }
    mx /= e.touches.length; my /= e.touches.length;
    var dx = mx - rotateLastMX, dy = my - rotateLastMY;
    rotateLastMX = mx; rotateLastMY = my;
    camera.yaw += dx * 0.005;
    camera.pitch -= dy * 0.005;
    camera.pitch = Math.max(-1.2, Math.min(1.2, camera.pitch));
  } else if (joystick.active && joyTouchId !== null) {
    var t = null;
    for (var i = 0; i < e.touches.length; i++) { if (e.touches[i].identifier === joyTouchId) { t = e.touches[i]; break; } }
    if (t) {
      var dx = t.clientX - joystick.originX;
      var dy = t.clientY - joystick.originY;
      var len = Math.sqrt(dx*dx + dy*dy);
      var maxR = joystick.maxR;
      if (len > 0.001) {
        var cl = Math.min(len, maxR);
        joystick.nx = (dx / len) * (cl / maxR);
        joystick.ny = (dy / len) * (cl / maxR);
        joystick.knobX = joystick.originX + (dx / len) * cl;
        joystick.knobY = joystick.originY + (dy / len) * cl;
      } else {
        joystick.nx = 0; joystick.ny = 0;
        joystick.knobX = joystick.originX;
        joystick.knobY = joystick.originY;
      }
    }
  }
  e.preventDefault();
}, { passive: false });

canvas.addEventListener('touchend', function(e) {
  if (joyTouchId !== null) {
    var still = false;
    for (var i = 0; i < e.touches.length; i++) { if (e.touches[i].identifier === joyTouchId) { still = true; break; } }
    if (!still) {
      joyTouchId = null;
      joystick.active = false;
      joystick.nx = 0; joystick.ny = 0;
    }
  }
  if (rotateActive && e.touches.length < 2) rotateActive = false;
  e.preventDefault();
}, { passive: false });

canvas.addEventListener('touchcancel', function() {
  joystick.active = false;
  joyTouchId = null;
  rotateActive = false;
  joystick.nx = 0; joystick.ny = 0;
}, { passive: false });

// ===== 逻辑更新 =====
var last = performance.now();
function update(now) {
  var dt = Math.min(0.05, (now - last) / 1000);
  last = now;

  var speed = 2.5;
  var cy = Math.cos(camera.yaw), sy = Math.sin(camera.yaw);
  var flatFwd = [sy, 0, -cy];
  var flatRight = [cy, 0, sy];

  if (keys['w']) camera.pos = addScale(camera.pos, flatFwd, speed * dt);
  if (keys['s']) camera.pos = addScale(camera.pos, flatFwd, -speed * dt);
  if (keys['a']) camera.pos = addScale(camera.pos, flatRight, -speed * dt);
  if (keys['d']) camera.pos = addScale(camera.pos, flatRight, speed * dt);

  if (joystick.active && (Math.abs(joystick.nx) > 0.001 || Math.abs(joystick.ny) > 0.001)) {
    camera.pos = addScale(camera.pos, flatFwd, -joystick.ny * speed * dt);
    camera.pos = addScale(camera.pos, flatRight, joystick.nx * speed * dt);
  }

  camera.pos[0] = Math.max(-hx + 0.3, Math.min(hx - 0.3, camera.pos[0]));
  camera.pos[2] = Math.max(-hz + 0.3, Math.min(hz - 0.3, camera.pos[2]));

  requestAnimationFrame(update);
}
requestAnimationFrame(update);
</script>
</body>
</html>