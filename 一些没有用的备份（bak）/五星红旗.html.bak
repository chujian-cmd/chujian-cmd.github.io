<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>飘扬的五星红旗</title>
<style>
  body { margin: 0; overflow: hidden; background: #111; }
  canvas { display: block; }
  #hud {
    position: fixed; top: 16px; left: 16px; color: #fff;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 13px; line-height: 1.6;
    background: rgba(0,0,0,0.45);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    padding: 10px 14px; border-radius: 8px;
    border: 1px solid rgba(255,255,255,0.15);
    pointer-events: none; user-select: none; min-width: 180px;
  }
  #hud .title { font-weight: 600; color: #ffde59; margin-bottom: 4px; font-size: 14px; }
  #hud .row { display: flex; justify-content: space-between; gap: 16px; }
  #hud .key { color: #9ad; }
  #hud .val { color: #fff; font-variant-numeric: tabular-nums; }
</style>
</head>
<body>

<div id="hud">
  <div class="title">🇨🇳 五星红旗</div>
  <div class="row"><span class="key">拖动</span><span class="val">旋转视角</span></div>
  <div class="row"><span class="key">滚轮</span><span class="val">缩放</span></div>
  <div class="row"><span class="key">FPS</span><span class="val" id="fps">--</span></div>
</div>

<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
    "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
  }
}
</script>

<script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

const hudFps = document.getElementById('fps');

// --- 场景 ---
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x0a0a12);

const camera = new THREE.PerspectiveCamera(45, innerWidth / innerHeight, 0.1, 100);
camera.position.set(2.5, 1.2, 4.5);
camera.lookAt(0.5, 1.4, 0);

const renderer = new THREE.WebGLRenderer({ antialias: true });
renderer.setSize(innerWidth, innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
document.body.appendChild(renderer.domElement);

// --- 控制器 ---
const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;
controls.dampingFactor = 0.05;
controls.target.set(0.5, 1.4, 0);
controls.minDistance = 1.5;
controls.maxDistance = 12;
controls.maxPolarAngle = Math.PI / 2 + 0.3;

// --- 光照 ---
scene.add(new THREE.AmbientLight(0xffffff, 0.7));

const dirLight = new THREE.DirectionalLight(0xfff5e6, 1.2);
dirLight.position.set(3, 5, 4);
dirLight.castShadow = true;
dirLight.shadow.mapSize.set(1024, 1024);
dirLight.shadow.camera.near = 0.5;
dirLight.shadow.camera.far = 15;
dirLight.shadow.camera.left = -3;
dirLight.shadow.camera.right = 3;
dirLight.shadow.camera.top = 3;
dirLight.shadow.camera.bottom = -1;
scene.add(dirLight);

const fillLight = new THREE.DirectionalLight(0xaaccff, 0.4);
fillLight.position.set(-2, 1, 2);
scene.add(fillLight);

// --- 旗杆 ---
const pole = new THREE.Mesh(
  new THREE.CylinderGeometry(0.06, 0.08, 3.2, 16),
  new THREE.MeshStandardMaterial({ color: 0x8B7355, roughness: 0.6, metalness: 0.1 })
);
pole.position.y = 1.6;
pole.castShadow = true;
pole.receiveShadow = true;
scene.add(pole);

const finial = new THREE.Mesh(
  new THREE.SphereGeometry(0.1, 16, 16),
  new THREE.MeshStandardMaterial({ color: 0xDAA520, roughness: 0.25, metalness: 0.9 })
);
finial.position.y = 3.25;
finial.castShadow = true;
scene.add(finial);

const base = new THREE.Mesh(
  new THREE.CylinderGeometry(0.25, 0.3, 0.15, 16),
  new THREE.MeshStandardMaterial({ color: 0x5a4a3a, roughness: 0.8 })
);
base.position.y = 0.075;
base.receiveShadow = true;
scene.add(base);

const ground = new THREE.Mesh(
  new THREE.PlaneGeometry(8, 8),
  new THREE.MeshStandardMaterial({ color: 0x1a1a2e, roughness: 0.95 })
);
ground.rotation.x = -Math.PI / 2;
ground.position.y = -0.05;
ground.receiveShadow = true;
scene.add(ground);

// =====================================================
// 国旗：几何体绘制（红色旗面 + 五颗黄星），颜色绝对标准
// =====================================================

// 旗帜尺寸 3:2（缩小到 0.65 倍）
const SCALE = 0.65;
const W = 2.4 * SCALE;
const H = 1.6 * SCALE;
const cell = H / 20;

// 旗帜位置：升到杆顶
const poleTopY = 3.2;
const flagTopY = poleTopY - 0.12;
const flagCenterY = flagTopY - H / 2;

const flagGroup = new THREE.Group();
flagGroup.position.set(W / 2, flagCenterY, 0);
scene.add(flagGroup);

// --- 红色旗面（标准色 #DE2910，MeshBasicMaterial 不受光照影响）---
const redMat = new THREE.MeshBasicMaterial({
  color: 0xDE2910,
  side: THREE.DoubleSide,
});
const red = new THREE.Mesh(new THREE.PlaneGeometry(W, H, 80, 60), redMat);
flagGroup.add(red);

// --- 五角星 Shape（第一个尖角朝上）---
function makeStarShape(outerR, innerR) {
  const shape = new THREE.Shape();
  const points = 5;
  for (let i = 0; i < points * 2; i++) {
    const r = i % 2 === 0 ? outerR : innerR;
    const a = (Math.PI * 2 / (points * 2)) * i + Math.PI / 2;
    const x = Math.cos(a) * r;
    const y = Math.sin(a) * r;
    if (i === 0) shape.moveTo(x, y);
    else shape.lineTo(x, y);
  }
  shape.closePath();
  return shape;
}

// --- 黄色五角星（标准色 #FFDE00，MeshBasicMaterial 不受光照影响）---
const yellowMat = new THREE.MeshBasicMaterial({
  color: 0xFFDE00,
  side: THREE.DoubleSide,
});

// --- 坐标换算 ---
const originX = -W / 2;
const originY =  H / 2;

// 大星
const bigR = (H * 3 / 10) / 2;
const bigCX = originX + 5 * cell;
const bigCY = originY - 5 * cell;

const bigStar = new THREE.Mesh(
  new THREE.ShapeGeometry(makeStarShape(bigR, bigR * 0.382)),
  yellowMat
);
bigStar.position.set(bigCX, bigCY, 0.005);
flagGroup.add(bigStar);

// 小星
const smallR = (H * 1 / 10) / 2;
const smallCenters = [
  { x: 10, y: 2 },
  { x: 12, y: 4 },
  { x: 12, y: 7 },
  { x: 10, y: 9 },
];

const smallStars = [];

smallCenters.forEach(({ x, y }) => {
  const cx = originX + x * cell;
  const cy = originY - y * cell;

  const star = new THREE.Mesh(
    new THREE.ShapeGeometry(makeStarShape(smallR, smallR * 0.382)),
    yellowMat
  );
  star.position.set(cx, cy, 0.005);

  const angle = Math.atan2(bigCY - cy, bigCX - cx);
  star.rotation.z = angle - Math.PI / 2;

  flagGroup.add(star);
  smallStars.push({ mesh: star, x: cx, y: cy });
});

const bigStarInfo = { mesh: bigStar, x: bigCX, y: bigCY };

// --- 波浪函数 ---
function waveZ(x, y, t) {
  const f = Math.min(Math.max((x + W / 2) / W, 0), 1);
  const ff = f * f;
  return (
    Math.sin(x * 3.5 - t * 2.0) * 0.22 * ff +
    Math.sin(y * 2.8 - t * 1.3) * 0.11 * ff +
    Math.sin((x + y) * 2.5 - t * 1.8) * 0.055 * ff
  );
}

// --- 连接件 ---
const clipGeo = new THREE.TorusGeometry(0.05, 0.015, 8, 16);
const clipMat = new THREE.MeshStandardMaterial({ color: 0xDAA520, metalness: 0.8, roughness: 0.3 });
for (let i = 0; i < 3; i++) {
  const clip = new THREE.Mesh(clipGeo, clipMat);
  clip.position.set(0, flagTopY - (i + 0.5) * (H / 3), 0);
  clip.rotation.y = Math.PI / 2;
  clip.castShadow = true;
  scene.add(clip);
}

// --- 动画 ---
const redGeo = red.geometry;
const basePositions = redGeo.attributes.position.array.slice();
const clock = new THREE.Clock();
let frames = 0;
let fpsTimer = 0;

function animate() {
  requestAnimationFrame(animate);
  const dt = clock.getDelta();
  const t = clock.getElapsedTime();

  // 1. 旗面波浪
  const pos = redGeo.attributes.position;
  for (let i = 0; i < pos.count; i++) {
    const ix = i * 3;
    const x0 = basePositions[ix];
    const y0 = basePositions[ix + 1];

    pos.array[ix]     = x0;
    pos.array[ix + 1] = y0;
    pos.array[ix + 2] = waveZ(x0, y0, t);
  }
  pos.needsUpdate = true;
  redGeo.computeVertexNormals();

  // 2. 星星跟随波浪
  bigStarInfo.mesh.position.z = waveZ(bigStarInfo.x, bigStarInfo.y, t) + 0.008;
  smallStars.forEach(({ mesh, x, y }) => {
    mesh.position.z = waveZ(x, y, t) + 0.008;
  });

  // 3. 整组轻微摆动
  flagGroup.rotation.z = Math.sin(t * 1.5) * 0.008;
  flagGroup.rotation.x = Math.sin(t * 1.1) * 0.005;

  controls.update();
  renderer.render(scene, camera);

  frames++;
  fpsTimer += dt;
  if (fpsTimer >= 0.5) {
    hudFps.textContent = Math.round(frames / fpsTimer);
    frames = 0;
    fpsTimer = 0;
  }
}

animate();

addEventListener('resize', () => {
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});
</script>
</body>
</html>