<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>壁纸复刻</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            /* 模拟手机屏幕比例，居中显示 */
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background-color: #111;
        }

        .phone-screen {
            width: 390px;
            height: 844px; /* 类似 iPhone 的尺寸比例 */
            background-color: #0d0410; /* 极暗的紫黑色底色 */
            position: relative;
            overflow: hidden;
            border-radius: 40px;
            box-shadow: 0 0 20px rgba(0,0,0,0.8);
        }

        /* 核心发光图形 */
        .glow-shape {
            position: absolute;
            bottom: 5%;
            left: -5%;
            width: 110%;
            height: 70%;
            z-index: 1;
        }

        /* 左侧巨大的亮粉色光晕 */
        .glow-shape::before {
            content: '';
            position: absolute;
            bottom: 5%;
            left: 10%;
            width: 450px;
            height: 450px;
            background: radial-gradient(circle, rgba(255, 0, 150, 0.85) 0%, rgba(200, 0, 120, 0.5) 30%, rgba(100, 0, 80, 0.1) 60%, transparent 80%);
            border-radius: 50%;
            filter: blur(35px); /* 核心模糊效果 */
            transform: translate(-15%, 0);
        }

        /* 右侧延展的弧线光带 */
        .glow-shape::after {
            content: '';
            position: absolute;
            bottom: 10%;
            right: 5%;
            width: 380px;
            height: 500px;
            /* 使用椭圆渐变来模拟弧形 */
            background: radial-gradient(ellipse at bottom left, rgba(230, 0, 140, 0.75) 0%, rgba(180, 0, 110, 0.4) 40%, transparent 70%);
            border-radius: 50% 50% 40% 60% / 60% 40% 60% 40%;
            filter: blur(45px);
            transform: rotate(-20deg);
        }

        /* 增加一层柔光，让整体过渡更自然 */
        .extra-glow {
            position: absolute;
            bottom: 20%;
            left: 15%;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(255, 50, 180, 0.3) 0%, transparent 70%);
            filter: blur(50px);
            z-index: 0;
        }
    </style>
</head>
<body>

    <div class="phone-screen">
        <div class="extra-glow"></div>
        <div class="glow-shape"></div>
        <!-- 你可以在这里继续添加图标、时间等元素 -->
    </div>

</body>
</html>