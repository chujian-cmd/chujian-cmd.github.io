<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>^_^</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  html, body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #050510;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: crosshair;
  }

  /* 极简深空背景：一层静态径向渐变，GPU 合成零成本 */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
      radial-gradient(circle at 50% 45%, rgba(20, 0, 40, 0.9) 0%, #050510 70%);
    z-index: 0;
  }

  /* 少量 CSS 粒子：6 个漂浮光点，用 transform + opacity 动画（GPU 加速） */
  .particles {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .particle {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 12px currentColor, 0 0 24px currentColor;
    will-change: transform, opacity;
    animation: floatUp linear infinite;
  }

  @keyframes floatUp {
    0%   { transform: translateY(20vh) scale(0.5); opacity: 0; }
    20%  { opacity: 0.9; }
    80%  { opacity: 0.9; }
    100% { transform: translateY(-80vh) scale(1.2); opacity: 0; }
  }

  /* ============ 核心：像素化 ^_^ ============ */

  .stage {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    /* 整体呼吸缩放 */
    animation: breathe 3.5s ease-in-out infinite;
  }

  @keyframes breathe {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.06); }
  }

  /* 每个字符单独一层，可以做逐字动画 */
  .glyph {
    font-family: 'Courier New', 'Consolas', monospace;
    font-weight: 900;
    font-size: clamp(7rem, 26vw, 20rem);
    line-height: 1;
    letter-spacing: 0.02em;
    display: inline-block;

    /* 像素化外观：关掉抗锯齿 + 用 steps 动画抖动 */
    image-rendering: pixelated;
    -webkit-font-smoothing: none;
    font-smooth: never;

    /* 彩虹渐变文字 */
    background: linear-gradient(
      90deg,
      #ff004c, #ff8a00, #ffe600, #4dff00,
      #00ffe1, #0066ff, #b400ff, #ff004c
    );
    background-size: 800% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;

    /* 多层光晕，但用 filter 代替 text-shadow（GPU 合成） */
    filter:
      drop-shadow(0 0 8px rgba(0, 255, 255, 0.9))
      drop-shadow(0 0 22px rgba(255, 0, 255, 0.7))
      drop-shadow(0 0 40px rgba(120, 0, 255, 0.5));

    animation:
      rainbowFlow 3s linear infinite,
      pixelJitter 0.6s steps(2) infinite;
    will-change: background-position, transform;
  }

  /* 逐字错峰：让三个字符不完全同步，更生动 */
  .glyph:nth-child(1) { animation-delay: 0s, 0s; }
  .glyph:nth-child(2) { animation-delay: -1s, -0.2s; }
  .glyph:nth-child(3) { animation-delay: -2s, -0.4s; }

  /* 彩虹在字符内部流动 */
  @keyframes rainbowFlow {
    0%   { background-position: 0% 50%; }
    100% { background-position: 800% 50%; }
  }

  /* 像素化抖动：位移 1~2px，配合 steps 制造"像素跳动"感 */
  @keyframes pixelJitter {
    0%   { transform: translate(0, 0); }
    25%  { transform: translate(-2px, 1px); }
    50%  { transform: translate(1px, -2px); }
    75%  { transform: translate(2px, 2px); }
    100% { transform: translate(0, 0); }
  }

  /* 外圈脉冲光环：用一个元素，只动 transform 和 opacity */
  .halo {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 3px solid rgba(0, 255, 255, 0.6);
    box-shadow:
      0 0 30px rgba(0, 255, 255, 0.5),
      inset 0 0 30px rgba(255, 0, 255, 0.3);
    animation: haloPulse 2s ease-out infinite;
    pointer-events: none;
    z-index: -1;
  }

  @keyframes haloPulse {
    0%   { transform: scale(0.6); opacity: 0.9; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  /* 第二个光环错开时间 */
  .halo:nth-child(2) { animation-delay: 1s; }

  /* 鼠标跟随的小像素点（很轻） */
  .cursor-pixel {
    position: fixed;
    width: 10px;
    height: 10px;
    background: #0ff;
    box-shadow: 0 0 15px #0ff, 0 0 30px #f0f;
    pointer-events: none;
    z-index: 20;
    transform: translate(-50%, -50%);
    /* 像素化：无圆角 */
    will-change: left, top;
  }
</style>
</head>
<body>

<!-- 少量粒子 -->
<div class="particles" id="particles"></div>

<!-- 中心舞台 -->
<div class="stage">
  <div class="halo"></div>
  <div class="halo"></div>
  <span class="glyph">^</span>
  <span class="glyph">_</span>
  <span class="glyph">^</span>
</div>

<!-- 鼠标像素点 -->
<div class="cursor-pixel" id="cursorPixel"></div>

<script>
(function () {
  // ---- 只生成 8 个 CSS 粒子，位置随机、颜色随机、动画时长随机 ----
  const container = document.getElementById('particles');
  const colors = ['#0ff', '#f0f', '#ff0', '#0f8', '#f08', '#08f'];
  const count = 8;

  for (let i = 0; i < count; i++) {
    const p = document.createElement('div');
    p.className = 'particle';
    const color = colors[i % colors.length];
    p.style.color = color;
    p.style.background = color;
    p.style.left = (Math.random() * 100) + '%';
    p.style.top = (Math.random() * 30 + 70) + '%'; // 从底部区域开始
    p.style.animationDuration = (6 + Math.random() * 6) + 's';
    p.style.animationDelay = (-Math.random() * 8) + 's'; // 错峰，避免同时出现
    // 尺寸随机
    const size = 4 + Math.random() * 6;
    p.style.width = size + 'px';
    p.style.height = size + 'px';
    container.appendChild(p);
  }

  // ---- 鼠标跟随像素点 ----
  const cursor = document.getElementById('cursorPixel');
  window.addEventListener('mousemove', (e) => {
    cursor.style.left = e.clientX + 'px';
    cursor.style.top = e.clientY + 'px';
  });

  // ---- 点击时中心舞台闪一下（纯 CSS class 切换，无 Canvas） ----
  const stage = document.querySelector('.stage');
  window.addEventListener('click', (e) => {
    // 中心位置触发一次快速缩放
    stage.style.transition = 'transform 0.1s';
    stage.style.transform = 'scale(1.15)';
    setTimeout(() => {
      stage.style.transition = 'transform 0.4s';
      stage.style.transform = '';
    }, 100);

    // 点击处生成 4 个像素火花（DOM，很快消失）
    for (let i = 0; i < 4; i++) {
      const s = document.createElement('div');
      const color = colors[Math.floor(Math.random() * colors.length)];
      s.style.cssText = `
        position: fixed;
        left: ${e.clientX}px;
        top: ${e.clientY}px;
        width: 8px; height: 8px;
        background: ${color};
        box-shadow: 0 0 12px ${color};
        pointer-events: none;
        z-index: 999;
        transition: transform 0.6s ease-out, opacity 0.6s ease-out;
      `;
      document.body.appendChild(s);
      const angle = Math.random() * Math.PI * 2;
      const dist = 60 + Math.random() * 80;
      requestAnimationFrame(() => {
        s.style.transform = `translate(${Math.cos(angle) * dist}px, ${Math.sin(angle) * dist}px) scale(0)`;
        s.style.opacity = '0';
      });
      setTimeout(() => s.remove(), 700);
    }
  });

  // ---- 防止移动端双击缩放干扰 ----
  document.addEventListener('touchstart', () => {}, { passive: true });
})();
</script>

</body>
</html>