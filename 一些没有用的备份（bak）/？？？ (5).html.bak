<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>System</title>
<style>
  body { margin: 0; overflow: hidden; background: #000; touch-action: none; }
  canvas { display: block; }
</style>
</head>
<body>
<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.160.0/build/three.module.js"
  }
}
</script>
<script type="module">
import * as THREE from 'three';

const scene = new THREE.Scene();
scene.fog = new THREE.FogExp2(0x000000, 0.04);

const camera = new THREE.PerspectiveCamera(45, innerWidth / innerHeight, 0.1, 100);
camera.position.set(0, 0, 10);

const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
renderer.setSize(innerWidth, innerHeight);
renderer.setPixelRatio(Math.min(devicePixelRatio, 1.5));
renderer.toneMapping = THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure = 1.1;
document.body.appendChild(renderer.domElement);

scene.add(new THREE.AmbientLight(0x220011, 3));

const lightR = new THREE.PointLight(0xff0044, 100, 20);
lightR.position.set(2, 2, 5);
scene.add(lightR);

const lightB = new THREE.PointLight(0x0044ff, 100, 20);
lightB.position.set(-2, -2, 5);
scene.add(lightB);

const pGeo = new THREE.BufferGeometry();
const pCount = 3000;
const pPos = new Float32Array(pCount * 3);
for (let i = 0; i < pCount; i++) {
  pPos[i*3] = (Math.random() - 0.5) * 20;
  pPos[i*3+1] = (Math.random() - 0.5) * 20;
  pPos[i*3+2] = (Math.random() - 0.5) * 20;
}
pGeo.setAttribute('position', new THREE.BufferAttribute(pPos, 3));
const pMat = new THREE.PointsMaterial({
  size: 0.03,
  color: 0xffffff,
  transparent: true,
  opacity: 0.2,
  blending: THREE.AdditiveBlending,
  depthWrite: false
});
const particles = new THREE.Points(pGeo, pMat);
scene.add(particles);

const outerGroup = new THREE.Group();
const outerCore = new THREE.Mesh(
  new THREE.CylinderGeometry(0.6, 0.8, 4.5, 32),
  new THREE.MeshStandardMaterial({
    color: 0xff0044,
    emissive: 0x550011,
    emissiveIntensity: 1.5,
    roughness: 0.3,
    metalness: 0.1,
    transparent: true,
    opacity: 0.85,
    side: THREE.DoubleSide
  })
);
outerCore.rotation.x = Math.PI * 0.5;
outerGroup.add(outerCore);
scene.add(outerGroup);

const innerGroup = new THREE.Group();
const innerCore = new THREE.Mesh(
  new THREE.CylinderGeometry(0.35, 0.35, 4.8, 32),
  new THREE.MeshStandardMaterial({
    color: 0x0044ff,
    emissive: 0x001155,
    emissiveIntensity: 2,
    roughness: 0.1,
    metalness: 0.5
  })
);
innerCore.rotation.x = Math.PI * 0.5;
innerGroup.add(innerCore);
scene.add(innerGroup);

let state = 'idle';
let cycleTime = 0;
let speed = 0;

window.addEventListener('pointerdown', () => {
  if (state === 'idle') {
    state = 'run';
    cycleTime = 0;
  }
});

const clock = new THREE.Clock();

function animate() {
  requestAnimationFrame(animate);
  const dt = clock.getDelta();
  const t = clock.getElapsedTime();

  particles.rotation.y = t * 0.02;
  particles.rotation.z = Math.sin(t * 0.1) * 0.1;
  pMat.opacity = 0.15 + Math.sin(t * 3) * 0.05;

  if (state === 'run') {
    cycleTime += dt;
    
    let phase = cycleTime % 3.5;
    let isThrusting = phase > 1.2 && phase < 2.8;
    let depth = 0;
    let scaleY = 1;

    if (isThrusting) {
      depth = Math.pow(Math.sin((phase - 1.2) / 1.6 * Math.PI), 1.5);
      speed = 4.0;
      scaleY = 1 + depth * 0.05;
    } else if (phase >= 2.8) {
      depth = 0.2 * Math.sin(phase * 10) * Math.exp(-(phase - 2.8) * 5);
      speed = 0.5;
    } else {
      depth = 0.1 + 0.1 * Math.sin(phase * 5);
      speed = 1.5;
    }

    innerGroup.position.z = -depth * 3.5;
    innerGroup.position.x = Math.sin(t * speed) * 0.05;
    innerGroup.position.y = Math.cos(t * speed * 1.3) * 0.05;

    outerGroup.position.z = -depth * 1.5;
    outerGroup.position.x = Math.sin(t * speed * 0.8) * 0.03;
    
    outerCore.scale.set(
      1 + depth * 0.1,
      scaleY + depth * 0.15,
      1 + depth * 0.05
    );

    innerCore.scale.set(
      1 + depth * 0.05,
      1 + depth * 0.2,
      1
    );
    
    innerCore.material.emissiveIntensity = 1.5 + depth * 2.5;
    outerCore.material.emissiveIntensity = 1.0 + depth * 2.0;

    lightR.intensity = 50 + depth * 150;
    lightB.intensity = 50 + depth * 100;
    
    lightR.position.z = 3 - depth * 2;
    lightB.position.z = 3 - depth * 2;

    lightR.position.x = 1.5 + Math.sin(t * speed) * 0.5;
    lightB.position.x = -1.5 + Math.cos(t * speed) * 0.5;
    lightR.position.y = 1.5 + Math.cos(t * speed) * 0.5;
    lightB.position.y = -1.5 + Math.sin(t * speed) * 0.5;

    camera.position.z = 8 - depth * 1.2 + Math.sin(t) * 0.1;
    camera.position.y = Math.sin(t * 2) * 0.1;

    pMat.size = 0.03 + depth * 0.04;
    pMat.opacity = 0.2 + depth * 0.3;

  } else {
    outerGroup.position.z = 0;
    outerGroup.rotation.z = Math.sin(t) * 0.1;
    innerGroup.position.z = -0.5;
    innerGroup.rotation.z = Math.cos(t) * 0.1;
    lightR.intensity = 50;
    lightB.intensity = 50;
    camera.position.z = 10;
  }

  renderer.render(scene, camera);
}
animate();

window.addEventListener('resize', () => {
  camera.aspect = innerWidth / innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(innerWidth, innerHeight);
});
</script>
</body>
</html>