<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>3D 房间测试 2</title>
<style>
  html, body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    background: #000;
    overflow: hidden;
    touch-action: none;          /* 禁止浏览器默认手势 */
    -webkit-user-select: none;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  #app {
    position: relative;
    width: 100%;
    height: 100%;
    background: #000;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }
  #labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .label {
    position: absolute;
    transform: translate(-50%, -50%);
    font-family: "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }
  .label-wall,
  .label-ground {
    color: #fff;
  }
</style>
</head>
<body>
<div id="app">
  <canvas id="scene"></canvas>
  <div id="labels"></div>
</div>

<script>
// ===== 3D 向量工具 =====
const V = {
  add: (a, b) => [a[0]+b[0], a[1]+b[1], a[2]+b[2]],
  sub: (a, b) => [a[0]-b[0], a[1]-b[1], a[2]-b[2]],
  scale: (a, s) => [a[0]*s, a[1]*s, a[2]*s],
  dot: (a, b) => a[0]*b[0] + a[1]*b[1] + a[2]*b[2],
  cross: (a, b) => [
    a[1]*b[2] - a[2]*b[1],
    a[2]*b[0] - a[0]*b[2],
    a[0]*b[1] - a[1]*b[0]
  ],
  norm: (a) => {
    const l = Math.hypot(a[0], a[1], a[2]) || 1;
    return [a[0]/l, a[1]/l, a[2]/l];
  }
};

// ===== 摄像机 =====
const camera = {
  pos: [0, 1.6, 4.5],
  yaw: 0,
  pitch: -0.05,
  fov: Math.PI / 3,
  near: 0.1
};

// ===== 房间 =====
const ROOM = {
  width: 8,
  height: 3.2,
  depth: 10
};

const canvas = document.getElementById('scene');
const ctx = canvas.getContext('2d');
const labelsEl = document.getElementById('labels');

// ===== 标签定义 =====
const labels = [];

function addWallLabel(points, text) {
  labels.push({ points, text });
}

// 后墙
addWallLabel([
  [-ROOM.width/2, 0, -ROOM.depth/2],
  [ ROOM.width/2, 0, -ROOM.depth/2],
  [ ROOM.width/2, ROOM.height, -ROOM.depth/2],
  [-ROOM.width/2, ROOM.height, -ROOM.depth/2]
], '墙');

// 前墙
addWallLabel([
  [-ROOM.width/2, 0, ROOM.depth/2],
  [ ROOM.width/2, 0, ROOM.depth/2],
  [ ROOM.width/2, ROOM.height, ROOM.depth/2],
  [-ROOM.width/2, ROOM.height, ROOM.depth/2]
], '墙');

// 左墙
addWallLabel([
  [-ROOM.width/2, 0, -ROOM.depth/2],
  [-ROOM.width/2, 0, ROOM.depth/2],
  [-ROOM.width/2, ROOM.height, ROOM.depth/2],
  [-ROOM.width/2, ROOM.height, -ROOM.depth/2]
], '墙');

// 右墙
addWallLabel([
  [ROOM.width/2, 0, -ROOM.depth/2],
  [ROOM.width/2, 0, ROOM.depth/2],
  [ROOM.width/2, ROOM.height, ROOM.depth/2],
  [ROOM.width/2, ROOM.height, -ROOM.depth/2]
], '墙');

// 地面
addWallLabel([
  [-ROOM.width/2, 0, -ROOM.depth/2],
  [ ROOM.width/2, 0, -ROOM.depth/2],
  [ ROOM.width/2, 0,  ROOM.depth/2],
  [-ROOM.width/2, 0,  ROOM.depth/2]
], '地');

// ===== 视图基向量 =====
function getViewBasis() {
  const cy = Math.cos(camera.yaw), sy = Math.sin(camera.yaw);
  const cp = Math.cos(camera.pitch), sp = Math.sin(camera.pitch);

  const forward = V.norm([sy * cp, sp, -cy * cp]);
  const worldUp = [0, 1, 0];
  let right = V.cross(forward, worldUp);
  if (Math.hypot(right[0], right[1], right[2]) < 1e-6) right = [1, 0, 0];
  right = V.norm(right);
  const up = V.norm(V.cross(right, forward));

  return { forward, right, up };
}

// ===== 投影 =====
function projectPoint(p, basis) {
  const rel = V.sub(p, camera.pos);
  const x = V.dot(rel, basis.right);
  const y = V.dot(rel, basis.up);
  const z = V.dot(rel, basis.forward);

  if (z <= camera.near) return null;

  const f = (canvas.height / 2) / Math.tan(camera.fov / 2);
  const sx = canvas.width / 2 + (x / z) * f;
  const sy = canvas.height / 2 - (y / z) * f;
  return { x: sx, y: sy, z };
}

// ===== 渲染标签 =====
function renderLabels(basis) {
  labelsEl.innerHTML = '';

  for (const label of labels) {
    const pts = label.points;
    const projected = pts.map(p => projectPoint(p, basis));

    // 测试版简单处理：任一顶点在相机后则跳过
    if (projected.some(p => p === null)) continue;

    let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
    for (const p of projected) {
      minX = Math.min(minX, p.x);
      maxX = Math.max(maxX, p.x);
      minY = Math.min(minY, p.y);
      maxY = Math.max(maxY, p.y);
    }
    const w = maxX - minX;
    const h = maxY - minY;
    if (w < 8 || h < 8) continue;

    const area = w * h;
    const fontSize = Math.max(10, Math.min(96, Math.sqrt(area) * 0.12));

    const cols = Math.max(1, Math.round(w / (fontSize * 1.15)));
    const rows = Math.max(1, Math.round(h / (fontSize * 1.15)));
    const total = Math.min(cols * rows, 240);

    for (let i = 0; i < total; i++) {
      const gx = i % cols;
      const gy = Math.floor(i / cols);
      const nx = cols <= 1 ? 0.5 : gx / (cols - 1);
      const ny = rows <= 1 ? 0.5 : gy / (rows - 1);
      const px = minX + nx * w;
      const py = minY + ny * h;

      const span = document.createElement('span');
      span.className = 'label ' + (label.text === '墙' ? 'label-wall' : 'label-ground');
      span.textContent = label.text;
      span.style.left = px + 'px';
      span.style.top = py + 'px';
      span.style.fontSize = fontSize + 'px';
      labelsEl.appendChild(span);
    }
  }
}

// ===== 尺寸 =====
function resize() {
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
}
window.addEventListener('resize', resize);
window.addEventListener('orientationchange', () => setTimeout(resize, 100));
resize();

// ===== 渲染循环 =====
function frame() {
  ctx.fillStyle = '#000';
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  const basis = getViewBasis();
  renderLabels(basis);

  requestAnimationFrame(frame);
}
frame();

// ===== 键盘 =====
let keys = {};
window.addEventListener('keydown', e => keys[e.key.toLowerCase()] = true);
window.addEventListener('keyup', e => keys[e.key.toLowerCase()] = false);

// ===== 鼠标拖动旋转 =====
let dragging = false;
let lastX = 0, lastY = 0;

canvas.addEventListener('mousedown', e => {
  dragging = true;
  lastX = e.clientX;
  lastY = e.clientY;
});
window.addEventListener('mouseup', () => dragging = false);
window.addEventListener('mousemove', e => {
  if (!dragging) return;
  const dx = e.clientX - lastX;
  const dy = e.clientY - lastY;
  lastX = e.clientX;
  lastY = e.clientY;
  camera.yaw += dx * 0.005;
  camera.pitch -= dy * 0.005;
  camera.pitch = Math.max(-1.2, Math.min(1.2, camera.pitch));
});

// ===== 触摸拖动旋转（手机） =====
let touchId = null;
let touchLastX = 0, touchLastY = 0;

canvas.addEventListener('touchstart', e => {
  if (e.touches.length !== 1) return;
  const t = e.touches[0];
  touchId = t.identifier;
  touchLastX = t.clientX;
  touchLastY = t.clientY;
}, { passive: false });

canvas.addEventListener('touchmove', e => {
  if (touchId === null) return;
  let t = null;
  for (const touch of e.touches) {
    if (touch.identifier === touchId) { t = touch; break; }
  }
  if (!t) return;

  const dx = t.clientX - touchLastX;
  const dy = t.clientY - touchLastY;
  touchLastX = t.clientX;
  touchLastY = t.clientY;

  camera.yaw += dx * 0.005;
  camera.pitch -= dy * 0.005;
  camera.pitch = Math.max(-1.2, Math.min(1.2, camera.pitch));

  e.preventDefault();
}, { passive: false });

canvas.addEventListener('touchend', e => {
  for (const touch of e.changedTouches) {
    if (touch.identifier === touchId) {
      touchId = null;
      break;
    }
  }
}, { passive: false });

canvas.addEventListener('touchcancel', () => {
  touchId = null;
}, { passive: false });

// ===== 更新 =====
let last = performance.now();
function update(now) {
  const dt = Math.min(0.05, (now - last) / 1000);
  last = now;

  const speed = 2.5;
  const basis = getViewBasis();
  const flatForward = V.norm([basis.forward[0], 0, basis.forward[2]]);
  const flatRight = V.norm([basis.right[0], 0, basis.right[2]]);

  if (keys['w']) camera.pos = V.add(camera.pos, V.scale(flatForward, speed * dt));
  if (keys['s']) camera.pos = V.add(camera.pos, V.scale(flatForward, -speed * dt));
  if (keys['a']) camera.pos = V.add(camera.pos, V.scale(flatRight, -speed * dt));
  if (keys['d']) camera.pos = V.add(camera.pos, V.scale(flatRight, speed * dt));

  camera.pos[0] = Math.max(-ROOM.width/2 + 0.3, Math.min(ROOM.width/2 - 0.3, camera.pos[0]));
  camera.pos[2] = Math.max(-ROOM.depth/2 + 0.3, Math.min(ROOM.depth/2 - 0.3, camera.pos[2]));

  requestAnimationFrame(update);
}
requestAnimationFrame(update);
</script>
</body>
</html>