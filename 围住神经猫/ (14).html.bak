<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>围住贱贱的棋子 (高清 9x9 情绪版)</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            font-family: sans-serif;
            color: #000000;
            overflow: hidden;
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
            -webkit-user-select: none;
            user-select: none;
        }
        
        canvas {
            background-color: #ffffff;
            border: 2px solid #000000;
            cursor: pointer;
            image-rendering: -webkit-optimize-contrast; 
            outline: none;
        }
        
        #info {
            margin-top: 20px;
            text-align: center;
        }
        
        button {
            padding: 8px 16px;
            font-size: 16px;
            cursor: pointer;
            background-color: #ffffff;
            color: #000000;
            border: 2px solid #000000;
            margin-top: 10px;
            font-weight: bold;
            transition: 0.1s;
            outline: none;
            -webkit-tap-highlight-color: transparent;
        }
        button:hover {
            background-color: #000000;
            color: #ffffff;
        }
        
        h2 { margin-bottom: 5px; }

        #hintBtn {
            position: fixed;
            top: 16px;
            right: 16px;
            margin: 0;
            background-color: #000000;
            color: #ffffff;
            border: 2px solid #000000;
            z-index: 100;
            padding: 8px 14px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.1s;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
            outline: none;
            -webkit-tap-highlight-color: transparent;
        }
        #hintBtn:hover {
            background-color: #ffffff;
            color: #000000;
        }
        #hintBtn.active {
            background-color: #444444;
            border-color: #444444;
            color: #ffffff;
            box-shadow: inset 0 3px 5px rgba(0,0,0,0.5);
        }
    </style>
</head>
<body>

    <button id="hintBtn" onclick="toggleHint()">引导模式</button>

    <h2>围住那个贱贱的棋子</h2>
    <div id="info">
        <span id="status">点击白圈变黑，斜角已封死，不能穿墙！</span>
        <br>
        <button onclick="initGame()">重新开始</button>
    </div>
    <br>
    <canvas id="gameCanvas"></canvas>

<script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const statusText = document.getElementById('status');
    const hintBtn = document.getElementById('hintBtn');

    // 高清屏适配
    const dpr = window.devicePixelRatio || 1;
    const ROWS = 9;
    const COLS = 9;
    const RADIUS = 18;     
    const SPACING = 42;    
    const PADDING = 30;    

    const cssWidth = COLS * SPACING + PADDING * 2;
    const cssHeight = ROWS * SPACING + PADDING * 2;

    canvas.style.width = cssWidth + 'px';
    canvas.style.height = cssHeight + 'px';
    canvas.width = cssWidth * dpr;
    canvas.height = cssHeight * dpr;
    ctx.scale(dpr, dpr);

    // --- 离线画布（性能优化核心） ---
    // 用于缓存棋盘和普通棋子，避免每帧重画几十个圆圈
    const bgCanvas = document.createElement('canvas');
    bgCanvas.width = cssWidth * dpr;
    bgCanvas.height = cssHeight * dpr;
    const bgCtx = bgCanvas.getContext('2d');
    bgCtx.scale(dpr, dpr);

    // 状态
    let grid = [];
    let enemy = { x: 4, y: 4 };
    let gameOver = false;

    // 动画状态
    let animation = null;
    const MOVE_DURATION = 180;

    // 引导模式
    let hintMode = false;
    let hintCell = null;

    // 情绪系统
    let enemyEmotion = 'smug';
    let emotionTimer = null;

    function initGame() {
        grid = Array.from({ length: ROWS }, () => Array(COLS).fill(0));
        enemy = { x: 4, y: 4 };
        grid[enemy.y][enemy.x] = 2;
        gameOver = false;
        animation = null;
        hintMode = false;
        hintCell = null;
        enemyEmotion = 'smug';
        if (emotionTimer) clearTimeout(emotionTimer);
        hintBtn.classList.remove('active');
        statusText.innerText = "点击白圈变黑，斜角已封死，不能穿墙！";
        renderBackground(); // 重新生成底图
        draw();
    }

    function toggleHint() {
        if (gameOver || animation) return;
        hintMode = !hintMode;
        hintBtn.classList.toggle('active', hintMode);
        
        if (hintMode) {
            setEnemyEmotion('confused', 1500);
            statusText.innerText = "AI 正在计算最佳落子...";
            draw();
            setTimeout(() => {
                computeHint();
                if (!hintCell) {
                    statusText.innerText = "无解局，随便下吧...";
                } else {
                    statusText.innerText = "高亮位置是最佳落子点！";
                }
                draw();
            }, 30);
        } else {
            hintCell = null;
            setEnemyEmotion('smug', 0); 
            statusText.innerText = "点击白圈变黑，斜角已封死，不能穿墙！";
            draw();
        }
    }

    function setEnemyEmotion(emotion, duration) {
        enemyEmotion = emotion;
        if (emotionTimer) clearTimeout(emotionTimer);
        if (duration > 0) {
            emotionTimer = setTimeout(() => {
                if (!gameOver) {
                    enemyEmotion = 'smug';
                    draw();
                }
            }, duration);
        }
    }

    function checkEscape(x, y) {
        return x === 0 || x === COLS - 1 || y === 0 || y === ROWS - 1;
    }

    function getNextMove(startX, startY) {
        const queue = [{ x: startX, y: startY, path: [] }];
        const visited = new Set([`${startX},${startY}`]);
        const straightDirs = [{ dx: 0, dy: -1 }, { dx: 1, dy: 0 }, { dx: 0, dy: 1 }, { dx: -1, dy: 0 }];
        const diagDirs = [{ dx: -1, dy: -1 }, { dx: 1, dy: -1 }, { dx: 1, dy: 1 }, { dx: -1, dy: 1 }];

        while (queue.length > 0) {
            const current = queue.shift();
            if (checkEscape(current.x, current.y) && current.path.length > 0) return current.path[0];

            for (let d of straightDirs) {
                const nx = current.x + d.dx, ny = current.y + d.dy;
                if (nx >= 0 && nx < COLS && ny >= 0 && ny < ROWS && grid[ny][nx] === 0 && !visited.has(`${nx},${ny}`)) {
                    visited.add(`${nx},${ny}`);
                    queue.push({ x: nx, y: ny, path: [...current.path, { x: nx, y: ny }] });
                }
            }
            for (let d of diagDirs) {
                const nx = current.x + d.dx, ny = current.y + d.dy;
                if (nx >= 0 && nx < COLS && ny >= 0 && ny < ROWS) {
                    const sx1 = current.x + d.dx, sy1 = current.y, sx2 = current.x, sy2 = current.y + d.dy;
                    if (grid[ny][nx] === 0 && grid[sy1][sx1] === 0 && grid[sy2][sx2] === 0 && !visited.has(`${nx},${ny}`)) {
                        visited.add(`${nx},${ny}`);
                        queue.push({ x: nx, y: ny, path: [...current.path, { x: nx, y: ny }] });
                    }
                }
            }
        }
        return null;
    }

    function computeHint() {
        hintCell = null;
        if (gameOver || animation) return;
        let empties = [];
        for (let y = 0; y < ROWS; y++) {
            for (let x = 0; x < COLS; x++) {
                if (grid[y][x] === 0) empties.push({ x, y });
            }
        }
        if (empties.length === 0) return;

        let bestCell = null, bestScore = -Infinity;
        const backupGrid = grid.map(row => [...row]);
        const backupEnemy = { ...enemy };

        for (let cell of empties) {
            grid[cell.y][cell.x] = 1;
            if (!getNextMove(enemy.x, enemy.y)) {
                bestCell = { x: cell.x, y: cell.y };
                grid = backupGrid.map(row => [...row]);
                enemy = { ...backupEnemy };
                hintCell = bestCell;
                return;
            }

            let simGrid = grid.map(row => [...row]);
            let simEnemy = { ...enemy };
            const originalGrid = grid;
            grid = simGrid; 

            let turns = 0, isWin = false;
            while (turns < 6) {
                const nextStep = getNextMove(simEnemy.x, simEnemy.y);
                if (!nextStep) { isWin = true; break; }
                grid[simEnemy.y][simEnemy.x] = 0;
                simEnemy.x = nextStep.x; simEnemy.y = nextStep.y;
                grid[simEnemy.y][simEnemy.x] = 2;
                if (checkEscape(simEnemy.x, simEnemy.y)) { isWin = false; break; }
                const enemyNext = getNextMove(simEnemy.x, simEnemy.y);
                if (enemyNext && grid[enemyNext.y][enemyNext.x] === 0) {
                    grid[enemyNext.y][enemyNext.x] = 1;
                } else {
                    for (let y = 0; y < ROWS; y++) {
                        for (let x = 0; x < COLS; x++) {
                            if (grid[y][x] === 0) { grid[y][x] = 1; break; }
                        }
                    }
                }
                turns++;
            }
            grid = originalGrid;
            let score = isWin ? (100000 - turns * 100) : (turns * 100);
            const dist = Math.abs(cell.x - enemy.x) + Math.abs(cell.y - enemy.y);
            score -= dist * 0.1;

            if (score > bestScore) { bestScore = score; bestCell = { x: cell.x, y: cell.y }; }
            grid = backupGrid.map(row => [...row]);
            enemy = { ...backupEnemy };
        }
        grid = backupGrid.map(row => [...row]);
        enemy = { ...backupEnemy };
        hintCell = bestCell;
    }

    // 渲染静态背景到离屏画布
    function renderBackground() {
        bgCtx.clearRect(0, 0, cssWidth, cssHeight);
        bgCtx.fillStyle = '#ffffff';
        bgCtx.fillRect(0, 0, cssWidth, cssHeight);

        // 画引导提示（如果有）
        if (hintCell && !gameOver && !animation) {
            const cx = PADDING + hintCell.x * SPACING;
            const cy = PADDING + hintCell.y * SPACING;
            drawHintOnCtx(bgCtx, cx, cy);
        }

        for (let y = 0; y < ROWS; y++) {
            for (let x = 0; x < COLS; x++) {
                const cx = PADDING + x * SPACING;
                const cy = PADDING + y * SPACING;
                if (grid[y][x] === 0) drawPieceOnCtx(bgCtx, cx, cy, false);
                else if (grid[y][x] === 1) drawPieceOnCtx(bgCtx, cx, cy, true);
            }
        }
    }

    function drawPieceOnCtx(c, cx, cy, isPlayer) {
        c.beginPath();
        c.arc(cx, cy, RADIUS, 0, Math.PI * 2);
        if (isPlayer) {
            c.fillStyle = '#000000';
            c.fill();
        } else {
            c.fillStyle = '#ffffff';
            c.fill();
            c.strokeStyle = '#000000';
            c.lineWidth = 2;
            c.stroke();
        }
    }

    function drawHintOnCtx(c, cx, cy) {
        c.beginPath();
        c.arc(cx, cy, RADIUS + 6, 0, Math.PI * 2);
        c.fillStyle = 'rgba(180, 180, 180, 0.4)';
        c.fill();
        
        c.beginPath();
        c.arc(cx, cy, RADIUS + 6, 0, Math.PI * 2);
        c.strokeStyle = 'rgba(100, 100, 100, 0.8)';
        c.lineWidth = 2;
        c.setLineDash([5, 5]);
        c.stroke();
        c.setLineDash([]);

        c.strokeStyle = 'rgba(80, 80, 80, 0.7)';
        c.lineWidth = 3;
        c.lineCap = 'round';
        c.beginPath();
        c.moveTo(cx - 8, cy - 8);
        c.lineTo(cx + 8, cy + 8);
        c.moveTo(cx + 8, cy - 8);
        c.lineTo(cx - 8, cy + 8);
        c.stroke();
    }

    function drawEnemyOnCtx(c, cx, cy) {
        c.beginPath();
        c.arc(cx, cy, RADIUS + 2, 0, Math.PI * 2);
        c.fillStyle = '#000000';
        c.fill();

        c.fillStyle = '#ffffff';
        c.textAlign = 'center';
        c.textBaseline = 'middle';
        
        let faceText = '^_^';
        if (enemyEmotion === 'confused') faceText = '囧';
        else if (enemyEmotion === 'pitiful') faceText = '(´• ω •`)';
        else if (enemyEmotion === 'laughing') faceText = '^0^';

        if (faceText.length > 5) c.font = 'bold 10px Arial, sans-serif';
        else if (faceText.length > 3) c.font = 'bold 14px Arial, sans-serif';
        else c.font = 'bold 18px Arial, sans-serif';
        
        c.fillText(faceText, cx, cy + 1);

        if (enemyEmotion === 'confused') {
            c.fillStyle = '#000000';
            c.font = 'bold 22px Arial, sans-serif';
            c.fillText('❓', cx + 18, cy - 22);
        } else if (enemyEmotion === 'pitiful') {
            c.fillStyle = '#ff0000';
            c.font = 'bold 24px Arial, sans-serif';
            c.fillText('❗', cx + 18, cy - 22);
        }
    }

    // 主渲染函数 (使用缓存底图提升性能)
    function draw() {
        // 每次重绘前，重新生成底图（因为棋盘状态变了）
        // 如果追求极致可以判断如果棋盘没变只重绘动画，但在这里重绘底图消耗极小
        renderBackground();

        // 将缓存好的底图贴到主画布上
        ctx.clearRect(0, 0, cssWidth, cssHeight);
        ctx.drawImage(bgCanvas, 0, 0, cssWidth, cssHeight);

        // 如果处于动画中，只单独画移动的敌人
        if (animation) {
            const now = performance.now();
            let t = (now - animation.startTime) / animation.duration;
            if (t > 1) t = 1;
            const easeT = 1 - (1 - t) * (1 - t); // 缓动函数
            
            const currentX = animation.fromX + (animation.toX - animation.fromX) * easeT;
            const currentY = animation.fromY + (animation.toY - animation.fromY) * easeT;

            const cx = PADDING + currentX * SPACING;
            const cy = PADDING + currentY * SPACING;
            
            // 用带性能优化的函数直接在屏幕上画敌人
            drawEnemyOnCtx(ctx, cx, cy);

            if (t >= 1) {
                // 动画结束，更新网格状态
                grid[animation.toY][animation.toX] = 2;
                animation = null;
                if (hintMode && !gameOver) computeHint();
                draw(); // 最终重绘一次完整状态
                if (checkEscape(enemy.x, enemy.y)) endGame(false);
            } else {
                requestAnimationFrame(draw);
            }
        } else {
            // 没有动画时，只需要画出静止的敌人即可
            if (!gameOver) {
                const cx = PADDING + enemy.x * SPACING;
                const cy = PADDING + enemy.y * SPACING;
                drawEnemyOnCtx(ctx, cx, cy);
            } else {
                // 游戏结束，敌人可能停留在最后位置
                const cx = PADDING + enemy.x * SPACING;
                const cy = PADDING + enemy.y * SPACING;
                drawEnemyOnCtx(ctx, cx, cy);
            }
        }
    }

    canvas.addEventListener('mousedown', (e) => {
        if (gameOver || animation) return;

        const rect = canvas.getBoundingClientRect();
        const clickX = (e.clientX || e.touches[0].clientX) - rect.left;
        const clickY = (e.clientY || e.touches[0].clientY) - rect.top;

        const gridX = Math.round((clickX - PADDING) / SPACING);
        const gridY = Math.round((clickY - PADDING) / SPACING);

        if (gridX >= 0 && gridX < COLS && gridY >= 0 && gridY < ROWS) {
            const centerX = PADDING + gridX * SPACING;
            const centerY = PADDING + gridY * SPACING;
            const dist = Math.hypot(clickX - centerX, clickY - centerY);
            
            if (dist <= SPACING * 0.6) {
                if (grid[gridY][gridX] === 0) {
                    grid[gridY][gridX] = 1;
                    if (hintMode) hintCell = null;
                    setEnemyEmotion('smug', 0);
                    statusText.innerText = "棋子正在逃窜...";
                    
                    // 关闭引导模式，重新计算底图
                    renderBackground();
                    draw();
                    
                    setTimeout(() => {
                        if (!gameOver) moveEnemy();
                    }, 80);
                }
            }
        }
    });

    function moveEnemy() {
        if (gameOver || animation) return;

        if (checkEscape(enemy.x, enemy.y)) {
            endGame(false);
            return;
        }

        const nextStep = getNextMove(enemy.x, enemy.y);

        if (nextStep) {
            const fromX = enemy.x;
            const fromY = enemy.y;
            const toX = nextStep.x;
            const toY = nextStep.y;

            // 从网格中清除敌人原位置，为新动画做准备
            grid[fromY][fromX] = 0;
            enemy.x = toX;
            enemy.y = toY;

            // 启动动画，记录初始时间和起点终点
            animation = {
                fromX, fromY, toX, toY,
                startTime: performance.now(),
                duration: MOVE_DURATION
            };
            
            // 重新生成背景（此时敌人原来位置变成了白圈）
            renderBackground();
            // 开始逐帧渲染
            requestAnimationFrame(draw);
        } else {
            endGame(true);
        }
    }

    function endGame(isWin) {
        if (gameOver) return;
        gameOver = true;
        hintCell = null;
        hintMode = false;
        hintBtn.classList.remove('active');
        
        if (isWin) {
            setEnemyEmotion('pitiful', 0);
            statusText.innerText = "🎉 成功围住！贱棋子无路可走！你赢了！";
        } else {
            setEnemyEmotion('laughing', 0);
            statusText.innerText = "🏃 棋子逃跑了！它带着 ^0^ 的表情溜了...你输了！";
        }
        draw();
    }

    initGame();
</script>

</body>
</html>