<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>围住贱贱的棋子 (纯黑白物理版)</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #ffffff; /* 纯白背景 */
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            font-family: sans-serif;
            color: #000000; /* 纯黑文字 */
            overflow: hidden;
        }
        canvas {
            background-color: #ffffff; /* 纯白画布 */
            border: 2px solid #000000; /* 纯黑边框，无阴影 */
            cursor: pointer;
        }
        #info {
            margin-top: 20px;
            text-align: center;
        }
        button {
            padding: 8px 16px;
            font-size: 16px;
            cursor: pointer;
            background-color: #ffffff;
            color: #000000;
            border: 2px solid #000000;
            margin-top: 10px;
            font-weight: bold;
            transition: 0.1s;
        }
        button:hover { 
            background-color: #000000; 
            color: #ffffff;
        }
        h2 { margin-bottom: 5px; }
    </style>
</head>
<body>

    <h2>围住那个贱贱的棋子</h2>
    <div id="info">
        <span id="status">点击白圈变黑，斜角已封死，不能穿墙！</span>
        <br>
        <button onclick="initGame()">重新开始</button>
    </div>
    <br>
    <canvas id="gameCanvas"></canvas>

<script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const statusText = document.getElementById('status');

    // 游戏配置
    const ROWS = 9;
    const COLS = 9;
    const RADIUS = 18;     
    const SPACING = 42;    
    const PADDING = 30;    

    canvas.width = COLS * SPACING + PADDING * 2;
    canvas.height = ROWS * SPACING + PADDING * 2;

    // 状态：0=空地(白), 1=玩家(黑), 2=逃跑的贱棋子
    let grid = []; 
    let enemy = { x: 4, y: 4 }; 
    let gameOver = false;

    // 动画状态：用于逃跑时的平滑移动
    let animation = null; // { fromX, fromY, toX, toY, progress, duration, startTime }
    const MOVE_DURATION = 180; // 毫秒

    // 初始化游戏
    function initGame() {
        grid = Array.from({ length: ROWS }, () => Array(COLS).fill(0));
        enemy = { x: 4, y: 4 };
        grid[enemy.y][enemy.x] = 2;
        gameOver = false;
        animation = null;
        statusText.innerText = "点击白圈变黑，斜角已封死，不能穿墙！";
        draw();
    }

    // 绘制普通棋子 (纯黑白)
    function drawPiece(cx, cy, isPlayer) {
        ctx.beginPath();
        ctx.arc(cx, cy, RADIUS, 0, Math.PI * 2);
        
        if (isPlayer) {
            ctx.fillStyle = '#000000'; // 纯黑
            ctx.fill();
        } else {
            ctx.fillStyle = '#ffffff'; // 纯白
            ctx.fill();
            ctx.strokeStyle = '#000000'; // 纯黑描边
            ctx.lineWidth = 2;
            ctx.stroke();
        }
    }

    // 绘制那个“贱贱”的逃跑棋子 (纯黑底，白线表情 ^_^)
    function drawEnemy(cx, cy) {
        // 纯黑棋子底
        ctx.beginPath();
        ctx.arc(cx, cy, RADIUS + 2, 0, Math.PI * 2);
        ctx.fillStyle = '#000000';
        ctx.fill();
        
        // 纯白表情 ^_^
        ctx.strokeStyle = '#ffffff';
        ctx.fillStyle = '#ffffff';
        ctx.lineWidth = 2;
        ctx.lineCap = 'round';

        // 左眼 ^ 形状 (两条短斜线)
        ctx.beginPath();
        ctx.moveTo(cx - 12, cy - 6);
        ctx.lineTo(cx - 6, cy - 1);
        ctx.lineTo(cx - 0, cy - 6);
        ctx.stroke();

        // 右眼 ^ 形状
        ctx.beginPath();
        ctx.moveTo(cx + 2, cy - 6);
        ctx.lineTo(cx + 8, cy - 1);
        ctx.lineTo(cx + 14, cy - 6);
        ctx.stroke();

        // 嘴巴 _ 形状 (一条弧线，小微笑)
        ctx.beginPath();
        ctx.moveTo(cx - 7, cy + 8);
        ctx.quadraticCurveTo(cx + 0, cy + 13, cx + 7, cy + 8);
        ctx.stroke();

        // 可选：脸颊小点（纯装饰，保持贱贱的感觉）
        ctx.beginPath();
        ctx.arc(cx - 12, cy + 6, 1.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.arc(cx + 12, cy + 6, 1.5, 0, Math.PI * 2);
        ctx.fill();
    }

    // 绘图主函数
    function draw() {
        // 清空画布为纯白
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        for (let y = 0; y < ROWS; y++) {
            for (let x = 0; x < COLS; x++) {
                // 如果当前格子是敌人并且正在动画中，则跳过绘制（由动画层绘制）
                if (animation && x === enemy.x && y === enemy.y) {
                    // 但底层要画一个空位或者白圈？敌人已经不在原格逻辑上，但动画中旧位置已清空。
                    // 实际上因为移动动画，旧位置grid已经置0，所以这里自然绘制白圈。
                    // 为了避免在动画过程中绘制敌人（因为我们会单独画动画中的敌人），我们跳过敌人。
                    // 但grid[enemy.y][enemy.x]已经是2，但我们要等动画结束才显示在新位置。
                    // 所以如果正在动画，不要在grid循环里绘制敌人，等会儿单独画。
                    continue;
                }
                const cx = PADDING + x * SPACING;
                const cy = PADDING + y * SPACING;

                if (grid[y][x] === 0) {
                    drawPiece(cx, cy, false); // 白底黑边
                } else if (grid[y][x] === 1) {
                    drawPiece(cx, cy, true);  // 纯黑
                } else if (grid[y][x] === 2) {
                    // 不在动画中，正常绘制敌人
                    drawEnemy(cx, cy);        
                }
            }
        }

        // 如果有动画，单独绘制敌人（平滑移动）
        if (animation) {
            const now = performance.now();
            let t = (now - animation.startTime) / animation.duration;
            if (t > 1) t = 1;
            // 缓动函数 easeOutQuad 让移动更自然
            const easeT = 1 - (1 - t) * (1 - t);
            const currentX = animation.fromX + (animation.toX - animation.fromX) * easeT;
            const currentY = animation.fromY + (animation.toY - animation.fromY) * easeT;

            const cx = PADDING + currentX * SPACING;
            const cy = PADDING + currentY * SPACING;
            drawEnemy(cx, cy);

            if (t >= 1) {
                // 动画结束，更新逻辑位置，清空动画
                grid[animation.toY][animation.toX] = 2;
                animation = null;
                draw(); // 重绘最终状态
                // 检查是否逃出边缘
                if (checkEscape(enemy.x, enemy.y)) {
                    endGame(false);
                }
            } else {
                // 继续下一帧
                requestAnimationFrame(draw);
            }
        }
    }

    // 检查是否到达边缘
    function checkEscape(x, y) {
        return x === 0 || x === COLS - 1 || y === 0 || y === ROWS - 1;
    }

    // 核心算法：BFS 找最短路径 (加入防穿角逻辑)
    function getNextMove(startX, startY) {
        const queue = [{ x: startX, y: startY, path: [] }];
        const visited = new Set([`${startX},${startY}`]);

        // 4个直线方向
        const straightDirs = [
            { dx: 0, dy: -1 }, { dx: 1, dy: 0 }, { dx: 0, dy: 1 }, { dx: -1, dy: 0 }
        ];
        // 4个斜线方向
        const diagDirs = [
            { dx: -1, dy: -1 }, { dx: 1, dy: -1 }, { dx: 1, dy: 1 }, { dx: -1, dy: 1 }
        ];

        while (queue.length > 0) {
            const current = queue.shift();
            
            if (checkEscape(current.x, current.y) && current.path.length > 0) {
                return current.path[0]; 
            }

            // 1. 尝试走直线 (无限制)
            for (let d of straightDirs) {
                const nx = current.x + d.dx;
                const ny = current.y + d.dy;

                if (nx >= 0 && nx < COLS && ny >= 0 && ny < ROWS) {
                    if (grid[ny][nx] === 0 && !visited.has(`${nx},${ny}`)) {
                        visited.add(`${nx},${ny}`);
                        queue.push({ x: nx, y: ny, path: [...current.path, { x: nx, y: ny }] });
                    }
                }
            }

            // 2. 尝试走斜线 (加入严格的防穿角判定)
            for (let d of diagDirs) {
                const nx = current.x + d.dx;
                const ny = current.y + d.dy;

                if (nx >= 0 && nx < COLS && ny >= 0 && ny < ROWS) {
                    // 计算两侧的卡角坐标 (比如向右下走，就要检查右边和下边)
                    const sideX1 = current.x + d.dx; // 横向邻居
                    const sideY1 = current.y;        // 纵向保持
                    const sideX2 = current.x;        // 横向保持
                    const sideY2 = current.y + d.dy; // 纵向邻居

                    // 只有目标点是空地，且两个直角侧边都是空地，才允许穿过
                    if (grid[ny][nx] === 0 && 
                        grid[sideY1][sideX1] === 0 && 
                        grid[sideY2][sideX2] === 0 && 
                        !visited.has(`${nx},${ny}`)) {
                        
                        visited.add(`${nx},${ny}`);
                        queue.push({ x: nx, y: ny, path: [...current.path, { x: nx, y: ny }] });
                    }
                }
            }
        }
        return null; // 无路可走
    }

    // 玩家点击事件
    canvas.addEventListener('mousedown', (e) => {
        if (gameOver || animation) return; // 动画进行中不能操作

        const rect = canvas.getBoundingClientRect();
        const clickX = e.clientX - rect.left;
        const clickY = e.clientY - rect.top;

        const gridX = Math.round((clickX - PADDING) / SPACING);
        const gridY = Math.round((clickY - PADDING) / SPACING);

        if (gridX >= 0 && gridX < COLS && gridY >= 0 && gridY < ROWS) {
            if (grid[gridY][gridX] === 0) {
                grid[gridY][gridX] = 1; 
                draw();
                // 延迟一点让玩家看到自己的落子，然后开始敌人移动动画
                setTimeout(() => {
                    if (!gameOver) {
                        moveEnemy();
                    }
                }, 80); 
            }
        }
    });

    // 棋子移动逻辑 (加入动画)
    function moveEnemy() {
        if (gameOver || animation) return;

        // 如果已经在边缘，直接结束
        if (checkEscape(enemy.x, enemy.y)) {
            endGame(false);
            return;
        }

        const nextStep = getNextMove(enemy.x, enemy.y);

        if (nextStep) {
            // 设置动画
            const fromX = enemy.x;
            const fromY = enemy.y;
            const toX = nextStep.x;
            const toY = nextStep.y;

            // 逻辑上先把旧位置清空，新位置先标记为0（但动画期间grid不更新，防止重复绘制）
            // 我们暂时把敌人从grid移除，动画结束后再设置新位置
            grid[fromY][fromX] = 0;
            // 注意：不立刻设置 grid[toY][toX] = 2，因为动画中需要画一个过渡状态的敌人
            // 但敌人逻辑坐标 enemy 更新为新的位置，用于判断和后续。
            enemy.x = toX;
            enemy.y = toY;

            // 启动动画
            animation = {
                fromX: fromX,
                fromY: fromY,
                toX: toX,
                toY: toY,
                startTime: performance.now(),
                duration: MOVE_DURATION
            };

            // 立刻重绘以开始动画
            draw();

            // 动画结束后在 draw 的动画完成分支里会设置 grid[toY][toX] = 2 并检查是否胜利
        } else {
            // 无路可走，玩家胜利
            endGame(true);
        }
    }

    // 游戏结束
    function endGame(isWin) {
        if (gameOver) return;
        gameOver = true;
        if (isWin) {
            statusText.innerText = "🎉 成功围住！贱棋子无路可走！你赢了！";
        } else {
            statusText.innerText = "🏃 棋子逃跑了！它带着贱贱的^_^笑容溜了...你输了！";
        }
        // 如果敌人逃跑了，确保显示在正确的位置
        draw();
    }

    // 启动游戏
    initGame();
</script>

</body>
</html>