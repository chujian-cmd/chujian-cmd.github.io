<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>围住贱贱的棋子 (全自动死局检测版)</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            font-family: sans-serif;
            color: #000000;
            overflow: hidden;
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
            -webkit-user-select: none;
            user-select: none;
        }
        
        canvas {
            background-color: #ffffff;
            border: 2px solid #000000;
            cursor: pointer;
            image-rendering: -webkit-optimize-contrast; 
            outline: none;
        }
        
        #info {
            margin-top: 10px;
            text-align: center;
            font-size: 14px;
            color: #666;
        }
        
        button {
            padding: 8px 16px;
            font-size: 16px;
            cursor: pointer;
            background-color: #ffffff;
            color: #000000;
            border: 2px solid #000000;
            margin-top: 10px;
            font-weight: bold;
            transition: 0.1s;
            outline: none;
            -webkit-tap-highlight-color: transparent;
        }
        button:hover {
            background-color: #000000;
            color: #ffffff;
        }
        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        
        h2 { margin-bottom: 5px; }

        /* 红色警告小标题 */
        #cheatSubtitle {
            display: none;
            margin-top: 8px;
            font-size: 13px;
            font-weight: bold;
            color: #d32f2f;
            text-align: center;
            animation: flash 0.5s infinite alternate;
        }
        @keyframes flash {
            from { opacity: 0.5; }
            to { opacity: 1; }
        }

        /* 全屏遮罩弹窗 */
        #modalOverlay {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.4);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }
        #modalBox {
            background: #fff;
            border: 3px solid #000;
            border-radius: 12px;
            padding: 24px;
            width: 80%;
            max-width: 320px;
            text-align: center;
            box-shadow: 6px 6px 0 #000;
            animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        @keyframes popIn {
            from { transform: scale(0.7); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }
        #modalTitle {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 12px;
            color: #d32f2f;
        }
        #modalText {
            font-size: 15px;
            line-height: 1.5;
            margin-bottom: 20px;
            text-align: left;
        }
        #modalBtn {
            background: #000;
            color: #fff;
            border: 2px solid #000;
            padding: 8px 20px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 6px;
        }
        #modalBtn:active {
            transform: scale(0.95);
        }

        #hintBtn {
            position: fixed;
            top: 16px;
            right: 16px;
            margin: 0;
            background-color: #000000;
            color: #ffffff;
            border: 2px solid #000000;
            z-index: 100;
            padding: 8px 14px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.1s;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
            outline: none;
            -webkit-tap-highlight-color: transparent;
        }
        #hintBtn:hover {
            background-color: #ffffff;
            color: #000000;
        }
        #hintBtn.active {
            background-color: #444444;
            border-color: #444444;
            color: #ffffff;
            box-shadow: inset 0 3px 5px rgba(0,0,0,0.5);
        }
    </style>
</head>
<body>

    <button id="hintBtn" onclick="toggleHint()">引导模式</button>

    <h2>围住那个贱贱的棋子</h2>
    <div id="info">
        <button id="restartBtn" onclick="handleRestart()">重新开始</button>
        <div id="cheatSubtitle">⚠️ 检测到死局，请求强制干预...</div>
    </div>
    <br>
    <canvas id="gameCanvas"></canvas>

    <!-- 弹窗 -->
    <div id="modalOverlay">
        <div id="modalBox">
            <div id="modalTitle">⚠️ 紧急通知</div>
            <div id="modalText">由于不可抵抗的原因，我们被迫将您的 <b>[坐标 A]</b> 棋子移动到 <b>[坐标 B]</b>。</div>
            <button id="modalBtn" onclick="confirmCheat()">同意</button>
        </div>
    </div>

<script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const hintBtn = document.getElementById('hintBtn');
    const restartBtn = document.getElementById('restartBtn');
    const cheatSubtitle = document.getElementById('cheatSubtitle');
    const modalOverlay = document.getElementById('modalOverlay');
    const modalText = document.getElementById('modalText');

    const dpr = window.devicePixelRatio || 1;
    const ROWS = 9;
    const COLS = 9;
    const RADIUS = 18;     
    const SPACING = 42;    
    const PADDING = 30;    

    const cssWidth = COLS * SPACING + PADDING * 2;
    const cssHeight = ROWS * SPACING + PADDING * 2;

    canvas.style.width = cssWidth + 'px';
    canvas.style.height = cssHeight + 'px';
    canvas.width = cssWidth * dpr;
    canvas.height = cssHeight * dpr;
    ctx.scale(dpr, dpr);

    // 状态
    let grid = [];
    let enemy = { x: 4, y: 4 };
    let gameOver = false;
    
    // 动画状态
    let isRestarting = false;
    let particles = []; 
    let restartAnimId = null;
    let restartPhaseStartTime = 0;
    const RESTART_PHASE_DURATION = 1500; 
    
    // 耍赖状态
    let isCheating = false;
    let pendingCheat = false; 
    let cheatSource = { x: 0, y: 0 };
    let cheatTarget = { x: 0, y: 0 };
    let cheatAnimProgress = 0;
    let cheatParticles = [];
    let cheatAnimId = null;

    // 普通移动动画
    let animation = null;
    const MOVE_DURATION = 180;

    // 引导与情绪
    let hintMode = false;
    let hintCell = null;
    let enemyEmotion = 'smug';
    let emotionTimer = null;

    // 闲置计时器
    let idleTimer = null;
    let idleState = 0; 

    // 对话气泡
    let chatMessage = "点击白圈变黑，斜角已封死！";
    let chatTimer = null;
    let chatOpacity = 1.0;
    
    function showChat(text, duration = 3000) {
        chatMessage = text;
        chatOpacity = 1.0;
        if (chatTimer) clearTimeout(chatTimer);
        if (duration > 0) {
            chatTimer = setTimeout(() => {
                chatOpacity = 0;
                draw();
            }, duration);
        }
        draw();
    }

    function resetIdleTimer() {
        if (idleTimer) clearTimeout(idleTimer);
        if (gameOver || isRestarting || animation || isCheating || pendingCheat) return;
        
        idleTimer = setTimeout(() => {
            if (gameOver || isRestarting || animation || isCheating || pendingCheat) return;
            idleState = 1;
            setEnemyEmotion('confused', 0); 
            showChat("你下不下啊？我都快睡着了...", 4000);
            
            idleTimer = setTimeout(() => {
                if (gameOver || isRestarting || animation || isCheating || pendingCheat) return;
                idleState = 2;
                setEnemyEmotion('laughing', 0);
                showChat("就这？我闭着眼睛你都抓不住！", 4000);
                
                idleTimer = setTimeout(() => {
                    if (gameOver || isRestarting || animation || isCheating || pendingCheat) return;
                    idleState = 3;
                    setEnemyEmotion('angry', 0); 
                    showChat("到底下不下？不下我掀桌子了！", 4000);
                }, 5000);
            }, 5000);
        }, 5000);
    }

    function initGame() {
        isRestarting = false;
        isCheating = false;
        pendingCheat = false;
        cheatParticles = [];
        cheatSubtitle.style.display = 'none';
        modalOverlay.style.display = 'none';
        
        grid = Array.from({ length: ROWS }, () => Array(COLS).fill(0));
        enemy = { x: 4, y: 4 };
        grid[enemy.y][enemy.x] = 2;
        gameOver = false;
        animation = null;
        hintMode = false;
        hintCell = null;
        enemyEmotion = 'smug';
        particles = [];
        enemySlide = { startX: 4, startY: 4, progress: 1 };
        idleState = 0;
        
        if (emotionTimer) clearTimeout(emotionTimer);
        if (restartAnimId) cancelAnimationFrame(restartAnimId);
        if (cheatAnimId) cancelAnimationFrame(cheatAnimId);
        if (idleTimer) clearTimeout(idleTimer);
        if (chatTimer) clearTimeout(chatTimer);
        hintBtn.classList.remove('active');
        restartBtn.disabled = false;
        
        showChat("点击白圈变黑，斜角已封死！", 0); 
        draw();
        resetIdleTimer();
    }

    // 重新开始
    function handleRestart() {
        if (isRestarting || isCheating || pendingCheat) return; 
        isRestarting = true;
        restartBtn.disabled = true;
        hintMode = false;
        hintBtn.classList.remove('active');
        hintCell = null;
        if (idleTimer) clearTimeout(idleTimer);
        idleState = 0;

        let isPlayerWinning = false;
        let isPlayerLosing = false;

        if (gameOver) {
            if (enemyEmotion === 'pitiful') isPlayerWinning = true;
            else isPlayerLosing = true;
        } else {
            const nextMove = getNextMove(enemy.x, enemy.y);
            if (!nextMove) {
                isPlayerWinning = true;
            } else {
                const distToEdge = Math.min(enemy.x, enemy.y, COLS - 1 - enemy.x, ROWS - 1 - enemy.y);
                if (distToEdge <= 1) isPlayerLosing = true;
            }
        }

        if (gameOver && isPlayerWinning) {
            setEnemyEmotion('confused', 0);
            showChat("行行行，你赢了，再来一局还不行吗...", 2000);
        } else if (isPlayerWinning) {
            setEnemyEmotion('confused', 0);
            showChat("就差一步了！你居然重开？玩不起是吧！", 2000);
        } else if (gameOver && isPlayerLosing) {
            setEnemyEmotion('laughing', 0);
            showChat("哈哈哈哈，打不过我就跑，真菜！", 2000);
        } else if (isPlayerLosing) {
            setEnemyEmotion('laughing', 0);
            showChat("眼看我就要溜出去了吧？嘿嘿！", 2000);
        } else {
            setEnemyEmotion('confused', 0);
            showChat("干嘛？不玩啦？", 2000);
        }

        particles = [];
        for (let y = 0; y < ROWS; y++) {
            for (let x = 0; x < COLS; x++) {
                if (grid[y][x] === 1) {
                    const cx = PADDING + x * SPACING;
                    const cy = PADDING + y * SPACING;
                    
                    for (let i = 0; i < 40; i++) {
                        const angle = Math.random() * Math.PI * 2;
                        const r = Math.random() * RADIUS * 1.5;
                        const px = cx + Math.cos(angle) * r;
                        const py = cy + Math.sin(angle) * r;
                        
                        const screenCx = cssWidth / 2;
                        const screenCy = cssHeight / 2;
                        const dirX = px - screenCx + (Math.random() - 0.5) * 100;
                        const dirY = py - screenCy + (Math.random() - 0.5) * 100;
                        const distToEdge = Math.hypot(dirX, dirY) || 1;
                        
                        const speed = 3 + Math.random() * 5; 
                        
                        particles.push({
                            x: px, y: py,
                            vx: (dirX / distToEdge) * speed,
                            vy: (dirY / distToEdge) * speed,
                            size: 1 + Math.random() * 2.5, 
                            life: 1.0,
                            decay: 0.015 + Math.random() * 0.02 
                        });
                    }
                }
            }
        }

        enemySlide = { startX: enemy.x, startY: enemy.y, progress: 0 };

        for (let y = 0; y < ROWS; y++) {
            for (let x = 0; x < COLS; x++) {
                if (grid[y][x] === 1 || grid[y][x] === 2) {
                    grid[y][x] = 0; 
                }
            }
        }

        restartPhaseStartTime = performance.now();
        restartAnimId = requestAnimationFrame(restartLoop);
    }

    function easeInOutQuad(t) {
        return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
    }

    function restartLoop(timestamp) {
        if (!isRestarting) return;

        const elapsed = timestamp - restartPhaseStartTime;
        const progress = Math.min(elapsed / RESTART_PHASE_DURATION, 1);

        for (let i = particles.length - 1; i >= 0; i--) {
            const p = particles[i];
            p.x += p.vx;
            p.y += p.vy;
            p.vx += (Math.random() - 0.5) * 0.6;
            p.vy += (Math.random() - 0.5) * 0.6;
            p.life -= p.decay;
            if (p.life <= 0) particles.splice(i, 1);
        }

        let slideProgress = Math.max(0, (progress - 0.2) / 0.8); 
        const easeT = easeInOutQuad(slideProgress);
        const curEx = enemySlide.startX + (4 - enemySlide.startX) * easeT;
        const curEy = enemySlide.startY + (4 - enemySlide.startY) * easeT;

        ctx.clearRect(0, 0, cssWidth, cssHeight);
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, cssWidth, cssHeight);

        for (let y = 0; y < ROWS; y++) {
            for (let x = 0; x < COLS; x++) {
                drawPieceOnCtx(ctx, PADDING + x * SPACING, PADDING + y * SPACING, false);
            }
        }

        for (let p of particles) {
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
            ctx.fillStyle = '#000000';
            ctx.globalAlpha = p.life;
            ctx.fill();
        }
        ctx.globalAlpha = 1.0;

        const ex = PADDING + curEx * SPACING;
        const ey = PADDING + curEy * SPACING;
        drawEnemyOnCtx(ctx, ex, ey, timestamp);
        drawChatBubble(ctx, ex, ey);

        if (progress < 1) {
            restartAnimId = requestAnimationFrame(restartLoop);
        } else {
            isRestarting = false;
            initGame();
        }
    }

    // 引导模式（已去除触发弹窗的功能，纯做高亮计算）
    function toggleHint() {
        if (gameOver || animation || isRestarting || isCheating || pendingCheat) return;
        hintMode = !hintMode;
        hintBtn.classList.toggle('active', hintMode);
        
        if (hintMode) {
            setEnemyEmotion('confused', 1500); 
            showChat("AI 正在计算...", 1000);
            draw();
            setTimeout(() => {
                const bestCell = computeHint();
                if (!bestCell) {
                    showChat("哎呀，这局好像没救了...", 2000);
                } else {
                    showChat("高亮位置是最佳落子点！", 2000);
                    draw();
                }
            }, 30);
        } else {
            hintCell = null;
            setEnemyEmotion('smug', 0); 
            showChat("点击白圈变黑，斜角已封死！", 0);
            draw();
        }
        resetIdleTimer();
    }

    // 触发弹窗
    function triggerCheatRequest() {
        let playerPieces = [];
        for (let y = 0; y < ROWS; y++) {
            for (let x = 0; x < COLS; x++) {
                if (grid[y][x] === 1) playerPieces.push({ x, y });
            }
        }
        
        if (playerPieces.length === 0) {
            pendingCheat = false;
            cheatSubtitle.style.display = 'none';
            showChat("你连棋都没下，没得挪啦...", 2000);
            draw();
            return;
        }

        // 找离敌人最近的那颗玩家棋子
        playerPieces.sort((a, b) => {
            const distA = Math.hypot(a.x - enemy.x, a.y - enemy.y);
            const distB = Math.hypot(b.x - enemy.x, b.y - enemy.y);
            return distA - distB;
        });
        const source = playerPieces[0];
        cheatSource = { x: source.x, y: source.y };
        
        let bestTarget = null;
        const backupGrid = grid.map(row => [...row]);
        const backupEnemy = { ...enemy };
        
        let maxScore = -Infinity;
        for (let y = 0; y < ROWS; y++) {
            for (let x = 0; x < COLS; x++) {
                if (grid[y][x] === 0) {
                    grid[y][x] = 1;
                    const nextMove = getNextMove(enemy.x, enemy.y);
                    let score = 0;
                    if (!nextMove) {
                        score = 10000;
                    } else {
                        const steps = simulateEscapeSteps(enemy.x, enemy.y);
                        score = steps * 100;
                    }
                    
                    // 距离惩罚超级加倍
                    const distance = Math.hypot(x - cheatSource.x, y - cheatSource.y);
                    score -= distance * 5000;
                    
                    if (score > maxScore) {
                        maxScore = score;
                        bestTarget = { x, y };
                    }
                    grid[y][x] = 0;
                }
            }
        }
        
        grid = backupGrid.map(row => [...row]);
        enemy = { ...backupEnemy };

        if (!bestTarget) {
            pendingCheat = false;
            cheatSubtitle.style.display = 'none';
            showChat("连我都挪不动了，你自求多福吧...", 2000);
            draw();
            return;
        }

        cheatTarget = { x: bestTarget.x, y: bestTarget.y };

        const fromStr = `(${cheatSource.x + 1}, ${cheatSource.y + 1})`;
        const toStr = `(${cheatTarget.x + 1}, ${cheatTarget.y + 1})`;
        modalText.innerHTML = `由于不可抵抗的原因，我们被迫将您的 <b style="font-size:18px; color:#d32f2f;">${fromStr}</b> 棋子移动到 <b style="font-size:18px; color:#d32f2f;">${toStr}</b>。`;
        
        modalOverlay.style.display = 'flex';
        draw(); 
    }

    // 玩家点同意
    function confirmCheat() {
        modalOverlay.style.display = 'none';
        pendingCheat = false;
        isCheating = true;
        
        // 核心动画：清除旧棋子，生成粒子飞向目标
        startCheatParticles();
    }

    function startCheatParticles() {
        // 从原网格中移除
        grid[cheatSource.y][cheatSource.x] = 0;
        
        const startCx = PADDING + cheatSource.x * SPACING;
        const startCy = PADDING + cheatSource.y * SPACING;
        const endCx = PADDING + cheatTarget.x * SPACING;
        const endCy = PADDING + cheatTarget.y * SPACING;

        cheatParticles = [];
        for (let i = 0; i < 40; i++) {
            const angle = Math.random() * Math.PI * 2;
            const r = Math.random() * RADIUS;
            const px = startCx + Math.cos(angle) * r;
            const py = startCy + Math.sin(angle) * r;
            
            const dx = endCx - startCx;
            const dy = endCy - startCy;
            const dist = Math.hypot(dx, dy) || 1;
            
            const speed = dist / 20;

            cheatParticles.push({
                x: px, y: py,
                startX: px, startY: py,
                targetX: endCx, targetY: endCy,
                vx: (dx / dist) * speed + (Math.random() - 0.5) * 2,
                vy: (dy / dist) * speed + (Math.random() - 0.5) * 2,
                size: 1 + Math.random() * 2.5,
                life: 1.0,
                delay: Math.random() * 10 
            });
        }

        cheatAnimProgress = 0;
        drawCheatAnim();
    }

    function drawCheatAnim() {
        cheatAnimProgress++;
        
        ctx.clearRect(0, 0, cssWidth, cssHeight);
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, cssWidth, cssHeight);

        for (let y = 0; y < ROWS; y++) {
            for (let x = 0; x < COLS; x++) {
                const isPlayer = (grid[y][x] === 1);
                drawPieceOnCtx(ctx, PADDING + x * SPACING, PADDING + y * SPACING, isPlayer);
            }
        }

        if (cheatAnimProgress > 25) {
            const targetCx = PADDING + cheatTarget.x * SPACING;
            const targetCy = PADDING + cheatTarget.y * SPACING;
            drawPieceOnCtx(ctx, targetCx, targetCy, true);
            grid[cheatTarget.y][cheatTarget.x] = 1; 
        }

        let allArrived = true;
        for (let p of cheatParticles) {
            if (p.delay > 0) {
                p.delay--;
                allArrived = false;
                continue;
            }
            
            p.x += (p.targetX - p.x) * 0.15 + p.vx * 0.1;
            p.y += (p.targetY - p.y) * 0.15 + p.vy * 0.1;
            
            const dist = Math.hypot(p.targetX - p.x, p.targetY - p.y);
            if (dist < 2) {
                p.life = 0;
            } else {
                allArrived = false;
            }

            if (p.life > 0) {
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fillStyle = '#000000';
                ctx.globalAlpha = p.life;
                ctx.fill();
            }
        }
        ctx.globalAlpha = 1.0;

        const ex = PADDING + enemy.x * SPACING;
        const ey = PADDING + enemy.y * SPACING;
        drawEnemyOnCtx(ctx, ex, ey, performance.now());
        drawChatBubble(ctx, ex, ey);

        if (!allArrived && cheatAnimProgress < 80) {
            cheatAnimId = requestAnimationFrame(drawCheatAnim);
        } else {
            cheatAnimId = null;
            isCheating = false;
            cheatSubtitle.style.display = 'none';
            showChat("嘿嘿，我什么都没干哦~", 2000);
            draw();
            resetIdleTimer();
        }
    }

    function setEnemyEmotion(emotion, duration) {
        enemyEmotion = emotion;
        if (emotionTimer) clearTimeout(emotionTimer);
        if (duration > 0) {
            emotionTimer = setTimeout(() => {
                if (!gameOver && !isRestarting && !isCheating && !pendingCheat) {
                    enemyEmotion = 'smug';
                    draw();
                }
            }, duration);
        }
    }

    function checkEscape(x, y) {
        return x === 0 || x === COLS - 1 || y === 0 || y === ROWS - 1;
    }

    function getNextMove(startX, startY) {
        const queue = [{ x: startX, y: startY, path: [] }];
        const visited = new Set([`${startX},${startY}`]);
        const straightDirs = [{ dx: 0, dy: -1 }, { dx: 1, dy: 0 }, { dx: 0, dy: 1 }, { dx: -1, dy: 0 }];
        const diagDirs = [{ dx: -1, dy: -1 }, { dx: 1, dy: -1 }, { dx: 1, dy: 1 }, { dx: -1, dy: 1 }];

        while (queue.length > 0) {
            const current = queue.shift();
            if (checkEscape(current.x, current.y) && current.path.length > 0) return current.path[0];

            for (let d of straightDirs) {
                const nx = current.x + d.dx, ny = current.y + d.dy;
                if (nx >= 0 && nx < COLS && ny >= 0 && ny < ROWS && grid[ny][nx] === 0 && !visited.has(`${nx},${ny}`)) {
                    visited.add(`${nx},${ny}`);
                    queue.push({ x: nx, y: ny, path: [...current.path, { x: nx, y: ny }] });
                }
            }
            for (let d of diagDirs) {
                const nx = current.x + d.dx, ny = current.y + d.dy;
                if (nx >= 0 && nx < COLS && ny >= 0 && ny < ROWS) {
                    const sx1 = current.x + d.dx, sy1 = current.y, sx2 = current.x, sy2 = current.y + d.dy;
                    if (grid[ny][nx] === 0 && grid[sy1][sx1] === 0 && grid[sy2][sx2] === 0 && !visited.has(`${nx},${ny}`)) {
                        visited.add(`${nx},${ny}`);
                        queue.push({ x: nx, y: ny, path: [...current.path, { x: nx, y: ny }] });
                    }
                }
            }
        }
        return null;
    }

    function simulateEscapeSteps(startX, startY) {
        if (checkEscape(startX, startY)) return 0;
        const queue = [{ x: startX, y: startY, dist: 0 }];
        const visited = new Set([`${startX},${startY}`]);
        const straightDirs = [{ dx: 0, dy: -1 }, { dx: 1, dy: 0 }, { dx: 0, dy: 1 }, { dx: -1, dy: 0 }];
        const diagDirs = [{ dx: -1, dy: -1 }, { dx: 1, dy: -1 }, { dx: 1, dy: 1 }, { dx: -1, dy: 1 }];

        while (queue.length > 0) {
            const current = queue.shift();
            for (let d of straightDirs) {
                const nx = current.x + d.dx, ny = current.y + d.dy;
                if (nx >= 0 && nx < COLS && ny >= 0 && ny < ROWS && grid[ny][nx] === 0 && !visited.has(`${nx},${ny}`)) {
                    visited.add(`${nx},${ny}`);
                    const nd = current.dist + 1;
                    if (checkEscape(nx, ny)) return nd;
                    queue.push({ x: nx, y: ny, dist: nd });
                }
            }
            for (let d of diagDirs) {
                const nx = current.x + d.dx, ny = current.y + d.dy;
                if (nx >= 0 && nx < COLS && ny >= 0 && ny < ROWS) {
                    const sx1 = current.x + d.dx, sy1 = current.y, sx2 = current.x, sy2 = current.y + d.dy;
                    if (grid[ny][nx] === 0 && grid[sy1][sx1] === 0 && grid[sy2][sx2] === 0 && !visited.has(`${nx},${ny}`)) {
                        visited.add(`${nx},${ny}`);
                        const nd = current.dist + 1;
                        if (checkEscape(nx, ny)) return nd;
                        queue.push({ x: nx, y: ny, dist: nd });
                    }
                }
            }
        }
        return 999;
    }

    // 精准阈值：能拖延 5 步以上算好棋，只拖延 4 步及以下直接算死局
    function computeHint() {
        hintCell = null;
        if (gameOver || animation || isRestarting || isCheating || pendingCheat) return null;
        let empties = [];
        for (let y = 0; y < ROWS; y++) {
            for (let x = 0; x < COLS; x++) {
                if (grid[y][x] === 0) empties.push({ x, y });
            }
        }
        if (empties.length === 0) return null;

        let bestCell = null, bestScore = -Infinity;
        const backupGrid = grid.map(row => [...row]);
        const backupEnemy = { ...enemy };

        for (let cell of empties) {
            grid[cell.y][cell.x] = 1;
            if (!getNextMove(enemy.x, enemy.y)) {
                bestCell = { x: cell.x, y: cell.y };
                grid = backupGrid.map(row => [...row]);
                enemy = { ...backupEnemy };
                hintCell = bestCell;
                return bestCell;
            }

            let simGrid = grid.map(row => [...row]);
            let simEnemy = { ...enemy };
            const originalGrid = grid;
            grid = simGrid; 

            let turns = 0, isWin = false;
            while (turns < 6) {
                const nextStep = getNextMove(simEnemy.x, simEnemy.y);
                if (!nextStep) { isWin = true; break; }
                grid[simEnemy.y][simEnemy.x] = 0;
                simEnemy.x = nextStep.x; simEnemy.y = nextStep.y;
                grid[simEnemy.y][simEnemy.x] = 2;
                if (checkEscape(simEnemy.x, simEnemy.y)) { isWin = false; break; }
                const enemyNext = getNextMove(simEnemy.x, simEnemy.y);
                if (enemyNext && grid[enemyNext.y][enemyNext.x] === 0) {
                    grid[enemyNext.y][enemyNext.x] = 1;
                } else {
                    for (let y = 0; y < ROWS; y++) {
                        for (let x = 0; x < COLS; x++) {
                            if (grid[y][x] === 0) { grid[y][x] = 1; break; }
                        }
                    }
                }
                turns++;
            }
            grid = originalGrid;
            
            // 基础分
            let score = isWin ? (10000 - turns * 100) : (turns * 100);
            
            // 距离扣分（越远越不好）
            const dist = Math.hypot(cell.x - enemy.x, cell.y - enemy.y);
            score -= dist * 2;

            if (score > bestScore) { 
                bestScore = score; 
                bestCell = { x: cell.x, y: cell.y }; 
            }
            grid = backupGrid.map(row => [...row]);
            enemy = { ...backupEnemy };
        }
        grid = backupGrid.map(row => [...row]);
        enemy = { ...backupEnemy };
        
        // 关键调整：如果最高分连拖 5 步都做不到，直接判定死局
        if (bestScore < 500) return null; 
        
        hintCell = bestCell;
        return bestCell;
    }

    function drawPieceOnCtx(c, cx, cy, isPlayer) {
        c.beginPath();
        c.arc(cx, cy, RADIUS, 0, Math.PI * 2);
        if (isPlayer) {
            c.fillStyle = '#000000';
            c.fill();
        } else {
            c.fillStyle = '#ffffff';
            c.fill();
            c.strokeStyle = '#000000';
            c.lineWidth = 2;
            c.stroke();
        }
    }

    function drawHintOnCtx(c, cx, cy) {
        c.beginPath();
        c.arc(cx, cy, RADIUS + 6, 0, Math.PI * 2);
        c.fillStyle = 'rgba(180, 180, 180, 0.4)';
        c.fill();
        
        c.beginPath();
        c.arc(cx, cy, RADIUS + 6, 0, Math.PI * 2);
        c.strokeStyle = 'rgba(100, 100, 100, 0.8)';
        c.lineWidth = 2;
        c.setLineDash([5, 5]);
        c.stroke();
        c.setLineDash([]);

        c.strokeStyle = 'rgba(80, 80, 80, 0.7)';
        c.lineWidth = 3;
        c.lineCap = 'round';
        c.beginPath();
        c.moveTo(cx - 8, cy - 8);
        c.lineTo(cx + 8, cy + 8);
        c.moveTo(cx + 8, cy - 8);
        c.lineTo(cx - 8, cy + 8);
        c.stroke();
    }

    function drawSymbol(c, baseX, baseY, type, time) {
        const angle = Math.sin(time / 80) * (Math.PI / 12); 

        c.save();
        c.translate(baseX, baseY); 
        c.rotate(angle); 

        c.fillStyle = '#000000';
        c.strokeStyle = '#000000';
        c.lineWidth = 2.5;
        c.lineCap = 'round';
        c.lineJoin = 'round';

        if (type === 'question') {
            c.beginPath();
            c.moveTo(-3, -8);
            c.bezierCurveTo(-3, -14, 4, -14, 4, -8);
            c.bezierCurveTo(4, -4, 0, -2, 0, 2);
            c.stroke();

            c.beginPath();
            c.arc(0, 7, 1.8, 0, Math.PI * 2);
            c.fill();

        } else if (type === 'exclamation') {
            c.beginPath();
            c.moveTo(0, -14);
            c.lineTo(1.5, -4);
            c.lineTo(-1.5, -4);
            c.closePath();
            c.fill();

            c.beginPath();
            c.arc(0, 2, 1.8, 0, Math.PI * 2);
            c.fill();
        }
        c.restore();
    }

    function drawEnemyOnCtx(c, cx, cy, time = performance.now()) {
        c.beginPath();
        c.arc(cx, cy, RADIUS + 2, 0, Math.PI * 2);
        c.fillStyle = '#000000';
        c.fill();

        c.fillStyle = '#ffffff';
        c.textAlign = 'center';
        c.textBaseline = 'middle';
        
        let faceText = '^_^';
        if (enemyEmotion === 'confused') faceText = '囧';
        else if (enemyEmotion === 'pitiful') faceText = '(´• ω •`)';
        else if (enemyEmotion === 'laughing') faceText = '^0^';
        else if (enemyEmotion === 'angry') faceText = '(°Д°)';

        if (faceText.length > 5) c.font = 'bold 10px Arial, sans-serif';
        else if (faceText.length > 3) c.font = 'bold 14px Arial, sans-serif';
        else c.font = 'bold 18px Arial, sans-serif';
        
        c.fillText(faceText, cx, cy + 1);

        const symbolX = cx + 18;
        const symbolY = cy - 18;

        if (enemyEmotion === 'confused') {
            drawSymbol(c, symbolX, symbolY, 'question', time);
        } else if (enemyEmotion === 'pitiful' || enemyEmotion === 'angry') {
            drawSymbol(c, symbolX, symbolY, 'exclamation', time);
        }
    }

    function drawChatBubble(c, ex, ey) {
        if (chatOpacity <= 0) return;

        c.save();
        c.globalAlpha = chatOpacity;
        
        const fontSize = 13;
        c.font = `bold ${fontSize}px sans-serif`;
        
        const textWidth = c.measureText(chatMessage).width;
        const paddingX = 12;
        const paddingY = 8;
        const bubbleWidth = textWidth + paddingX * 2;
        const bubbleHeight = fontSize + paddingY * 2;
        
        let bubbleX = ex + RADIUS + 15; 
        let bubbleY = ey - bubbleHeight / 2; 

        let isFlipped = false;
        if (bubbleX + bubbleWidth > cssWidth - 10) {
            bubbleX = ex - RADIUS - 15 - bubbleWidth;
            isFlipped = true;
        }

        if (bubbleY < 10) bubbleY = 10;
        if (bubbleY + bubbleHeight > cssHeight - 10) bubbleY = cssHeight - bubbleHeight - 10;

        const r = 8; 
        const arrowY = ey;
        const arrowTopY = bubbleY + bubbleHeight / 2 - 6;
        const arrowBottomY = bubbleY + bubbleHeight / 2 + 6;

        c.beginPath();
        
        if (!isFlipped) {
            c.moveTo(bubbleX + r, bubbleY);
            c.lineTo(bubbleX + bubbleWidth - r, bubbleY);
            c.quadraticCurveTo(bubbleX + bubbleWidth, bubbleY, bubbleX + bubbleWidth, bubbleY + r);
            c.lineTo(bubbleX + bubbleWidth, bubbleY + bubbleHeight - r);
            c.quadraticCurveTo(bubbleX + bubbleWidth, bubbleY + bubbleHeight, bubbleX + bubbleWidth - r, bubbleY + bubbleHeight);
            c.lineTo(bubbleX + r, bubbleY + bubbleHeight);
            c.quadraticCurveTo(bubbleX, bubbleY + bubbleHeight, bubbleX, bubbleY + bubbleHeight - r);
            c.lineTo(bubbleX, arrowBottomY);
            c.lineTo(ex + RADIUS + 5, arrowY);
            c.lineTo(bubbleX, arrowTopY);
            c.lineTo(bubbleX, bubbleY + r);
            c.quadraticCurveTo(bubbleX, bubbleY, bubbleX + r, bubbleY);
        } else {
            c.moveTo(bubbleX + r, bubbleY);
            c.lineTo(bubbleX + bubbleWidth, bubbleY + r); 
            c.lineTo(bubbleX + bubbleWidth, arrowTopY);
            c.lineTo(ex - RADIUS - 5, arrowY);
            c.lineTo(bubbleX + bubbleWidth, arrowBottomY);
            c.lineTo(bubbleX + bubbleWidth, bubbleY + bubbleHeight - r);
            c.quadraticCurveTo(bubbleX + bubbleWidth, bubbleY + bubbleHeight, bubbleX + bubbleWidth - r, bubbleY + bubbleHeight);
            c.lineTo(bubbleX + r, bubbleY + bubbleHeight);
            c.quadraticCurveTo(bubbleX, bubbleY + bubbleHeight, bubbleX, bubbleY + bubbleHeight - r);
            c.lineTo(bubbleX, bubbleY + r);
            c.quadraticCurveTo(bubbleX, bubbleY, bubbleX + r, bubbleY);
        }
        
        c.closePath();
        
        c.fillStyle = '#ffffff';
        c.fill();
        c.strokeStyle = '#000000';
        c.lineWidth = 2;
        c.stroke();

        c.fillStyle = '#000000';
        c.textAlign = 'center';
        c.textBaseline = 'middle';
        c.fillText(chatMessage, bubbleX + bubbleWidth / 2, bubbleY + bubbleHeight / 2);

        c.restore();
    }

    function draw() {
        if (isRestarting) return; 
        if (isCheating) return; 
        if (pendingCheat) {
            ctx.clearRect(0, 0, cssWidth, cssHeight);
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, cssWidth, cssHeight);

            for (let y = 0; y < ROWS; y++) {
                for (let x = 0; x < COLS; x++) {
                    const cx = PADDING + x * SPACING;
                    const cy = PADDING + y * SPACING;
                    if (grid[y][x] === 0) drawPieceOnCtx(ctx, cx, cy, false);
                    else if (grid[y][x] === 1) drawPieceOnCtx(ctx, cx, cy, true);
                }
            }
            const ex = PADDING + enemy.x * SPACING;
            const ey = PADDING + enemy.y * SPACING;
            drawEnemyOnCtx(ctx, ex, ey, performance.now());
            drawChatBubble(ctx, ex, ey);
            return;
        }

        ctx.clearRect(0, 0, cssWidth, cssHeight);
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, 0, cssWidth, cssHeight);

        if (hintCell && !gameOver && !animation && !isRestarting) {
            const cx = PADDING + hintCell.x * SPACING;
            const cy = PADDING + hintCell.y * SPACING;
            drawHintOnCtx(ctx, cx, cy);
        }

        for (let y = 0; y < ROWS; y++) {
            for (let x = 0; x < COLS; x++) {
                const cx = PADDING + x * SPACING;
                const cy = PADDING + y * SPACING;
                
                if (animation && x === enemy.x && y === enemy.y) {
                    drawPieceOnCtx(ctx, cx, cy, false);
                    continue;
                }
                
                if (grid[y][x] === 0) drawPieceOnCtx(ctx, cx, cy, false);
                else if (grid[y][x] === 1) drawPieceOnCtx(ctx, cx, cy, true);
                else if (grid[y][x] === 2) drawPieceOnCtx(ctx, cx, cy, false); 
            }
        }

        if (animation) {
            const now = performance.now();
            let t = (now - animation.startTime) / animation.duration;
            if (t > 1) t = 1;
            const easeT = 1 - (1 - t) * (1 - t); 
            
            const currentX = animation.fromX + (animation.toX - animation.fromX) * easeT;
            const currentY = animation.fromY + (animation.toY - animation.fromY) * easeT;

            const cx = PADDING + currentX * SPACING;
            const cy = PADDING + currentY * SPACING;
            
            drawEnemyOnCtx(ctx, cx, cy, now);
            drawChatBubble(ctx, cx, cy);

            if (t >= 1) {
                grid[animation.toY][animation.toX] = 2;
                animation = null;
                if (hintMode && !gameOver) computeHint();
                draw(); 
                if (checkEscape(enemy.x, enemy.y)) endGame(false);
            } else {
                requestAnimationFrame(draw);
            }
        } else {
            if (!isRestarting) {
                const cx = PADDING + enemy.x * SPACING;
                const cy = PADDING + enemy.y * SPACING;
                
                if (enemyEmotion !== 'smug' || chatOpacity > 0) {
                    requestAnimationFrame(draw);
                }
                drawEnemyOnCtx(ctx, cx, cy, performance.now());
                drawChatBubble(ctx, cx, cy);
            }
        }
    }

    canvas.addEventListener('mousedown', (e) => {
        if (gameOver || animation || isRestarting || isCheating || pendingCheat) return;

        const rect = canvas.getBoundingClientRect();
        const clickX = (e.clientX || e.touches[0].clientX) - rect.left;
        const clickY = (e.clientY || e.touches[0].clientY) - rect.top;

        const gridX = Math.round((clickX - PADDING) / SPACING);
        const gridY = Math.round((clickY - PADDING) / SPACING);

        if (gridX >= 0 && gridX < COLS && gridY >= 0 && gridY < ROWS) {
            const centerX = PADDING + gridX * SPACING;
            const centerY = PADDING + gridY * SPACING;
            const dist = Math.hypot(clickX - centerX, clickY - centerY);
            
            if (dist <= SPACING * 0.6) {
                if (grid[gridY][gridX] === 0) {
                    grid[gridY][gridX] = 1;
                    if (hintMode) hintCell = null;
                    
                    idleState = 0;
                    setEnemyEmotion('smug', 0);
                    showChat("溜了溜了...", 1000);
                    resetIdleTimer();
                    
                    draw();
                    
                    // 关键修复：全自动死局检测（不再依赖引导开关）
                    const bestHint = computeHint();
                    if (!bestHint) {
                        // 真的死局了，立刻弹窗！
                        pendingCheat = true;
                        cheatSubtitle.style.display = 'block';
                        setEnemyEmotion('laughing', 0);
                        showChat("哎呀，这局好像没救了...", 2000);
                        hintBtn.classList.remove('active');
                        hintMode = false;
                        hintCell = null;
                        triggerCheatRequest();
                    } else {
                        // 还能玩，让敌人动
                        setTimeout(() => {
                            if (!gameOver && !isRestarting && !isCheating && !pendingCheat) moveEnemy();
                        }, 80);
                    }
                }
            }
        }
    });

    function moveEnemy() {
        if (gameOver || animation || isRestarting || isCheating || pendingCheat) return;

        if (checkEscape(enemy.x, enemy.y)) {
            endGame(false);
            return;
        }

        const nextStep = getNextMove(enemy.x, enemy.y);

        if (nextStep) {
            const fromX = enemy.x;
            const fromY = enemy.y;
            const toX = nextStep.x;
            const toY = nextStep.y;

            grid[fromY][fromX] = 0;
            enemy.x = toX;
            enemy.y = toY;

            animation = {
                fromX, fromY, toX, toY,
                startTime: performance.now(),
                duration: MOVE_DURATION
            };
            
            requestAnimationFrame(draw);
        } else {
            endGame(true);
        }
    }

    function endGame(isWin) {
        if (gameOver) return;
        gameOver = true;
        hintCell = null;
        hintMode = false;
        hintBtn.classList.remove('active');
        if (idleTimer) clearTimeout(idleTimer);
        
        if (isWin) {
            setEnemyEmotion('pitiful', 0);
            showChat("呜呜呜，被你关起来了...", 0);
        } else {
            setEnemyEmotion('laughing', 0);
            showChat("哈哈哈！就凭你也想抓我？", 0);
        }
        draw();
    }

    initGame();
</script>

</body>
</html>