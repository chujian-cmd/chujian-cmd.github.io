/* ============================================================
   SVG 解析工具
   ============================================================ */
// 矩阵工具：[a b c d e f]，与 SVG matrix(a,b,c,d,e,f) 一致
function mulMat(m1, m2) {
  return [
    m1[0] * m2[0] + m1[2] * m2[1],
    m1[1] * m2[0] + m1[3] * m2[1],
    m1[0] * m2[2] + m1[2] * m2[3],
    m1[1] * m2[2] + m1[3] * m2[3],
    m1[0] * m2[4] + m1[2] * m2[5] + m1[4],
    m1[1] * m2[4] + m1[3] * m2[5] + m1[5]
  ];
}

function parseTransformMatrix(str) {
  if (!str) return null;
  const re = /(matrix|translate|scale|rotate)\s*\(([^)]*)\)/g;
  let m, mat = [1, 0, 0, 1, 0, 0], found = false;
  while ((m = re.exec(str)) !== null) {
    found = true;
    const name = m[1];
    const args = m[2].split(/[\s,]+/).map(parseFloat).filter(n => !isNaN(n));
    let mm;
    if (name === 'matrix') {
      if (args.length < 6) continue;
      mm = args.slice(0, 6);
    } else if (name === 'translate') {
      mm = [1, 0, 0, 1, args[0] || 0, args[1] || 0];
    } else if (name === 'scale') {
      const sx = args.length ? args[0] : 1;
      const sy = args.length > 1 ? args[1] : sx;
      mm = [sx, 0, 0, sy, 0, 0];
    } else { // rotate
      const a = (args[0] || 0) * Math.PI / 180;
      const cs = Math.cos(a), sn = Math.sin(a);
      const cx = args.length > 1 ? args[1] : 0;
      const cy = args.length > 2 ? args[2] : 0;
      mm = [cs, sn, -sn, cs, cx - cx * cs + cy * sn, cy - cx * sn - cy * cs];
    }
    mat = mulMat(mat, mm);
  }
  return found ? mat : null;
}

// 累积元素自身及祖先的 transform（到 svg 根为止）
function accumulateTransform(el, svgRoot) {
  const chain = [];
  let cur = el;
  while (cur && cur !== svgRoot) { chain.unshift(cur); cur = cur.parentNode; }
  let mat = [1, 0, 0, 1, 0, 0], found = false;
  for (const node of chain) {
    if (!node.getAttribute) continue;
    const mm = parseTransformMatrix(node.getAttribute('transform'));
    if (mm) { mat = mulMat(mat, mm); found = true; }
  }
  return found ? mat : null;
}

function applyMat(mat, p) {
  if (!mat) return p;
  return {
    x: mat[0] * p.x + mat[2] * p.y + mat[4],
    y: mat[1] * p.x + mat[3] * p.y + mat[5]
  };
}

/* 从 SVG 字符串提取子路径（已归一化：中心在原点，长边为 1） */
function svgToSubPaths(svgStr) {
  let doc;
  try {
    doc = new DOMParser().parseFromString(svgStr, 'image/svg+xml');
  } catch (e) { return null; }
  const svg = doc.querySelector('svg');
  if (!svg) return null;

  const tempSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  tempSvg.setAttribute('viewBox', '0 0 24 24');
  tempSvg.style.cssText = 'position:absolute;width:0;height:0;overflow:hidden;opacity:0;pointer-events:none;';
  document.body.appendChild(tempSvg);

  const subPaths = [];
  const SAMPLES = CONFIG.morph.svgSamples;
  const shapeEls = svg.querySelectorAll('path, circle, rect, line, polyline, polygon, ellipse');

  shapeEls.forEach(el => {
    try {
      const mat = accumulateTransform(el, svg);

      if (el.tagName === 'path') {
        const d = el.getAttribute('d') || '';
        const mRegex = /[Mm]/g;
        const indices = [];
        let m;
        while ((m = mRegex.exec(d)) !== null) indices.push(m.index);
        if (indices.length === 0) return;

        for (let k = 0; k < indices.length; k++) {
          const start = indices[k];
          const end = k + 1 < indices.length ? indices[k + 1] : d.length;
          const subD = d.slice(start, end).trim();
          if (!subD) continue;

          const pathEl = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          pathEl.setAttribute('d', subD);
          tempSvg.appendChild(pathEl);

          const len = pathEl.getTotalLength();
          if (len === 0) { tempSvg.removeChild(pathEl); continue; }

          const pts = [];
          for (let i = 0; i < SAMPLES; i++) {
            const p = pathEl.getPointAtLength((i / SAMPLES) * len);
            pts.push(applyMat(mat, { x: p.x, y: p.y }));
          }
          const closed = /[Zz]/.test(subD);
          subPaths.push({ points: pts, closed });
          tempSvg.removeChild(pathEl);
        }
      } else if (el.tagName === 'circle') {
        const cx = parseFloat(el.getAttribute('cx') || 0);
        const cy = parseFloat(el.getAttribute('cy') || 0);
        const r = parseFloat(el.getAttribute('r') || 0);
        const pts = [];
        for (let i = 0; i < SAMPLES; i++) {
          const a = (i / SAMPLES) * Math.PI * 2;
          pts.push(applyMat(mat, { x: cx + Math.cos(a) * r, y: cy + Math.sin(a) * r }));
        }
        subPaths.push({ points: pts, closed: true });
      } else if (el.tagName === 'ellipse') {
        const cx = parseFloat(el.getAttribute('cx') || 0);
        const cy = parseFloat(el.getAttribute('cy') || 0);
        const rx = parseFloat(el.getAttribute('rx') || 0);
        const ry = parseFloat(el.getAttribute('ry') || 0);
        const pts = [];
        for (let i = 0; i < SAMPLES; i++) {
          const a = (i / SAMPLES) * Math.PI * 2;
          pts.push(applyMat(mat, { x: cx + Math.cos(a) * rx, y: cy + Math.sin(a) * ry }));
        }
        subPaths.push({ points: pts, closed: true });
      } else if (el.tagName === 'rect') {
        const x = parseFloat(el.getAttribute('x') || 0);
        const y = parseFloat(el.getAttribute('y') || 0);
        const w = parseFloat(el.getAttribute('width') || 0);
        const h = parseFloat(el.getAttribute('height') || 0);
        const per = 2 * (w + h);
        if (per <= 0) return;
        const corners = [{ x, y }, { x: x + w, y }, { x: x + w, y: y + h }, { x, y: y + h }];
        const pts = [];
        for (let i = 0; i < SAMPLES; i++) {
          const d = (i / SAMPLES) * per;
          let acc = 0;
          for (let j = 0; j < 4; j++) {
            const a = corners[j], b = corners[(j + 1) % 4];
            const segLen = Math.hypot(b.x - a.x, b.y - a.y);
            if (acc + segLen >= d) {
              const t = (d - acc) / segLen;
              pts.push(applyMat(mat, { x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t }));
              break;
            }
            acc += segLen;
          }
        }
        subPaths.push({ points: pts, closed: true });
      } else if (el.tagName === 'line') {
        const x1 = parseFloat(el.getAttribute('x1') || 0);
        const y1 = parseFloat(el.getAttribute('y1') || 0);
        const x2 = parseFloat(el.getAttribute('x2') || 0);
        const y2 = parseFloat(el.getAttribute('y2') || 0);
        const pts = [];
        for (let i = 0; i < SAMPLES; i++) {
          const t = i / SAMPLES;
          pts.push(applyMat(mat, { x: x1 + (x2 - x1) * t, y: y1 + (y2 - y1) * t }));
        }
        subPaths.push({ points: pts, closed: false });
      } else if (el.tagName === 'polyline' || el.tagName === 'polygon') {
        const raw = (el.getAttribute('points') || '').trim();
        if (!raw) return;
        const nums = raw.split(/[\s,]+/).map(parseFloat).filter(n => !isNaN(n));
        const verts = [];
        for (let i = 0; i + 1 < nums.length; i += 2) verts.push({ x: nums[i], y: nums[i + 1] });
        if (verts.length < 2) return;
        const isClosed = el.tagName === 'polygon';
        const vlist = isClosed ? verts.concat([verts[0]]) : verts;
        let total = 0;
        for (let i = 1; i < vlist.length; i++) {
          total += Math.hypot(vlist[i].x - vlist[i - 1].x, vlist[i].y - vlist[i - 1].y);
        }
        if (total <= 0) return;
        const pts = [];
        for (let i = 0; i < SAMPLES; i++) {
          const d = (i / SAMPLES) * total;
          let acc = 0;
          for (let j = 1; j < vlist.length; j++) {
            const a = vlist[j - 1], b = vlist[j];
            const segLen = Math.hypot(b.x - a.x, b.y - a.y);
            if (acc + segLen >= d) {
              const t = (d - acc) / segLen;
              pts.push(applyMat(mat, { x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t }));
              break;
            }
            acc += segLen;
          }
        }
        subPaths.push({ points: pts, closed: isClosed });
      }
    } catch (e) { /* 单个元素失败不影响其他 */ }
  });

  document.body.removeChild(tempSvg);
  if (subPaths.length === 0) return null;

  // 归一化：中心平移到原点，长边缩放到 1（坐标范围约 [-0.5, 0.5]）
  let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
  for (const sp of subPaths) {
    for (const p of sp.points) {
      if (p.x < minX) minX = p.x;
      if (p.y < minY) minY = p.y;
      if (p.x > maxX) maxX = p.x;
      if (p.y > maxY) maxY = p.y;
    }
  }
  if (!isFinite(minX)) return null;

  const cx = (minX + maxX) / 2;
  const cy = (minY + maxY) / 2;
  const size = Math.max(maxX - minX, maxY - minY, 0.001);

  for (const sp of subPaths) {
    sp.points = sp.points.map(p => ({
      x: (p.x - cx) / size,
      y: (p.y - cy) / size
    }));
  }

  return subPaths;
}

/* 把子路径渲染成缩略图 SVG 字符串（用于 picker 里的图标） */
function subPathsToThumbSvg(subPaths, size) {
  size = size || 24;
  const pad = size * 0.09;
  const s = size - pad * 2;
  let d = '';
  for (const sp of subPaths) {
    if (sp.points.length < 2) continue;
    for (let i = 0; i < sp.points.length; i++) {
      const p = sp.points[i];
      const x = (pad + (p.x + 0.5) * s).toFixed(2);
      const y = (pad + (p.y + 0.5) * s).toFixed(2);
      d += (i === 0 ? 'M' : 'L') + x + ' ' + y + ' ';
    }
    if (sp.closed) d += 'Z ';
  }
  return `<svg viewBox="0 0 ${size} ${size}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="${d}"/></svg>`;
}

const STAR_TEMPLATE = [{
  points: [
    { x: 0,     y: -1.00 },
    { x: 0.32,  y: -0.40 },
    { x: 1.00,  y: -0.30 },
    { x: 0.50,  y: 0.15 },
    { x: 0.62,  y: 0.85 },
    { x: 0,     y: 0.50 },
    { x: -0.62, y: 0.85 },
    { x: -0.50, y: 0.15 },
    { x: -1.00, y: -0.30 },
    { x: -0.32, y: -0.40 }
  ],
  closed: true
}];

/* ============================================================
   画布与状态
   ============================================================ */
const canvas = document.getElementById('c');
const ctx = canvas.getContext('2d');

let W = 0, H = 0, DPR = 1;

const SAMPLE_COUNT = CONFIG.morph.sampleCount;
const MIN_DIST = CONFIG.brush.minDist;

const view = { scale: 1, offsetX: 0, offsetY: 0 };
const brush = { color: CONFIG.brush.defaultColor, width: CONFIG.brush.defaultWidth };

let currentTemplate = STAR_TEMPLATE;
let currentTemplateName = '星形';

let morphMode = 'immediate';
let history = [];
let redoStack = [];
let pendingLines = [];
let morphs = [];
let drawing = false;
let points = [];
let rafId = null;
let needsRender = false;
let hintHidden = false;

/* 自定义图形集合：{ id, name, type:'svg'|'path', data, subPaths } */
let customShapes = [];

/* 渲染模式 */
let renderMode = 'vector'; // 'vector' | 'layer'

const layerBaseCanvas  = document.createElement('canvas');
const layerBaseCtx     = layerBaseCanvas.getContext('2d');
const layerMorphCanvas = document.createElement('canvas');
const layerMorphCtx    = layerMorphCanvas.getContext('2d');
const layerDrawCanvas  = document.createElement('canvas');
const layerDrawCtx     = layerDrawCanvas.getContext('2d');

let WORLD_W = 0, WORLD_H = 0;
let layerPixelRatio = 1;
const layerOrigin = { x: 0, y: 0 };

function minScale() { return renderMode === 'layer' ? CONFIG.view.layerMinScale : CONFIG.view.vectorMinScale; }
function maxScale() { return renderMode === 'layer' ? CONFIG.view.layerMaxScale : CONFIG.view.vectorMaxScale; }

/* ============================================================
   基础工具
   ============================================================ */
function ease(t) {
  return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
}

function uid() {
  return 'c' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
}

function totalLength(pts) {
  let len = 0;
  for (let i = 1; i < pts.length; i++) len += Math.hypot(pts[i].x - pts[i-1].x, pts[i].y - pts[i-1].y);
  return len;
}

function resample(pts, n) {
  if (pts.length === 0) return [];
  if (pts.length === 1) return Array(n).fill().map(() => ({ ...pts[0] }));
  const total = totalLength(pts);
  if (total === 0) return Array(n).fill().map(() => ({ ...pts[0] }));
  const step = total / (n - 1);
  const out = [{ x: pts[0].x, y: pts[0].y }];
  let segIdx = 0, segStart = pts[0], segEnd = pts[1];
  let segLen = Math.hypot(segEnd.x - segStart.x, segEnd.y - segStart.y);
  let segDone = 0;
  for (let i = 1; i < n; i++) {
    const targetDist = i * step;
    let ok = false;
    while (segIdx < pts.length - 1) {
      if (segDone + segLen >= targetDist) {
        const t = segLen === 0 ? 0 : (targetDist - segDone) / segLen;
        out.push({
          x: segStart.x + (segEnd.x - segStart.x) * t,
          y: segStart.y + (segEnd.y - segStart.y) * t
        });
        ok = true;
        break;
      } else {
        segDone += segLen;
        segIdx++;
        if (segIdx >= pts.length - 1) break;
        segStart = pts[segIdx];
        segEnd = pts[segIdx + 1];
        segLen = Math.hypot(segEnd.x - segStart.x, segEnd.y - segStart.y);
      }
    }
    if (!ok) {
      const last = pts[pts.length - 1];
      out.push({ x: last.x, y: last.y });
    }
  }
  while (out.length < n) {
    const last = pts[pts.length - 1];
    out.push({ x: last.x, y: last.y });
  }
  return out.slice(0, n);
}

function resampleClosed(pts, n) {
  if (pts.length < 2) return [];
  const closed = pts.concat([{ ...pts[0] }]);
  const total = totalLength(closed);
  if (total === 0) return Array(n).fill().map(() => ({ ...pts[0] }));
  const step = total / (n - 1);
  const out = [{ x: pts[0].x, y: pts[0].y }];
  let segIdx = 0, segStart = closed[0], segEnd = closed[1];
  let segLen = Math.hypot(segEnd.x - segStart.x, segEnd.y - segStart.y);
  let segDone = 0;
  for (let i = 1; i < n; i++) {
    const targetDist = i * step;
    let ok = false;
    while (segIdx < closed.length - 1) {
      if (segDone + segLen >= targetDist - 1e-9) {
        const t = segLen === 0 ? 0 : (targetDist - segDone) / segLen;
        out.push({
          x: segStart.x + (segEnd.x - segStart.x) * t,
          y: segStart.y + (segEnd.y - segStart.y) * t
        });
        ok = true;
        break;
      } else {
        segDone += segLen;
        segIdx++;
        if (segIdx >= closed.length - 1) break;
        segStart = closed[segIdx];
        segEnd = closed[segIdx + 1];
        segLen = Math.hypot(segEnd.x - segStart.x, segEnd.y - segStart.y);
      }
    }
    if (!ok) {
      const last = closed[closed.length - 1];
      out.push({ x: last.x, y: last.y });
    }
  }
  out[n - 1] = { x: out[0].x, y: out[0].y };
  return out;
}

function enforceClosed(samples) {
  if (samples.length > 1) samples[samples.length - 1] = { ...samples[0] };
}

function bboxOfPoints(pts) {
  if (pts.length === 0) return { minX: 0, minY: 0, maxX: 0, maxY: 0 };
  let minX = pts[0].x, maxX = pts[0].x;
  let minY = pts[0].y, maxY = pts[0].y;
  for (let i = 1; i < pts.length; i++) {
    if (pts[i].x < minX) minX = pts[i].x;
    if (pts[i].x > maxX) maxX = pts[i].x;
    if (pts[i].y < minY) minY = pts[i].y;
    if (pts[i].y > maxY) maxY = pts[i].y;
  }
  return { minX, minY, maxX, maxY };
}

function bboxOfSubPaths(subPaths) {
  let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
  for (const sp of subPaths) {
    const b = bboxOfPoints(sp.points);
    if (b.minX < minX) minX = b.minX;
    if (b.minY < minY) minY = b.minY;
    if (b.maxX > maxX) maxX = b.maxX;
    if (b.maxY > maxY) maxY = b.maxY;
  }
  return { minX, minY, maxX, maxY };
}

function contentBBox() {
  let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
  function add(pts) {
    for (let i = 0; i < pts.length; i++) {
      const p = pts[i];
      if (p.x < minX) minX = p.x;
      if (p.y < minY) minY = p.y;
      if (p.x > maxX) maxX = p.x;
      if (p.y > maxY) maxY = p.y;
    }
  }
  for (const item of history) for (const sp of item.subPaths) add(sp.points);
  for (const item of pendingLines) add(item.points);
  for (const m of morphs) for (const sp of m.subPaths) { add(sp.start); add(sp.end); }
  if (points.length) add(points);
  if (minX === Infinity) return null;
  return { minX, minY, maxX, maxY };
}

function getVisibleWorldRect() {
  return {
    minX: -view.offsetX / view.scale,
    minY: -view.offsetY / view.scale,
    maxX: (W - view.offsetX) / view.scale,
    maxY: (H - view.offsetY) / view.scale
  };
}

function bboxIntersects(bbox, rect, margin) {
  margin = margin || 30;
  return !(bbox.maxX < rect.minX - margin || bbox.minX > rect.maxX + margin ||
           bbox.maxY < rect.minY - margin || bbox.minY > rect.maxY + margin);
}

/* ============================================================
   绘制辅助
   ============================================================ */
function strokeSubPaths(targetCtx, subPaths, color, width) {
  targetCtx.strokeStyle = color;
  targetCtx.lineWidth = width;
  targetCtx.lineCap = 'round';
  targetCtx.lineJoin = 'round';
  for (const sp of subPaths) {
    targetCtx.beginPath();
    for (let i = 0; i < sp.points.length; i++) {
      if (i === 0) targetCtx.moveTo(sp.points[i].x, sp.points[i].y);
      else targetCtx.lineTo(sp.points[i].x, sp.points[i].y);
    }
    if (sp.closed) targetCtx.closePath();
    targetCtx.stroke();
  }
}

function strokePoints(targetCtx, pts, color, width) {
  if (pts.length < 2) return;
  targetCtx.strokeStyle = color;
  targetCtx.lineWidth = width;
  targetCtx.lineCap = 'round';
  targetCtx.lineJoin = 'round';
  targetCtx.beginPath();
  targetCtx.moveTo(pts[0].x, pts[0].y);
  for (let i = 1; i < pts.length; i++) targetCtx.lineTo(pts[i].x, pts[i].y);
  targetCtx.stroke();
}

/* ============================================================
   渲染 —— 矢量模式
   ============================================================ */
function drawMorphVector(targetCtx, m) {
  const t = ease(m.progress);
  if (!bboxIntersects(m.bbox, getVisibleWorldRect(), m.width + 30)) return;

  targetCtx.strokeStyle = m.color;
  targetCtx.lineWidth = m.width;
  targetCtx.lineCap = 'round';
  targetCtx.lineJoin = 'round';

  for (const sp of m.subPaths) {
    targetCtx.beginPath();
    for (let i = 0; i < sp.start.length; i++) {
      const a = sp.start[i];
      const b = sp.end[i];
      const x = a.x + (b.x - a.x) * t;
      const y = a.y + (b.y - a.y) * t;
      if (i === 0) targetCtx.moveTo(x, y);
      else targetCtx.lineTo(x, y);
    }
    targetCtx.stroke();
  }
}

function compositeVector() {
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  ctx.clearRect(0, 0, W, H);

  ctx.save();
  ctx.translate(view.offsetX, view.offsetY);
  ctx.scale(view.scale, view.scale);

  const visible = getVisibleWorldRect();

  for (const item of history) {
    if (bboxIntersects(item.bbox, visible, item.width + 20)) {
      strokeSubPaths(ctx, item.subPaths, item.color, item.width);
    }
  }
  for (const m of morphs) drawMorphVector(ctx, m);
  for (const item of pendingLines) {
    if (bboxIntersects(item.bbox, visible, item.width + 20)) {
      strokePoints(ctx, item.points, item.color, item.width);
    }
  }
  if (points.length > 0) {
    strokePoints(ctx, points, brush.color, brush.width);
  }

  ctx.restore();
}

/* ============================================================
   渲染 —— 图层模式
   ============================================================ */
function computeLayerPixelRatio() {
  const maxPixels = CONFIG.layer.maxPixels;
  const worldPixels = Math.max(1, WORLD_W * WORLD_H);
  let d = DPR;
  if (worldPixels * d * d > maxPixels) d = Math.sqrt(maxPixels / worldPixels);
  return Math.max(0.5, d);
}

function allocateLayerCanvases() {
  const pw = Math.max(1, Math.round(WORLD_W * layerPixelRatio));
  const ph = Math.max(1, Math.round(WORLD_H * layerPixelRatio));
  layerBaseCanvas.width = pw;  layerBaseCanvas.height = ph;
  layerMorphCanvas.width = pw; layerMorphCanvas.height = ph;
  layerDrawCanvas.width = pw;  layerDrawCanvas.height = ph;
}

function applyLayerTransform(c) {
  c.setTransform(layerPixelRatio, 0, 0, layerPixelRatio, 0, 0);
  c.translate(-layerOrigin.x, -layerOrigin.y);
  c.lineCap = 'round';
  c.lineJoin = 'round';
}

function prepareLayerCtx(c) {
  c.setTransform(layerPixelRatio, 0, 0, layerPixelRatio, 0, 0);
  c.clearRect(0, 0, WORLD_W, WORLD_H);
  c.translate(-layerOrigin.x, -layerOrigin.y);
  c.lineCap = 'round';
  c.lineJoin = 'round';
}

function rebuildLayerBase() {
  prepareLayerCtx(layerBaseCtx);
  for (const item of history) {
    strokeSubPaths(layerBaseCtx, item.subPaths, item.color, item.width);
  }
}

function renderLayerMorph() {
  prepareLayerCtx(layerMorphCtx);
  if (morphs.length === 0) return;

  for (const m of morphs) {
    const t = ease(m.progress);
    layerMorphCtx.strokeStyle = m.color;
    layerMorphCtx.lineWidth = m.width;
    for (const sp of m.subPaths) {
      layerMorphCtx.beginPath();
      for (let i = 0; i < sp.start.length; i++) {
        const a = sp.start[i];
        const b = sp.end[i];
        const x = a.x + (b.x - a.x) * t;
        const y = a.y + (b.y - a.y) * t;
        if (i === 0) layerMorphCtx.moveTo(x, y);
        else layerMorphCtx.lineTo(x, y);
      }
      layerMorphCtx.stroke();
    }
  }
}

function renderLayerDraw() {
  prepareLayerCtx(layerDrawCtx);
  if (pendingLines.length === 0 && points.length === 0) return;

  for (const item of pendingLines) {
    strokePoints(layerDrawCtx, item.points, item.color, item.width);
  }
  if (points.length > 0) {
    strokePoints(layerDrawCtx, points, brush.color, brush.width);
  }
}

function compositeLayer() {
  ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
  ctx.clearRect(0, 0, W, H);

  ctx.save();
  ctx.translate(view.offsetX, view.offsetY);
  ctx.scale(view.scale, view.scale);
  ctx.drawImage(layerBaseCanvas,  layerOrigin.x, layerOrigin.y, WORLD_W, WORLD_H);
  ctx.drawImage(layerMorphCanvas, layerOrigin.x, layerOrigin.y, WORLD_W, WORLD_H);
  ctx.drawImage(layerDrawCanvas,  layerOrigin.x, layerOrigin.y, WORLD_W, WORLD_H);
  ctx.restore();
}

/* ============================================================
   统一渲染入口
   ============================================================ */
function composite() {
  if (renderMode === 'layer') {
    renderLayerMorph();
    renderLayerDraw();
    compositeLayer();
  } else {
    compositeVector();
  }
}

function clampView() {
  if (renderMode !== 'layer') return;
  const s = view.scale;
  const minOX = W - (layerOrigin.x + WORLD_W) * s;
  const maxOX = -layerOrigin.x * s;
  const minOY = H - (layerOrigin.y + WORLD_H) * s;
  const maxOY = -layerOrigin.y * s;
  view.offsetX = Math.min(maxOX, Math.max(minOX, view.offsetX));
  view.offsetY = Math.min(maxOY, Math.max(minOY, view.offsetY));
}

/* ============================================================
   渲染模式切换
   ============================================================ */
function enterLayerMode() {
  renderMode = 'layer';

  WORLD_W = W * CONFIG.layer.worldFactor;
  WORLD_H = H * CONFIG.layer.worldFactor;
  layerPixelRatio = computeLayerPixelRatio();
  allocateLayerCanvases();

  const bb = contentBBox();
  if (bb) {
    layerOrigin.x = (bb.minX + bb.maxX) / 2 - WORLD_W / 2;
    layerOrigin.y = (bb.minY + bb.maxY) / 2 - WORLD_H / 2;
  } else {
    layerOrigin.x = -WORLD_W / 2;
    layerOrigin.y = -WORLD_H / 2;
  }

  view.scale = 1;
  view.offsetX = W / 2 - (layerOrigin.x + WORLD_W / 2);
  view.offsetY = H / 2 - (layerOrigin.y + WORLD_H / 2);
  clampView();

  rebuildLayerBase();
  renderLayerMorph();
  renderLayerDraw();
  compositeLayer();
}

function exitLayerMode() {
  renderMode = 'vector';
  compositeVector();
}

function setRenderMode(mode) {
  if (mode === renderMode) return;
  if (mode === 'layer') enterLayerMode();
  else exitLayerMode();
  updateRenderModeButton();
  updateZoomLabel();
  updateToolbar();
}

const renderBtn = document.getElementById('renderBtn');

function updateRenderModeButton() {
  if (renderMode === 'vector') {
    renderBtn.innerHTML = `
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 20l4-1 10-10-3-3L5 16z"/><path d="M14 6l3 3"/>
      </svg>
      <span>矢量</span>`;
    renderBtn.title = '当前：矢量渲染（无限画布）· 点击切换为图层';
  } else {
    renderBtn.innerHTML = `
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="13" height="13" rx="2"/>
        <rect x="8" y="8" width="13" height="13" rx="2"/>
      </svg>
      <span>图层</span>`;
    renderBtn.title = '当前：图层渲染（离屏缓存）· 点击切换为矢量';
  }
}

renderBtn.addEventListener('click', () => {
  setRenderMode(renderMode === 'vector' ? 'layer' : 'vector');
});

/* ============================================================
   动画
   ============================================================ */
function animate() {
  rafId = null;
  let stillMorphing = false;

  for (let i = morphs.length - 1; i >= 0; i--) {
    const m = morphs[i];
    m.progress += CONFIG.morph.speed;
    if (m.progress >= 1) {
      m.progress = 1;
      const finalSubPaths = m.subPaths.map(sp => ({
        points: sp.end.map(p => ({ x: p.x, y: p.y })),
        closed: sp.closed
      }));
      history.push({
        subPaths: finalSubPaths,
        color: m.color,
        width: m.width,
        bbox: bboxOfSubPaths(finalSubPaths)
      });

      if (renderMode === 'layer') {
        applyLayerTransform(layerBaseCtx);
        strokeSubPaths(layerBaseCtx, finalSubPaths, m.color, m.width);
      }

      redoStack = [];
      morphs.splice(i, 1);
    } else {
      stillMorphing = true;
    }
  }

  composite();
  updateToolbar();

  if (stillMorphing) rafId = requestAnimationFrame(animate);
}

function ensureAnimating() {
  if (rafId === null && morphs.length > 0) rafId = requestAnimationFrame(animate);
}

/* ============================================================
   变形准备
   ============================================================ */
function prepareSubPath(startSamples, targetPoints, targetClosed) {
  let endSamples = targetClosed
    ? resampleClosed(targetPoints, SAMPLE_COUNT)
    : resample(targetPoints, SAMPLE_COUNT);

  const first = startSamples[0];

  let bestIdx = 0, bestDist = Infinity;
  for (let i = 0; i < endSamples.length; i++) {
    const d = Math.hypot(endSamples[i].x - first.x, endSamples[i].y - first.y);
    if (d < bestDist) { bestDist = d; bestIdx = i; }
  }
  if (bestIdx !== 0) {
    endSamples = endSamples.slice(bestIdx).concat(endSamples.slice(0, bestIdx));
    if (targetClosed) enforceClosed(endSamples);
  }

  const dForward = Math.hypot(endSamples[0].x - first.x, endSamples[0].y - first.y);
  const dReverse = Math.hypot(
    endSamples[endSamples.length - 1].x - first.x,
    endSamples[endSamples.length - 1].y - first.y
  );
  if (dReverse < dForward) {
    endSamples.reverse();
    if (targetClosed) enforceClosed(endSamples);
  }

  return endSamples;
}

function startMorph(linePoints) {
  if (linePoints.length < 2) return;
  const targets = currentTemplate;
  const N = targets.length;
  if (N === 0) return;

  let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
  for (const p of linePoints) {
    if (p.x < minX) minX = p.x;
    if (p.y < minY) minY = p.y;
    if (p.x > maxX) maxX = p.x;
    if (p.y > maxY) maxY = p.y;
  }
  const cx = (minX + maxX) / 2;
  const cy = (minY + maxY) / 2;
  const size = Math.max(maxX - minX, maxY - minY, CONFIG.morph.minSize);
  const scale = size * CONFIG.morph.shapeScale;

  const scaledTargets = targets.map(t => ({
    points: t.points.map(p => ({
      x: cx + p.x * scale,
      y: cy + p.y * scale
    })),
    closed: t.closed
  }));

  const startSamples = resample(linePoints, SAMPLE_COUNT);

  const subPaths = [];
  for (let s = 0; s < N; s++) {
    const target = scaledTargets[s];
    const endSamples = prepareSubPath(startSamples, target.points, target.closed);
    subPaths.push({
      start: startSamples,
      end: endSamples,
      closed: target.closed
    });
  }

  let bMinX = Infinity, bMinY = Infinity, bMaxX = -Infinity, bMaxY = -Infinity;
  for (const sp of subPaths) {
    for (const p of sp.start) {
      if (p.x < bMinX) bMinX = p.x;
      if (p.y < bMinY) bMinY = p.y;
      if (p.x > bMaxX) bMaxX = p.x;
      if (p.y > bMaxY) bMaxY = p.y;
    }
    for (const p of sp.end) {
      if (p.x < bMinX) bMinX = p.x;
      if (p.y < bMinY) bMinY = p.y;
      if (p.x > bMaxX) bMaxX = p.x;
      if (p.y > bMaxY) bMaxY = p.y;
    }
  }

  morphs.push({
    subPaths,
    progress: 0,
    color: brush.color,
    width: brush.width,
    bbox: { minX: bMinX, minY: bMinY, maxX: bMaxX, maxY: bMaxY }
  });
  ensureAnimating();
}

/* ============================================================
   坐标转换
   ============================================================ */
function screenToWorld(sx, sy) {
  return {
    x: (sx - view.offsetX) / view.scale,
    y: (sy - view.offsetY) / view.scale
  };
}

function getPos(e) {
  const rect = canvas.getBoundingClientRect();
  const src = e.touches ? e.touches[0] : e;
  return screenToWorld(src.clientX - rect.left, src.clientY - rect.top);
}

/* ============================================================
   绘制事件
   ============================================================ */
function scheduleRender() {
  if (needsRender) return;
  needsRender = true;
  requestAnimationFrame(() => {
    needsRender = false;
    composite();
  });
}

function hideHint() {
  if (!CONFIG.ui.hideHintOnFirstDraw || hintHidden) return;
  hintHidden = true;
  const el = document.getElementById('hint');
  if (el) el.style.opacity = '0';
}

function down(e) {
  e.preventDefault();
  drawing = true;
  points = [getPos(e)];
  hideHint();
  composite();
}

function move(e) {
  if (!drawing) return;
  e.preventDefault();
  const p = getPos(e);
  const last = points[points.length - 1];
  if (Math.hypot(p.x - last.x, p.y - last.y) < MIN_DIST) return;
  points.push(p);
  scheduleRender();
}

function commitPoints() {
  if (points.length >= 2) {
    if (morphMode === 'immediate') {
      startMorph(points);
      redoStack = [];
    } else {
      pendingLines.push({
        points: [...points],
        color: brush.color,
        width: brush.width,
        bbox: bboxOfPoints(points)
      });
      redoStack = [];
    }
    points = [];
    composite();
    updateToolbar();
  } else {
    points = [];
    composite();
  }
}

function up(e) {
  if (!drawing) return;
  e.preventDefault();
  drawing = false;
  commitPoints();
}

function leave(e) {
  if (!drawing) return;
  drawing = false;
  commitPoints();
}

/* ============================================================
   鼠标事件
   ============================================================ */
let mousePanning = false;
let panStart = null;

canvas.addEventListener('mousedown', (e) => {
  if (e.button === 1 || (e.button === 0 && e.shiftKey) || e.button === 2) {
    e.preventDefault();
    mousePanning = true;
    panStart = {
      screenX: e.clientX,
      screenY: e.clientY,
      offsetX: view.offsetX,
      offsetY: view.offsetY
    };
    document.body.classList.add('panning');
    return;
  }
  if (e.button === 0) down(e);
});

window.addEventListener('mousemove', (e) => {
  if (mousePanning && panStart) {
    view.offsetX = panStart.offsetX + (e.clientX - panStart.screenX);
    view.offsetY = panStart.offsetY + (e.clientY - panStart.screenY);
    clampView();
    composite();
    return;
  }
  if (drawing) move(e);
});

window.addEventListener('mouseup', (e) => {
  if (mousePanning) {
    mousePanning = false;
    panStart = null;
    document.body.classList.remove('panning');
    return;
  }
  if (drawing) up(e);
});

canvas.addEventListener('mouseleave', (e) => {
  if (drawing) leave(e);
});

canvas.addEventListener('contextmenu', (e) => e.preventDefault());

/* ============================================================
   触摸事件
   ============================================================ */
let touchMode = null;
let pinchState = null;

function touchDist(t1, t2) {
  return Math.hypot(t1.clientX - t2.clientX, t1.clientY - t2.clientY);
}
function touchCenterScreen(t1, t2, rect) {
  return {
    x: (t1.clientX + t2.clientX) / 2 - rect.left,
    y: (t1.clientY + t2.clientY) / 2 - rect.top
  };
}

canvas.addEventListener('touchstart', (e) => {
  const rect = canvas.getBoundingClientRect();

  if (e.touches.length === 1 && touchMode === null) {
    touchMode = 'draw';
    down(e);
    return;
  }

  if (e.touches.length === 2) {
    e.preventDefault();
    if (drawing) {
      drawing = false;
      points = [];
      composite();
    }
    touchMode = 'pan';
    const t1 = e.touches[0], t2 = e.touches[1];
    const dist = touchDist(t1, t2);
    const center = touchCenterScreen(t1, t2, rect);
    pinchState = {
      startDist: dist,
      startScale: view.scale,
      startOffsetX: view.offsetX,
      startOffsetY: view.offsetY,
      centerX: center.x,
      centerY: center.y
    };
    const w = screenToWorld(center.x, center.y);
    pinchState.worldCenterX = w.x;
    pinchState.worldCenterY = w.y;
    return;
  }
}, { passive: false });

canvas.addEventListener('touchmove', (e) => {
  if (touchMode === 'pan' && e.touches.length === 2 && pinchState) {
    e.preventDefault();
    const rect = canvas.getBoundingClientRect();
    const t1 = e.touches[0], t2 = e.touches[1];
    const dist = touchDist(t1, t2);
    const center = touchCenterScreen(t1, t2, rect);

    let newScale = pinchState.startScale * (dist / pinchState.startDist);
    newScale = Math.min(maxScale(), Math.max(minScale(), newScale));

    view.scale = newScale;
    view.offsetX = center.x - pinchState.worldCenterX * newScale;
    view.offsetY = center.y - pinchState.worldCenterY * newScale;
    clampView();

    composite();
    updateZoomLabel();
    return;
  }
  if (touchMode === 'draw' && e.touches.length === 1) {
    move(e);
  }
}, { passive: false });

canvas.addEventListener('touchend', (e) => {
  if (touchMode === 'pan') {
    if (e.touches.length < 2) {
      touchMode = e.touches.length === 1 ? 'draw' : null;
      pinchState = null;
      if (touchMode === 'draw') touchMode = null;
    }
    return;
  }
  if (touchMode === 'draw') {
    up(e);
    touchMode = null;
  }
}, { passive: false });

canvas.addEventListener('touchcancel', (e) => {
  touchMode = null;
  pinchState = null;
  if (drawing) {
    drawing = false;
    points = [];
    composite();
  }
}, { passive: false });

/* ============================================================
   缩放
   ============================================================ */
function zoomAt(sx, sy, factor) {
  const newScale = Math.min(maxScale(), Math.max(minScale(), view.scale * factor));
  if (Math.abs(newScale - view.scale) < 0.0001) return;

  const wx = (sx - view.offsetX) / view.scale;
  const wy = (sy - view.offsetY) / view.scale;

  view.scale = newScale;
  view.offsetX = sx - wx * view.scale;
  view.offsetY = sy - wy * view.scale;
  clampView();

  composite();
  updateZoomLabel();
}

function zoomCenter(factor) {
  zoomAt(W / 2, H / 2, factor);
}

function resetView() {
  view.scale = 1;
  if (renderMode === 'layer') {
    view.offsetX = W / 2 - (layerOrigin.x + WORLD_W / 2);
    view.offsetY = H / 2 - (layerOrigin.y + WORLD_H / 2);
  } else {
    view.offsetX = W / 2;
    view.offsetY = H / 2;
  }
  clampView();
  composite();
  updateZoomLabel();
}

canvas.addEventListener('wheel', (e) => {
  e.preventDefault();
  const rect = canvas.getBoundingClientRect();
  const sx = e.clientX - rect.left;
  const sy = e.clientY - rect.top;
  const factor = e.deltaY < 0 ? CONFIG.view.zoomStep : 1 / CONFIG.view.zoomStep;
  zoomAt(sx, sy, factor);
}, { passive: false });

function updateZoomLabel() {
  document.getElementById('zoomLabel').textContent = Math.round(view.scale * 100) + '%';
}

/* ============================================================
   工具栏
   ============================================================ */
const clearBtn = document.getElementById('clearBtn');
const undoBtn = document.getElementById('undoBtn');
const redoBtn = document.getElementById('redoBtn');
const modeBtn = document.getElementById('modeBtn');
const morphBtn = document.getElementById('morphBtn');

function updateToolbar() {
  undoBtn.disabled = history.length === 0 && pendingLines.length === 0;
  redoBtn.disabled = redoStack.length === 0;
  if (morphMode === 'batch' && pendingLines.length > 0) {
    morphBtn.style.display = 'flex';
  } else {
    morphBtn.style.display = 'none';
  }
}

function updateModeButton() {
  if (morphMode === 'immediate') {
    modeBtn.innerHTML = `
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L4 14h6l-1 8 9-12h-6z"/></svg>
      <span>立即</span>`;
    modeBtn.title = '当前：画完立即变形 · 点击切换为批量';
  } else {
    modeBtn.innerHTML = `
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3l8 4.5-8 4.5-8-4.5z"/>
        <path d="M4 12l8 4.5 8-4.5"/>
        <path d="M4 16.5l8 4.5 8-4.5"/>
      </svg>
      <span>批量</span>`;
    modeBtn.title = '当前：画完累积 · 点击切换为立即';
  }
}

clearBtn.addEventListener('click', () => {
  history = [];
  redoStack = [];
  pendingLines = [];
  morphs = [];
  points = [];
  drawing = false;
  if (rafId) cancelAnimationFrame(rafId);
  rafId = null;

  if (renderMode === 'layer') {
    prepareLayerCtx(layerBaseCtx);
    prepareLayerCtx(layerMorphCtx);
    prepareLayerCtx(layerDrawCtx);
  }

  composite();
  updateToolbar();
});

undoBtn.addEventListener('click', () => {
  if (pendingLines.length > 0) {
    pendingLines.pop();
    composite();
    updateToolbar();
    return;
  }
  if (history.length > 0) {
    redoStack.push(history.pop());
    if (renderMode === 'layer') rebuildLayerBase();
    composite();
    updateToolbar();
  }
});

redoBtn.addEventListener('click', () => {
  if (redoStack.length === 0) return;
  history.push(redoStack.pop());
  if (renderMode === 'layer') rebuildLayerBase();
  composite();
  updateToolbar();
});

function flushPendingLines() {
  if (pendingLines.length === 0) return;
  for (const item of pendingLines) {
    const savedColor = brush.color;
    const savedWidth = brush.width;
    brush.color = item.color;
    brush.width = item.width;
    startMorph(item.points);
    brush.color = savedColor;
    brush.width = savedWidth;
  }
  pendingLines = [];
  composite();
  redoStack = [];
  updateToolbar();
}

modeBtn.addEventListener('click', () => {
  if (morphMode === 'immediate') {
    morphMode = 'batch';
  } else {
    flushPendingLines();
    morphMode = 'immediate';
  }
  updateModeButton();
  updateToolbar();
});

morphBtn.addEventListener('click', flushPendingLines);

/* ============================================================
   画笔控件
   ============================================================ */
const colorInput = document.getElementById('colorInput');
const sizeInput = document.getElementById('sizeInput');
const sizeLabel = document.getElementById('sizeLabel');

colorInput.value = CONFIG.brush.defaultColor;
sizeInput.min = CONFIG.brush.minWidth;
sizeInput.max = CONFIG.brush.maxWidth;
sizeInput.value = CONFIG.brush.defaultWidth;
sizeLabel.textContent = CONFIG.brush.defaultWidth;

colorInput.addEventListener('input', (e) => { brush.color = e.target.value; });
sizeInput.addEventListener('input', (e) => {
  brush.width = parseFloat(e.target.value);
  sizeLabel.textContent = brush.width;
});

/* ============================================================
   缩放控件
   ============================================================ */
document.getElementById('zoomInBtn').addEventListener('click', () => zoomCenter(CONFIG.view.buttonZoomStep));
document.getElementById('zoomOutBtn').addEventListener('click', () => zoomCenter(1 / CONFIG.view.buttonZoomStep));
document.getElementById('zoomLabel').addEventListener('click', resetView);

/* ============================================================
   自定义图形 —— 存储
   ============================================================ */
function loadCustomShapes() {
  customShapes = [];
  let raw;
  try { raw = localStorage.getItem(CONFIG.custom.storageKey); } catch (e) { return; }
  if (!raw) return;

  let arr;
  try { arr = JSON.parse(raw); } catch (e) { return; }
  if (!Array.isArray(arr)) return;

  for (const item of arr) {
    if (!item || typeof item.name !== 'string') continue;
    let subPaths = null;
    if (item.type === 'svg' && typeof item.data === 'string') {
      subPaths = svgToSubPaths(item.data);
    } else if (item.type === 'path' && Array.isArray(item.data)) {
      try {
        subPaths = item.data.map(sp => ({
          points: (sp.points || []).map(p => ({ x: +p.x, y: +p.y })),
          closed: !!sp.closed
        })).filter(sp => sp.points.length >= 2);
        if (subPaths.length === 0) subPaths = null;
      } catch (e) { subPaths = null; }
    }
    if (!subPaths) continue;
    customShapes.push({
      id: item.id || uid(),
      name: item.name,
      type: item.type,
      data: item.data,
      subPaths
    });
  }
}

function persistCustomShapes() {
  try {
    const arr = customShapes.map(s => ({
      id: s.id, name: s.name, type: s.type, data: s.data
    }));
    localStorage.setItem(CONFIG.custom.storageKey, JSON.stringify(arr));
    return true;
  } catch (e) {
    console.warn('保存自定义图形失败：', e);
    return false;
  }
}

function uniqueName(base) {
  const used = new Set(customShapes.map(s => s.name));
  used.add('星形');
  if (!used.has(base)) return base;
  let i = 2;
  while (used.has(base + CONFIG.ui.nameConflictSuffix + i)) i++;
  return base + CONFIG.ui.nameConflictSuffix + i;
}

function removeCustomShape(id) {
  const idx = customShapes.findIndex(s => s.id === id);
  if (idx < 0) return;
  const removed = customShapes.splice(idx, 1)[0];
  persistCustomShapes();

  // 如果正在使用被删除的图形，回退到星形
  if (currentTemplateName === removed.name) {
    currentTemplate = STAR_TEMPLATE;
    currentTemplateName = '星形';
    pickerLabel.textContent = '星形';
  }
  buildPicker();
}

/* ============================================================
   自定义图形 —— 弹窗
   ============================================================ */
const customModal = document.getElementById('customModal');
const modalTabs = Array.from(customModal.querySelectorAll('.modal-tab'));
const tabUpload = document.getElementById('tabUpload');
const tabDraw = document.getElementById('tabDraw');
const dropZone = document.getElementById('dropZone');
const svgFileInput = document.getElementById('svgFileInput');
const uploadPreview = document.getElementById('uploadPreview');
const padCanvas = document.getElementById('padCanvas');
const padCtx = padCanvas.getContext('2d');
const padClearBtn = document.getElementById('padClearBtn');
const customNameInput = document.getElementById('customNameInput');
const modalError = document.getElementById('modalError');
const modalCancel = document.getElementById('modalCancel');
const modalSave = document.getElementById('modalSave');

const modalState = {
  tab: 'upload',
  svgText: null,
  svgSubPaths: null,
  strokes: []   // [{ points:[{x,y}], closed:false }]
};

function showModalError(msg) { modalError.textContent = msg || ''; }

function switchTab(tab) {
  modalState.tab = tab;
  modalTabs.forEach(btn => btn.classList.toggle('active', btn.dataset.tab === tab));
  tabUpload.classList.toggle('active', tab === 'upload');
  tabDraw.classList.toggle('active', tab === 'draw');
  showModalError('');
  if (tab === 'draw') {
    requestAnimationFrame(syncPadCanvasSize);
  }
}

function openCustomModal() {
  closePicker();
  modalState.tab = 'upload';
  modalState.svgText = null;
  modalState.svgSubPaths = null;
  modalState.strokes = [];
  customNameInput.value = '';
  uploadPreview.classList.remove('show');
  uploadPreview.innerHTML = '';
  svgFileInput.value = '';
  showModalError('');
  switchTab('upload');
  customModal.classList.add('open');
  setTimeout(() => customNameInput.focus(), 60);
}

function closeCustomModal() {
  customModal.classList.remove('open');
}

modalTabs.forEach(btn => btn.addEventListener('click', () => switchTab(btn.dataset.tab)));
modalCancel.addEventListener('click', closeCustomModal);
customModal.addEventListener('click', (e) => { if (e.target === customModal) closeCustomModal(); });
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && customModal.classList.contains('open')) closeCustomModal();
});

/* ---------- 上传 SVG ---------- */
dropZone.addEventListener('click', () => svgFileInput.click());

svgFileInput.addEventListener('change', (e) => {
  const f = e.target.files && e.target.files[0];
  if (f) handleSvgFile(f);
});

['dragenter', 'dragover'].forEach(evt => {
  dropZone.addEventListener(evt, (e) => {
    e.preventDefault();
    e.stopPropagation();
    dropZone.classList.add('dragover');
  });
});
['dragleave', 'drop'].forEach(evt => {
  dropZone.addEventListener(evt, (e) => {
    e.preventDefault();
    e.stopPropagation();
    dropZone.classList.remove('dragover');
  });
});
dropZone.addEventListener('drop', (e) => {
  const f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
  if (f) handleSvgFile(f);
});

function handleSvgFile(file) {
  showModalError('');
  if (file.size > CONFIG.custom.maxSvgBytes) {
    showModalError(`文件太大，最大 ${Math.round(CONFIG.custom.maxSvgBytes / 1024)} KB`);
    return;
  }
  if (!/\.svg$/i.test(file.name) && file.type !== 'image/svg+xml') {
    showModalError('请选择 .svg 格式的文件');
    return;
  }

  const reader = new FileReader();
  reader.onload = () => {
    const text = String(reader.result || '');
    const subPaths = svgToSubPaths(text);
    if (!subPaths || subPaths.length === 0) {
      showModalError('无法从该文件中解析出图形，请确认 SVG 包含 path / circle / rect 等元素');
      return;
    }
    modalState.svgText = text;
    modalState.svgSubPaths = subPaths;

    // 预览
    uploadPreview.innerHTML = subPathsToThumbSvg(subPaths, 64);
    uploadPreview.classList.add('show');

    // 自动填名称
    if (!customNameInput.value.trim()) {
      const base = file.name.replace(/\.svg$/i, '').slice(0, CONFIG.custom.maxNameLength).trim();
      customNameInput.value = base || '自定义图形';
    }
  };
  reader.onerror = () => showModalError('读取文件失败');
  reader.readAsText(file);
}

/* ---------- 手绘板 ---------- */
let padDrawing = false;
let padCurrent = null;

function syncPadCanvasSize() {
  const dpr = CONFIG.custom.padPixelRatio;
  const cssW = padCanvas.clientWidth || 260;
  const cssH = padCanvas.clientHeight || cssW;
  const w = Math.max(1, Math.round(cssW * dpr));
  const h = Math.max(1, Math.round(cssH * dpr));
  if (padCanvas.width !== w || padCanvas.height !== h) {
    padCanvas.width = w;
    padCanvas.height = h;
  }
  drawPadRender();
}

function padPos(e) {
  const r = padCanvas.getBoundingClientRect();
  return { x: e.clientX - r.left, y: e.clientY - r.top };
}

function drawPadRender() {
  const dpr = CONFIG.custom.padPixelRatio;
  const w = padCanvas.width / dpr;
  const h = padCanvas.height / dpr;
  padCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
  padCtx.clearRect(0, 0, w, h);

  padCtx.lineCap = 'round';
  padCtx.lineJoin = 'round';
  padCtx.strokeStyle = '#171717';
  padCtx.fillStyle = '#171717';
  padCtx.lineWidth = 2;

  for (const s of modalState.strokes) {
    if (s.points.length === 0) continue;
    if (s.points.length === 1) {
      padCtx.beginPath();
      padCtx.arc(s.points[0].x, s.points[0].y, 1.4, 0, Math.PI * 2);
      padCtx.fill();
      continue;
    }
    padCtx.beginPath();
    padCtx.moveTo(s.points[0].x, s.points[0].y);
    for (let i = 1; i < s.points.length; i++) padCtx.lineTo(s.points[i].x, s.points[i].y);
    padCtx.stroke();
  }
}

padCanvas.addEventListener('pointerdown', (e) => {
  if (e.button !== undefined && e.button !== 0 && e.pointerType === 'mouse') return;
  e.preventDefault();
  try { padCanvas.setPointerCapture(e.pointerId); } catch (err) {}
  padDrawing = true;
  padCurrent = { points: [padPos(e)], closed: false };
  modalState.strokes.push(padCurrent);
  drawPadRender();
});

padCanvas.addEventListener('pointermove', (e) => {
  if (!padDrawing || !padCurrent) return;
  e.preventDefault();
  const p = padPos(e);
  const last = padCurrent.points[padCurrent.points.length - 1];
  if (Math.hypot(p.x - last.x, p.y - last.y) < CONFIG.custom.padPointMinDist) return;
  padCurrent.points.push(p);
  drawPadRender();
});

function padEnd(e) {
  if (!padDrawing) return;
  padDrawing = false;
  padCurrent = null;
  drawPadRender();
}

padCanvas.addEventListener('pointerup', padEnd);
padCanvas.addEventListener('pointercancel', padEnd);
padCanvas.addEventListener('pointerleave', padEnd);

padClearBtn.addEventListener('click', () => {
  modalState.strokes = [];
  padCurrent = null;
  padDrawing = false;
  drawPadRender();
});

/* 把手绘笔画转成归一化子路径 */
function buildShapeFromPad() {
  const strokes = modalState.strokes.filter(s => s.points.length >= CONFIG.custom.minStrokePoints);
  if (strokes.length === 0) return null;

  let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
  for (const s of strokes) {
    for (const p of s.points) {
      if (p.x < minX) minX = p.x;
      if (p.y < minY) minY = p.y;
      if (p.x > maxX) maxX = p.x;
      if (p.y > maxY) maxY = p.y;
    }
  }
  if (!isFinite(minX)) return null;

  const cx = (minX + maxX) / 2;
  const cy = (minY + maxY) / 2;
  const size = Math.max(maxX - minX, maxY - minY, 1);

  const subPaths = [];
  for (const s of strokes) {
    let pts = s.points.map(p => ({ x: (p.x - cx) / size, y: (p.y - cy) / size }));

    // 首尾接近 → 自动闭合
    let closed = false;
    const len = totalLength(pts);
    if (len > 0 && pts.length > 2) {
      const gap = Math.hypot(pts[0].x - pts[pts.length - 1].x, pts[0].y - pts[pts.length - 1].y);
      if (gap / len < CONFIG.custom.autoCloseRatio) closed = true;
    }

    pts = closed ? resampleClosed(pts, SAMPLE_COUNT) : resample(pts, SAMPLE_COUNT);
    if (pts.length >= 2) subPaths.push({ points: pts, closed });
  }
  return subPaths.length ? subPaths : null;
}

/* ---------- 保存 ---------- */
modalSave.addEventListener('click', () => {
  showModalError('');
  const nameRaw = (customNameInput.value || '').trim();
  if (!nameRaw) { showModalError('请先给图形起一个名字'); return; }
  if (nameRaw.length > CONFIG.custom.maxNameLength) {
    showModalError(`名称最多 ${CONFIG.custom.maxNameLength} 个字符`);
    return;
  }
  if (customShapes.length >= CONFIG.custom.maxCount) {
    showModalError(`最多保存 ${CONFIG.custom.maxCount} 个自定义图形，请先删除一些`);
    return;
  }

  let subPaths = null, type = null, data = null;

  if (modalState.tab === 'upload') {
    if (!modalState.svgSubPaths) { showModalError('请先上传一个 SVG 文件'); return; }
    subPaths = modalState.svgSubPaths;
    type = 'svg';
    data = modalState.svgText;
  } else {
    subPaths = buildShapeFromPad();
    if (!subPaths) { showModalError('请先在画板上绘制图形轮廓'); return; }
    const dec = CONFIG.custom.coordDecimals;
    const k = Math.pow(10, dec);
    type = 'path';
    data = subPaths.map(sp => ({
      points: sp.points.map(p => ({ x: Math.round(p.x * k) / k, y: Math.round(p.y * k) / k })),
      closed: sp.closed
    }));
  }

  const finalName = uniqueName(nameRaw);
  const shape = { id: uid(), name: finalName, type, data, subPaths };
  customShapes.push(shape);

  const ok = persistCustomShapes();
  if (!ok) {
    // 存储失败也不阻止本次使用
    showModalError('已添加，但保存到本地失败（可能是存储空间不足）');
  }

  buildPicker();

  if (CONFIG.custom.autoUseNew) {
    currentTemplate = shape.subPaths;
    currentTemplateName = shape.name;
    pickerLabel.textContent = shape.name;
    updateActiveCell();
  }

  if (ok) {
    closeCustomModal();
  } else {
    setTimeout(closeCustomModal, 1200);
  }
});

/* ============================================================
   图形选择器
   ============================================================ */
const pickerBtn = document.getElementById('pickerBtn');
const pickerPanel = document.getElementById('pickerPanel');
const pickerLabel = document.getElementById('pickerLabel');

function makeCustomCell(shape) {
  const cell = document.createElement('div');
  cell.className = 'icon-cell custom-cell';
  cell.dataset.customId = shape.id;
  cell.title = shape.name;
  cell.innerHTML = subPathsToThumbSvg(shape.subPaths, 24);

  const del = document.createElement('button');
  del.type = 'button';
  del.className = 'del-btn';
  del.textContent = '×';
  del.title = '删除';
  del.addEventListener('click', (e) => {
    e.stopPropagation();
    e.preventDefault();
    if (confirm(`删除自定义图形「${shape.name}」？`)) removeCustomShape(shape.id);
  });
  cell.appendChild(del);

  cell.addEventListener('click', () => {
    currentTemplate = shape.subPaths;
    currentTemplateName = shape.name;
    pickerLabel.textContent = shape.name;
    updateActiveCell();
    closePicker();
  });

  return cell;
}

function buildPicker() {
  pickerPanel.innerHTML = '';

  /* ---- 自定义图形（置顶） ---- */
  const custHead = document.createElement('div');
  custHead.className = 'cat-label cat-label-row';

  const custTitle = document.createElement('span');
  custTitle.textContent = '自定义';

  const addBtn = document.createElement('button');
  addBtn.type = 'button';
  addBtn.className = 'add-custom-btn';
  addBtn.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>新建`;

  addBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    openCustomModal();
  });

  custHead.appendChild(custTitle);
  custHead.appendChild(addBtn);
  pickerPanel.appendChild(custHead);

  if (customShapes.length === 0) {
    const empty = document.createElement('div');
    empty.className = 'custom-empty';
    empty.textContent = '还没有自定义图形，点击「新建」上传 SVG 或手绘一个';
    pickerPanel.appendChild(empty);
  } else {
    const grid = document.createElement('div');
    grid.className = 'icon-grid';
    for (const shape of customShapes) grid.appendChild(makeCustomCell(shape));
    pickerPanel.appendChild(grid);
  }

  /* ---- 默认 ---- */
  const starLabel = document.createElement('div');
  starLabel.className = 'cat-label';
  starLabel.textContent = '默认';
  pickerPanel.appendChild(starLabel);

  const starGrid = document.createElement('div');
  starGrid.className = 'icon-grid';
  const starCell = document.createElement('div');
  starCell.className = 'icon-cell';
  starCell.innerHTML = L('<path d="M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7z"/>');
  starCell.title = '星形';
  starCell.addEventListener('click', () => {
    currentTemplate = STAR_TEMPLATE;
    currentTemplateName = '星形';
    pickerLabel.textContent = '星形';
    updateActiveCell();
    closePicker();
  });
  starGrid.appendChild(starCell);
  pickerPanel.appendChild(starGrid);

  /* ---- 内置分类 ---- */
  for (const [cat, svgs] of Object.entries(SVG_DATA)) {
    const label = document.createElement('div');
    label.className = 'cat-label';
    label.textContent = cat;
    pickerPanel.appendChild(label);

    const grid = document.createElement('div');
    grid.className = 'icon-grid';

    svgs.forEach((svgStr, idx) => {
      const cell = document.createElement('div');
      cell.className = 'icon-cell';
      cell.innerHTML = svgStr;
      cell.dataset.cat = cat;
      cell.dataset.idx = idx;
      cell.title = `${cat} #${idx + 1}`;
      cell.addEventListener('click', () => {
        const subPaths = svgToSubPaths(svgStr);
        if (!subPaths || subPaths.length === 0) return;
        currentTemplate = subPaths;
        currentTemplateName = `${cat} #${idx + 1}`;
        pickerLabel.textContent = currentTemplateName;
        updateActiveCell();
        closePicker();
      });
      grid.appendChild(cell);
    });

    pickerPanel.appendChild(grid);
  }

  updateActiveCell();
}

function updateActiveCell() {
  pickerPanel.querySelectorAll('.icon-cell').forEach(cell => {
    const cat = cell.dataset.cat;
    const idx = cell.dataset.idx;
    const cid = cell.dataset.customId;

    if (cid) {
      const shape = customShapes.find(s => s.id === cid);
      cell.classList.toggle('active', !!shape && currentTemplateName === shape.name);
    } else if (cat === undefined) {
      cell.classList.toggle('active', currentTemplateName === '星形');
    } else {
      cell.classList.toggle('active', currentTemplateName === `${cat} #${parseInt(idx) + 1}`);
    }
  });
}

function openPicker() { pickerPanel.classList.add('open'); pickerBtn.classList.add('open'); }
function closePicker() { pickerPanel.classList.remove('open'); pickerBtn.classList.remove('open'); }

pickerBtn.addEventListener('click', (e) => {
  e.stopPropagation();
  if (pickerPanel.classList.contains('open')) closePicker();
  else openPicker();
});

document.addEventListener('click', (e) => {
  if (!pickerPanel.contains(e.target) && e.target !== pickerBtn && !pickerBtn.contains(e.target)) {
    closePicker();
  }
});

/* ============================================================
   尺寸
   ============================================================ */
function handleLayerResize() {
  const centerX = layerOrigin.x + WORLD_W / 2;
  const centerY = layerOrigin.y + WORLD_H / 2;

  WORLD_W = W * CONFIG.layer.worldFactor;
  WORLD_H = H * CONFIG.layer.worldFactor;
  layerPixelRatio = computeLayerPixelRatio();
  allocateLayerCanvases();

  layerOrigin.x = centerX - WORLD_W / 2;
  layerOrigin.y = centerY - WORLD_H / 2;

  view.offsetX = W / 2 - centerX * view.scale;
  view.offsetY = H / 2 - centerY * view.scale;
  clampView();

  rebuildLayerBase();
  renderLayerMorph();
  renderLayerDraw();
}

function resizeCanvas() {
  const oldW = W, oldH = H;
  W = window.innerWidth;
  H = window.innerHeight;
  DPR = Math.min(window.devicePixelRatio || 1, 2);

  canvas.width = W * DPR;
  canvas.height = H * DPR;
  canvas.style.width = W + 'px';
  canvas.style.height = H + 'px';

  if (renderMode === 'layer') {
    if (oldW === 0) {
      WORLD_W = W * CONFIG.layer.worldFactor;
      WORLD_H = H * CONFIG.layer.worldFactor;
      layerPixelRatio = computeLayerPixelRatio();
      allocateLayerCanvases();
      layerOrigin.x = -WORLD_W / 2;
      layerOrigin.y = -WORLD_H / 2;
      view.scale = 1;
      view.offsetX = W / 2 - (layerOrigin.x + WORLD_W / 2);
      view.offsetY = H / 2 - (layerOrigin.y + WORLD_H / 2);
    } else {
      handleLayerResize();
    }
  } else {
    if (oldW === 0) {
      view.scale = 1;
      view.offsetX = W / 2;
      view.offsetY = H / 2;
    } else {
      view.offsetX += (W - oldW) / 2;
      view.offsetY += (H - oldH) / 2;
    }
  }

  clampView();
  composite();
  updateZoomLabel();

  if (customModal.classList.contains('open')) syncPadCanvasSize();
}

/* ============================================================
   初始化
   ============================================================ */
loadCustomShapes();
buildPicker();
updateModeButton();
updateRenderModeButton();
updateToolbar();
resizeCanvas();

window.addEventListener('resize', resizeCanvas);

window.addEventListener('blur', () => {
  if (drawing) {
    drawing = false;
    commitPoints();
  }
});
</script>

</body>
</html>