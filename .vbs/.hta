<html>
<head>
<title>五角星</title>
<HTA:APPLICATION
  APPLICATIONNAME="Star"
  BORDER="none"
  CAPTION="no"
  SHOWINTASKBAR="no"
  SYSMENU="no"
  SCROLL="no"
/>
<style>
  body { background-color: #111; margin: 0; overflow: hidden; }
  .star { color: gold; font-size: 30px; position: absolute; font-family: "Segoe UI Symbol", Arial; }
</style>
</head>
<body>
<script language="VBScript">
  Dim cx, cy, r1, r2, i, angle, x, y, s
  cx = 400 : cy = 300
  r1 = 200 ' 外圈半径
  r2 = 80  ' 内圈半径

  ' 画五角星的10个点
  For i = 0 To 9
    angle = i * 36 - 90 ' 每个点相差36度
    If i Mod 2 = 0 Then
      r = r1 ' 偶数点用外圈
    Else
      r = r2 ' 奇数点用内圈
    End If
    x = cx + r * Cos(angle * 3.14159 / 180)
    y = cy + r * Sin(angle * 3.14159 / 180)
    AddStar x, y
  Next

  ' 中间再画个星星
  AddStar cx, cy

  Sub AddStar(px, py)
    Dim div
    Set div = document.createElement("div")
    div.ClassName = "star"
    div.InnerText = "★"
    div.Style.Left = px - 15 & "px"
    div.Style.Top = py - 15 & "px"
    document.body.appendChild div
  End Sub
  
  ' 5秒后自动关闭
  window.setTimeout "window.close", 5000
</script>
</body>
</html>