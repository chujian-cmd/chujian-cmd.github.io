<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>太阳 → 月亮 变形</title>
<style>
  html,body{height:100%;margin:0;display:grid;place-items:center;background:#fff}
  canvas{display:block}
</style>
</head>
<body>
<canvas id="c" width="400" height="400"></canvas>
<script>
const ctx = document.getElementById('c').getContext('2d');
const W = 400, H = 400, CX = 200, CY = 200, R = 120;
const N = 120;
const SPEED = 0.005;

const ease = t => t < 0.5 ? 4*t*t*t : 1 - Math.pow(-2*t+2, 3)/2;

function totalLength(pts){
  let len = 0;
  for (let i = 1; i < pts.length; i++) len += Math.hypot(pts[i].x-pts[i-1].x, pts[i].y-pts[i-1].y);
  return len;
}

function resample(pts, n){
  if (pts.length === 0) return [];
  if (pts.length === 1) return Array.from({length:n}, () => ({...pts[0]}));
  const total = totalLength(pts);
  if (total === 0) return Array.from({length:n}, () => ({...pts[0]}));
  const step = total/(n-1);
  const out = [{x:pts[0].x, y:pts[0].y}];
  let segIdx = 0, segStart = pts[0], segEnd = pts[1];
  let segLen = Math.hypot(segEnd.x-segStart.x, segEnd.y-segStart.y);
  let segDone = 0;
  for (let i = 1; i < n; i++){
    const target = i*step;
    let ok = false;
    while (segIdx < pts.length-1){
      if (segDone+segLen >= target-1e-9){
        const t = segLen===0 ? 0 : (target-segDone)/segLen;
        out.push({x:segStart.x+(segEnd.x-segStart.x)*t, y:segStart.y+(segEnd.y-segStart.y)*t});
        ok = true; break;
      }
      segDone += segLen; segIdx++;
      if (segIdx >= pts.length-1) break;
      segStart = pts[segIdx]; segEnd = pts[segIdx+1];
      segLen = Math.hypot(segEnd.x-segStart.x, segEnd.y-segStart.y);
    }
    if (!ok){ const last = pts[pts.length-1]; out.push({x:last.x, y:last.y}); }
  }
  while (out.length < n){ const last = pts[pts.length-1]; out.push({x:last.x, y:last.y}); }
  return out.slice(0, n);
}

function resampleClosed(pts, n){
  if (pts.length < 2) return [];
  const closed = pts.concat([{...pts[0]}]);
  const out = resample(closed, n);
  out[n-1] = {x:out[0].x, y:out[0].y};
  return out;
}

function mulMat(m1, m2){
  return [
    m1[0]*m2[0]+m1[2]*m2[1], m1[1]*m2[0]+m1[3]*m2[1],
    m1[0]*m2[2]+m1[2]*m2[3], m1[1]*m2[2]+m1[3]*m2[3],
    m1[0]*m2[4]+m1[2]*m2[5]+m1[4], m1[1]*m2[4]+m1[3]*m2[5]+m1[5]
  ];
}

function parseTransformMatrix(str){
  if (!str) return null;
  const re = /(matrix|translate|scale|rotate)\s*\(([^)]*)\)/g;
  let m, mat = [1,0,0,1,0,0], found = false;
  while ((m = re.exec(str)) !== null){
    found = true;
    const name = m[1];
    const args = m[2].split(/[\s,]+/).map(parseFloat).filter(n => !isNaN(n));
    let mm;
    if (name === 'matrix'){
      if (args.length < 6) continue;
      mm = args.slice(0, 6);
    } else if (name === 'translate'){
      mm = [1,0,0,1, args[0]||0, args[1]||0];
    } else if (name === 'scale'){
      const sx = args.length ? args[0] : 1;
      const sy = args.length > 1 ? args[1] : sx;
      mm = [sx,0,0,sy,0,0];
    } else {
      const a = (args[0]||0)*Math.PI/180;
      const cs = Math.cos(a), sn = Math.sin(a);
      const cx = args.length > 1 ? args[1] : 0;
      const cy = args.length > 2 ? args[2] : 0;
      mm = [cs,sn,-sn,cs, cx-cx*cs+cy*sn, cy-cx*sn-cy*cs];
    }
    mat = mulMat(mat, mm);
  }
  return found ? mat : null;
}

function accumulateTransform(el, svgRoot){
  const chain = [];
  let cur = el;
  while (cur && cur !== svgRoot){ chain.unshift(cur); cur = cur.parentNode; }
  let mat = [1,0,0,1,0,0], found = false;
  for (const node of chain){
    if (!node.getAttribute) continue;
    const mm = parseTransformMatrix(node.getAttribute('transform'));
    if (mm){ mat = mulMat(mat, mm); found = true; }
  }
  return found ? mat : null;
}

function applyMat(mat, p){
  if (!mat) return p;
  return { x: mat[0]*p.x + mat[2]*p.y + mat[4], y: mat[1]*p.x + mat[3]*p.y + mat[5] };
}

function svgToSubPaths(svgStr, samples){
  samples = samples || N;
  let doc;
  try { doc = new DOMParser().parseFromString(svgStr, 'image/svg+xml'); }
  catch(e){ return null; }
  const svg = doc.querySelector('svg');
  if (!svg) return null;

  const tempSvg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  tempSvg.setAttribute('viewBox', '0 0 24 24');
  tempSvg.style.cssText = 'position:absolute;width:0;height:0;overflow:hidden;opacity:0;pointer-events:none;';
  document.body.appendChild(tempSvg);

  const subPaths = [];
  const shapeEls = svg.querySelectorAll('path, circle, rect, line, polyline, polygon, ellipse');

  shapeEls.forEach(el => {
    try {
      const mat = accumulateTransform(el, svg);

      if (el.tagName === 'path'){
        const d = el.getAttribute('d') || '';
        const indices = [];
        const mRegex = /[Mm]/g;
        let m;
        while ((m = mRegex.exec(d)) !== null) indices.push(m.index);
        if (indices.length === 0) return;

        for (let k = 0; k < indices.length; k++){
          const start = indices[k];
          const end = k+1 < indices.length ? indices[k+1] : d.length;
          const subD = d.slice(start, end).trim();
          if (!subD) continue;

          const pathEl = document.createElementNS('http://www.w3.org/2000/svg', 'path');
          pathEl.setAttribute('d', subD);
          tempSvg.appendChild(pathEl);

          const len = pathEl.getTotalLength();
          if (len === 0){ tempSvg.removeChild(pathEl); continue; }

          const pts = [];
          for (let i = 0; i < samples; i++){
            const p = pathEl.getPointAtLength((i/samples)*len);
            pts.push(applyMat(mat, {x:p.x, y:p.y}));
          }
          const closed = /[Zz]/.test(subD);
          subPaths.push({points: pts, closed});
          tempSvg.removeChild(pathEl);
        }
      } else if (el.tagName === 'circle'){
        const cx = parseFloat(el.getAttribute('cx')||0);
        const cy = parseFloat(el.getAttribute('cy')||0);
        const r  = parseFloat(el.getAttribute('r')||0);
        const pts = [];
        for (let i = 0; i < samples; i++){
          const a = (i/samples)*Math.PI*2;
          pts.push(applyMat(mat, {x:cx+Math.cos(a)*r, y:cy+Math.sin(a)*r}));
        }
        subPaths.push({points: pts, closed: true});
      } else if (el.tagName === 'ellipse'){
        const cx = parseFloat(el.getAttribute('cx')||0);
        const cy = parseFloat(el.getAttribute('cy')||0);
        const rx = parseFloat(el.getAttribute('rx')||0);
        const ry = parseFloat(el.getAttribute('ry')||0);
        const pts = [];
        for (let i = 0; i < samples; i++){
          const a = (i/samples)*Math.PI*2;
          pts.push(applyMat(mat, {x:cx+Math.cos(a)*rx, y:cy+Math.sin(a)*ry}));
        }
        subPaths.push({points: pts, closed: true});
      } else if (el.tagName === 'rect'){
        const x = parseFloat(el.getAttribute('x')||0);
        const y = parseFloat(el.getAttribute('y')||0);
        const w = parseFloat(el.getAttribute('width')||0);
        const h = parseFloat(el.getAttribute('height')||0);
        const per = 2*(w+h);
        if (per <= 0) return;
        const corners = [{x,y},{x:x+w,y},{x:x+w,y:y+h},{x,y:y+h}];
        const pts = [];
        for (let i = 0; i < samples; i++){
          const d = (i/samples)*per;
          let acc = 0;
          for (let j = 0; j < 4; j++){
            const a = corners[j], b = corners[(j+1)%4];
            const segLen = Math.hypot(b.x-a.x, b.y-a.y);
            if (acc+segLen >= d){
              const t = (d-acc)/segLen;
              pts.push(applyMat(mat, {x:a.x+(b.x-a.x)*t, y:a.y+(b.y-a.y)*t}));
              break;
            }
            acc += segLen;
          }
        }
        subPaths.push({points: pts, closed: true});
      } else if (el.tagName === 'line'){
        const x1 = parseFloat(el.getAttribute('x1')||0);
        const y1 = parseFloat(el.getAttribute('y1')||0);
        const x2 = parseFloat(el.getAttribute('