<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no, viewport-fit=cover" />
<title>龙茶牛逼 · 至尊版</title>
<style>
:root{
  --bg:#02030a; --fg:#0ff; --green:#0f0; --red:#ff3333;
  --accent:#4444ff; --accent2:#333366; --panel:rgba(10,12,40,.97);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-user-select:none;user-select:none;-webkit-touch-callout:none;}
html,body{width:100vw;height:100vh;overflow:hidden;background:var(--bg);color:#fff;
  font-family:Consolas,"Courier New",monospace;touch-action:none;}

/* ===== CRT 叠加层 ===== */
.crt{position:fixed;inset:0;z-index:2;pointer-events:none;}
.crt::before{content:"";position:absolute;inset:0;
  background:repeating-linear-gradient(0deg,rgba(0,255,255,.04) 0 1px,transparent 1px 3px);
  animation:scan 8s linear infinite;}
.crt::after{content:"";position:absolute;inset:0;
  background:radial-gradient(ellipse at center,transparent 55%,rgba(0,0,0,.55) 100%);
  mix-blend-mode:multiply;}
@keyframes scan{from{transform:translateY(0)}to{transform:translateY(3px)}}
@keyframes flicker{0%,100%{opacity:1}97%{opacity:.96}98%{opacity:.9}99%{opacity:.98}}
body{animation:flicker 6s infinite;}

/* ===== 终端背景 ===== */
.terminal-bg{position:fixed;inset:0;z-index:1;pointer-events:none;overflow:hidden;
  padding:10px;font-size:14px;}
.cmd-line{color:var(--green);margin:14px 6px 8px;min-height:1.2em;}
.term-line{color:var(--fg);margin:5px 6px;min-height:1.2em;white-space:pre-wrap;
  word-break:break-all;text-shadow:0 0 6px rgba(0,255,255,.35);}
.cursor{display:inline-block;width:8px;height:14px;background:var(--fg);
  vertical-align:-2px;animation:blink .8s steps(1) infinite;}
@keyframes blink{50%{opacity:0}}

/* ===== 下落层 ===== */
#fallLayer{position:fixed;inset:0;z-index:99998;pointer-events:none;overflow:hidden;}
.fall-txt{position:absolute;top:-40px;color:var(--red);font-size:13px;font-weight:700;
  white-space:nowrap;text-shadow:0 0 8px rgba(255,0,0,.6);will-change:transform;}
.fall-img{position:absolute;top:-60px;width:44px;height:44px;object-fit:cover;
  border-radius:5px;border:1px solid rgba(255,255,255,.7);will-change:transform;}

/* ===== 窗口 ===== */
.window{position:absolute;width:min(86%,440px);background:var(--panel);
  border:1px solid var(--accent);border-radius:12px;overflow:hidden;z-index:10;
  box-shadow:0 0 24px rgba(68,68,255,.35),inset 0 0 40px rgba(68,68,255,.06);
  visibility:hidden;opacity:0;transition:opacity .4s ease;will-change:transform;}
.window.show{visibility:visible;opacity:1;}
.win-header{display:flex;align-items:center;justify-content:space-between;
  background:linear-gradient(180deg,#3a3a7a,#2a2a55);padding:7px 10px;
  cursor:grab;touch-action:none;}
.win-header:active{cursor:grabbing;}
.win-title{font-size:12px;letter-spacing:.5px;color:#dfe3ff;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.win-dots{display:flex;gap:6px;}
.win-dot{width:10px;height:10px;border-radius:50%;cursor:pointer;}
.win-dot.min{background:#ffbd2e;} .win-dot.close{background:#ff5f57;}
.win-body{padding:8px;max-height:260px;overflow-y:auto;cursor:grab;touch-action:none;}
.win-body::-webkit-scrollbar{width:6px;}
.win-body::-webkit-scrollbar-thumb{background:#4444aa;border-radius:3px;}

.status-bar{display:flex;align-items:center;gap:6px;margin-bottom:6px;font-size:10px;}
.status-tag{padding:2px 7px;border-radius:4px;font-size:9px;font-weight:700;}
.status-tag.green{background:#00aa00;}
.status-tag.blue{background:#0088ff;}
.status-tag.pulse{animation:tagpulse 1.6s infinite;}
@keyframes tagpulse{50%{box-shadow:0 0 10px currentColor;}}

.btn{width:100%;padding:7px;margin:4px 0;background:#4444aa;color:#fff;border:none;
  border-radius:6px;font-size:11px;cursor:pointer;transition:background .15s,transform .1s;
  letter-spacing:.5px;}
.btn:hover{background:#5555cc;} .btn:active{transform:scale(.98);}
.btn.warn{background:#8a2a2a;} .btn.warn:hover{background:#a83333;}
.btn.ghost{background:transparent;border:1px solid var(--accent);}

.card-wrap{margin-top:8px;border-radius:8px;overflow:hidden;border:1px solid rgba(68,68,255,.4);}
.card-img{width:100%;display:block;pointer-events:none;-webkit-user-drag:none;}

/* 日志 */
.log-line{font-size:11.5px;line-height:1.35;white-space:pre-wrap;word-break:break-all;
  animation:logIn .18s ease-out;}
@keyframes logIn{from{opacity:0;transform:translateY(3px)}to{opacity:1;transform:none}}
.log-line.normal{color:#bbb;} .log-line.error{color:var(--red);}
.log-line.success{color:#00e600;} .log-line.countdown{color:#ffdd00;}
.log-line.prepare{color:#88ddff;}

/* 进度条 */
.pbar-wrap{margin:8px 0 4px;font-size:10px;color:#9aa;}
.pbar{height:10px;background:#111a33;border:1px solid var(--accent);border-radius:5px;
  overflow:hidden;}
.pbar-fill{height:100%;width:0;background:linear-gradient(90deg,#2266ff,#44e0ff);
  transition:width .25s linear;}
.pbar.stuck .pbar-fill{background:linear-gradient(90deg,#ff8800,#ff3333);
  animation:stuck .5s infinite alternate;}
@keyframes stuck{to{opacity:.55}}

/* 悬浮球 */
.circle-float{position:fixed;right:20px;bottom:130px;width:64px;height:64px;border-radius:50%;
  background:radial-gradient(circle at 32% 28%,#6a6aff,#2a2a66);border:1px solid #8888ff;
  display:none;align-items:center;justify-content:center;z-index:20;cursor:grab;
  touch-action:none;font-size:11px;text-align:center;line-height:1.2;
  box-shadow:0 0 18px rgba(68,68,255,.6);}
.circle-float:active{cursor:grabbing;}
.expand-box{position:absolute;right:74px;top:0;background:var(--accent2);padding:8px 10px;
  border-radius:8px;font-size:10px;white-space:nowrap;display:none;border:1px solid #6666cc;}
.circle-float:hover .expand-box{display:block;}

/* 拍照预览 */
.shot-preview{position:fixed;inset:0;background:rgba(0,0,0,.96);z-index:999999;
  display:none;flex-direction:column;align-items:center;justify-content:center;gap:14px;padding:20px;}
.shot-preview img{max-width:72vw;max-height:62vh;border:2px solid var(--accent);
  border-radius:10px;box-shadow:0 0 30px rgba(68,68,255,.5);}
.shot-preview .tip{font-size:12px;color:#88ddff;text-align:center;line-height:1.6;}

/* 全屏黑 */
html.black-fullscreen,body.black-fullscreen{background:#000!important;}
html.black-fullscreen *,body.black-fullscreen *{display:none!important;visibility:hidden!important;}

/* 移动端 */
@media(max-width:480px){
  .terminal-bg{font-size:12px;}
  .window{width:90%;}
  .btn{padding:6px;font-size:10px;}
}
</style>
</head>
<body>

<!-- CRT 效果层 -->
<div class="crt"></div>

<!-- 假终端背景 -->
<div class="terminal-bg" id="terminalBg"></div>

<!-- 下落层 -->
<div id="fallLayer"></div>

<!-- 主窗口 -->
<div class="window" id="mainWindow" style="top:46px;left:5%">
  <div class="win-header" data-drag>
    <span class="win-title">官方频道 @YGWMK</span>
    <div class="win-dots">
      <span class="win-dot min" data-min="mainWindow" title="最小化"></span>
      <span class="win-dot close" data-close="mainWindow" title="关闭"></span>
    </div>
  </div>
  <div class="win-body" data-drag>
    <div class="status-bar">
      <span class="status-tag green pulse" id="tagStatus">龙茶nb</span>
    </div>
    <div class="status-bar">
      <span class="status-tag blue">发送状态</span>
      <span style="color:#ff0;font-size:10px" id="sendState">发送中…</span>
    </div>
    <button class="btn" id="btnReset">初始化程序</button>
    <button class="btn ghost" id="btnCam">授权拍摄（仅本地特效）</button>
    <button class="btn warn" id="btnExit">安全退出</button>
    <div class="card-wrap">
      <img class="card-img" id="cardImg"
        src="https://pan.szfx.top/view.php/ea1939c0d9eebbba546ab38eb782ec9a.jpg"
        alt="工具图" />
    </div>
  </div>
</div>

<!-- 日志窗口 -->
<div class="window" id="logWindow" style="top:352px;left:5%">
  <div class="win-header" data-drag>
    <span class="win-title">日志输出</span>
    <div class="win-dots">
      <span class="win-dot min" data-min="logWindow" title="最小化"></span>
      <span class="win-dot close" data-close="logWindow" title="关闭"></span>
    </div>
  </div>
  <div class="win-body" id="logContent" data-drag>
    <div class="pbar-wrap">
      <div style="display:flex;justify-content:space-between">
        <span>格机进度</span><span id="pbarPct">0%</span>
      </div>
      <div class="pbar" id="pbar"><div class="pbar-fill" id="pbarFill"></div></div>
    </div>
  </div>
</div>

<!-- 悬浮上传球 -->
<div class="circle-float" id="circleBtn">
  <span>上传</span>
  <div class="expand-box">
    <span>上传状态：</span><span id="stateText" style="color:#ffdd00">上传中</span>
  </div>
</div>

<!-- 拍照预览 -->
<div class="shot-preview" id="shotPreview">
  <img id="previewImg" alt="预览" />
  <div class="tip" id="previewTip">前置摄像头已采集（仅用于本地下落特效，不会上传）</div>
</div>

<!-- 隐藏摄像头 -->
<div style="position:fixed;width:1px;height:1px;overflow:hidden;opacity:0;pointer-events:none">
  <video id="cameraVideo" autoplay playsinline muted></video>
  <canvas id="shotCanvas" width="320" height="320"></canvas>
</div>

<audio id="bgMusic" loop preload="auto"
  src="https://mp3tourl.com/audio/1787476902073-5f1c2ac6-dcf2-4d7f-903f-4b210e159f6f.mp3"></audio>

<script>
/* 第二部分脚本放这里 */
</script>
</body>
</html>