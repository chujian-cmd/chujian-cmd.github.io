<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LED 跑马灯艺术柜</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body {
            display: flex; justify-content: center; align-items: center;
            min-height: 100vh; background-color: #121212;
            font-family: 'Brush Script MT', cursive, sans-serif;
            overflow: hidden;
        }

        /* 整体柜子框架 */
        .cabinet {
            position: relative;
            width: 420px; height: 650px;
            background: #080808;
            border-left: 15px solid #151515;
            border-top: 15px solid #151515;
            border-bottom: 25px solid #222;
            border-right: 45px solid #c8b59a; /* 右侧木纹挡板 */
            box-shadow: 0 20px 60px rgba(0,0,0,0.9);
            overflow: hidden;
        }

        /* 顶部霓虹灯文字 */
        .text { position: absolute; font-weight: bold; text-shadow: 0 0 5px currentColor, 0 0 15px currentColor; z-index: 10; }
        .t-people { color: #0088ff; top: 50px; left: 15px; transform: rotate(-8deg); font-size: 1.5rem; }
        .t-art { color: #ffffff; top: 85px; left: 80px; transform: rotate(-5deg); font-size: 2.2rem; text-shadow: 0 0 5px #fff, 0 0 15px #88bbff; }
        .t-ktv { color: #d4ff00; top: 10px; left: 180px; transform: rotate(5deg); font-size: 2.5rem; font-family: Impact, sans-serif; letter-spacing: 2px;}
        .t-nature { color: #00ffaa; top: 70px; right: -10px; transform: rotate(5deg); font-size: 1.8rem; }

        /* ================= 核心：左下方 LED 面板 ================= */
        .led-box {
            position: absolute; bottom: 0; left: 0;
            width: 230px; height: 280px;
            background-color: #0a0a0a;
            border-top: 5px solid #1a1a1a;
            border-right: 5px solid #1a1a1a;
            overflow: hidden;
            z-index: 1;
        }

        /* 1. 面板的物理打孔纹理 (覆盖在最上面，形成遮挡感) */
        .led-box::after {
            content: '';
            position: absolute; inset: 0;
            /* 用径向渐变画出黑色小圆孔，模拟面板表面 */
            background-image: radial-gradient(circle, #000 2px, transparent 2.5px);
            background-size: 8px 8px;
            background-position: 2px 2px;
            z-index: 3;
            pointer-events: none;
        }

        /* 2. 隐藏的 LED 水柱 (放在孔洞下方) */
        .led-water {
            position: absolute;
            bottom: -20px; left: -20px; right: 0; top: 0;
            z-index: 2;
        }

        /* SVG 描绘抛物线 */
        .water-path {
            fill: none;
            stroke-width: 12; /* 宽一点，保证能透过孔洞 */
            stroke-linecap: round;
            /* 核心：虚线效果，长短不一，模拟 LED 灯珠 */
            stroke-dasharray: 2 10; 
            /* 强烈的橙黄发光 */
            stroke: #ffcc00;
            filter: drop-shadow(0 0 8px #ffaa00) drop-shadow(0 0 15px #ff6600);
            /* 跑马灯动画 */
            animation: flow-led 1.5s linear infinite;
        }

        /* 跑马灯流动动画 */
        @keyframes flow-led {
            0% { stroke-dashoffset: 24; }
            100% { stroke-dashoffset: 0; }
        }

        /* 水流底部的散落 LED 颗粒 */
        .led-splash {
            fill: #ffcc00;
            filter: drop-shadow(0 0 6px #ffaa00);
            animation: pulse 0.8s infinite alternate;
        }
        .led-splash:nth-child(2) { animation-delay: 0.3s; }
        .led-splash:nth-child(3) { animation-delay: 0.6s; }

        @keyframes pulse {
            0% { opacity: 0.3; }
            100% { opacity: 1; }
        }

        /* ================= 金色小人 ================= */
        .stickman-svg {
            position: absolute; bottom: 0; right: 15px;
            width: 160px; height: 420px;
            filter: drop-shadow(0 0 4px #d4af37) drop-shadow(0 0 10px #d4af37);
            z-index: 4; /* 在小面板之上 */
        }

    </style>
</head>
<body>

    <div class="cabinet">
        <!-- 霓虹灯文字 -->
        <div class="text t-people">People</div>
        <div class="text t-art">Art</div>
        <div class="text t-ktv">KTV</div>
        <div class="text t-nature">Nature</div>

        <!-- 左下角 LED 打孔面板 -->
        <div class="led-box">
            <!-- 藏在面板后面的动态水柱 -->
            <svg class="led-water" viewBox="0 0 230 280" preserveAspectRatio="none">
                <!-- 抛物线路径 (起点在小人位置，落向左下角) -->
                <path class="water-path" d="M 240,90 Q 120,50 30,260" />
                
                <!-- 底部散落的灯珠 -->
                <circle class="led-splash" cx="30" cy="260" r="3" />
                <circle class="led-splash" cx="18" cy="270" r="2" />
                <circle class="led-splash" cx="42" cy="268" r="2.5" />
            </svg>
        </div>

        <!-- 金色小人 (SVG 绘制，姿态微调) -->
        <svg class="stickman-svg" viewBox="0 0 100 250">
            <g stroke="#d4af37" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <!-- 头 -->
                <circle cx="45" cy="30" r="20" />
                <!-- 躯干 -->
                <path d="M 40,50 Q 35,90 45,120 Q 50,140 45,170" />
                <!-- 手臂(呈现扶着瞄准的姿态) -->
                <path d="M 38,70 Q 15,90 35,110" />
                <path d="M 45,120 Q 25,120 20,100" />
                <!-- 腿 -->
                <path d="M 45,170 Q 60,200 65,230" />
                <path d="M 45,170 Q 25,190 20,230" />
            </g>
        </svg>
    </div>

</body>
</html>