<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>霓虹艺术柜子（动态抛物线版）</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        
        body {
            display: flex; justify-content: center; align-items: center;
            min-height: 100vh; background-color: #121212;
            font-family: 'Brush Script MT', cursive, sans-serif;
            overflow: hidden;
        }

        /* 整体柜子框架 */
        .cabinet {
            position: relative;
            width: 400px; height: 600px;
            background: #080808;
            border-left: 15px solid #151515;
            border-top: 15px solid #151515;
            border-bottom: 25px solid #222;
            border-right: 45px solid #c8b59a; /* 右侧木纹挡板 */
            box-shadow: 0 20px 60px rgba(0,0,0,0.9), inset 0 0 50px rgba(0,0,0,0.5);
            overflow: hidden;
        }

        /* 顶部霓虹灯环境光 */
        .glow-blue {
            position: absolute; top: -100px; left: -50px; width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(0, 119, 255, 0.25) 0%, transparent 60%);
            pointer-events: none;
        }
        .glow-green {
            position: absolute; top: -100px; right: -100px; width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(0, 255, 100, 0.2) 0%, transparent 60%);
            pointer-events: none;
        }

        /* 顶部文字 */
        .text { position: absolute; font-weight: bold; text-shadow: 0 0 5px currentColor, 0 0 15px currentColor; z-index: 10; }
        .t-people { color: #0088ff; top: 50px; left: 15px; transform: rotate(-8deg); font-size: 1.5rem; }
        .t-art { color: #ffffff; top: 85px; left: 80px; transform: rotate(-5deg); font-size: 2.2rem; text-shadow: 0 0 5px #fff, 0 0 15px #88bbff; }
        .t-ktv { color: #d4ff00; top: 10px; left: 180px; transform: rotate(5deg); font-size: 2.5rem; font-family: Impact, sans-serif; letter-spacing: 2px;}
        .t-nature { color: #00ffaa; top: 70px; right: -10px; transform: rotate(5deg); font-size: 1.8rem; }

        /* 左下方的 LED 面板 */
        .led-box {
            position: absolute; bottom: 0; left: 0;
            width: 220px; height: 280px;
            background-color: #0d0d0d;
            background-image: radial-gradient(circle, #222 1.5px, transparent 1.5px);
            background-size: 7px 7px;
            border-top: 5px solid #1a1a1a;
            border-right: 5px solid #1a1a1a;
            z-index: 1;
        }

        /* 金色线条小人 (使用 SVG 精准绘制) */
        .stickman-svg {
            position: absolute; bottom: 0; right: 10px;
            width: 160px; height: 420px;
            filter: drop-shadow(0 0 4px #d4af37) drop-shadow(0 0 10px #d4af37); /* 金色发光 */
            z-index: 3;
        }

        /* 动态抛物线容器 */
        .pee-stream {
            position: absolute; bottom: 0; left: 0;
            width: 100%; height: 100%;
            z-index: 2;
            pointer-events: none;
        }

        /* 使用 SVG 动画让线条流动起来 */
        .pee-line {
            fill: none;
            stroke: #ffcc00;
            stroke-width: 4;
            stroke-linecap: round;
            stroke-dasharray: 8 12; /* 虚线效果，形成一节一节的水滴 */
            filter: drop-shadow(0 0 5px #ffaa00) drop-shadow(0 0 10px #ff8800); /* 强烈的霓虹橘黄光 */
            animation: flow 1s linear infinite; /* 动画让虚线跑起来 */
        }

        /* 抛物线末端的“飞溅”效果 */
        .pee-splash {
            fill: #ffcc00;
            filter: drop-shadow(0 0 5px #ffaa00);
            animation: pulse 0.6s ease-in-out infinite alternate;
        }

        /* 流动动画 */
        @keyframes flow {
            0% { stroke-dashoffset: 20; }
            100% { stroke-dashoffset: 0; }
        }

        /* 闪烁动画 */
        @keyframes pulse {
            0% { opacity: 0.6; transform: scale(0.9); }
            100% { opacity: 1; transform: scale(1.1); }
        }

    </style>
</head>
<body>

    <div class="cabinet">
        <!-- 顶部光晕 -->
        <div class="glow-blue"></div>
        <div class="glow-green"></div>

        <!-- 霓虹灯文字 -->
        <div class="text t-people">People</div>
        <div class="text t-art">Art</div>
        <div class="text t-ktv">KTV</div>
        <div class="text t-nature">Nature</div>

        <!-- 左下角打孔面板 -->
        <div class="led-box"></div>

        <!-- 动态抛物线 (水流) -->
        <svg class="pee-stream" viewBox="0 0 400 600" preserveAspectRatio="none">
            <!-- 抛物线路径 -->
            <path class="pee-line" d="M 235,380 Q 150,320 80,550" />
            <!-- 底部飞溅的光点 -->
            <circle class="pee-splash" cx="80" cy="550" r="4" />
            <circle class="pee-splash" cx="70" cy="560" r="2" style="animation-delay: 0.2s" />
            <circle class="pee-splash" cx="90" cy="558" r="3" style="animation-delay: 0.4s" />
        </svg>

        <!-- 金色小人 (SVG 绘制) -->
        <svg class="stickman-svg" viewBox="0 0 100 250">
            <g stroke="#d4af37" stroke-width="5" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <!-- 头 (圆) -->
                <circle cx="45" cy="30" r="20" />
                <!-- 躯干 (微弯曲) -->
                <path d="M 40,50 Q 35,90 45,120 Q 50,140 45,170" />
                <!-- 手臂 (叉腰/扶着) -->
                <path d="M 38,70 Q 15,90 40,115" />
                <path d="M 45,120 Q 20,110 15,90" /> <!-- 另一只手臂 -->
                <!-- 双腿 (前后错开) -->
                <path d="M 45,170 Q 60,200 65,230" />
                <path d="M 45,170 Q 25,190 20,230" />
            </g>
        </svg>
    </div>

</body>
</html>