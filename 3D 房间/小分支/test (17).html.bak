<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>3D 房间 - 真·高清彩蛋版</title>
<style>
  html, body {
    margin: 0; padding: 0; width: 100%; height: 100%;
    background: #000; overflow: hidden;
    touch-action: none;
    -webkit-user-select: none; user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  #app { position: relative; width: 100%; height: 100%; background: #000; }
  canvas { display: block; width: 100%; height: 100%; touch-action: none; }
</style>
</head>
<body>
<div id="app">
  <canvas id="scene"></canvas>
</div>

<script>
var canvas = document.getElementById('scene');
var ctx = canvas.getContext('2d');

var camera = { pos: [0, 1.6, 4.5], yaw: 0, pitch: -0.08, fov: Math.PI / 3 };
var hx = 4, hz = 5, top = 3.2;

// ===== 3D 几何数据 (用多边形面片构建) =====
var faces = [];

// 房间的 5 个内表面（墙和地）
// 法线和颜色（高清版直接用黑白灰铺底，带一点光影）
// 后墙
faces.push({ pts: [[-hx, 0, -hz], [hx, 0, -hz], [hx, top, -hz], [-hx, top, -hz]], color: [40, 40, 40] });
// 前墙
faces.push({ pts: [[-hx, 0, hz], [hx, 0, hz], [hx, top, hz], [-hx, top, hz]], color: [30, 30, 30] });
// 左墙
faces.push({ pts: [[-hx, 0, -hz], [-hx, 0, hz], [-hx, top, hz], [-hx, top, -hz]], color: [50, 50, 50] });
// 右墙
faces.push({ pts: [[hx, 0, -hz], [hx, 0, hz], [hx, top, hz], [hx, top, -hz]], color: [45, 45, 45] });
// 地面
faces.push({ pts: [[-hx, 0, -hz], [hx, 0, -hz], [hx, 0, hz], [-hx, 0, hz]], color: [20, 20, 20] });

// 辅助函数：生成一个长方体（桌椅用）
function addBox(cx, cy, cz, sx, sy, sz, color) {
  var min = [cx - sx/2, cy - sy/2, cz - sz/2];
  var max = [cx + sx/2, cy + sy/2, cz + sz/2];
  var p = [
    [min[0], min[1], min[2]], [max[0], min[1], min[2]], [max[0], max[1], min[2]], [min[0], max[1], min[2]], // 后
    [min[0], min[1], max[2]], [max[0], min[1], max[2]], [max[0], max[1], max[2]], [min[0], max[1], max[2]]  // 前
  ];
  // 6个面
  faces.push({ pts: [p[0], p[1], p[2], p[3]], color: color }); // 后
  faces.push({ pts: [p[5], p[4], p[7], p[6]], color: color }); // 前
  faces.push({ pts: [p[4], p[0], p[3], p[7]], color: color }); // 左
  faces.push({ pts: [p[1], p[5], p[6], p[2]], color: color }); // 右
  faces.push({ pts: [p[3], p[2], p[6], p[7]], color: color }); // 上
  faces.push({ pts: [p[4], p[5], p[1], p[0]], color: color }); // 下
}

// 桌子 (深灰色)
addBox(0, 0.39, 0, 1.8, 0.78, 1.1, [80, 80, 80]);
// 4把椅子 (浅灰)
addBox(0, 0.225, -1.15, 0.48, 0.45, 0.48, [120, 120, 120]);
addBox(0, 0.225,  1.15, 0.48, 0.45, 0.48, [120, 120, 120]);
addBox(-1.35, 0.225, 0, 0.48, 0.45, 0.48, [120, 120, 120]);
addBox( 1.35, 0.225, 0, 0.48, 0.45, 0.48, [120, 120, 120]);

// 椅子靠背
addBox(0, 0.7, -1.43, 0.48, 0.5, 0.08, [120, 120, 120]);
addBox(0, 0.7,  1.43, 0.48, 0.5, 0.08, [120, 120, 120]);
addBox(-1.63, 0.7, 0, 0.08, 0.5, 0.48, [120, 120, 120]);
addBox( 1.63, 0.7, 0, 0.08, 0.5, 0.48, [120, 120, 120]);

// ★ 彩蛋：苹果 (真正的 3D 球体，用经纬线网格面拼起来) ★
function addSphere(cx, cy, cz, radius, segments, rings, color) {
  for (var r = 0; r < rings; r++) {
    var phi1 = (r / rings) * Math.PI;
    var phi2 = ((r + 1) / rings) * Math.PI;
    var y1 = cy + radius * Math.cos(phi1);
    var y2 = cy + radius * Math.cos(phi2);
    var r1 = radius * Math.sin(phi1);
    var r2 = radius * Math.sin(phi2);
    
    for (var s = 0; s < segments; s++) {
      var theta1 = (s / segments) * Math.PI * 2;
      var theta2 = ((s + 1) / segments) * Math.PI * 2;
      
      var p1 = [cx + r1 * Math.sin(theta1), y1, cz + r1 * Math.cos(theta1)];
      var p2 = [cx + r1 * Math.sin(theta2), y1, cz + r1 * Math.cos(theta2)];
      var p3 = [cx + r2 * Math.sin(theta2), y2, cz + r2 * Math.cos(theta2)];
      var p4 = [cx + r2 * Math.sin(theta1), y2, cz + r2 * Math.cos(theta1)];
      
      faces.push({ pts: [p1, p2, p3, p4], color: color, isSphere: true });
    }
  }
}
// 苹果本体：中心在 (0, 0.88, 0)，半径 0.12，红色
addSphere(0, 0.88, 0, 0.12, 16, 12, [255, 40, 40]);
// 苹果柄：绿色小方块
addBox(0, 1.02, 0, 0.03, 0.1, 0.03, [100, 255, 80]);

// ===== 物理碰撞 =====
var colliders = [];
colliders.push({ minX: -0.9, maxX: 0.9, minZ: -0.55, maxZ: 0.55 });
colliders.push({ minX: -0.24, maxX: 0.24, minZ: -1.39, maxZ: -0.91 });
colliders.push({ minX: -0.24, maxX: 0.24, minZ: 0.91, maxZ: 1.39 });
colliders.push({ minX: -1.59, maxX: -1.11, minZ: -0.24, maxZ: 0.24 });
colliders.push({ minX: 1.11, maxX: 1.59, minZ: -0.24, maxZ: 0.24 });

// ===== 尺寸与摇杆 =====
var dpr = Math.min(window.devicePixelRatio || 1, 2);
var cssW = 0, cssH = 0;

function resize() {
  cssW = window.innerWidth;
  cssH = window.innerHeight;
  canvas.width = Math.floor(cssW * dpr);
  canvas.height = Math.floor(cssH * dpr);
  canvas.style.width = cssW + 'px';
  canvas.style.height = cssH + 'px';
}
window.addEventListener('resize', resize);
resize();

var joystick = { active: false, originX: 0, originY: 0, knobX: 0, knobY: 0, nx: 0, ny: 0, maxR: 50, outerR: 72, knobR: 22 };

// ===== 渲染 (画家算法) =====
function render() {
  ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  ctx.fillStyle = '#000';
  ctx.fillRect(0, 0, cssW, cssH);

  // 相机矩阵计算
  var cy = Math.cos(camera.yaw), sy = Math.sin(camera.yaw);
  var cp = Math.cos(camera.pitch), sp = Math.sin(camera.pitch);
  var fwX = sy*cp, fwY = sp, fwZ = -cy*cp;
  var rtX = fwZ, rtY = 0, rtZ = -fwX; // cross(fw, [0,1,0]) 简化
  var rtL = Math.sqrt(rtX*rtX + rtY*rtY + rtZ*rtZ);
  rtX /= rtL; rtY /= rtL; rtZ /= rtL;
  var upX = rtY*fwZ - rtZ*fwY, upY = rtZ*fwX - rtX*fwZ, upZ = rtX*fwY - rtY*fwX;

  var f = (cssH / 2) / Math.tan(camera.fov / 2);
  var cxScreen = cssW / 2, cyScreen = cssH / 2;
  var ox = camera.pos[0], oy = camera.pos[1], oz = camera.pos[2];

  // 计算每个面的深度（用于排序）
  var renderList = [];
  for (var i = 0; i < faces.length; i++) {
    var face = faces[i];
    var pts = face.pts;
    
    // 计算面的中心点，作为排序依据
    var centX = 0, centY = 0, centZ = 0;
    for (var j = 0; j < pts.length; j++) {
      centX += pts[j][0]; centY += pts[j][1]; centZ += pts[j][2];
    }
    centX /= pts.length; centY /= pts.length; centZ /= pts.length;
    
    var dx = centX - ox, dy = centY - oy, dz = centZ - oz;
    var dist = dx*fwX + dy*fwY + dz*fwZ; // 沿相机前向的距离
    
    if (dist > 0.1) { // 在相机前面
      // 将顶点投影到 2D
      var proj = [];
      var clipped = false;
      for (var j = 0; j < pts.length; j++) {
        var p = pts[j];
        var vx = p[0] - ox, vy = p[1] - oy, vz = p[2] - oz;
        
        var pZ = vx*fwX + vy*fwY + vz*fwZ;
        if (pZ < 0.1) { clipped = true; break; }
        
        var pX = vx*rtX + vy*rtY + vz*rtZ;
        var pY = vx*upX + vy*upY + vz*upZ;
        
        proj.push([
          cxScreen + (pX / pZ) * f,
          cyScreen - (pY / pZ) * f
        ]);
      }
      
      if (!clipped) {
        renderList.push({ dist: dist, pts: proj, color: face.color });
      }
    }
  }

  // 按距离从远到近排序（画家算法：先画远处的，再画近处的）
  renderList.sort(function(a, b) { return b.dist - a.dist; });

  // 绘制多边形
  for (var i = 0; i < renderList.length; i++) {
    var item = renderList[i];
    var col = item.color;
    
    ctx.fillStyle = 'rgb(' + col[0] + ',' + col[1] + ',' + col[2] + ')';
    ctx.beginPath();
    ctx.moveTo(item.pts[0][0], item.pts[0][1]);
    for (var j = 1; j < item.pts.length; j++) {
      ctx.lineTo(item.pts[j][0], item.pts[j][1]);
    }
    ctx.closePath();
    ctx.fill();
    
    // 给面片加一点点极细的描边，防止缝隙（适合像素风和高清几何）
    ctx.strokeStyle = 'rgba(0,0,0,0.05)';
    ctx.lineWidth = 1;
    ctx.stroke();
  }

  // ===== 高清矢量摇杆 =====
  if (joystick.active) {
    ctx.save();
    ctx.globalAlpha = 0.75;
    
    ctx.beginPath();
    ctx.arc(joystick.originX, joystick.originY, joystick.outerR, 0, Math.PI * 2);
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 3;
    ctx.stroke();
    
    ctx.beginPath();
    ctx.arc(joystick.knobX, joystick.knobY, joystick.knobR, 0, Math.PI * 2);
    ctx.fillStyle = '#000000';
    ctx.fill();
    ctx.lineWidth = 2;
    ctx.strokeStyle = '#ffffff';
    ctx.stroke();
    
    ctx.restore();
  }
}

var lastRender = 0;
function frame(now) {
  if (now - lastRender > 16) { // 60fps
    render();
    lastRender = now;
  }
  requestAnimationFrame(frame);
}
resize();
requestAnimationFrame(frame);

// ===== 输入控制 =====
var keys = {};
window.addEventListener('keydown', function(e) { keys[e.key.toLowerCase()] = true; });
window.addEventListener('keyup', function(e) { keys[e.key.toLowerCase()] = false; });

var dragging = false, lastX = 0, lastY = 0;
canvas.addEventListener('mousedown', function(e) { dragging = true; lastX = e.clientX; lastY = e.clientY; });
window.addEventListener('mouseup', function() { dragging = false; });
window.addEventListener('mousemove', function(e) {
  if (!dragging) return;
  var dx = e.clientX - lastX, dy = e.clientY - lastY;
  lastX = e.clientX; lastY = e.clientY;
  camera.yaw += dx * 0.005;
  camera.pitch -= dy * 0.005;
  camera.pitch = Math.max(-1.2, Math.min(1.2, camera.pitch));
});

var joyTouchId = null, rotateActive = false, rotateLastMX = 0, rotateLastMY = 0;
canvas.addEventListener('touchstart', function(e) {
  if (e.touches.length === 1) {
    var t = e.touches[0];
    joyTouchId = t.identifier;
    joystick.active = true;
    joystick.originX = t.clientX; joystick.originY = t.clientY;
    joystick.knobX = t.clientX; joystick.knobY = t.clientY;
    joystick.nx = 0; joystick.ny = 0;
  } else if (e.touches.length === 2) {
    joystick.active = false; joyTouchId = null; rotateActive = true;
    var mx = 0, my = 0;
    for (var i = 0; i < e.touches.length; i++) { mx += e.touches[i].clientX; my += e.touches[i].clientY; }
    mx /= e.touches.length; my /= e.touches.length;
    rotateLastMX = mx; rotateLastMY = my;
  }
  e.preventDefault();
}, { passive: false });

canvas.addEventListener('touchmove', function(e) {
  if (rotateActive && e.touches.length >= 2) {
    var mx = 0, my = 0;
    for (var i = 0; i < e.touches.length; i++) { mx += e.touches[i].clientX; my += e.touches[i].clientY; }
    mx /= e.touches.length; my /= e.touches.length;
    var dx = mx - rotateLastMX, dy = my - rotateLastMY;
    rotateLastMX = mx; rotateLastMY = my;
    camera.yaw += dx * 0.005;
    camera.pitch -= dy * 0.005;
    camera.pitch = Math.max(-1.2, Math.min(1.2, camera.pitch));
  } else if (joystick.active && joyTouchId !== null) {
    var t = null;
    for (var i = 0; i < e.touches.length; i++) { if (e.touches[i].identifier === joyTouchId) { t = e.touches[i]; break; } }
    if (t) {
      var dx = t.clientX - joystick.originX;
      var dy = t.clientY - joystick.originY;
      var len = Math.sqrt(dx*dx + dy*dy);
      var maxR = joystick.maxR;
      if (len > 0.001) {
        var cl = Math.min(len, maxR);
        joystick.nx = (dx / len) * (cl / maxR);
        joystick.ny = (dy / len) * (cl / maxR);
        joystick.knobX = joystick.originX + (dx / len) * cl;
        joystick.knobY = joystick.originY + (dy / len) * cl;
      }
    }
  }
  e.preventDefault();
}, { passive: false });

canvas.addEventListener('touchend', function(e) {
  if (joyTouchId !== null) {
    var still = false;
    for (var i = 0; i < e.touches.length; i++) { if (e.touches[i].identifier === joyTouchId) { still = true; break; } }
    if (!still) { joyTouchId = null; joystick.active = false; joystick.nx = 0; joystick.ny = 0; }
  }
  if (rotateActive && e.touches.length < 2) rotateActive = false;
  e.preventDefault();
}, { passive: false });

canvas.addEventListener('touchcancel', function() {
  joystick.active = false; joyTouchId = null; rotateActive = false;
  joystick.nx = 0; joystick.ny = 0;
}, { passive: false });

// ===== 移动与碰撞 =====
var last = performance.now();
function update(now) {
  var dt = Math.min(0.05, (now - last) / 1000);
  last = now;

  var speed = 3.0;
  var cy = Math.cos(camera.yaw), sy = Math.sin(camera.yaw);
  var fwdX = sy, fwdZ = -cy;
  var rgtX = cy, rgtZ = sy;

  var mx = 0, mz = 0;
  if (keys['w']) { mx += fwdX; mz += fwdZ; }
  if (keys['s']) { mx -= fwdX; mz -= fwdZ; }
  if (keys['a']) { mx -= rgtX; mz -= rgtZ; }
  if (keys['d']) { mx += rgtX; mz += rgtZ; }

  if (joystick.active) {
    mx += fwdX * (-joystick.ny) + rgtX * joystick.nx;
    mz += fwdZ * (-joystick.ny) + rgtZ * joystick.nx;
  }

  var mLen = Math.sqrt(mx*mx + mz*mz);
  if (mLen > 1) { mx /= mLen; mz /= mLen; }

  var newX = camera.pos[0] + mx * speed * dt;
  var newZ = camera.pos[2] + mz * speed * dt;
  var radius = 0.35;

  newX = Math.max(-hx + radius, Math.min(hx - radius, newX));
  newZ = Math.max(-hz + radius, Math.min(hz - radius, newZ));

  // 简单的碰撞处理
  for (var i = 0; i < colliders.length; i++) {
    var col = colliders[i];
    var closestX = Math.max(col.minX, Math.min(newX, col.maxX));
    var closestZ = Math.max(col.minZ, Math.min(newZ, col.maxZ));
    var distX = newX - closestX;
    var distZ = newZ - closestZ;
    var distSq = distX*distX + distZ*distZ;

    if (distSq < radius * radius) {
      var dist = Math.sqrt(distSq);
      if (dist > 0.0001) {
        newX = closestX + (distX / dist) * radius;
        newZ = closestZ + (distZ / dist) * radius;
      }
    }
  }

  camera.pos[0] = newX;
  camera.pos[2] = newZ;

  requestAnimationFrame(update);
}
requestAnimationFrame(update);
</script>
</body>
</html>