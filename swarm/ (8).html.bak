<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Swarm - 真实网页 iframe 视觉撕裂</title>
<style>
  body, html { margin: 0; padding: 0; height: 100%; overflow: hidden; background: #111; font-family: sans-serif; }
  #toolbar { height: 60px; background: #222; display: flex; align-items: center; padding: 0 15px; gap: 10px; z-index: 9999; position: relative; }
  input { flex: 1; height: 36px; border-radius: 6px; border: 1px solid #444; background: #111; color: #fff; padding: 0 10px; outline: none; }
  button { height: 36px; padding: 0 20px; border-radius: 6px; border: none; font-weight: bold; cursor: pointer; }
  #load-btn { background: #0D99FF; color: #fff; }
  #run-btn { background: #14AE5C; color: #fff; display: none; }
  
  #container { position: absolute; top: 60px; left: 0; right: 0; bottom: 0; }
  iframe { width: 100%; height: 100%; border: none; background: #fff; }
  canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; display: none; }
</style>
</head>
<body>

  <div id="toolbar">
    <input type="text" id="url-input" placeholder="输入真实网址 (如 example.com)" value="example.com">
    <button id="load-btn">加载真实网页</button>
    <button id="run-btn">运行蜂群撕裂</button>
  </div>

  <div id="container">
    <!-- 这里内嵌真实的跨域网页 -->
    <iframe id="real-web" src="about:blank"></iframe>
    <!-- 用于视觉撕裂的 Canvas -->
    <canvas id="tear-canvas"></canvas>
  </div>

  <!-- ⚠️ 请把你的 swarm.js 源码贴在这里 -->
  <script id="swarm-code" type="text/plain">
[占位符]
  </script>

  <script>
    const iframe = document.getElementById('real-web');
    const canvas = document.getElementById('tear-canvas');
    const urlInput = document.getElementById('url-input');
    const loadBtn = document.getElementById('load-btn');
    const runBtn = document.getElementById('run-btn');

    // 1. 加载真实网页
    loadBtn.addEventListener('click', () => {
      let url = urlInput.value.trim();
      if (!url.startsWith('http')) url = 'https://' + url;
      
      loadBtn.textContent = '加载中...';
      iframe.src = url;
      
      // 注意：由于跨域，我们无法监听 iframe 是否完全加载成功，只能大概估算
      setTimeout(() => {
        loadBtn.textContent = '加载真实网页';
        runBtn.style.display = 'block';
      }, 1500);
    });

    // 2. 核心黑科技：视觉撕裂
    runBtn.addEventListener('click', async () => {
      let rawCode = document.getElementById('swarm-code').textContent;
      if (!rawCode || rawCode.includes('[占位符')) return alert("请先贴入源码！");

      // 因为完全无法接触 iframe 里的内容，我们只能依靠 swarm 引擎的"空白重建"能力。
      // 真正的逻辑是：我们要让 swarm 在这个外层页面运行，然后隐藏 iframe，让 swarm 画在 iframe 上方。
      
      try {
        // 清理并伪装环境
        let cleanCode = rawCode
          .replace(/const KEY = "__swarmRebuild";\s*if \(window\[KEY\]\) \{\s*window\[KEY\]\.toggle\(\);\s*return;\s*\}/g, 'const KEY = "__swarmRebuild";')
          .replace(/async loadShot\(\) \{[\s\S]*?\n    \}/g, 'async loadShot() { return null; }')
          .replace(/if\s*\(typeof chrome !== "undefined"[\s\S]*?catch\s*\(_\)\s*\{\s*\}/g, '');

        window.chrome = {
          runtime: { sendMessage: () => Promise.resolve() },
          scripting: { insertCSS: () => Promise.resolve(), removeCSS: () => Promise.resolve(), executeScript: () => Promise.resolve() },
          tabs: { captureVisibleTab: () => Promise.resolve(null) }
        };
        window.__swarmShot = null;
        window.__swarmHidden = false;

        // 启动前，把网页隐藏，这样用户就会觉得网页真的被“吃”了
        iframe.style.opacity = '0';

        // 在当前外层页面执行 swarm
        eval(cleanCode);

        // 隐藏工具栏
        document.getElementById('toolbar').style.display = 'none';
        document.getElementById('container').style.top = '0';

      } catch (err) {
        alert("注入失败: " + err.message);
      }
    });
  </script>
</body>
</html>