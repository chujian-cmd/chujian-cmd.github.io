<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Swarm 无跨域终极版</title>
<style>
  body, html { margin: 0; padding: 0; height: 100%; font-family: sans-serif; overflow: hidden; }
  #toolbar { height: 60px; background: #222; display: flex; align-items: center; padding: 0 15px; gap: 10px; z-index: 999; position: relative; }
  input { flex: 1; height: 36px; border-radius: 6px; border: 1px solid #444; background: #111; color: #fff; padding: 0 10px; outline: none; }
  button { height: 36px; padding: 0 20px; border-radius: 6px; border: none; font-weight: bold; cursor: pointer; background: #0D99FF; color: #fff; }
  #run-btn { background: #14AE5C; }
  #stage { width: 100%; height: calc(100% - 60px); background: #fff; overflow-y: auto; overflow-x: hidden; position: absolute; top: 60px; left: 0; }
</style>
</head>
<body>

  <div id="toolbar">
    <input type="text" id="url-input" placeholder="输入真实网址（如 example.com）" value="https://example.com">
    <button id="load-btn">加载网页</button>
    <button id="run-btn">运行蜂群</button>
  </div>

  <div id="stage"></div>

  <!-- ⚠️ 请把你那几千行的 swarm.js 源码完整粘贴到下面 -->
  <script id="swarm-code" type="text/plain">
    // 在这里粘贴 swarm.js 的源码，不要带 <script> 标签
  </script>

  <script>
    const stage = document.getElementById('stage');
    const urlInput = document.getElementById('url-input');
    const loadBtn = document.getElementById('load-btn');
    const runBtn = document.getElementById('run-btn');

    // 1. 加载真实网页（通过代理抓取 HTML，避开 iframe 跨域）
    loadBtn.addEventListener('click', async () => {
      let url = urlInput.value.trim();
      if (!url.startsWith('http')) url = 'https://' + url;
      
      stage.innerHTML = '<div style="padding:20px;">正在抓取网页源码...</div>';
      
      try {
        // 使用 allorigins 代理获取真实源码
        const res = await fetch(`https://api.allorigins.win/get?url=${encodeURIComponent(url)}`);
        const data = await res.json();
        
        // 将源码直接渲染到当前页面（此时完全同源）
        stage.innerHTML = data.contents;
        
        // 补充 base 标签，让网页里的图片和 CSS 能正常加载
        const base = document.createElement('base');
        base.href = url;
        document.head.appendChild(base);
        
      } catch (err) {
        stage.innerHTML = '<div style="padding:20px;color:red;">抓取失败，可能是代理超时或目标网站拒绝访问。</div>';
      }
    });

    // 2. 运行蜂群
    runBtn.addEventListener('click', () => {
      let rawCode = document.getElementById('swarm-code').textContent;
      
      if (!rawCode || rawCode.trim() === '' || rawCode.includes('在这里粘贴')) {
        alert("请先在代码里粘贴 swarm.js 的源码！");
        return;
      }

      try {
        // 清理死锁代码
        let cleanCode = rawCode
          .replace(/async loadShot\(\) \{[\s\S]*?\n    \}/g, 'async loadShot() { return null; }')
          .replace(/async function unhidePage\(\) \{[\s\S]*?\n  \}/g, 'async function unhidePage() { return; }')
          .replace(/if \(window\[KEY\]\) \{[\s\S]*?return;\n  \}/g, '')
          .replace(/chrome\.runtime[\s\S]*?;/g, '');

        // 注入假环境
        window.chrome = {
          runtime: { sendMessage: () => Promise.resolve() },
          scripting: { insertCSS: () => Promise.resolve(), removeCSS: () => Promise.resolve(), executeScript: () => Promise.resolve() },
          tabs: { captureVisibleTab: () => Promise.resolve(null) }
        };
        window.__swarmShot = null;
        window.__swarmHidden = false;

        // 直接在当前窗口执行
        eval(cleanCode);
        
        // 隐藏工具栏
        document.getElementById('toolbar').style.display = 'none';
        stage.style.top = '0';
        stage.style.height = '100%';
        
      } catch (err) {
        alert("注入报错：" + err.message);
        console.error(err);
      }
    });
  </script>
</body>
</html>