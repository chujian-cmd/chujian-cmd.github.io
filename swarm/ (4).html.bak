<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Swarm 终极运行器</title>
<style>
  body, html { margin: 0; padding: 0; height: 100%; font-family: sans-serif; overflow: hidden; background: #111; }
  #toolbar { height: 60px; background: #222; display: flex; align-items: center; padding: 0 15px; gap: 10px; z-index: 999; position: relative; }
  input { flex: 1; height: 36px; border-radius: 6px; border: 1px solid #444; background: #111; color: #fff; padding: 0 10px; outline: none; }
  button { height: 36px; padding: 0 20px; border-radius: 6px; border: none; font-weight: bold; cursor: pointer; }
  #load-btn { background: #0D99FF; color: #fff; }
  #run-btn { background: #14AE5C; color: #fff; }
  iframe { width: 100%; height: calc(100% - 60px); border: none; background: #fff; position: absolute; top: 60px; left: 0; }
</style>
</head>
<body>

  <div id="toolbar">
    <input type="text" id="url-input" placeholder="输入真实网址（如 example.com）" value="https://example.com">
    <button id="load-btn">加载网页</button>
    <button id="run-btn">运行蜂群</button>
  </div>

  <iframe id="real-frame" src="about:blank"></iframe>

  <!-- ⚠️ 请将你的 swarm.js 源码原封不动地粘贴在下面这两行之间 -->
  <script id="swarm-source" type="text/plain">
[占位符]
  </script>

  <script>
    const frame = document.getElementById('real-frame');
    const urlInput = document.getElementById('url-input');
    const loadBtn = document.getElementById('load-btn');
    const runBtn = document.getElementById('run-btn');

    // 加载网页
    loadBtn.addEventListener('click', () => {
      let url = urlInput.value.trim();
      if (!url.startsWith('http')) url = 'https://' + url;
      frame.src = url;
    });

    // 运行蜂群
    runBtn.addEventListener('click', () => {
      let rawCode = document.getElementById('swarm-source').textContent;
      
      if (!rawCode || rawCode.includes('[占位符]')) {
        alert("请先在代码里的 [占位符] 处粘贴 swarm.js 的源码！");
        return;
      }

      const iframeWindow = frame.contentWindow;
      const iframeDoc = iframeWindow.document;

      try {
        // 【核心修复 1】注入假环境，欺骗扩展 API 检测
        iframeWindow.chrome = {
          runtime: { sendMessage: () => Promise.resolve() },
          scripting: { insertCSS: () => Promise.resolve(), removeCSS: () => Promise.resolve(), executeScript: () => Promise.resolve() },
          tabs: { captureVisibleTab: () => Promise.resolve(null) }
        };
        iframeWindow.__swarmShot = null;
        iframeWindow.__swarmHidden = false;
        iframeWindow.__swarmUnhide = () => {};

        // 【核心修复 2】使用最精准的字符串替换，干掉会报错的那几句，保留原版逻辑
        let cleanCode = rawCode
          // 干掉尝试获取扩展后台截图的逻辑
          .replace(/if\s*\(typeof chrome !== "undefined" && chrome\.runtime && chrome\.runtime\.sendMessage\)[\s\S]*?await chrome\.runtime\.sendMessage\(\{\s*type:\s*"swarm:unhide"\s*\}\);/g, '')
          // 干掉无法使用的截图等待逻辑
          .replace(/let src = window\.__swarmShot;[\s\S]*?return null;/g, 'return null;')
          // 干掉原版最外层为了防止重复注入的检测（因为在 iframe 里每次都必须执行）
          .replace(/const KEY = "__swarmRebuild";\s*if \(window\[KEY\]\) \{\s*window\[KEY\]\.toggle\(\);\s*return;\s*\}/g, '');

        // 【核心修复 3】通过 iframe 的 document 创建 script 标签执行，这是 100% 同源环境
        const script = iframeDoc.createElement('script');
        script.textContent = cleanCode;
        iframeDoc.body.appendChild(script);

        // 隐藏工具栏
        document.getElementById('toolbar').style.display = 'none';
        frame.style.top = '0';
        frame.style.height = '100%';
        
      } catch (err) {
        console.error(err);
        alert("注入失败：" + err.message + "\n如果跑不起来，多半是目标网站有 CSP 安全策略，建议用 example.com 测试。");
      }
    });
  </script>
</body>
</html>