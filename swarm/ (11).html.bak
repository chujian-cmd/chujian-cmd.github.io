<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Swarm Rebuild · 地址栏版</title>
<style>
  :root { color-scheme: light dark; }
  * { box-sizing: border-box; }
  html, body { height: 100%; margin: 0; }
  body {
    font: 14px/1.4 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    background: #111; color: #eee;
    display: flex; flex-direction: column;
  }
  header {
    display: flex; gap: 8px; align-items: center;
    padding: 10px 12px; background: #1b1b1f;
    border-bottom: 1px solid #2c2c33; flex: 0 0 auto;
  }
  header .title { font-weight: 700; white-space: nowrap; }
  header input[type=url] {
    flex: 1 1 auto; min-width: 120px;
    padding: 8px 10px; border-radius: 8px;
    border: 1px solid #3a3a44; background: #26262c; color: #eee;
    outline: none;
  }
  header input[type=url]:focus { border-color: #0D99FF; }
  header button {
    padding: 8px 12px; border-radius: 8px; border: 0;
    background: #2c2c33; color: #eee; cursor: pointer; white-space: nowrap;
  }
  header button:hover { background: #3a3a44; }
  header button.pri { background: #0D99FF; color: #fff; }
  header button.pri:hover { background: #2aa6ff; }
  #status {
    padding: 6px 12px; font-size: 12px; color: #9aa0a6;
    background: #17171b; border-bottom: 1px solid #26262c;
    flex: 0 0 auto; min-height: 28px;
  }
  #status.err { color: #ff8a8a; }
  #stage { position: relative; flex: 1 1 auto; background: #0b0b0d; overflow: hidden; }
  #frame {
    position: absolute; inset: 0; width: 100%; height: 100%;
    border: 0; background: #fff; display: none;
  }
  #local {
    position: absolute; inset: 0; overflow: auto; padding: 40px 24px;
    background:
      radial-gradient(1200px 600px at 20% 0%, #1d2a3a 0%, transparent 60%),
      radial-gradient(1000px 500px at 100% 100%, #2a1d3a 0%, transparent 55%),
      #0b0b0d;
  }
  #local .card {
    max-width: 760px; margin: 0 auto;
    background: rgba(255,255,255,.04);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 16px; padding: 24px;
  }
  #local h1 { margin: 0 0 8px; font-size: 22px; }
  #local p { color: #a9b0b8; margin: 8px 0; }
  #local code { background: #22222a; padding: 1px 5px; border-radius: 4px; }
  .row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
</style>
</head>
<body>

<header>
  <span class="title">Swarm Rebuild</span>
  <input id="url" type="url" placeholder="输入同源网址，例如 /demo.html 或 http://localhost:8080/（可留空）" autocomplete="off" spellcheck="false">
  <button id="load" class="pri">加载并运行</button>
  <button id="runLocal">在当前页运行</button>
  <button id="toggle">开始 / 停止</button>
</header>

<div id="status">就绪。可点“在当前页运行”，或输入<strong>同源</strong>网址后在 iframe 中注入运行。</div>

<div id="stage">
  <div id="local">
    <div class="card">
      <h1>Swarm Rebuild · 地址栏版</h1>
      <p>这是把原 <code>swarm.js</code> 改造为可注入模块后的单页应用。点“在当前页运行”会让蜂群重建<strong>这个页面本身</strong>。</p>
      <p>顶部输入同源网址后，会把它加载进 <code>iframe</code>，并在其中注入 <code>swarm.js</code> 运行。</p>
      <p><strong>限制：</strong>浏览器同源策略不允许读取跨域 iframe 的 DOM；大多数真实网站还禁止被 iframe 嵌入（<code>X-Frame-Options</code> / CSP <code>frame-ancestors</code>）。跨域或被拦截时会在状态栏提示，此时请改用浏览器扩展方式注入。</p>
      <div class="row">
        <button onclick="document.getElementById('runLocal').click()">在当前页运行</button>
      </div>
    </div>
  </div>
  <iframe id="frame" referrerpolicy="no-referrer" sandbox="allow-same-origin allow-scripts allow-forms allow-popups"></iframe>
</div>

<script type="module">
import { install, uninstall } from "./swarm.js";

const $ = (s) => document.querySelector(s);
const urlInput = $("#url");
const frame = $("#frame");
const local = $("#local");
const statusEl = $("#status");

function setStatus(msg, isErr = false) {
  statusEl.textContent = msg;
  statusEl.classList.toggle("err", isErr);
}

let frameWin = null;      // 当前 iframe 的 window（同源时可用）
let frameReady = false;

// ---------- 当前页运行 ----------
$("#runLocal").addEventListener("click", () => {
  if (frameWin) {
    setStatus("请先停止 iframe 中的运行，或刷新页面。", true);
    return;
  }
  try {
    install(window);
    setStatus("已在当前页运行。再次点击“开始 / 停止”可关闭。");
  } catch (e) {
    console.error(e);
    setStatus("当前页运行失败：" + e.message, true);
  }
});

// ---------- 开始 / 停止（对当前活动目标） ----------
$("#toggle").addEventListener("click", () => {
  try {
    if (frameWin) {
      install(frameWin);
      setStatus("已切换 iframe 中的 Swarm。");
    } else {
      install(window);
      setStatus("已切换当前页 Swarm。");
    }
  } catch (e) {
    console.error(e);
    setStatus("切换失败：" + e.message, true);
  }
});

// ---------- 加载网址并注入 ----------
$("#load").addEventListener("click", async () => {
  const raw = urlInput.value.trim();
  if (!raw) {
    setStatus("请输入网址，或点“在当前页运行”。", true);
    return;
  }
  let target;
  try {
    target = new URL(raw, location.href);
  } catch {
    setStatus("网址格式不正确。", true);
    return;
  }

  // 先卸载旧的
  if (frameWin) {
    try { uninstall(frameWin); } catch {}
    frameWin = null;
    frameReady = false;
  }

  local.style.display = "none";
  frame.style.display = "block";
  setStatus("正在加载 " + target.href + " …");

  frame.onload = null;
  frame.onerror = null;
  frame.src = target.href;

  frame.onload = () => {
    let win;
    try {
      win = frame.contentWindow;
      // 访问 contentDocument 触发同源检查
      const doc = win.document;
      if (!doc || doc.location.href === "about:blank") throw new Error("blank");
      // 同源可访问
      frameWin = win;
      frameReady = true;
      setStatus("加载成功，正在注入 Swarm …");
      try {
        install(win);
        setStatus("已在 iframe 中运行 Swarm（" + target.href + "）。");
      } catch (e) {
        console.error(e);
        setStatus("注入失败：" + e.message, true);
      }
    } catch (e) {
      // 跨域 / 被拦截 / about:blank
      frameWin = null;
      frameReady = false;
      const tip =
        target.origin !== location.origin
          ? "跨域：浏览器不允许读取该 iframe 的 DOM（同源策略）。"
          : "无法访问 iframe 文档：目标可能设置了 X-Frame-Options / CSP frame-ancestors，或被浏览器拦截。";
      setStatus(tip + " 请在目标页使用浏览器扩展方式注入，或点“在当前页运行”。", true);
    }
  };

  frame.onerror = () => {
    setStatus("加载失败：网络错误或被目标站点拦截。", true);
  };
});

// 地址栏回车 = 加载
urlInput.addEventListener("keydown", (e) => {
  if (e.key === "Enter") $("#load").click();
});

// 页面卸载时清理
window.addEventListener("beforeunload", () => {
  try { if (frameWin) uninstall(frameWin); } catch {}
  try { uninstall(window); } catch {}
});
</script>

</body>
</html>