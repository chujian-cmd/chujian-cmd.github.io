<!DOCTYPE html><meta charset=UTF-8><meta name=viewport content="width=device-width,initial-scale=1,user-scalable=no"><title>✨</title><style>body{margin:0;overflow:hidden;background:#000;touch-action:none}canvas{display:block}</style><canvas id=c></canvas><script>C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,A=[],R=_=>{W=c.width=innerWidth,H=c.height=innerHeight},addEventListener('resize',R),addEventListener('touchmove',e=>{e.preventDefault();for(t of e.touches)for(i=0;i<8;i++)A.push([t.clientX+(Math.random()-.5)*16,t.clientY+(Math.random()-.5)*16,(Math.random()-.5)*3,(Math.random()-.5)*3,`hsl(${Math.random()*360},100%,65%)`,1])},{passive:0}),addEventListener('touchstart',e=>{for(t of e.touches)for(i=0;i<50;i++)r=Math.random()*6.28,s=Math.random()*5+1,A.push([t.clientX,t.clientY,Math.cos(r)*s,Math.sin(r)*s,`hsl(${Math.random()*360},100%,65%)`,1])}),setInterval(_=>{C.fillStyle='#0008',C.fillRect(0,0,W,H);A=A.filter(p=>{p[0]+=p[2],p[1]+=p[3],p[2]*=.97,p[3]*=.97,p[5]*=.95,C.globalAlpha=p[5],C.fillStyle=p[4],C.beginPath(),C.arc(p[0],p[1],p[5]*4,0,7),C.fill();return p[5]>.05})},16)</script>