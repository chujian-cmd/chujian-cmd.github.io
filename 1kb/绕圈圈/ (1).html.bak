<!DOCTYPE html><meta charset=UTF-8><meta name=viewport content="width=device-width,initial-scale=1"><title>✨</title><style>body{margin:0;overflow:hidden;background:#000}canvas{display:block}</style><canvas id=c></canvas><script>C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,A=[],onresize=_=>{W=c.width=innerWidth,H=c.height=innerHeight},onmousemove=e=>{for(i=0;i<8;i++)A.push([e.clientX+(Math.random()-.5)*20,e.clientY+(Math.random()-.5)*20,(Math.random()-.5)*4,(Math.random()-.5)*4,`hsl(${Math.random()*360},100%,65%)`,1])},setInterval(_=>{C.fillStyle='#0008',C.fillRect(0,0,W,H);A=A.filter(p=>{p[0]+=p[2],p[1]+=p[3],p[2]*=.97,p[3]*=.97,p[5]*=.95,C.globalAlpha=p[5],C.fillStyle=p[4],C.beginPath(),C.arc(p[0],p[1],p[5]*4,0,7),C.fill();return p[5]>.05})},16)</script>