<!doctype html><body style=margin:0;overflow:hidden;background:#000;touch-action:none><canvas id=c><script>C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,R=Math.random,S=[],X=Y=l=m=u=0;for(i=0;i<1200;i++){e=i%12,t=(i%100-50)*8;if(e<4)x=t,y=e%2?300:-300,z=e<2?300:-300;else if(e<8)y=t,x=e%2?300:-300,z=e<6?300:-300;else z=t,x=e%2?300:-300,y=e<10?300:-300;S.push({x,y,z,c:e*30})}ontouchstart=e=>{u=1;l=e.touches[0].clientX;m=e.touches[0].clientY};ontouchmove=e=>{e.preventDefault();if(u){X+=(e.touches[0].clientY-m)*.005;Y+=(e.touches[0].clientX-l)*.005;l=e.touches[0].clientX;m=e.touches[0].clientY}};ontouchend=e=>u=0;setInterval(_=>{C.fillStyle='rgba(0,0,0,0.4)';C.fillRect(0,0,W,H);if(!u){X+=.005;Y+=.008}for(i=0;i<1200;i++){s=S[i],a=s.y*Math.cos(X)-s.z*Math.sin(X),b=s.y*Math.sin(X)+s.z*Math.cos(X),c=s.x*Math.cos(Y)-b*Math.sin(Y),d=s.x*Math.sin(Y)+b*Math.cos(Y),f=500/(c+800);if(f>0){C.fillStyle=`hsl(${s.c},100%,60%)`;C.beginPath();C.arc(W/2+d*f,H/2+a*f,Math.max(0.5,f*3),0,7);C.fill()}}},16)</script>