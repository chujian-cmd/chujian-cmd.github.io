<!doctype html><body style="margin:0;overflow:hidden;background:#000;touch-action:none"><canvas id=c><script>C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,R=Math.random,S=[],X=Y=l=m=0,u=0;for(i=0;i<600;i++){let p=i%3,v=(R()-.5)*300;S.push({x:p==0?v:(R()-.5)*300,y:p==1?v:(R()-.5)*300,z:p==2?v:(R()-.5)*300,c:i%360})}ontouchstart=e=>{u=1;l=e.touches[0].clientX;m=e.touches[0].clientY};ontouchmove=e=>{e.preventDefault();if(u){X+=(e.touches[0].clientY-m)*.005;Y+=(e.touches[0].clientX-l)*.005;l=e.touches[0].clientX;m=e.touches[0].clientY}};ontouchend=e=>u=0;setInterval(_=>{C.fillStyle='rgba(0,0,0,0.2)';C.fillRect(0,0,W,H);if(!u){X+=.005;Y+=.005}for(i=0;i<600;i++){s=S[i];let y1=s.y*Math.cos(X)-s.z*Math.sin(X),z1=s.y*Math.sin(X)+s.z*Math.cos(X);let x2=s.x*Math.cos(Y)-z1*Math.sin(Y),z2=s.x*Math.sin(Y)+z1*Math.cos(Y);let f=400/(z2+500);if(f>0){let px=W/2+x2*f,py=H/2+y1*f,r=Math.max(0.5,f*2.5);C.fillStyle=`hsl(${s.c},100%,60%)`;C.beginPath();C.arc(px,py,r,0,7);C.fill()}}},16)</script>