<!doctype html><body style=margin:0;overflow:hidden;background:#000;touch-action:none><canvas id=c><script>C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,R=Math.random,S=[],X=Y=l=m=0,u=0;for(i=0;i<1200;i++){let p=i%600,v=(p%300-150)*2,e=(i%2)?-300:300;if(p<300)S.push({x:v,y:e,z:e,c:p});else S.push({x:e,y:(p%300-150)*2,z:e,c:p})}ontouchstart=e=>{u=1;l=e.touches[0].clientX;m=e.touches[0].clientY};ontouchmove=e=>{e.preventDefault();if(u){X+=(e.touches[0].clientY-m)*.005;Y+=(e.touches[0].clientX-l)*.005;l=e.touches[0].clientX;m=e.touches[0].clientY}};ontouchend=e=>u=0;setInterval(_=>{C.fillStyle='#000';C.fillRect(0,0,W,H);if(!u){X+=.005;Y+=.008}for(i=0;i<1200;i++){s=S[i];let a=s.x*Math.cos(Y)-s.z*Math.sin(Y),b=s.x*Math.sin(Y)+s.z*Math.cos(Y);let c=s.y*Math.cos(X)-b*Math.sin(X),d=s.y*Math.sin(X)+b*Math.cos(X);let f=500/(a+800);if(f>0){C.fillStyle=`hsl(${s.c},100%,${50+f*20}%)`;C.beginPath();C.arc(W/2+c*f,H/2+d*f,f*3,0,7);C.fill()}}},16)</script>