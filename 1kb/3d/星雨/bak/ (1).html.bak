<!doctype html><body style="margin:0;overflow:hidden;background:#000;touch-action:none"><canvas id=c><script>C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,R=Math.random,S=[],MX=W/2,MY=H/2,AX=0,AY=0;for(i=0;i<400;i++)S.push({x:(R()-.5)*2000,y:(R()-.5)*2000,z:R()*2000,c:`hsl(${R()*360},100%,60%)`});ontouchstart=ontouchmove=e=>{e.preventDefault();if(e.touches[0]){AX=(e.touches[0].clientX-W/2)*.005;AY=(e.touches[0].clientY-H/2)*.005}};setInterval(_=>{C.fillStyle='#000';C.fillRect(0,0,W,H);for(i=0;i<400;i++){s=S[i];s.z-=15;if(s.z<1){s.z=2000;s.x=(R()-.5)*2000;s.y=(R()-.5)*2000}let px=s.x*Math.cos(AX)-s.y*Math.sin(AX),py=s.x*Math.sin(AX)+s.y*Math.cos(AX);let cx=px*Math.cos(AY)-s.z*Math.sin(AY),cz=px*Math.sin(AY)+s.z*Math.cos(AY);let f=800/cz,size=f*2;if(size>0&&size<100){C.fillStyle=s.c;C.beginPath();C.arc(W/2+cx*f,H/2+py*f,size,0,7);C.fill()}}},16)</script>