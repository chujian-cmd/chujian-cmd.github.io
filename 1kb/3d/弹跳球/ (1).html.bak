<!doctype html><body style="margin:0;overflow:hidden;background:#000;touch-action:none"><canvas id=c><script>O=Math.cos,M=Math.sin,C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,X=Y=l=m=u=0,bx=0,by=100,bz=0,vx=3,vy=0,vz=2.5,S=200;ontouchstart=e=>{u=1;l=e.touches[0].clientX;m=e.touches[0].clientY};ontouchmove=e=>{e.preventDefault();if(u){X+=(e.touches[0].clientY-m)*.005;Y+=(e.touches[0].clientX-l)*.005;l=e.touches[0].clientX;m=e.touches[0].clientY}};ontouchend=e=>u=0;setInterval(_=>{C.fillStyle='#000';C.fillRect(0,0,W,H);if(!u){X+=.002;Y+=.003}vy+=0.4;bx+=vx;by+=vy;bz+=vz;if(by>S){by=S;vy*=-0.8}if(bx<-S||bx>S){vx*=-1}if(bz<-S||bz>S){vz*=-1}let p=(px,py,pz)=>{let a=py*O(X)-pz*M(X),b=py*M(X)+pz*O(X),c=px*O(Y)-b*M(Y),d=px*M(Y)+b*O(Y),f=500/(c+800);return[W/2+d*f,H/2+a*f,f]};C.strokeStyle='#3bf';C.lineWidth=1;for(i=-S;i<=S;i+=50){let p1=p(i,S,-S),p2=p(i,S,S),p3=p(-S,S,i),p4=p(S,S,i);if(p1[2]>0){C.beginPath();C.moveTo(p1[0],p1[1]);C.lineTo(p2[0],p2[1]);C.stroke()}if(p3[2]>0){C.beginPath();C.moveTo(p3[0],p3[1]);C.lineTo(p4[0],p4[1]);C.stroke()}}let sp=p(bx,by,bz);if(sp[2]>0){C.fillStyle=`hsl(${by+200},100%,60%)`;C.beginPath();C.arc(sp[0],sp[1],Math.max(2,sp[2]*12),0,7);C.fill();let ss=p(bx,S,bz);if(ss[2]>0){C.fillStyle='#fff';C.globalAlpha=.2;C.beginPath();C.arc(ss[0],ss[1],Math.max(1,ss[2]*8),0,7);C.fill();C.globalAlpha=1}}},16)</script>