<!doctype html><body style=margin:0;overflow:hidden;background:#111;touch-action:none><canvas id=c><script>O=Math.cos,M=Math.sin,C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,X=Y=l=m=u=0,bx=bz=0,by=-100,vx=vy=vz=0,S=120;ontouchstart=e=>{u=1;l=e.touches[0].clientX;m=e.touches[0].clientY};ontouchmove=e=>{e.preventDefault();if(u){X+=(e.touches[0].clientY-m)*.005;Y+=(e.touches[0].clientX-l)*.005;l=e.touches[0].clientX;m=e.touches[0].clientY}};ontouchend=e=>u=0;setInterval(_=>{C.fillStyle='#111';C.fillRect(0,0,W,H);if(!u){X+=.002;Y+=.003}vy+=0.5;bx+=vx;by+=vy;bz+=vz;if(by>S){by=S;vy*=-0.7;vx*=.95;vz*=.95}if(bx<-S||bx>S)vx*=-0.8,bx=bx<0?-S:S;if(bz<-S||bz>S)vz*=-0.8,bz=bz<0?-S:S;if(by<-200)vy=2;let p=(px,py,pz)=>{let a=py*O(X)-pz*M(X),b=py*M(X)+pz*O(X),c=px*O(Y)-b*M(Y),d=px*M(Y)+b*O(Y),f=500/(c+700);return[W/2+d*f,H/2+a*f,f]};let P1=p(-S,S,-S),P2=p(S,S,-S),P3=p(S,S,S),P4=p(-S,S,S);if(P1[2]>0&&P3[2]>0){C.fillStyle='#1e3a8a99';C.beginPath();C.moveTo(P1[0],P1[1]);C.lineTo(P2[0],P2[1]);C.lineTo(P3[0],P3[1]);C.lineTo(P4[0],P4[1]);C.fill();C.strokeStyle='#3bf';C.lineWidth=2;C.stroke()}let sp=p(bx,by,bz);if(sp[2]>0){C.fillStyle='#f43';C.beginPath();C.arc(sp[0],sp[1],Math.max(2,sp[2]*10),0,7);C.fill();let ss=p(bx,S,bz);if(ss[2]>0){C.fillStyle='#000';C.globalAlpha=.6;C.beginPath();C.arc(ss[0],ss[1],Math.max(1,ss[2]*8),0,7);C.fill();C.globalAlpha=1}}},16)</script>