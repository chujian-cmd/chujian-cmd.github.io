<!doctype html><body style=margin:0;overflow:hidden;background:#000;touch-action:none><canvas id=c><script>O=Math.cos,M=Math.sin,C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,X=Y=l=m=u=0,bx=by=bz=0,vx=vy=vz=0,S=150;ontouchstart=e=>{u=1;l=e.touches[0].clientX;m=e.touches[0].clientY};ontouchmove=e=>{e.preventDefault();if(u){X+=(e.touches[0].clientY-m)*.005;Y+=(e.touches[0].clientX-l)*.005;l=e.touches[0].clientX;m=e.touches[0].clientY}};ontouchend=e=>u=0;setInterval(_=>{C.fillStyle='rgba(0,0,0,0.5)';C.fillRect(0,0,W,H);if(!u){X+=.002;Y+=.003}vy+=3*O(X);vz+=3*M(X);bx+=vx;by+=vy;bz+=vz;if(by>S){by=S;vy*=-0.8}if(by<-S){by=-S;vy*=-0.8}if(bx<-S||bx>S){vx*=-1}if(bz<-S||bz>S){vz*=-1}let p=(px,py,pz)=>{let a=py*O(X)-pz*M(X),b=py*M(X)+pz*O(X),c=px*O(Y)-b*M(Y),d=px*M(Y)+b*O(Y),f=500/(c+800);return[W/2+d*f,H/2+a*f,f]};C.strokeStyle='#333';C.lineWidth=2;[[-S,-S,-S],[S,-S,-S],[S,-S,S],[-S,-S,S],[-S,-S,-S]].forEach((pt,i,a)=>{if(i){let p1=p(a[i-1][0],a[i-1][1],a[i-1][2]),p2=p(pt[0],pt[1],pt[2]);if(p1[2]>0&&p2[2]>0){C.beginPath();C.moveTo(p1[0],p1[1]);C.lineTo(p2[0],p2[1]);C.stroke()}}});let sp=p(bx,by,bz);if(sp[2]>0){C.fillStyle=`hsl(${by+200},100%,60%)`;C.beginPath();C.arc(sp[0],sp[1],Math.max(2,sp[2]*12),0,7);C.fill();let ss=p(bx,S,bz);if(ss[2]>0){C.fillStyle='#fff';C.globalAlpha=.1;C.beginPath();C.arc(ss[0],ss[1],Math.max(1,ss[2]*8),0,7);C.fill();C.globalAlpha=1}}},16)</script>