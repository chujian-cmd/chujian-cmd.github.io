<!doctype html><body style=margin:0;overflow:hidden;background:#111;touch-action:none><canvas id=c><script>O=Math.cos,M=Math.sin,C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,X=Y=l=m=u=0,bx=bz=0,by=-100,vx=vy=vz=0,S=100;ontouchstart=e=>{u=1;l=e.touches[0].clientX;m=e.touches[0].clientY};ontouchmove=e=>{e.preventDefault();if(u){X+=(e.touches[0].clientY-m)*.005;Y+=(e.touches[0].clientX-l)*.005;l=e.touches[0].clientX;m=e.touches[0].clientY}};ontouchend=e=>u=0;setInterval(_=>{C.fillStyle='#111';C.fillRect(0,0,W,H);vx-=M(Y)*.2;vz-=M(X)*.2;vy+=.5;bx+=vx;by+=vy;bz+=vz;if(by>S){by=S;vy*=-.7;vx*=.95;vz*=.95}if(bx<-S||bx>S){vx*=-.7;bx=bx<0?-S:S}if(bz<-S||bz>S){vz*=-.7;bz=bz<0?-S:S}let p=(x,y,z)=>{let a=y*O(X)-z*M(X),b=y*M(X)+z*O(X),c=x*O(Y)-b*M(Y),d=x*M(Y)+b*O(Y),f=500/(c+1500);return[W/2+d*f,H/2+a*f,f]};let a=p(-S,S,-S),b=p(S,S,-S),c=p(S,S,S),d=p(-S,S,S);C.fillStyle='#1e3a8a';C.beginPath();C.moveTo(a[0],a[1]);C.lineTo(b[0],b[1]);C.lineTo(c[0],c[1]);C.lineTo(d[0],d[1]);C.closePath();C.fill();C.strokeStyle='#3bf';C.stroke();let sp=p(bx,by,bz);C.fillStyle='#f43';C.beginPath();C.arc(sp[0],sp[1],Math.max(2,sp[2]/30),0,7);C.fill()},16)</script>