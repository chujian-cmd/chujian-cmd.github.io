<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>1KB · 极简交互时钟</title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    body{min-height:100vh;display:flex;justify-content:center;align-items:center;background:#0a0f1e;font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;transition:background .3s}
    .card{background:rgba(20,30,50,.75);backdrop-filter:blur(12px);border-radius:3rem;padding:2.5rem 3rem;box-shadow:0 25px 40px -10px rgba(0,0,0,.6),0 0 0 1px rgba(255,255,255,.06) inset;text-align:center;color:#eef5ff;transition:box-shadow .3s,transform .2s}
    .card:hover{box-shadow:0 30px 50px -12px #3b82f6,0 0 0 1.5px rgba(120,180,255,.4) inset;transform:scale(1.01)}
    #time{font-size:clamp(3rem,15vw,7rem);font-weight:600;letter-spacing:6px;line-height:1.1;text-shadow:0 0 20px rgba(100,180,255,.7);font-variant-numeric:tabular-nums;transition:color .2s}
    #date{font-size:1.2rem;margin-top:.5rem;opacity:.8;letter-spacing:2px;font-weight:300;border-top:1px solid rgba(255,255,255,.15);padding-top:1rem;display:inline-block}
    .dot{display:inline-block;width:12px;height:12px;border-radius:50%;background:#3b82f6;margin:0 6px;box-shadow:0 0 15px #3b82f6;animation:pulse 2s infinite}
    @keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.8)}}
  </style>
</head>
<body>
  <div class="card">
    <div id="time">00:00:00</div>
    <div id="date">loading...</div>
    <div style="margin-top:1rem;font-size:.9rem;opacity:.5">
      <span class="dot"></span> 1KB · 极简交互时钟 <span class="dot"></span>
    </div>
  </div>
  <script>
    (function(){
      const t = document.getElementById('time'),
            d = document.getElementById('date'),
            b = document.body,
            c = document.querySelector('.card');
      const wd = ['周日','周一','周二','周三','周四','周五','周六'];
      function pad(n){return n<10?'0'+n:n}
      function update(){
        const now = new Date(),
              h = now.getHours(),
              m = now.getMinutes(),
              s = now.getSeconds();
        // 主时间
        t.textContent = `${pad(h)}:${pad(m)}:${pad(s)}`;
        // 日期 (包含星期)
        d.textContent = `${now.getFullYear()}.${pad(now.getMonth()+1)}.${pad(now.getDate())} ${wd[now.getDay()]}`;
        // 动态颜色 —— 基于小时变换卡片和背景氛围
        const hue = (h * 30 + m * 0.5) % 360,
              bgHue = (hue + 200) % 360;
        b.style.background = `radial-gradient(circle at 30% 20%, hsl(${bgHue} 60% 12%), hsl(${bgHue} 70% 5%))`;
        c.style.color = `hsl(${hue} 80% 85%)`;
        t.style.color = `hsl(${hue} 90% 75%)`;
        t.style.textShadow = `0 0 20px hsl(${hue} 90% 60% / .8)`;
        // 每个整点略微调整卡片边框光晕 (微交互)
        if(s === 0) c.style.boxShadow = `0 0 0 2px hsl(${hue} 90% 60%) inset`;
        else if(s === 1) c.style.boxShadow = ''; // 恢复，但会被hover覆盖，保留干净视觉
      }
      update(); setInterval(update, 1000);
      // 点击卡片暂停/继续动画？ 保留妙趣：点击快速切换一次颜色 (触发更新)
      c.addEventListener('click', () => {
        update();
        c.style.transform = 'scale(0.98)';
        setTimeout(()=>c.style.transform = '', 120);
      });
    })();
  </script>
</body>
</html>