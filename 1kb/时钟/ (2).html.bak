<!DOCTYPE html><html><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>1KB</title><style>*{margin:0;box-sizing:border-box}body{min-height:100vh;display:grid;place-items:center;background:#0a0f1e;font-family:system-ui,sans-serif;transition:.3s}.c{background:rgba(20,30,50,.7);backdrop-filter:blur(12px);border-radius:3rem;padding:2.5rem 3rem;text-align:center;color:#eef5ff;box-shadow:0 0 0 1px #fff1 inset,0 25px 40px -10px #0009;transition:.3s}.c:hover{transform:scale(1.02);box-shadow:0 0 0 1.5px #78b4ff66 inset,0 30px 50px -12px #3b82f6}#t{font-size:clamp(3rem,15vw,7rem);font-weight:600;letter-spacing:6px;font-variant-numeric:tabular-nums;transition:.2s}#d{margin-top:.5rem;opacity:.8;letter-spacing:2px;font-weight:300;border-top:1px solid #fff3;padding-top:1rem}</style><div class=c><div id=t>00:00:00</div><div id=d></div></div><script>let t=document.getElementById('t'),d=document.getElementById('d'),b=document.body,c=document.querySelector('.c'),w=['日','一','二','三','四','五','六'],p=n=>n<10?'0'+n:n;function u(){let n=new Date,h=n.getHours(),m=n.getMinutes(),s=n.getSeconds();t.textContent=p(h)+':'+p(m)+':'+p(s),d.textContent=n.getFullYear()+'.'+p(n.getMonth()+1)+'.'+p(n.getDate())+' 周'+w[n.getDay()];let x=(h*30+m*.5)%360,y=(x+200)%360;b.style.background=`radial-gradient(circle at 30% 20%,hsl(${y} 60% 12%),hsl(${y} 70% 5%))`;c.style.color=`hsl(${x} 80% 85%)`;t.style.color=`hsl(${x} 90% 75%)`;t.style.textShadow=`0 0 20px hsl(${x} 90% 60%/.8)`;c.style.boxShadow=s<1?`0 0 0 2px hsl(${x} 90% 60%) inset,0 25px 40px -10px #0009`:'0 0 0 1px #fff1 inset,0 25px 40px -10px #0009'}u();setInterval(u,1000);c.onclick=()=>{u();c.style.transform='scale(.98)';setTimeout(()=>c.style.transform='',120)}</script>