<body style=margin:0;background:#111><canvas id=c></canvas><script>W=c.width=innerWidth||360;H=c.height=innerHeight||640;g=c.getContext('2d');h=30;d=0;go=0;cu=[];st=[[W/2-70,140]];cur;nw=()=>{w=st[st.length-1][1];cur=[d?0:W-w,w,d*8-4];d=!d};nw();dn=()=>{if(go){st=[[W/2-70,140]];go=0;cu=[];nw();return};p=st[st.length-1],l=Math.max(cur[0],p[0]),r=Math.min(cur[0]+cur[1],p[0]+p[1]);if(r<=l){go=1;return};y=H-100-st.length*h;if(cur[0]<l)cu.push([cur[0],l-cur[0],y]);if(cur[0]+cur[1]>r)cu.push([r,cur[0]+cur[1]-r,y]);st.push([l,r-l]);nw()};L=()=>{g.clearRect(0,0,W,H);for(i=0;i<=st.length;i++){b=i<st.length?st[i]:cur;g.fillStyle=i<st.length?'#48f':'#8cf';g.fillRect(b[0],H-100-i*h,b[1],h)}for(i=cu.length;i--;){o=cu[i];o[2]+=8;g.fillStyle='#777';g.fillRect(o[0],o[2],o[1],h);o[2]>H&&cu.splice(i,1)}if(!go){cur[0]+=cur[2];if(cur[0]<0||cur[0]+cur[1]>W){cur[2]=-cur[2];cur[0]=Math.max(0,Math.min(W-cur[1],cur[0]))}}};c.onclick=dn;L();setInterval(L,16)</script>