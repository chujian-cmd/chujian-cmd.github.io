<!doctype html><body style=margin:0;overflow:hidden;background:#111;touch-action:none><canvas id=c><script>c=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,B=[],Cx=W/2-50,Cw=100,V=3,S=0,D=0,O=0,Cy=H-130;r=_=>{B=[[W/2-50,H-100,100,'#f43']],Cx=W/2-50,Cw=100,V=3,S=0,D=0,O=0,Cy=H-130};r();ontouchstart=e=>{if(D){r();return}L=B[0],o=Math.min(Cx+Cw,L[0]+L[2])-Math.max(Cx,L[0]);if(o<=0){D=1;return}B.unshift([Math.max(Cx,L[0]),L[1]-30,o,'hsl('+(S*20)+',80%,60%)']);O+=30,Cy-=60;Cw=o,Cx=Math.random()*(W-Cw),V=(Math.random()<.5?1:-1)*(3+S/10),S++};setInterval(_=>{c.fillStyle='#111';c.fillRect(0,0,W,H);if(D){c.fillStyle='#fff';c.font='30px sans-serif';c.textAlign='center';c.fillText('GAME OVER',W/2,H/2-20);c.fillText('SC:'+S,W/2,H/2+30);c.fillText('Tap to retry',W/2,H/2+80);return}Cx+=V;if(Cx<0||Cx+Cw>W)V=-V;for(i=0;i<B.length;i++){b=B[i];c.fillStyle=b[3];c.fillRect(b[0],b[1]-O,b[2],30)}c.fillStyle='#fff';c.fillRect(Cx,Cy,Cw,30);c.fillStyle='#fff';c.font='20px sans-serif';c.textAlign='left';c.fillText('SC:'+S,20,40)},16)</script>