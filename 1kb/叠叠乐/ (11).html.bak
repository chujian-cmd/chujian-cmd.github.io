<!DOCTYPE html><meta name=viewport content=width=device-width><style>body{margin:0;background:#111}canvas{display:block;width:100vw;height:100vh;object-fit:contain}</style><canvas id=c width=400 height=800></canvas><script>c=document.getElementById('c');g=c.getContext('2d');W=400;H=800;h=30;d=0;go=0;cu=[];st=[[130,140]];nw=function(){var w=st[st.length-1][1];cur=[d?0:W-w,w,d*8-4];d=!d};nw();dn=function(){if(go){st=[[130,140]];go=0;cu=[];nw();return}var p=st[st.length-1],l=Math.max(cur[0],p[0]),r=Math.min(cur[0]+cur[1],p[0]+p[1]);if(r<=l){go=1;return}var y=H-100-st.length*h;if(cur[0]<l)cu.push([cur[0],l-cur[0],y]);if(cur[0]+cur[1]>r)cu.push([r,cur[0]+cur[1]-r,y]);st.push([l,r-l]);nw()};L=function(){g.clearRect(0,0,W,H);for(var i=0;i<=st.length;i++){var b=i<st.length?st[i]:cur;g.fillStyle=i<st.length?'#48f':'#8cf';g.fillRect(b[0],H-100-i*h,b[1],h)}for(var i=cu.length;i--;){var o=cu[i];o[2]+=8;g.fillStyle='#777';g.fillRect(o[0],o[2],o[1],h);if(o[2]>H)cu.splice(i,1)}if(!go){cur[0]+=cur[2];if(cur[0]<0||cur[0]+cur[1]>W){cur[2]=-cur[2];cur[0]=Math.max(0,Math.min(W-cur[1],cur[0]))}}};c.onclick=dn;L();setInterval(L,16)</script>