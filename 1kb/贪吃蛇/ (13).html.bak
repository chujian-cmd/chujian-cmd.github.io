<!DOCTYPE html><meta charset="UTF-8"><meta name=viewport content="width=device-width,initial-scale=1,user-scalable=no"><body style=margin:0;overflow:hidden;background:#111;touch-action:none><canvas id=c><script>
C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,G=20,sx=0,sy=0,M=Math;
r=_=>F=[~~(M.random()*W/G),~~(M.random()*H/G)];
R=_=>{S=[[5,5],[4,5],[3,5]],D=[1,0],r()};R();
ontouchstart=e=>{sx=e.touches[0].clientX;sy=e.touches[0].clientY};
ontouchmove=e=>{
  e.preventDefault();
  if(e.touches.length>1)return;
  x=e.touches[0].clientX-sx,y=e.touches[0].clientY-sy;
  if(M.abs(x)>M.abs(y)&&M.abs(x)>15){
    if(x>0&&D[0]!=-1)D=[1,0];
    if(x<0&&D[0]!=1)D=[-1,0];
    sx=e.touches[0].clientX;sy=e.touches[0].clientY;
  }else if(M.abs(y)>15){
    if(y>0&&D[1]!=-1)D=[0,1];
    if(y<0&&D[1]!=1)D=[0,-1];
    sx=e.touches[0].clientX;sy=e.touches[0].clientY;
  }
};
setInterval(_=>{
  hx=S[0][0]+D[0],hy=S[0][1]+D[1],e=(hx==F[0]&&hy==F[1]);
  if(hx<0||hx>=W/G||hy<0||hy>=H/G)return R();
  for(i=0;i<S.length-!e;i++)if(S[i][0]==hx&&S[i][1]==hy)return R();
  S.unshift([hx,hy]);
  if(e)r();else S.pop();
  C.fillStyle='#111';C.fillRect(0,0,W,H);
  C.fillStyle='#f43';C.fillRect(F[0]*G,F[1]*G,18,18);
  C.fillStyle='#3bf';for(i=0;i<S.length;i++)C.fillRect(S[i][0]*G,S[i][1]*G,18,18);
},120)
</script>