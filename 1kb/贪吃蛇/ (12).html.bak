<!doctype html><meta name=viewport content=width=device-width,user-scalable=0><body style=margin:0;overflow:hidden;background:#111;touch-action:none><canvas id=c><script>
C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,G=20,sx=0,sy=0,M=Math.random;
r=_=>F=[~~(M()*W/G),~~(M()*H/G)];
R=_=>{S=[[5,5],[4,5],[3,5]],D=[1,0],r()};R();
ontouchstart=e=>sx=e.touches[0].clientX,sy=e.touches[0].clientY;
ontouchmove=e=>{
  e.preventDefault(),x=e.touches[0].clientX-sx,y=e.touches[0].clientY-sy;
  if(x*x>y*y){if(x>15&&D[0]>-1)D=[1,0],sx+=x;if(x<-15&&D[0]<1)D=[-1,0],sx+=x}
  else{if(y>15&&D[1]>-1)D=[0,1],sy+=y;if(y<-15&&D[1]<1)D=[0,-1],sy+=y}
};
setInterval(_=>{
  hx=S[0][0]+D[0],hy=S[0][1]+D[1];
  if(hx<0||hx>=W/G||hy<0||hy>=H/G)return R();
  e=hx==F[0]&&hy==F[1];
  for(i=0;i<S.length-!e;i++)if(S[i][0]==hx&&S[i][1]==hy)return R();
  S.unshift([hx,hy]);
  e?r():S.pop();
  C.fillStyle='#111';C.fillRect(0,0,W,H);
  C.fillStyle='#f43';C.fillRect(F[0]*G,F[1]*G,18,18);
  C.fillStyle='#3bf';for(i of S)C.fillRect(i[0]*G,i[1]*G,18,18)
},100)
</script>