<!DOCTYPE html><meta charset="UTF-8"><meta name=viewport content="width=device-width,initial-scale=1,user-scalable=no"><body style=margin:0;overflow:hidden;background:#111;touch-action:none><canvas id=c></canvas><script>
C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,G=20,S=[[5,5]],D=[1,0],F=[10,10],tx=0,ty=0;
r=_=>{F=[~~(Math.random()*W/G),~~(Math.random()*H/G)]};r();
document.addEventListener('touchstart',e=>{tx=e.touches[0].clientX;ty=e.touches[0].clientY});
document.addEventListener('touchmove',e=>{
  e.preventDefault();let cx=e.touches[0].clientX,cy=e.touches[0].clientY,dx=cx-tx,dy=cy-ty;
  if(Math.abs(dx)>Math.abs(dy)){
    if(dx>15&&D[0]!=-1){D=[1,0];tx=cx;ty=cy}if(dx<-15&&D[0]!=1){D=[-1,0];tx=cx;ty=cy}
  }else{
    if(dy>15&&D[1]!=-1){D=[0,1];tx=cx;ty=cy}if(dy<-15&&D[1]!=1){D=[0,-1];tx=cx;ty=cy}
  }
},{passive:0});
setInterval(()=>{
  let h=[S[0][0]+D[0],S[0][1]+D[1]];
  if(h[0]<0||h[0]>=W/G||h[1]<0||h[1]>=H/G||S.some(p=>p[0]==h[0]&&p[1]==h[1])){
    S=[[5,5]];D=[1,0];r();return; // 这次有 return 了，绝对不卡死！
  }
  S.unshift(h);
  if(h[0]==F[0]&&h[1]==F[1])r();else S.pop();
  C.fillStyle='#111';C.fillRect(0,0,W,H);
  C.fillStyle='#f43';C.fillRect(F[0]*G,F[1]*G,G-2,G-2);
  C.fillStyle='#3bf';S.forEach(p=>C.fillRect(p[0]*G,p[1]*G,G-2,G-2));
},120);
</script>