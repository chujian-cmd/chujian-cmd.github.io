<!DOCTYPE html><meta charset=UTF-8><meta name=viewport content="width=device-width,initial-scale=1,user-scalable=no"><style>body{margin:0;overflow:hidden;background:#111;touch-action:none}canvas{display:block}</style><canvas id=c></canvas><script>
c=document.getElementById('c'),C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,G=20;
let S=[[5,5],[4,5],[3,5]],vx=1,vy=0,F=[10,10],tx,ty;
R=()=>F=[~~(Math.random()*W/G),~~(Math.random()*H/G)];R();
document.addEventListener('touchstart',e=>{tx=e.touches[0].clientX,ty=e.touches[0].clientY});
document.addEventListener('touchmove',e=>{
  e.preventDefault();let cx=e.touches[0].clientX,cy=e.touches[0].clientY,dx=cx-tx,dy=cy-ty;
  if(Math.abs(dx)>Math.abs(dy)){if(dx>15&&vx!=-1)vx=1,vy=0,tx=cx,ty=cy;if(dx<-15&&vx!=1)vx=-1,vy=0,tx=cx,ty=cy}
  else{if(dy>15&&vy!=-1)vx=0,vy=1,tx=cx,ty=cy;if(dy<-15&&vy!=1)vx=0,vy=-1,tx=cx,ty=cy}
},{passive:0});
setInterval(()=>{
  let h=[S[0][0]+vx,S[0][1]+vy];
  if(h[0]<0||h[0]>=W/G||h[1]<0||h[1]>=H/G||S.some(p=>p[0]==h[0]&&p[1]==h[1])){S=[[5,5],[4,5],[3,5]];vx=1;vy=0;R();return}
  S.unshift(h);if(h[0]==F[0]&&h[1]==F[1])R();else S.pop();
  C.fillStyle='#111';C.fillRect(0,0,W,H);
  C.fillStyle='#ef4444';C.fillRect(F[0]*G,F[1]*G,G-2,G-2);
  C.fillStyle='#3b82f6';S.forEach(p=>C.fillRect(p[0]*G,p[1]*G,G-2,G-2));
},100);
</script>