<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no"><style>body{margin:0;overflow:hidden;background:#111;touch-action:none}canvas{display:block}</style></head><body><canvas id="c"></canvas><script>var c=document.getElementById('c'),C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,G=20,GW=200,OX=(W-GW)/2,S=[],X=4,Y=0,P,tx=0,ty=0;function r(){X=4;Y=0;var t=Math.floor(Math.random()*4);P=[[1,1],[1,1]];if(t==1)P=[[1,1,1,1]];if(t==2)P=[[1,0],[1,0],[1,1]];if(t==3)P=[[0,1],[0,1],[1,1]]}function h(px,py){if(px<0||px+P[0].length>10)return 1;for(var i=0;i<P.length;i++){for(var j=0;j<P[i].length;j++){if(P[i][j]){if(py+i>=H/G)return 1;if(S[py+i]&&S[py+i][px+j])return 1}}}return 0}r();document.addEventListener('touchstart',function(e){e.preventDefault();if(e.touches&&e.touches[0]){tx=e.touches[0].clientX;ty=e.touches[0].clientY}},{passive:false});document.addEventListener('touchmove',function(e){e.preventDefault();if(e.touches&&e.touches[0]){var x=e.touches[0].clientX,y=e.touches[0].clientY;if(y-ty>30){while(!h(X,Y+1))Y++;ty=y}else if(Math.abs(x-tx)>20){if(x>tx&&!h(X+1,Y))X++;else if(x<tx&&!h(X-1,Y))X--;tx=x;ty=y}}},{passive:false});setInterval(function(){if(!h(X,Y+1)){Y++}else{for(var i=0;i<P.length;i++){for(var j=0;j<P[i].length;j++){if(P[i][j]){if(!S[Y+i])S[Y+i]=[];S[Y+i][X+j]=1}}}for(var i=0;i<S.length;i++){if(S[i]){var n=0;for(var j=0;j<10;j++){if(S[i][j])n++}if(n==10){S.splice(i,1);S.unshift([]);i--}}}r()}C.fillStyle='#111';C.fillRect(0,0,W,H);C.fillStyle='#333';C.fillRect(OX,0,GW,H);for(var i=0;i<S.length;i++){if(S[i]){for(var j=0;j<10;j++){if(S[i][j]){C.fillStyle='#f43';C.fillRect(OX+j*G,i*G,G-1,G-1)}}}}for(var i=0;i<P.length;i++){for(var j=0;j<P[i].length;j++){if(P[i][j]){C.fillStyle='#3bf';C.fillRect(OX+(X+j)*G,(Y+i)*G,G-1,G-1)}}}},400)</script></body></html>