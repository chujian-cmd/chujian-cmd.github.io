<!doctype html><body style="margin:0;overflow:hidden;background:#111;touch-action:none"><canvas id=c></canvas><script>var C=document.getElementById('c').getContext('2d');var W=c.width=innerWidth,H=c.height=innerHeight,G=20,S=[],X=0,Y=0,P,T=0;function r(){X=5;Y=0;P=[[1,1],[1,1]];T=~~(Math.random()*4);if(T==1)P=[[1,1,1,1]];if(T==2)P=[[1,0],[1,0],[1,1]];if(T==3)P=[[0,1],[0,1],[1,1]]}function hit(x,y){for(var i=0;i<P.length;i++){for(var j=0;j<P[i].length;j++){if(P[i][j]){if(y+i>=H/G)return 1;if(S[y+i]&&S[y+i][x+j])return 1}}}return 0}r();document.addEventListener('touchstart',function(e){e.preventDefault();var x=e.touches[0].clientX;if(x<W/2&&!hit(X-1,Y)){X--}else if(x>=W/2&&!hit(X+1,Y)){X++}});setInterval(function(){if(!hit(X,Y+1)){Y++}else{for(var i=0;i<P.length;i++){for(var j=0;j<P[i].length;j++){if(P[i][j]){if(!S[Y+i])S[Y+i]=[];S[Y+i][X+j]=1}}}for(var i=0;i<S.length;i++){var n=0;if(S[i]){for(var j=0;j<10;j++){if(S[i][j])n++}}if(n==10){S.splice(i,1);S.unshift([])}}r()}C.fillStyle='#111';C.fillRect(0,0,W,H);C.fillStyle='#333';C.fillRect(W/2-10*G,0,10*G,H);for(var i=0;i<S.length;i++){if(S[i]){for(var j=0;j<10;j++){if(S[i][j]){C.fillStyle='#f43';C.fillRect(W/2-10*G+j*G,i*G,G-1,G-1)}}}}if(P){for(var i=0;i<P.length;i++){for(var j=0;j<P[i].length;j++){if(P[i][j]){C.fillStyle='#3bf';C.fillRect(W/2-10*G+(X+j)*G,(Y+i)*G,G-1,G-1)}}}}},400)</script>