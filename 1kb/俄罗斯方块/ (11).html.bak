<!doctype html><body style="margin:0;overflow:hidden;background:#111;touch-action:none"><canvas id=c></canvas><script>
c=document.getElementById('c'),C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,G=20,O=(W-200)/2,S=[],P,X=4,Y=0,T=0;
r=_=>{X=4,Y=0,P=[[1,1],[1,1]],t=~~(Math.random()*3);if(t==1)P=[[1,1,1,1]];if(t==2)P=[[1,0],[1,0],[1,1]]};r();
h=(px,py)=>{if(px<0||px+P[0].length>10)return 1;for(i=0;i<P.length;i++)for(j=0;j<P[i].length;j++)if(P[i][j]&&(py+i>=H/G||S[py+i]&&S[py+i][px+j]))return 1;return 0};
sx=0;ontouchstart=e=>{sx=e.touches[0].clientX};ontouchmove=e=>{e.preventDefault();dx=e.touches[0].clientX-sx;if(dx>20&&!h(X+1,Y))X++,sx+=dx;if(dx<-20&&!h(X-1,Y))X--,sx+=dx};ontouchend=e=>{if(!h(X,Y+1)){for(k=0;k<30;k++){if(h(X,Y+1))break;Y++}}};
setInterval(_=>{if(!h(X,Y+1))Y++;else{for(i=0;i<P.length;i++)for(j=0;j<P[i].length;j++)if(P[i][j]){if(!S[Y+i])S[Y+i]=[];S[Y+i][X+j]=1}for(i=0;i<S.length;i++)if(S[i]&&S[i].filter(v=>v).length==10)S.splice(i,1),S.unshift([]);r()}C.fillStyle='#111',C.fillRect(0,0,W,H),C.fillStyle='#333',C.fillRect(O,0,200,H);C.fillStyle='#f43';for(i=0;i<S.length;i++)if(S[i])for(j=0;j<10;j++)if(S[i][j])C.fillRect(O+j*G,i*G,G-1,G-1);C.fillStyle='#3bf';for(i=0;i<P.length;i++)for(j=0;j<P[i].length;j++)if(P[i][j])C.fillRect(O+(X+j)*G,(Y+i)*G,G-1,G-1)},400);
</script>