<!doctype html><body style=margin:0;overflow:hidden;background:#000;touch-action:none><canvas id=c><script>
C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,PX=W/2,PY=H-50,S=0,B=[],E=[],GT=0,T=0;
ontouchstart=function(e){e.preventDefault();if(GT){GT=0;S=0;E=[];B=[]}else if(e.touches[0]){PX=e.touches[0].clientX;PY=e.touches[0].clientY}};
ontouchmove=function(e){e.preventDefault();if(e.touches[0]){PX=e.touches[0].clientX;PY=e.touches[0].clientY}};
setInterval(function(){
if(GT){C.fillStyle='#000';C.fillRect(0,0,W,H);C.fillStyle='#fff';C.font='30px sans-serif';C.textAlign='center';C.fillText('GAME OVER',W/2,H/2-20);C.fillText('SC:'+S,W/2,H/2+30);C.fillText('Tap to restart',W/2,H/2+80);C.textAlign='left';return}
C.fillStyle='#000';C.fillRect(0,0,W,H);T++;
if(T%5==0)B.push([PX,PY-20]);
C.fillStyle='#fff';
for(i=B.length-1;i>=0;i--){b=B[i];b[1]-=12;C.fillRect(b[0]-2,b[1],4,10);if(b[1]<-10)B.splice(i,1)}
if(T%30==0)E.push([Math.random()*(W-40)+20,-20]);
C.fillStyle='#f43';
for(i=E.length-1;i>=0;i--){e=E[i];e[1]+=4;C.fillRect(e[0]-15,e[1],30,30);
if(Math.abs(e[0]-PX)<25&&Math.abs(e[1]-PY)<25)GT=1;
if(e[1]>H)E.splice(i,1);
for(j=B.length-1;j>=0;j--){b=B[j];if(Math.abs(e[0]-b[0])<20&&Math.abs(e[1]-b[1])<20){S++;E.splice(i,1);B.splice(j,1);break}}}
C.fillStyle='#3bf';C.beginPath();C.moveTo(PX,PY-20);C.lineTo(PX-20,PY+20);C.lineTo(PX+20,PY+20);C.fill();
C.fillStyle='#fff';C.font='20px sans-serif';C.fillText('SC: '+S,10,30)
},30)
</script>