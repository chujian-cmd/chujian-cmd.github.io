<!doctype html><body style="margin:0;overflow:hidden;background:#222;touch-action:none"><canvas id=c><script>C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,F=[],T=[],S=0,G=0;ontouchstart=ontouchmove=function(e){e.preventDefault();for(var i=0;i<e.touches.length;i++){t=e.touches[i];T.push({x:t.clientX,y:t.clientY,l:1})}};setInterval(function(){if(G){C.fillStyle='#222';C.fillRect(0,0,W,H);C.fillStyle='#fff';C.font='30px sans-serif';C.textAlign='center';C.fillText('BOOM!',W/2,H/2-20);C.fillText('SC:'+S,W/2,H/2+30);C.fillText('Tap to retry',W/2,H/2+80);C.textAlign='left';if(T.length){G=0;S=0;F=[];T=[]}return}C.fillStyle='#222';C.fillRect(0,0,W,H);if(Math.random()<.05){var b=Math.random()<.2;F.push({x:Math.random()*W,y:H+20,vx:(Math.random()-.5)*6,vy:-Math.random()*8-10,c:b?'#000':'#f43',b:b,r:b?15:25})}C.fillStyle='#fff';for(i=T.length-1;i>=0;i--){t=T[i];t.l-=.1;if(t.l<=0){T.splice(i,1);continue}C.globalAlpha=t.l;C.beginPath();C.arc(t.x,t.y,5,0,7);C.fill()}C.globalAlpha=1;for(i=F.length-1;i>=0;i--){f=F[i];f.x+=f.vx;f.y+=f.vy;f.vy+=.3;for(j=0;j<T.length;j++){t=T[j];if(Math.abs(f.x-t.x)<f.r&&Math.abs(f.y-t.y)<f.r){if(f.b){G=1;break}else{S++;F.splice(i,1);break}}}if(G)break;if(f.y>H+50){F.splice(i,1);continue}C.fillStyle=f.c;C.beginPath();C.arc(f.x,f.y,f.r,0,7);C.fill();if(f.b){C.fillStyle='#ff0';C.fillRect(f.x-2,f.y-f.r-10,4,10)}}if(!G){C.fillStyle='#fff';C.font='20px sans-serif';C.fillText('SC:'+S,20,30)}},16)</script>