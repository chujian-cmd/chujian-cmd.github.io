<meta name=viewport content=width=device-width>
<body style=margin:0;touch-action:none><canvas id=c></canvas><script>
C=c.getContext`2d`;F=[];P=[];S=0;c.width=innerWidth;c.height=innerHeight;onresize=()=>{c.width=innerWidth;c.height=innerHeight};
onpointermove=e=>{P.push({x:e.clientX,y:e.clientY,l:9});for(i=F.length;i--;)f=F[i],(f.x-e.clientX)**2+(f.y-e.clientY)**2<f.r*f.r*1.6&&(S++,F.splice(i,1))};
setInterval(()=>{
C.clearRect(0,0,c.width,c.height);
Math.random()<.04&&F.push({x:Math.random()*c.width,y:c.height+40,vx:(Math.random()-.5)*6,vy:-Math.random()*7-15,r:22+Math.random()*10});
for(i=F.length;i--;){f=F[i];f.x+=f.vx;f.y+=f.vy;f.vy+=.45;C.beginPath();C.fillStyle=`hsl(${f.r*9},80%,55%)`;C.arc(f.x,f.y,f.r,0,7);C.fill();f.y>c.height+90&&F.splice(i,1)}
for(i=P.length;i--;){p=P[i];if(p.l--<0){P.splice(i,1);continue}C.beginPath();C.fillStyle=`rgba(255,255,255,${p.l/9})`;C.arc(p.x,p.y,p.l,0,7);C.fill()}
C.fillStyle="#fff";C.font="30px a";C.fillText(S,20,50)
},16)
</script>