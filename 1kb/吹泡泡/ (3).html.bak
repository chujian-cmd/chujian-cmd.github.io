<!DOCTYPE html><meta charset=UTF-8><meta name=viewport content="width=device-width,initial-scale=1,user-scalable=no"><title>🫧</title><style>body{margin:0;overflow:hidden;background:linear-gradient(#001,#012);touch-action:none}canvas{display:block}</style><canvas id=c></canvas><script>c=document.getElementById('c'),C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,A=[],onresize=_=>{W=c.width=innerWidth,H=c.height=innerHeight},addEventListener('touchmove',e=>{e.preventDefault();for(t of e.touches)for(i=0;i<3;i++)A.push([t.clientX+(Math.random()-.5)*30,t.clientY+(Math.random()-.5)*30,(Math.random()-.5)*2,-Math.random()*2-1,Math.random()*30+10,`hsl(${Math.random()*360},80%,70%)`,1])},{passive:0}),setInterval(_=>{C.clearRect(0,0,W,H);A=A.filter(p=>{p[0]+=p[2],p[1]+=p[3],p[5]*=.98,C.globalAlpha=p[5],C.strokeStyle=p[6],C.lineWidth=2,C.beginPath(),C.arc(p[0],p[1],p[4]*p[5],0,7),C.stroke();return p[1]>-50&&p[5]>.05})},16)</script>