<!doctype html><body style="margin:0;overflow:hidden;background:#111;touch-action:none"><canvas id=c><script>C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,PX=W/2,BX=W/2,BY=H-100,VX=3,VY=-3,SC=0,BK=[];for(i=0;i<8;i++)for(j=0;j<4;j++)BK.push({x:i*W/8,y:j*25+40,w:W/8-4,h:20,l:1});ontouchstart=ontouchmove=function(e){e.preventDefault();var t=e.touches[0];if(t){PX=t.clientX;if(PX<40)PX=40;if(PX>W-40)PX=W-40}};setInterval(function(){if(BY>H){SC=0;BY=H-100;VY=-3;BX=W/2;for(i=0;i<BK.length;i++)BK[i].l=1}BX+=VX;BY+=VY;if(BX<10||BX>W-10)VX=-VX;if(BY<10)VY=-VY;if(BY>H-30&&BY<H-10&&BX>PX-40&&BX<PX+40)VY=-Math.abs(VY);for(i=BK.length-1;i>=0;i--){b=BK[i];if(b.l&&BX>b.x&&BX<b.x+b.w&&BY>b.y&&BY<b.y+b.h){b.l=0;VY=-VY;SC+=10;break}}C.clearRect(0,0,W,H);C.fillStyle='#fff';C.fillRect(PX-40,H-20,80,10);C.beginPath();C.arc(BX,BY,6,0,7);C.fill();for(i=0;i<BK.length;i++){b=BK[i];if(b.l){C.fillStyle='hsl('+b.x/W*360+',80%,60%)';C.fillRect(b.x,b.y,b.w,b.h)}}C.fillStyle='#fff';C.font='20px sans-serif';C.fillText('SC:'+SC,20,30)},16)</script>