<!doctype html><body style=margin:0;overflow:hidden;background:#111;touch-action:none><canvas id=c><script>C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,P=W/2,X=W/2,Y=H-100,V=3,U=-3,S=0,B=[];for(i=0;i<32;i++)B.push({x:i%8*W/8,y:~~(i/8)*25+40,w:W/8-4,h:20,l:1});ontouchstart=ontouchmove=function(e){e.preventDefault();if(t=e.touches[0])P=Math.max(40,Math.min(t.clientX,W-40))};setInterval(function(){if(Y>H){S=0,Y=H-100,U=-3,X=W/2;for(i=0;i<32;i++)B[i].l=1}X+=V,Y+=U;if(X<10||X>W-10)V=-V;if(Y<10)U=-U;if(Y>H-30&&X>P-40&&X<P+40)U=-Math.abs(U);for(i=31;i>=0;i--){b=B[i];if(b.l&&X>b.x&&X<b.x+b.w&&Y>b.y&&Y<b.y+b.h)b.l=0,U=-U,S+=10,V=V}C.clearRect(0,0,W,H),C.fillStyle='#fff',C.fillRect(P-40,H-20,80,10),C.beginPath(),C.arc(X,Y,6,0,7),C.fill();for(i=0;i<32;i++){b=B[i];if(b.l)C.fillStyle=`hsl(${b.x} 80% 60%)`,C.fillRect(b.x,b.y,b.w,b.h)}C.fillStyle='#fff',C.font='20px sans-serif',C.fillText('SC:'+S,20,30)},16)</script>