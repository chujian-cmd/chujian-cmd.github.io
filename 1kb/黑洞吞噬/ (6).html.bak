<!doctype html><body style=margin:0;overflow:hidden;background:#222;touch-action:none><canvas id=c><script>C=c.getContext('2d'),W=c.width=innerWidth,H=c.height=innerHeight,X=W/2,Y=H/2,R=20,S=0,F=[],T=0;ontouchstart=ontouchmove=e=>{e.preventDefault();X=e.touches[0].clientX;Y=e.touches[0].clientY};setInterval(_=>{T++;C.fillStyle='#222';C.fillRect(0,0,W,H);if(T%20==0)F.push({x:Math.random()*W,y:-20,s:Math.random()*60+10});C.fillStyle='#fff';for(i=F.length-1;i>=0;i--){f=F[i];f.y+=2+f.s/50;if(Math.hypot(f.x-X,f.y-Y)<R+f.s/2){if(R>f.s){S+=f.s;R+=f.s/50;F.splice(i,1);continue}else{R=20;S=0;F=[];break}}C.fillStyle=`hsl(${f.s*5},80%,60%)`;C.beginPath();C.arc(f.x,f.y,f.s/2,0,7);C.fill()}C.fillStyle='#000';C.beginPath();C.arc(X,Y,R,0,7);C.fill();C.strokeStyle='#fff';C.lineWidth=2;C.stroke();C.fillStyle='#fff';C.font='20px sans-serif';C.fillText('SC:'+S,20,30)},16)</script>