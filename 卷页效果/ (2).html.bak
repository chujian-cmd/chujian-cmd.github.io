<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>自动卷页翻书</title>
<style>
  html, body {
    margin: 0; height: 100%;
    background: #2b2b2b;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    font-family: "Georgia", "Songti SC", serif;
    overflow: hidden;
  }
  #book {
    position: relative;
    width: 900px; height: 600px;
    max-width: 94vw; max-height: 78vh;
    box-shadow: 0 20px 60px rgba(0,0,0,.6);
    border-radius: 4px;
    overflow: hidden;
    background: #f5f0e6;
    user-select: none;
  }
  canvas { display: block; width: 100%; height: 100%; }
  #pageNum {
    position: absolute; bottom: 14px; right: 24px;
    color: #888; font-size: 14px; font-family: system-ui, sans-serif;
    pointer-events: none;
  }
  #controls {
    margin-top: 18px;
    display: flex; gap: 14px; align-items: center;
    font-family: system-ui, sans-serif;
  }
  button {
    padding: 10px 22px;
    font-size: 16px;
    border: none; border-radius: 8px;
    background: #f0e6d2; color: #3a3228;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(0,0,0,.4);
    transition: transform .1s, background .2s;
  }
  button:hover { background: #fff6e2; }
  button:active { transform: scale(.96); }
  button:disabled { opacity: .4; cursor: default; }
</style>
</head>
<body>
<div id="book">
  <canvas id="cv"></canvas>
  <div id="pageNum"></div>
</div>
<div id="controls">
  <button id="prevBtn">← 上一页</button>
  <button id="nextBtn">下一页 →</button>
</div>

<script>
(() => {
  const book = document.getElementById('book');
  const cv = document.getElementById('cv');
  const ctx = cv.getContext('2d');
  const pageNumEl = document.getElementById('pageNum');
  const prevBtn = document.getElementById('prevBtn');
  const nextBtn = document.getElementById('nextBtn');

  // ---------- 页面内容 ----------
  const pages = [
    { title: '第一章 · 起点', lines: [
      '那是一个安静的下午，',
      '电脑屏幕泛着微微的光。',
      '我翻开一本电子书，',
      '页角从右下角轻轻卷起，',
      '带着柔和的阴影，',
      '翻到了下一页。'
    ]},
    { title: '第二章 · 卷页', lines: [
      '纸页不是整块平移，',
      '而是像被指尖掀起，',
      '沿着对角线卷曲，',
      '背面透出淡淡的字影。',
      '翻过去的页，',
      '在下一页上投下阴影。'
    ]},
    { title: '第三章 · 回翻', lines: [
      '向左翻时，',
      '页角从左下角掀起，',
      '同样带着卷曲与阴影，',
      '回到上一页。',
      '这种真实感，',
      '让人久久难忘。'
    ]},
    { title: '第四章 · 尾声', lines: [
      '如今用 HTML 也能还原，',
      'Canvas 绘制卷页，',
      '渐变模拟明暗，',
      '阴影随角度变化。',
      '翻页之间，',
      '仿佛又回到那个下午。'
    ]}
  ];

  let W = 0, H = 0, DPR = 1;
  let current = 0;
  let anim = null;      // { from, to, dir, t }
  let busy = false;

  function resize() {
    const r = book.getBoundingClientRect();
    DPR = Math.min(window.devicePixelRatio || 1, 2);
    W = r.width; H = r.height;
    cv.width = Math.round(W * DPR);
    cv.height = Math.round(H * DPR);
    ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    draw();
  }

  // ---------- 绘制单页 ----------
  function drawPage(page, x, y, w, h) {
    ctx.save();
    ctx.beginPath();
    ctx.rect(x, y, w, h);
    ctx.clip();

    const g = ctx.createLinearGradient(x, y, x + w, y + h);
    g.addColorStop(0, '#fbf7ee');
    g.addColorStop(1, '#efe7d6');
    ctx.fillStyle = g;
    ctx.fillRect(x, y, w, h);

    const edge = ctx.createLinearGradient(x, y, x, y + h);
    edge.addColorStop(0, 'rgba(0,0,0,.05)');
    edge.addColorStop(0.1, 'rgba(0,0,0,0)');
    edge.addColorStop(0.9, 'rgba(0,0,0,0)');
    edge.addColorStop(1, 'rgba(0,0,0,.08)');
    ctx.fillStyle = edge;
    ctx.fillRect(x, y, w, h);

    if (page) {
      const pad = Math.round(w * 0.08);
      ctx.fillStyle = '#3a3228';
      ctx.font = `bold ${Math.round(w * 0.032)}px Georgia, "Songti SC", serif`;
      ctx.textBaseline = 'top';
      ctx.fillText(page.title, x + pad, y + pad);

      ctx.fillStyle = '#4a4238';
      ctx.font = `${Math.round(w * 0.024)}px Georgia, "Songti SC", serif`;
      const lh = Math.round(w * 0.045);
      page.lines.forEach((line, i) => {
        ctx.fillText(line, x + pad, y + pad + Math.round(w * 0.06) + i * lh);
      });

      ctx.fillStyle = '#9a8f7c';
      ctx.font = `${Math.round(w * 0.02)}px system-ui, sans-serif`;
      ctx.textAlign = 'center';
      ctx.fillText(String(current + 1), x + w / 2, y + h - pad * 0.7);
      ctx.textAlign = 'left';
    }
    ctx.restore();
  }

  // ---------- 几何辅助 ----------
  function lineRectIntersections(cx, cy, nx, ny, x0, y0, x1, y1) {
    const pts = [];
    const eps = 1e-6;
    const edges = [
      { x: x0, y: y0, dx: x1-x0, dy: 0 },
      { x: x1, y: y0, dx: 0, dy: y1-y0 },
      { x: x1, y: y1, dx: x0-x1, dy: 0 },
      { x: x0, y: y1, dx: 0, dy: y0-y1 }
    ];
    for (const e of edges) {
      const det = nx * (-e.dy) - ny * (-e.dx);
      if (Math.abs(det) < eps) continue;
      const rx = e.x - cx, ry = e.y - cy;
      const t = (rx * (-e.dy) - ry * (-e.dx)) / det;
      const s = (nx * ry - ny * rx) / det;
      if (s >= -eps && s <= 1 + eps) {
        const px = cx + t * nx, py = cy + t * ny;
        if (px >= x0 - eps && px <= x1 + eps && py >= y0 - eps && py <= y1 + eps) {
          if (!pts.some(p => Math.hypot(p.x - px, p.y - py) < 0.5)) {
            pts.push({ x: px, y: py });
          }
        }
      }
    }
    return pts;
  }

  function clipRectByLine(x0, y0, x1, y1, A, B, keepSide) {
    ctx.beginPath();
    const side = (x, y) => (x - A.x) * (B.y - A.y) - (y - A.y) * (B.x - A.x);
    const corners = [
      { x: x0, y: y0 }, { x: x1, y: y0 },
      { x: x1, y: y1 }, { x: x0, y: y1 }
    ];
    const keepPts = [];
    for (let i = 0; i < 4; i++) {
      const p = corners[i], q = corners[(i + 1) % 4];
      const sp = Math.sign(side(p.x, p.y));
      const sq = Math.sign(side(q.x, q.y));
      if (sp === keepSide || sp === 0) keepPts.push(p);
      if (sp !== sq && sp !== 0 && sq !== 0) {
        const t = side(p.x, p.y) / (side(p.x, p.y) - side(q.x, q.y));
        keepPts.push({ x: p.x + (q.x - p.x) * t, y: p.y + (q.y - p.y) * t });
      }
    }
    if (keepPts.length === 0) {
      ctx.rect(0, 0, 0, 0);
    } else {
      ctx.moveTo(keepPts[0].x, keepPts[0].y);
      for (let i = 1; i < keepPts.length; i++) ctx.lineTo(keepPts[i].x, keepPts[i].y);
      ctx.closePath();
    }
    ctx.clip();
  }

  function buildFlapPolygon(x0, y0, x1, y1, A, B, cornerX, cornerY, px, py, cornerSide) {
    const side = (x, y) => (x - A.x) * (B.y - A.y) - (y - A.y) * (B.x - A.x);
    const corners = [
      { x: x0, y: y0 }, { x: x1, y: y0 },
      { x: x1, y: y1 }, { x: x0, y: y1 }
    ];
    const pts = [];
    for (let i = 0; i < 4; i++) {
      const p = corners[i], q = corners[(i + 1) % 4];
      const sp = Math.sign(side(p.x, p.y));
      const sq = Math.sign(side(q.x, q.y));
      if (sp === cornerSide) pts.push(p);
      if (sp !== sq && sp !== 0 && sq !== 0) {
        const t = side(p.x, p.y) / (side(p.x, p.y) - side(q.x, q.y));
        pts.push({ x: p.x + (q.x - p.x) * t, y: p.y + (q.y - p.y) * t });
      }
    }
    pts.push({ x: px, y: py });
    const cx = cornerX, cy = cornerY;
    pts.sort((a, b) => Math.atan2(a.y - cy, a.x - cx) - Math.atan2(b.y - cy, b.x - cx));
    return pts;
  }

  // ---------- 核心：绘制卷页 ----------
  function drawCurl(fromPage, toPage, dir, t) {
    const w = W, h = H;
    drawPage(toPage, 0, 0, w, h);

    const cornerX = dir === 1 ? w : 0;
    const cornerY = h;

    // 自动动画：页角从角落沿对角线向中心卷起
    const ease = t < 0.5 ? 2*t*t : 1-Math.pow(-2*t+2,2)/2;
    const maxDist = Math.hypot(w, h) * 0.85;
    const dist = ease * maxDist;
    const ang = Math.atan2(-h, dir === 1 ? -w : w);
    const px = cornerX + Math.cos(ang) * dist;
    const py = cornerY + Math.sin(ang) * dist;

    const cx = (cornerX + px) / 2;
    const cy = (cornerY + py) / 2;
    const dx = px - cornerX;
    const dy = py - cornerY;
    const len = Math.hypot(dx, dy) || 1;
    const nx = -dy / len;
    const ny = dx / len;

    const foldPts = lineRectIntersections(cx, cy, nx, ny, 0, 0, w, h);
    if (foldPts.length < 2) {
      drawPage(fromPage, 0, 0, w, h);
      return;
    }
    const [A, B] = foldPts;

    const side = (x, y) => (x - A.x) * (B.y - A.y) - (y - A.y) * (B.x - A.x);
    const cornerSide = Math.sign(side(cornerX, cornerY));

    // 未翻起部分
    ctx.save();
    ctx.beginPath();
    clipRectByLine(0, 0, w, h, A, B, -cornerSide);
    drawPage(fromPage, 0, 0, w, h);
    ctx.restore();

    // 卷起页片
    const flapPoly = buildFlapPolygon(0, 0, w, h, A, B, cornerX, cornerY, px, py, cornerSide);
    const ddx = B.x - A.x, ddy = B.y - A.y;
    const dlen2 = ddx*ddx + ddy*ddy || 1;
    const mirror = (x, y) => {
      const vx = x - A.x, vy = y - A.y;
      const proj = (vx*ddx + vy*ddy) / dlen2;
      const projX = A.x + proj*ddx;
      const projY = A.y + proj*ddy;
      return { x: 2*projX - x, y: 2*projY - y };
    };

    ctx.save();
    ctx.beginPath();
    const mirrored = flapPoly.map(p => mirror(p.x, p.y));
    ctx.moveTo(mirrored[0].x, mirrored[0].y);
    for (let i = 1; i < mirrored.length; i++) {
      ctx.lineTo(mirrored[i].x, mirrored[i].y);
    }
    ctx.closePath();
    ctx.clip();

    const bg = ctx.createLinearGradient(A.x, A.y, px, py);
    bg.addColorStop(0, '#e8dfcc');
    bg.addColorStop(0.6, '#d8ccb4');
    bg.addColorStop(1, '#c9bda3');
    ctx.fillStyle = bg;
    ctx.fillRect(0, 0, w, h);

    // 背面透印
    ctx.globalAlpha = 0.16;
    ctx.fillStyle = '#5a4f3f';
    ctx.font = `${Math.round(w * 0.022)}px Georgia, serif`;
    for (let i = 0; i < 6; i++) {
      ctx.fillText('透印文字 · 背面', w * 0.12, h * 0.25 + i * w * 0.04);
    }
    ctx.globalAlpha = 1;

    // 卷曲明暗
    const shade = ctx.createLinearGradient(px, py, cx, cy);
    shade.addColorStop(0, 'rgba(255,255,255,0.45)');
    shade.addColorStop(0.5, 'rgba(255,255,255,0.05)');
    shade.addColorStop(1, 'rgba(0,0,0,0.25)');
    ctx.fillStyle = shade;
    ctx.fillRect(0, 0, w, h);

    // 卷边高光
    ctx.strokeStyle = 'rgba(255,255,255,0.55)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(mirrored[0].x, mirrored[0].y);
    for (let i = 1; i < mirrored.length; i++) {
      ctx.lineTo(mirrored[i].x, mirrored[i].y);
    }
    ctx.stroke();
    ctx.restore();

    // 投影
    ctx.save();
    ctx.globalCompositeOperation = 'multiply';
    const shadowGrad = ctx.createLinearGradient(cx, cy, px, py);
    shadowGrad.addColorStop(0, 'rgba(0,0,0,0)');
    shadowGrad.addColorStop(0.4, 'rgba(0,0,0,0.12)');
    shadowGrad.addColorStop(1, 'rgba(0,0,0,0.28)');
    ctx.fillStyle = shadowGrad;
    ctx.beginPath();
    const sh = flapPoly.map(p => mirror(p.x, p.y));
    ctx.moveTo(sh[0].x, sh[0].y);
    for (let i = 1; i < sh.length; i++) ctx.lineTo(sh[i].x, sh[i].y);
    ctx.closePath();
    ctx.fill();
    ctx.restore();

    // 折痕
    ctx.save();
    ctx.strokeStyle = 'rgba(0,0,0,0.08)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(A.x, A.y);
    ctx.lineTo(B.x, B.y);
    ctx.stroke();
    ctx.restore();
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    if (anim) {
      drawCurl(pages[anim.from], pages[anim.to], anim.dir, anim.t);
      pageNumEl.textContent = `${anim.from + 1} / ${pages.length}`;
    } else {
      drawPage(pages[current], 0, 0, W, H);
      pageNumEl.textContent = `${current + 1} / ${pages.length}`;
    }
    prevBtn.disabled = busy || current === 0;
    nextBtn.disabled = busy || current === pages.length - 1;
  }

  // ---------- 自动翻页动画 ----------
  function flip(dir) {
    if (busy) return;
    const to = current + dir;
    if (to < 0 || to >= pages.length) return;
    busy = true;
    anim = { from: current, to, dir, t: 0 };
    const start = performance.now();
    const dur = 750;
    function step(now) {
      const p = Math.min(1, (now - start) / dur);
      anim.t = p;
      draw();
      if (p < 1) {
        requestAnimationFrame(step);
      } else {
        current = to;
        anim = null;
        busy = false;
        draw();
      }
    }
    requestAnimationFrame(step);
  }

  nextBtn.addEventListener('click', () => flip(1));
  prevBtn.addEventListener('click', () => flip(-1));
  window.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') flip(1);
    if (e.key === 'ArrowLeft') flip(-1);
  });

  window.addEventListener('resize', resize);
  resize();
})();
</script>
</body>
</html>