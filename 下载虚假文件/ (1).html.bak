<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>极速浏览器 · 应用下载</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
  body {
    min-height:100vh;
    background: linear-gradient(145deg, #0b1a2e 0%, #1a2f3f 100%);
    display:flex; align-items:center; justify-content:center;
    padding:20px; position:relative; overflow-x:hidden;
  }
  body::before {
    content:''; position:absolute; width:500px; height:500px;
    background: radial-gradient(circle, rgba(0,180,255,0.15) 0%, transparent 70%);
    top:-150px; right:-150px; border-radius:50%; pointer-events:none;
  }
  body::after {
    content:''; position:absolute; width:400px; height:400px;
    background: radial-gradient(circle, rgba(100,0,255,0.1) 0%, transparent 70%);
    bottom:-100px; left:-100px; border-radius:50%; pointer-events:none;
  }

  .card {
    width:100%; max-width:480px;
    background: rgba(22,34,48,0.85);
    backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
    border-radius: 40px;
    padding: 40px 28px 36px;
    box-shadow: 0 30px 50px rgba(0,0,0,0.7), 0 0 0 1px rgba(0,255,255,0.12) inset;
    border: 1px solid rgba(0,255,255,0.2);
    position:relative; z-index:10;
  }

  .app-icon {
    width:96px; height:96px;
    background: linear-gradient(135deg, #2b9aff, #6f4aff);
    border-radius:28px; margin:0 auto 20px;
    display:flex; align-items:center; justify-content:center;
    font-size:44px; font-weight:800; color:white;
    text-shadow:0 4px 12px rgba(0,0,0,0.5);
    box-shadow:0 15px 30px -6px rgba(43,154,255,0.5), 0 0 0 2px rgba(255,255,255,0.2) inset;
  }
  .app-icon span { transform: rotate(-2deg); }

  .app-name {
    font-size:30px; font-weight:700; text-align:center;
    color:#f0f9ff; letter-spacing:-0.5px;
    text-shadow:0 2px 10px rgba(0,200,255,0.4);
    margin-bottom:8px;
  }
  .app-sub {
    text-align:center; color:#9bb8d4; font-size:15px;
    margin-bottom:24px;
  }

  .file-info {
    display:flex; justify-content:space-between;
    background: rgba(0,0,0,0.3);
    border-radius:16px; padding:14px 18px;
    margin-bottom:22px;
    border:1px solid rgba(255,255,255,0.05);
    font-size:14px; color:#9bb8d4;
  }
  .file-info .val { color:#e0f2ff; font-weight:600; }

  /* 浏览器风格下载条 */
  .browser-download-bar {
    background: #202b38;
    border-radius: 12px;
    padding: 14px 16px;
    margin-bottom: 20px;
    border: 1px solid #2e4154;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 6px 16px rgba(0,0,0,0.4);
  }

  .file-icon {
    width: 40px; height: 40px;
    background: linear-gradient(135deg, #00c6ff, #0072ff);
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px; flex-shrink: 0;
  }

  .file-details {
    flex: 1;
    min-width: 0;
  }

  .file-name {
    color: #eaf4ff;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 4px;
  }

  .file-size-line {
    font-size: 12px;
    color: #7a9cbb;
    display: flex;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .bar-bg {
    height: 6px;
    background: #0e1a26;
    border-radius: 6px;
    overflow: hidden;
  }

  .bar-fill {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #00e0ff, #2b9aff);
    border-radius: 6px;
    transition: width 0.1s linear;
    box-shadow: 0 0 10px #2b9aff;
  }

  .check-icon {
    width: 28px; height: 28px;
    border-radius: 50%;
    background: #22c55e;
    display: flex; align-items: center; justify-content: center;
    color: white; font-size: 16px; font-weight: bold;
    flex-shrink: 0;
    opacity: 0;
    transform: scale(0.5);
    transition: all 0.25s cubic-bezier(0.34,1.56,0.64,1);
  }
  .check-icon.show {
    opacity: 1;
    transform: scale(1);
  }

  .status-msg {
    text-align:center;
    font-size:14px;
    color:#8ba9c7;
    min-height: 28px;
    margin-bottom: 16px;
    transition: all 0.2s;
  }
  .status-msg.done {
    color:#6ee7b7;
    font-weight: 600;
    text-shadow: 0 0 12px rgba(110,231,183,0.4);
  }

  .download-btn {
    width:100%;
    background: linear-gradient(135deg, #0066ff, #6f4aff);
    border:none; border-radius:60px;
    padding:18px 20px;
    font-size:18px; font-weight:700; color:white;
    display:flex; align-items:center; justify-content:center; gap:10px;
    cursor:pointer;
    box-shadow:0 20px 30px -8px rgba(0,120,255,0.7), 0 0 0 1px rgba(255,255,255,0.2) inset;
    transition: all 0.2s ease;
    letter-spacing: 0.5px;
  }
  .download-btn:hover:not(:disabled) { transform: translateY(-2px); box-shadow:0 25px 35px -6px rgba(0,120,255,0.9); }
  .download-btn:active:not(:disabled) { transform: translateY(1px); }
  .download-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    background: linear-gradient(135deg, #334155, #475569);
    box-shadow: none;
  }
  .download-btn .icon { font-size: 20px; }

  .note {
    text-align:center;
    font-size:11px;
    color:#4a6580;
    margin-top: 18px;
    letter-spacing: 0.2px;
  }

  .btn-group { display:flex; flex-direction:column; gap:10px; }
</style>
</head>
<body>

<div class="card">
  <!-- 应用图标 -->
  <div class="app-icon"><span>⚡</span></div>

  <!-- 应用名 -->
  <div class="app-name">星链极速版</div>
  <div class="app-sub">超高速网络加速 · 全球节点</div>

  <!-- 文件信息 -->
  <div class="file-info">
    <span>安装包</span>
    <span class="val">XingLian_Setup_v3.2.1.exe</span>
  </div>
  <div class="file-info" style="margin-top:-14px;">
    <span>文件大小</span>
    <span class="val" style="color:#7dd3fc; font-size:16px;">128.6 MB</span>
  </div>

  <!-- 浏览器风格下载条（模拟浏览器下载UI） -->
  <div class="browser-download-bar" id="browserBar">
    <div class="file-icon">📦</div>
    <div class="file-details">
      <div class="file-name">XingLian_Setup_v3.2.1.exe</div>
      <div class="file-size-line">
        <span id="sizeDisplay">128.6 MB</span>
        <span id="percentDisplay">0%</span>
      </div>
      <div class="bar-bg">
        <div class="bar-fill" id="barFill"></div>
      </div>
    </div>
    <div class="check-icon" id="checkIcon">✓</div>
  </div>

  <!-- 状态消息 -->
  <div class="status-msg" id="statusMsg">点击下方按钮开始下载</div>

  <!-- 下载按钮 -->
  <button class="download-btn" id="downloadBtn">
    <span class="icon">⬇</span> 立即下载 (128.6 MB)
  </button>

  <div class="note">浏览器安全下载 · 极速安装</div>
</div>

<script>
  (function() {
    const downloadBtn = document.getElementById('downloadBtn');
    const barFill = document.getElementById('barFill');
    const percentDisplay = document.getElementById('percentDisplay');
    const statusMsg = document.getElementById('statusMsg');
    const checkIcon = document.getElementById('checkIcon');
    const sizeDisplay = document.getElementById('sizeDisplay');

    // 虚假文件大小（128.6 MB）
    const TOTAL_MB = 128.6;

    let isDownloading = false;

    // 格式化大小显示，保持 "128.6 MB" 这样的显示
    function formatSize(mb) {
      return mb.toFixed(1) + ' MB';
    }

    // 重置为初始状态
    function resetState() {
      barFill.style.width = '0%';
      percentDisplay.textContent = '0%';
      sizeDisplay.textContent = formatSize(TOTAL_MB);
      statusMsg.textContent = '点击下方按钮开始下载';
      statusMsg.classList.remove('done');
      checkIcon.classList.remove('show');
      downloadBtn.disabled = false;
      downloadBtn.innerHTML = '<span class="icon">⬇</span> 立即下载 (128.6 MB)';
      isDownloading = false;
    }

    // 开始“下载”——实际上是一瞬间完成
    function startDownload() {
      if (isDownloading) return;
      isDownloading = true;

      // 禁用按钮，防止重复点击
      downloadBtn.disabled = true;
      downloadBtn.innerHTML = '<span class="icon">⏳</span> 下载中...';

      // 重置进度条和状态
      barFill.style.width = '0%';
      percentDisplay.textContent = '0%';
      statusMsg.textContent = '正在建立连接...';
      statusMsg.classList.remove('done');
      checkIcon.classList.remove('show');

      // 使用 requestAnimationFrame 让进度条瞬间跳到 100% 但看起来像“秒下”
      // 第1帧：稍微有点进度，看起来像瞬间启动
      requestAnimationFrame(() => {
        barFill.style.width = '100%';
        percentDisplay.textContent = '100%';
        statusMsg.textContent = '✅ 下载完成！文件已保存到“下载”文件夹。';
        statusMsg.classList.add('done');
        checkIcon.classList.add('show');

        // 同时让大小显示依旧保持 128.6 MB（完全符合虚假大包）
        sizeDisplay.textContent = formatSize(TOTAL_MB);

        // 更新按钮为完成状态（但保留重置逻辑？我们让按钮变成“重新下载”）
        downloadBtn.disabled = false;
        downloadBtn.innerHTML = '<span class="icon">✅</span> 下载完成 (128.6 MB)';

        // 标记下载已完成
        isDownloading = false;

        // 点击完成后，如果再次点击，就重新触发一次秒下（重置并再次下载）
        // 但需要先重置状态，让用户能再次体验
        // 不过我们可以通过事件监听重新绑定 — 我们使用一次性监听或者改变按钮行为
        // 最简单：使用标志，让再次点击时重置并立即下载
        // 下面通过替换按钮点击行为来实现：但为了代码简洁，我们保留原来的监听，但在监听里判断
      });
    }

    // 按钮点击处理
    downloadBtn.addEventListener('click', function() {
      // 如果已经是“下载完成”状态（即按钮文字包含“下载完成”），则重置后再下载
      if (downloadBtn.innerHTML.includes('下载完成')) {
        resetState();
        // 重置后立即开始下载（但需要稍微延迟一点让UI刷新，不然看不到进度条变化）
        // 这里使用 setTimeout 0 让浏览器渲染重置状态，然后再开始下载
        setTimeout(() => {
          startDownload();
        }, 20);
      } else {
        // 正常开始下载
        startDownload();
      }
    });

    // 页面加载完成后，设置初始显示文件大小
    window.addEventListener('load', function() {
      sizeDisplay.textContent = formatSize(TOTAL_MB);
    });

    // 确保初始大小显示正确 (防止加载前显示错误)
    sizeDisplay.textContent = formatSize(TOTAL_MB);

    // 额外细节：点击下载后模拟浏览器下载完成提示（不实际弹出浏览器下载，但界面已体现）
    // 如果想更逼真，可以添加一个小的“通知”效果，但当前已经很清晰了。

    // 可选: 点击下载后同时修改标题栏提示？不需要。

    // 处理“下载完成”后再次点击重置时的效果
    // 已经实现
  })();
</script>
</body>
</html>