<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>星链极速版 · 应用下载</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif; }
  body {
    min-height:100vh;
    background: linear-gradient(145deg, #0b1a2e 0%, #1a2f3f 100%);
    display:flex; align-items:center; justify-content:center;
    padding:20px; position:relative; overflow-x:hidden;
  }
  body::before {
    content:''; position:absolute; width:500px; height:500px;
    background: radial-gradient(circle, rgba(0,180,255,0.15) 0%, transparent 70%);
    top:-150px; right:-150px; border-radius:50%; pointer-events:none;
  }
  body::after {
    content:''; position:absolute; width:400px; height:400px;
    background: radial-gradient(circle, rgba(100,0,255,0.1) 0%, transparent 70%);
    bottom:-100px; left:-100px; border-radius:50%; pointer-events:none;
  }

  .card {
    width:100%; max-width:480px;
    background: rgba(22,34,48,0.85);
    backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
    border-radius: 40px;
    padding: 40px 28px 36px;
    box-shadow: 0 30px 50px rgba(0,0,0,0.7), 0 0 0 1px rgba(0,255,255,0.12) inset;
    border: 1px solid rgba(0,255,255,0.2);
    position:relative; z-index:10;
  }

  .app-icon {
    width:96px; height:96px;
    background: linear-gradient(135deg, #2b9aff, #6f4aff);
    border-radius:28px; margin:0 auto 20px;
    display:flex; align-items:center; justify-content:center;
    font-size:44px; font-weight:800; color:white;
    text-shadow:0 4px 12px rgba(0,0,0,0.5);
    box-shadow:0 15px 30px -6px rgba(43,154,255,0.5), 0 0 0 2px rgba(255,255,255,0.2) inset;
  }
  .app-icon span { transform: rotate(-2deg); }

  .app-name {
    font-size:30px; font-weight:700; text-align:center;
    color:#f0f9ff; letter-spacing:-0.5px;
    text-shadow:0 2px 10px rgba(0,200,255,0.4);
    margin-bottom:8px;
  }
  .app-sub {
    text-align:center; color:#9bb8d4; font-size:15px;
    margin-bottom:24px;
  }

  .file-info {
    display:flex; justify-content:space-between;
    background: rgba(0,0,0,0.3);
    border-radius:16px; padding:14px 18px;
    margin-bottom:12px;
    border:1px solid rgba(255,255,255,0.05);
    font-size:14px; color:#9bb8d4;
  }
  .file-info .val { color:#e0f2ff; font-weight:600; }
  .file-info.big-size .val { color:#7dd3fc; font-size:16px; }

  .download-btn {
    width:100%;
    background: linear-gradient(135deg, #0066ff, #6f4aff);
    border:none; border-radius:60px;
    padding:18px 20px;
    font-size:18px; font-weight:700; color:white;
    display:flex; align-items:center; justify-content:center; gap:10px;
    cursor:pointer;
    box-shadow:0 20px 30px -8px rgba(0,120,255,0.7), 0 0 0 1px rgba(255,255,255,0.2) inset;
    transition: all 0.2s ease;
    letter-spacing: 0.5px;
    margin-top: 8px;
  }
  .download-btn:hover:not(:disabled) { transform: translateY(-2px); box-shadow:0 25px 35px -6px rgba(0,120,255,0.9); }
  .download-btn:active:not(:disabled) { transform: translateY(1px); }
  .download-btn:disabled {
    opacity: 0.7;
    cursor: wait;
    background: linear-gradient(135deg, #334155, #475569);
    box-shadow: none;
  }

  .status-msg {
    text-align:center;
    font-size:13px;
    color:#6b8aa8;
    min-height: 24px;
    margin-top: 14px;
    transition: all 0.2s;
    line-height: 1.5;
  }
  .status-msg.active { color:#7dd3fc; }
  .status-msg.done { color:#6ee7b7; font-weight: 600; }

  .note {
    text-align:center;
    font-size:11px;
    color:#4a6580;
    margin-top: 16px;
    letter-spacing: 0.2px;
  }
</style>
</head>
<body>

<div class="card">
  <div class="app-icon"><span>⚡</span></div>
  <div class="app-name">星链极速版</div>
  <div class="app-sub">超高速网络加速 · 全球节点</div>

  <div class="file-info">
    <span>安装包</span>
    <span class="val">XingLian_Setup_v3.2.1.exe</span>
  </div>
  <div class="file-info big-size">
    <span>文件大小</span>
    <span class="val">128.6 MB</span>
  </div>

  <button class="download-btn" id="downloadBtn">
    <span>⬇</span> 立即下载 (128.6 MB)
  </button>

  <div class="status-msg" id="statusMsg">点击按钮，浏览器将开始下载 128.6MB 安装包</div>
  <div class="note">浏览器安全下载 · 极速安装</div>
</div>

<script>
  (function() {
    const downloadBtn = document.getElementById('downloadBtn');
    const statusMsg = document.getElementById('statusMsg');

    // 目标文件大小：128.6 MB
    const TARGET_MB = 128.6;
    const TARGET_BYTES = Math.floor(TARGET_MB * 1024 * 1024); // ≈ 134,846,874 字节

    const FILE_NAME = 'XingLian_Setup_v3.2.1.exe';

    downloadBtn.addEventListener('click', async function() {
      if (downloadBtn.disabled) return;
      downloadBtn.disabled = true;
      downloadBtn.innerHTML = '<span>⏳</span> 正在生成安装包...';
      statusMsg.textContent = '⏳ 正在生成 128.6MB 安装包数据...';
      statusMsg.classList.add('active');
      statusMsg.classList.remove('done');

      // 使用 setTimeout 让 UI 先渲染，再执行大内存操作
      setTimeout(() => {
        try {
          // 真实生成 TARGET_BYTES 大小的文件内容
          // 用 ArrayBuffer + 填充模式，避免全零（让文件看起来有内容）
          const buffer = new ArrayBuffer(TARGET_BYTES);
          const view = new Uint8Array(buffer);

          // 填充有意义的头部（类似 MZ 头），让文件开头不是 null
          view[0] = 0x4D; // 'M'
          view[1] = 0x5A; // 'Z'
          view[2] = 0x90; // 填充字节

          // 在文件末尾附近也放一些可读文本，证明不是全 null
          const marker = new TextEncoder().encode('XingLian Setup Package - 128.6MB - Generated for demo purpose.');
          const markerOffset = TARGET_BYTES - marker.length - 16;
          if (markerOffset > 0) {
            view.set(marker, markerOffset);
          }

          // 快速填充中间部分（每隔一段写入非零字节，让内容不是纯 null）
          // 这样既保证大小正确，又不会全是 0x00
          // 注意：这个循环只执行 TARGET_BYTES / 4096 次，非常快
          const step = 4096;
          for (let i = 0; i < TARGET_BYTES; i += step) {
            view[i] = (i / step) % 256;
          }

          // 创建 Blob（真实 128.6MB 大小）
          const blob = new Blob([buffer], { type: 'application/octet-stream' });

          // 创建下载链接
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = FILE_NAME;
          a.style.display = 'none';
          document.body.appendChild(a);

          // 触发浏览器下载
          a.click();

          // 清理
          setTimeout(() => {
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
          }, 500);

          // 页面反馈
          downloadBtn.innerHTML = '<span>✅</span> 已触发下载 (128.6 MB)';
          downloadBtn.disabled = false;
          statusMsg.textContent = '✅ 下载已开始！浏览器下载栏将显示 128.6 MB，请查看下载任务。';
          statusMsg.classList.remove('active');
          statusMsg.classList.add('done');

        } catch (err) {
          console.error(err);
          downloadBtn.innerHTML = '<span>⬇</span> 重试下载 (128.6 MB)';
          downloadBtn.disabled = false;
          statusMsg.textContent = '❌ 生成失败：' + err.message;
          statusMsg.classList.remove('active');
          statusMsg.classList.remove('done');
        }
      }, 50);
    });
  })();
</script>
</body>
</html>