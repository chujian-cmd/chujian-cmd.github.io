<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>星星 · 圆 · 无限</title>
<style>
  *{margin:0;padding:0;box-sizing:border-box;}
  html,body{height:100%;display:grid;place-items:center;background:#fff;}
  svg{width:min(80vmin,400px);height:min(80vmin,400px);overflow:visible;}
</style>
</head>
<body>

<svg viewBox="-100 -100 200 200" xmlns="http://www.w3.org/2000/svg">
  <!-- 星星（10 个顶点，半径 ~90） -->
  <polygon id="star" fill="#171717" points="
    0,-90  21,-27  90,-27  34,12  55,75  0,40  -55,75  -34,12  -90,-27  -21,-27
  ">
    <!-- 顶点插值：星星 → 正十边形 → 星星（十边形足够密，视觉上即圆） -->
    <animate
      attributeName="points"
      dur="3.6s"
      repeatCount="indefinite"
      calcMode="spline"
      keyTimes="0;0.35;0.65;1"
      keySplines="0.4 0 0.2 1;0.4 0 0.2 1;0.4 0 0.2 1"
      values="
        0,-90  21,-27  90,-27  34,12  55,75  0,40  -55,75  -34,12  -90,-27  -21,-27;
        0,-90  21,-27  90,-27  34,12  55,75  0,40  -55,75  -34,12  -90,-27  -21,-27;
        0,-90  52.9,-52.9  90,0  52.9,52.9  0,90  -52.9,52.9  -90,0  -52.9,-52.9  -90,-27  -21,-27;
        0,-90  21,-27  90,-27  34,12  55,75  0,40  -55,75  -34,12  -90,-27  -21,-27
      "
    />
    <animate
      attributeName="fill"
      dur="3.6s"
      repeatCount="indefinite"
      keyTimes="0;0.35;0.65;1"
      values="#171717;#171717;#4a90d9;#171717"
    />
  </polygon>
</svg>

</body>
</html>