      <div class="light-led red led-c0"></div><div class="light-led red led-c1"></div><div class="light-led red led-c2"></div><div class="light-led red led-c3"></div><div class="light-led red led-c4"></div>
      <div class="light-led amber led-c5"></div><div class="light-led amber led-c6"></div>
      <div class="light-led white led-c7"></div><div class="light-led white led-c8"></div>
      <div class="light-led amber led-c9"></div><div class="light-led amber led-c10"></div>
      <div class="light-led blue led-c11"></div><div class="light-led blue led-c12"></div><div class="light-led blue led-c13"></div><div class="light-led blue led-c14"></div><div class="light-led blue led-c15"></div>
