</div>

<!-- ============ CDK 激活 ============ -->
<div class="disclaimer-overlay" id="cdkAuthModal" style="display:none; z-index:99999998;">
  <div class="disclaimer-card">
    <div style="font-size:16px; font-weight:900; color:#f5f5f5; margin-bottom:12px; text-align:center; letter-spacing:1px;">
      手机警报器Pro · 正版激活
    </div>
    <div style="font-size:13.5px; color:#d4d4d4; line-height:1.75; margin-bottom:14px; text-align:justify; font-weight:600;">
      请输入您的激活码，激活码仅可使用一次，使用后与设备绑定。
    </div>
    <div style="background:#000; border:1px solid #262626; border-radius:6px; padding:8px 10px; margin-bottom:12px;">
      <div style="font-size:10.5px; color:#737373; font-weight:700;">本机设备识别码</div>
      <div id="dispDeviceId" style="font-size:12.5px; color:#f5f5f5; font-family:monospace; font-weight:800; word-break:break-all; margin-top:2px;">获取中...</div>
    </div>
    <div style="width:100%; margin-bottom:14px;">
      <input type="text" id="iptCdk" placeholder="请输入激活码" style="width:100%; height:40px; background:#050505; border:1px solid #2a2a2a; border-radius:6px; color:#f5f5f5; font-size:14px; font-weight:800; padding:0 10px; box-sizing:border-box; outline:none; text-transform:uppercase; letter-spacing:1px; -webkit-touch-callout:default !important; -webkit-user-select:text !important; user-select:text !important;" />
    </div>
    <div style="margin-bottom:12px;">
      <button type="button" id="btnBuyCdk" style="width:100%; height:38px; background:#f5f5f5; border:1px solid #ffffff; border-radius:6px; color:#0a0a0a; font-size:13.5px; font-weight:900; letter-spacing:0.8px; cursor:pointer; box-shadow:0 2px 0 #000;">没有CDK？立即购买</button>
    </div>
    <div class="disclaimer-actions">
      <button class="btn-disc-agree" id="btnDoActivate">立即激活</button>
      <button class="btn-disc-refuse" id="btnExitAuth">退出软件</button>
    </div>
  </div>
</div>

<!-- ============ 声明弹窗 ============ -->
<div class="disclaimer-overlay" id="disclaimerModal" style="z-index:999999999; pointer-events:auto !important; touch-action:manipulation;">
  <div class="disclaimer-card" style="max-height: 85vh; display: flex; flex-direction: column; pointer-events:auto !important; position:relative; z-index:999999999;">
    <div style="font-size: 16px; font-weight: 800; color: #f5f5f5; margin-bottom: 12px; text-align: center; letter-spacing: 1px; flex-shrink: 0;">
      声明与合规
    </div>
    <div class="disclaimer-body" id="tDiscBody" style="overflow-y: auto; max-height: 48vh; padding-right: 4px; margin-bottom: 16px; font-size: 13.5px; line-height: 1.85; color: #d4d4d4; text-align: justify; word-break: break-word; font-weight: normal; -webkit-overflow-scrolling: touch;">本软件仅供个人娱乐、专业学习及音效测试使用。<br><br><span style="color: #ffffff; font-weight: 900;">严禁在公共场所公开播放警报音效。</span><br><span style="color: #ffffff; font-weight: 900;">严禁利用本软件冒充特种车辆。</span><br><br>任何人因擅自公开播放、非法改装车辆或实施欺诈行为引发的一切行政处罚、民事侵权或刑事法律责任，均由行为人自行独立承担。</div>
    <div style="display:flex; align-items:center; justify-content:center; gap:8px; margin-bottom:14px; cursor:pointer; flex-shrink: 0;" id="rowRememberDisc">
      <input type="checkbox" id="chkRememberDisc" style="width:18px; height:18px; accent-color:#f5f5f5; cursor:pointer;">
      <label for="chkRememberDisc" style="font-size:12.5px; color:#d4d4d4; font-weight:700; cursor:pointer; user-select:none;">不再提示</label>
    </div>
    <div class="disclaimer-actions" style="flex-shrink: 0;">
      <button type="button" class="btn-disc-agree" id="btnDiscAgree" onclick="window.dismissDisclaimerDirect(event)" ontouchend="window.dismissDisclaimerDirect(event)" style="pointer-events:auto !important; cursor:pointer; position:relative; z-index:999999999; touch-action:manipulation;">同意并进入</button>
      <button class="btn-disc-refuse" id="btnDiscRefuse" onclick="window.triggerHardAppExit(event)" ontouchend="window.triggerHardAppExit(event)" style="pointer-events:auto !important; cursor:pointer; z-index:999999999; touch-action:manipulation;">拒绝并退出</button>
    </div>
  </div>
</div>

