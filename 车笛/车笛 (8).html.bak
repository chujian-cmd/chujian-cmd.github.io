    <div class="grid-2">
      <button class="btn" id="btnHorn">
        <span class="btn-lbl">
          <svg class="btn-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5L6 9H3v6h3l5 4V5z"/><path d="M16 9a4 4 0 010 6"/><path d="M19 6a9 9 0 010 12"/></svg>
          <span id="tBtnHorn">汽笛号角</span>
        </span>
        <span class="sub" id="tSubHorn">点按触发</span>
      </button>
      <button class="btn" id="btnMic">
        <span class="btn-lbl">
          <svg class="btn-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 11v1a7 7 0 0014 0v-1"/><line x1="12" y1="19" x2="12" y2="22"/><line x1="8" y1="22" x2="16" y2="22"/></svg>
          <span id="tBtnMic">广播喊话</span>
        </span>
        <span class="sub" id="micSubTxt">按住录音</span>
      </button>
    </div>

    <!-- 战术警灯 -->
    <div class="section-tag" id="tSec2">战术警灯</div>
    <div class="grid-4" style="margin-bottom:5px">
      <button class="btn active" id="btnLgtAuto">
        <span class="btn-lbl">
          <svg class="btn-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0115-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 01-15 6.7L3 16"/></svg>
          <span id="tBtnAutoLgt">自动联动</span>
        </span>
        <span class="sub" id="tSubAutoLgt">随动</span>
      </button>
      <button class="btn" id="btnLgtM1">
        <span class="btn-lbl">
          <svg class="btn-icon" viewBox="0 0 24 24" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span id="tBtnM1">代码 1</span>
        </span>
        <span class="sub" id="tSubM1">巡逻</span>
      </button>
      <button class="btn" id="btnLgtM2">
        <span class="btn-lbl">
          <svg class="btn-icon" viewBox="0 0 24 24" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          <span id="tBtnM2">代码 2</span>
        </span>
        <span class="sub" id="tSubM2">响应</span>
