<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<title id="pageTitle">手机警报器Pro2.0.0</title>
<style>
button * { pointer-events: none; }
input, textarea {
  -webkit-touch-callout: default !important;
  -webkit-user-select: text !important;
  user-select: text !important;
}
* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
  -webkit-touch-callout: none;
  -webkit-user-select: none;
  user-select: none;
}
html, body {
  margin: 0; padding: 0;
  width: 100%; height: 100%; height: 100dvh;
  background: #000;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
}
.console {
  width: 100%;
  max-width: 500px;
  height: 100%; height: 100dvh;
  background: #000;
  border: 1px solid #141414;
  box-shadow: 0 0 40px rgba(0, 0, 0, 1);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}
.txt-pro-red {
  color: #f5f5f5 !important;
  font-weight: 900 !important;
}
@keyframes hiddenRestLinearShimmer {
  0% { background-position: -120px 0; }
  48% { background-position: 240px 0; }
  100% { background-position: 240px 0; }
}
.brand-text-shimmer {
  display: inline-block;
  font-weight: 900;
  letter-spacing: 2px;
  background-color: #4a4a4a;
  background-image: linear-gradient(
    90deg,
    transparent 0px,
    transparent 20px,
    #8a8a8a 45px,
    #ffffff 55px,
    #8a8a8a 65px,
    transparent 90px,
    transparent 110px
  );
  background-repeat: no-repeat !important;
  background-size: 110px 100%;
  background-position: -120px 0;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: hiddenRestLinearShimmer 3.2s linear infinite;
  will-change: background-position;
}
.lightbar-cluster {
  background: #000;
  display: flex;
  flex-direction: column;
  gap: 2.5px;
  padding: 4px 6px;
  flex-shrink: 0;
}
.top-cluster { border-bottom: 1.5px solid #1a1a1a; }
.bottom-cluster { border-top: 1.5px solid #1a1a1a; }
.lightbar {
  display: flex;
  gap: 2px;
  align-items: center;
  width: 100%;
}
.light-led {
  flex: 1;
  height: 9px;
  border-radius: 2px;
  background: #0a0a0a;
  border: 1px solid #1a1a1a;
  transition: none !important;
  transform: translate3d(0, 0, 0);
  -webkit-transform: translate3d(0, 0, 0);
  backface-visibility: hidden;
  -webkit-backface-visibility: hidden;
  contain: strict;
  will-change: background-color, box-shadow;
}
/* —— 警示灯 LED 颜色（保留） —— */
.light-led.red.on, .fs-led.red.on {
  background: #ff0033 !important;
  box-shadow: 0 0 14px #ff0033, 0 0 28px rgba(255, 0, 51, 0.8) !important;
}
.light-led.amber.on, .fs-led.amber.on {
  background: #ffaa00 !important;
  box-shadow: 0 0 14px #ffaa00, 0 0 28px rgba(255, 170, 0, 0.8) !important;
}
.light-led.white.on, .fs-led.white.on {
  background: #ffffff !important;
  box-shadow: 0 0 18px #ffffff, 0 0 36px rgba(255, 255, 255, 0.9) !important;
}
.light-led.blue.on, .fs-led.blue.on {
  background: #0066ff !important;
  box-shadow: 0 0 14px #0066ff, 0 0 28px rgba(0, 102, 255, 0.8) !important;
}
body.siren-low .light-led.red.on, body.siren-low .fs-led.red.on { box-shadow: 0 0 8px #ff0033 !important; }
body.siren-low .light-led.amber.on, body.siren-low .fs-led.amber.on { box-shadow: 0 0 8px #ffaa00 !important; }
body.siren-low .light-led.white.on, body.siren-low .fs-led.white.on { box-shadow: 0 0 10px #ffffff !important; }
body.siren-low .light-led.blue.on, body.siren-low .fs-led.blue.on { box-shadow: 0 0 8px #0066ff !important; }
body.quality-low .light-led.red.on, body.quality-low .fs-led.red.on { box-shadow: 0 0 8px #ff0033 !important; background: #ff0033 !important; }
body.quality-low .light-led.amber.on, body.quality-low .fs-led.amber.on { box-shadow: 0 0 8px #ffaa00 !important; background: #ffaa00 !important; }
body.quality-low .light-led.white.on, body.quality-low .fs-led.white.on { box-shadow: 0 0 10px #ffffff !important; background: #ffffff !important; }
body.quality-low .light-led.blue.on, body.quality-low .fs-led.blue.on { box-shadow: 0 0 8px #0066ff !important; background: #0066ff !important; }

.brand {
  background: #0a0a0a;
  border-bottom: 1px solid #1a1a1a;
  padding: 8px;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}
.brand-name {
  font-weight: 800;
  font-size: 17px;
  display: flex;
  align-items: center;
  gap: 4px;
  color: #f5f5f5;
}
.statusbar {
  background: #050505;
  border-bottom: 1px solid #1a1a1a;
  padding: 4px 8px;
  display: flex;
  align-items: center;
  font-size: 10.5px;
  color: #737373;
  font-weight: 700;
  letter-spacing: .3px;
  flex-shrink: 0;
}
.statusbar .led {
  width: 7px; height: 7px;
  border-radius: 50%;
  background: #1a1a1a;
  display: inline-block;
  margin-right: 6px;
  transition: all .15s;
}
.statusbar .led.ready { background: #d4d4d4; box-shadow: 0 0 6px rgba(255,255,255,.5); }
.statusbar .led.active { background: #ffffff; box-shadow: 0 0 10px #ffffff; }

.content {
  padding: 5px 6px;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 0;
  overflow: hidden;
}
.section-tag {
  color: #a3a3a3;
  font-size: 11px;
  font-weight: 800;
  margin: 4px 0 3px;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  border-left: 3px solid #f5f5f5;
  padding-left: 7px;
  flex-shrink: 0;
}
.section-tag:first-child { margin-top: 0; }

.grid-2, .grid-3, .grid-4 {
  display: grid;
  gap: 5px;
  flex: 1;
  min-height: 0;
  margin-bottom: 3px;
}
.grid-2 { grid-template-columns: 1fr 1fr; }
.grid-3 { grid-template-columns: repeat(3, 1fr); }
.grid-4 { grid-template-columns: repeat(4, 1fr); }

/* —— 统一黑白按钮 —— */
.btn {
  position: relative;
  border: 1px solid #2a2a2a;
  outline: none;
  cursor: pointer;
  border-radius: 8px;
  font-weight: 700;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #1a1a1a 0%, #121212 100%);
  color: #e5e5e5;
  box-shadow: 0 2px 0 #000, inset 0 1px 0 rgba(255, 255, 255, 0.04);
  touch-action: none;
  transition: transform .04s, box-shadow .04s, background .04s, color .04s, border-color .04s;
  padding: 4px 4px;
  height: 100%;
  min-height: 32px;
  gap: 2px;
  font-size: 13px;
}
.btn-lbl {
  display: flex;
  align-items: center;
  gap: 4px;
  line-height: 1.1;
  min-width: 0;
  max-width: 100%;
}
.btn-lbl > span {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.btn-icon {
  width: 13px;
  height: 13px;
  flex-shrink: 0;
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
  opacity: 0.85;
}
.btn .sub {
  font-size: 9.5px;
  font-weight: 600;
  opacity: .65;
  letter-spacing: .2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}
.btn:active, .btn.pressed {
  transform: translateY(1px);
  box-shadow: 0 1px 0 #000, inset 0 1px 0 rgba(255,255,255,.04);
}
.btn.active {
  background: #f5f5f5;
  color: #0a0a0a;
  border-color: #ffffff;
  box-shadow: 0 0 0 1px rgba(255,255,255,.5), 0 0 22px rgba(255,255,255,.25);
  transform: translateY(1px);
}
.btn.active .btn-icon { opacity: 1; }
.btn.armed {
  background: #1a1a1a;
  color: #ffffff;
  border-color: #4a4a4a;
  box-shadow: 0 0 0 1px rgba(255,255,255,.15), inset 0 0 12px rgba(255,255,255,.06);
}

.footer {
  background: #050505;
  border-top: 1px solid #1a1a1a;
  padding: 5px 8px;
  font-size: 11px;
  color: #737373;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
}
.footer-ver { font-family: monospace; color: #a3a3a3; font-weight: 700; letter-spacing: .5px; }
.footer-right { display: flex; align-items: center; gap: 8px; }
.btn-contact {
  background: #141414;
  border: 1px solid #2a2a2a;
  color: #e5e5e5;
  border-radius: 4px;
  padding: 3px 10px;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  gap: 4px;
  box-shadow: 0 1px 0 #000;
}
.btn-contact:active { background: #f5f5f5; color: #0a0a0a; border-color: #ffffff; }

.fullscreen-lgt-overlay {
  position: fixed !important;
  top: 0 !important; left: 0 !important;
  width: 100vw !important;
  height: 100vh !important; height: 100dvh !important;
  background-color: #000000 !important;
  opacity: 1 !important;
  z-index: 99999999 !important;
  display: none;
  box-sizing: border-box !important;
  overflow: hidden !important;
}
.fullscreen-lgt-overlay.open {
  display: flex !important;
  flex-direction: column !important;
}
@media (orientation: portrait) {
  .fullscreen-lgt-overlay.force-landscape {
    width: 100vh !important; width: 100dvh !important;
    height: 100vw !important; height: 100dvw !important;
    top: 50% !important; left: 50% !important;
    transform: translate(-50%, -50%) rotate(90deg) !important;
    transform-origin: center center !important;
  }
}
.fs-ambient-layer {
  position: absolute !important;
  top: 0 !important; left: 0 !important;
  width: 100% !important; height: 100% !important;
  pointer-events: none !important;
  z-index: 1 !important;
  background-color: transparent;
  transform: translate3d(0, 0, 0);
  -webkit-transform: translate3d(0, 0, 0);
  will-change: background-color;
}
.fullscreen-lgt-content {
  position: relative !important;
  z-index: 2 !important;
  height: 100% !important;
  width: 100% !important;
  display: flex !important;
  flex-direction: column !important;
  justify-content: space-between !important;
  padding: 10px 14px !important;
  box-sizing: border-box !important;
  overflow: hidden !important;
}
.fs-cluster {
  display: flex !important;
  flex-direction: column !important;
  justify-content: space-between !important;
  gap: 5px !important;
  height: 33% !important;
  min-height: 85px !important;
  width: 100% !important;
  flex-shrink: 0 !important;
  box-sizing: border-box !important;
}
.fs-light-row {
  flex: 1 1 0 !important;
  height: 31% !important;
  min-height: 24px !important;
  display: flex !important;
  gap: 3px !important;
  width: 100% !important;
  box-sizing: border-box !important;
}
.fs-led {
  position: relative !important;
  flex: 1 1 0 !important;
  min-width: 0 !important;
  height: 100% !important;
  min-height: 22px !important;
  border-radius: 3px !important;
  background: #0a0a0a !important;
  border: 1px solid #1a1a1a !important;
  transform: translate3d(0, 0, 0) !important;
  -webkit-transform: translate3d(0, 0, 0) !important;
  backface-visibility: hidden !important;
  -webkit-backface-visibility: hidden !important;
  contain: strict !important;
  transition: none !important;
  will-change: background, box-shadow !important;
  box-sizing: border-box !important;
}
.fs-mid-gap {
  height: 25% !important;
  min-height: 75px !important;
  width: 100% !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  margin: 4px 0 !important;
  box-sizing: border-box !important;
  flex-shrink: 0 !important;
}
.fs-controls-grid {
  display: grid !important;
  grid-template-columns: repeat(7, 1fr) 1.2fr !important;
  gap: 6px !important;
  width: 100% !important;
  height: 100% !important;
}
.fs-btn {
  position: relative !important;
  height: 100% !important;
  min-height: 70px !important;
  border: 1.5px solid #1f1f1f !important;
  border-radius: 8px !important;
  background: linear-gradient(180deg, #0a0a0a 0%, #050505 100%) !important;
  color: #525252 !important;
  font-weight: 800 !important;
  font-size: clamp(14px, 3.2vw, 17px) !important;
  line-height: 1.1 !important;
  cursor: pointer !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  writing-mode: vertical-rl !important;
  text-orientation: upright !important;
  letter-spacing: 2px !important;
  box-shadow: 0 2px 0 #000000, inset 0 1px 0 rgba(255,255,255,0.02) !important;
  touch-action: manipulation !important;
  transition: transform .04s, background .04s, border-color .04s, color .04s !important;
  padding: 0 !important;
  box-sizing: border-box !important;
}
.fs-btn:active {
  transform: translateY(2px) !important;
  box-shadow: 0 1px 0 #08090b !important;
}
.fs-btn.active {
  background: #f5f5f5 !important;
  color: #0a0a0a !important;
  border-color: #ffffff !important;
  box-shadow: 0 0 0 1px rgba(255,255,255,.6), 0 0 20px rgba(255,255,255,.3) !important;
}
.fs-btn-return {
  background: #0f0f0f !important;
  border-color: #262626 !important;
  color: #737373 !important;
}
.fs-btn-return:active {
  background: #1a1a1a !important;
  color: #f5f5f5 !important;
}

.disclaimer-overlay {
  touch-action: auto !important;
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.94);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  z-index: 9999999;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 16px;
}
.disclaimer-card {
  width: 100%;
  max-width: 380px;
  background: #0a0a0a;
  border: 1px solid #262626;
  border-radius: 12px;
  padding: 22px 18px 18px;
  box-shadow: 0 24px 60px rgba(0,0,0,.95), inset 0 1px 0 rgba(255,255,255,.06);
}
.disclaimer-body {
  font-size: 14px;
  color: #e5e5e5;
  line-height: 1.75;
  text-align: justify;
  font-weight: 600;
  margin-bottom: 20px;
  letter-spacing: .3px;
}
.disclaimer-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.btn-disc-agree {
  touch-action: manipulation !important;
  padding: 11px 0;
  font-size: 13px;
  font-weight: 800;
  border-radius: 6px;
  cursor: pointer;
  background: #f5f5f5;
  color: #0a0a0a;
  border: 1px solid #ffffff;
  box-shadow: 0 2px 0 #000;
}
.btn-disc-agree:active { transform: translateY(1px); background: #ffffff; }
.btn-disc-refuse {
  padding: 11px 0;
  font-size: 13px;
  font-weight: 800;
  border-radius: 6px;
  cursor: pointer;
  background: #141414;
  color: #a3a3a3;
  border: 1px solid #2a2a2a;
  box-shadow: 0 2px 0 #000;
}
.btn-disc-refuse:active { transform: translateY(1px); background: #1f1f1f; color: #f5f5f5; }

.modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.92);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  z-index: 9999;
  display: none;
  justify-content: center;
  align-items: center;
  padding: 16px;
}
.modal-overlay.open { display: flex; }
.modal-card {
  width: 100%;
  max-width: 390px;
  background: #0a0a0a;
  border: 1px solid #262626;
  border-radius: 12px;
  padding: 18px 16px;
  box-shadow: 0 24px 60px rgba(0,0,0,.95), inset 0 1px 0 rgba(255,255,255,.06);
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #1f1f1f;
  padding-bottom: 10px;
  margin-bottom: 14px;
}
.modal-title { font-size: 16px; font-weight: 800; color: #f5f5f5; letter-spacing: .5px; }
.btn-close {
  background: none;
  border: none;
  color: #737373;
  cursor: pointer;
  padding: 4px 8px;
  border-radius: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-close svg { width: 16px; height: 16px; stroke: currentColor; stroke-width: 2; stroke-linecap: round; fill: none; }
.btn-close:active { color: #fff; background: #1f1f1f; }
.lang-toggle { display: flex; gap: 5px; }
.btn-lang {
  padding: 4px 10px;
  font-size: 11px;
  font-weight: 800;
  border: 1px solid #2a2a2a;
  background: #141414;
  color: #a3a3a3;
  border-radius: 4px;
  cursor: pointer;
}
.btn-lang.active { background: #f5f5f5; color: #0a0a0a; border-color: #ffffff; }
.slider-row {
  display: grid;
  grid-template-columns: 82px 1fr 48px;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
  font-size: 12.5px;
  color: #d4d4d4;
  font-weight: 700;
}
.slider-row:last-child { margin-bottom: 0; }
.slider-row input[type=range] { width: 100%; accent-color: #f5f5f5; cursor: pointer; margin: 0; }
.slider-val { text-align: right; color: #f5f5f5; font-family: monospace; font-size: 12px; }
.slider-row-flex { display: flex !important; justify-content: space-between !important; align-items: center !important; }
.btn-reset-defaults {
  width: 100%;
  margin-top: 14px;
  padding: 9px 0;
  background: #141414;
  border: 1px solid #2a2a2a;
  color: #d4d4d4;
  font-size: 11.5px;
  font-weight: 800;
  border-radius: 6px;
  cursor: pointer;
}
.btn-reset-defaults:active { background: #f5f5f5; color: #0a0a0a; border-color: #ffffff; }
.support-text {
  color: #f5f5f5 !important;
  font-size: 13px !important;
  line-height: 1.8 !important;
  font-weight: 700 !important;
}
.contact-card-box {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 8px;
}
.contact-item-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #111111;
  padding: 12px 14px;
  border-radius: 8px;
  border: 1px solid #262626;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
}
.contact-item-left {
  display: flex;
  flex-direction: column;
  gap: 3px;
}
.contact-item-title {
  color: #737373;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.8px;
}
.contact-item-value {
  color: #f5f5f5;
  font-weight: 900;
  font-size: 15px;
  letter-spacing: 0.5px;
}
.btn-copy-dy-big {
  background: #f5f5f5;
  border: 1px solid #ffffff;
  color: #0a0a0a;
  padding: 8px 16px;
  border-radius: 6px;
  font-size: 12.5px;
  font-weight: 900;
  cursor: pointer;
  box-shadow: 0 2px 0 #000;
}
.btn-copy-dy-big:active {
  transform: translateY(1px);
  background: #ffffff;
}
.toast {
  position: fixed;
  bottom: 38px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(10, 10, 10, 0.97);
  border: 1px solid #3f3f3f;
  color: #f5f5f5;
  padding: 9px 15px;
  border-radius: 8px;
  font-size: 11.5px;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 8px 24px rgba(0,0,0,.85);
  z-index: 99999999;
  pointer-events: none;
  opacity: 0;
  transition: opacity .2s, transform .2s;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(-6px); }
</style>
</head>
<body>

<!-- ============ 更新弹窗 ============ -->
<div class="disclaimer-overlay" id="appUpdateModal" style="display:none; z-index:99999999;">
  <div class="disclaimer-card">
    <div id="uModalTitle" style="font-size:16px; font-weight:900; color:#f5f5f5; margin-bottom:8px; text-align:center; letter-spacing:1px;">
      发现新版本
    </div>
    <div id="uModalVer" style="font-size:12px; color:#a3a3a3; font-family:monospace; text-align:center; font-weight:800; margin-bottom:12px;">
      V2.0.0 -> V2.1.0
    </div>
    <div id="uModalChangelog" style="font-size:12px; color:#d4d4d4; line-height:1.7; background:#000; border:1px solid #1f1f1f; border-radius:6px; padding:10px 12px; margin-bottom:14px; white-space:pre-wrap; max-height:140px; overflow-y:auto;"></div>
    <div class="disclaimer-actions" id="uModalActions">
