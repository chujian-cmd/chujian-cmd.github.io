<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>泛光圆 · 晃动小球</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: black;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
      touch-action: none;
      overscroll-behavior: none;
      overflow: hidden;
    }

    .scene {
      position: relative;
      width: 100%;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .glow-ring {
      position: relative;
      width: min(80vw, 80vh);
      height: min(80vw, 80vh);
      max-width: 560px;
      max-height: 560px;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, #111, #000);
      box-shadow:
        0 0 25px rgba(0, 200, 255, 0.7),
        0 0 60px rgba(0, 180, 255, 0.4),
        inset 0 0 30px rgba(0, 220, 255, 0.2),
        inset 0 0 10px rgba(0, 255, 255, 0.3);
      border: 1px solid rgba(0, 200, 255, 0.4);
    }

    .glow-ring::after {
      content: '';
      position: absolute;
      inset: -2px;
      border-radius: 50%;
      box-shadow: 0 0 15px #00c8ff, 0 0 30px #0088ff;
      opacity: 0.5;
      filter: blur(3px);
      z-index: -1;
    }

    .balls-layer {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      overflow: hidden;
    }

    .ball {
      position: absolute;
      left: 0;
      top: 0;
      border-radius: 50%;
      will-change: transform;
    }

    .hint {
      position: fixed;
      bottom: 16px;
      left: 0;
      right: 0;
      text-align: center;
      color: rgba(120, 220, 255, 0.6);
      font-size: 14px;
      letter-spacing: 2px;
      pointer-events: none;
      text-shadow: 0 0 10px #00aaff;
      z-index: 10;
    }
  </style>
</head>
<body>
  <div class="scene">
    <div class="glow-ring" id="glowRing">
      <div class="balls-layer" id="ballsLayer"></div>
    </div>
  </div>
  <div class="hint">晃动手机 · 小球跟着晃</div>

  <script>
    (function() {
      // ---------- 配置 ----------
      const BALL_COUNT   = 7;
      const WALL_BOUNCE  = 0.6;    // 撞边反弹
      const BALL_BOUNCE  = 0.6;    // 球间反弹
      const ACCEL_GAIN   = 0.06;   // 手机加速度 → 小球速度 的增益
      const MAX_SPEED    = 18;
      const FRICTION     = 0.96;   // 每帧速度衰减（很小，让运动自然）
      const TILT_GAIN    = 0.35;   // 倾斜产生的持续力

      const COLORS = [
        '#4df0ff', '#3a9eff', '#b84dff', '#00e0c0',
        '#5f7aff', '#ff4dd0', '#7af0ff',
      ];

      const ring       = document.getElementById('glowRing');
      const ballsLayer = document.getElementById('ballsLayer');

      let ringW = 0, ringH = 0;
      let ballRadius = 8;
      let balls = [];

      // 陀螺仪倾斜 (-1~1)
      let tiltX = 0, tiltY = 0;
      // 运动加速度原始值
      let rawAccX = 0, rawAccY = 0;

      // ---------- 初始化 ----------
      function init() {
        const rect = ring.getBoundingClientRect();
        ringW = rect.width;
        ringH = rect.height;
        ballRadius = Math.max(7, Math.min(14, ringW * 0.04));

        balls = [];
        ballsLayer.innerHTML = '';

        const cx = ringW / 2;
        const cy = ringH / 2;
        const maxR = ringW / 2 - ballRadius - 4;
        const minDist = ballRadius * 2.1;
        const minDistSq = minDist * minDist;

        for (let i = 0; i < BALL_COUNT; i++) {
          let x = 0, y = 0, ok = false, tries = 0;
          while (!ok && tries < 300) {
            ok = true;
            const a = Math.random() * Math.PI * 2;
            const r = Math.sqrt(Math.random()) * maxR;
            x = cx + Math.cos(a) * r;
            y = cy + Math.sin(a) * r;
            for (let b of balls) {
              const dx = x - b.x, dy = y - b.y;
              if (dx * dx + dy * dy < minDistSq) { ok = false; break; }
            }
            tries++;
          }

          const color = COLORS[i % COLORS.length];
          const el = document.createElement('div');
          el.className = 'ball';
          el.style.width  = ballRadius * 2 + 'px';
          el.style.height = ballRadius * 2 + 'px';
          el.style.background = color;
          el.style.boxShadow = `0 0 10px ${color}, 0 0 20px ${color}80`;
          ballsLayer.appendChild(el);

          balls.push({ x, y, vx: 0, vy: 0, el });
        }

        for (let b of balls) {
          b.el.style.transform = `translate3d(${b.x - ballRadius}px, ${b.y - ballRadius}px, 0)`;
        }
      }

      // ---------- 物理更新 ----------
      function update() {
        const cx = ringW / 2;
        const cy = ringH / 2;
        const maxR = ringW / 2 - ballRadius - 2;

        // 组合驱动：倾斜力 + 甩动加速度
        // 倾斜：持续小力，让球慢慢滚向低处
        // 甩动：加速度突变直接变成速度冲量
        const driveX = tiltX * TILT_GAIN;
        const driveY = tiltY * TILT_GAIN;

        // 甩动加速度（每秒平方），转成每帧速度增量
        const shakeX = rawAccX * ACCEL_GAIN;
        const shakeY = rawAccY * ACCEL_GAIN;

        for (let b of balls) {
          // 持续倾斜力（很轻）
          b.vx += driveX;
          b.vy += driveY;
          // 甩动冲量（瞬时强）
          b.vx += shakeX;
          b.vy += shakeY;

          // 轻微摩擦，让运动自然衰减
          b.vx *= FRICTION;
          b.vy *= FRICTION;

          // 限速
          const sp = Math.hypot(b.vx, b.vy);
          if (sp > MAX_SPEED) {
            b.vx = b.vx / sp * MAX_SPEED;
            b.vy = b.vy / sp * MAX_SPEED;
          }

          if (Math.abs(b.vx) < 0.03) b.vx = 0;
          if (Math.abs(b.vy) < 0.03) b.vy = 0;

          b.x += b.vx;
          b.y += b.vy;
        }

        // 球与球碰撞
        const r2 = ballRadius * 2;
        const r2Sq = r2 * r2;
        for (let i = 0; i < balls.length; i++) {
          for (let j = i + 1; j < balls.length; j++) {
            const a = balls[i], b = balls[j];
            let dx = b.x - a.x;
            let dy = b.y - a.y;
            let d2 = dx * dx + dy * dy;
            if (d2 > 0 && d2 < r2Sq) {
              const d = Math.sqrt(d2);
              const nx = dx / d;
              const ny = dy / d;
              const overlap = (r2 - d) / 2;
              a.x -= nx * overlap;
              a.y -= ny * overlap;
              b.x += nx * overlap;
              b.y += ny * overlap;

              const rvx = b.vx - a.vx;
              const rvy = b.vy - a.vy;
              const vn = rvx * nx + rvy * ny;
              if (vn < 0) {
                const impulse = -(1 + BALL_BOUNCE) * vn / 2;
                a.vx -= impulse * nx;
                a.vy -= impulse * ny;
                b.vx += impulse * nx;
                b.vy += impulse * ny;
              }
            }
          }
        }

        // 圆形边界
        for (let b of balls) {
          let dx = b.x - cx;
          let dy = b.y - cy;
          const dist = Math.hypot(dx, dy);
          if (dist > maxR) {
            const nx = dx / (dist || 1);
            const ny = dy / (dist || 1);
            b.x = cx + nx * maxR;
            b.y = cy + ny * maxR;
            const vn = b.vx * nx + b.vy * ny;
            if (vn > 0) {
              b.vx -= (1 + WALL_BOUNCE) * vn * nx;
              b.vy -= (1 + WALL_BOUNCE) * vn * ny;
            }
          }
          b.el.style.transform = `translate3d(${b.x - ballRadius}px, ${b.y - ballRadius}px, 0)`;
        }
      }

      function animate() {
        update();
        requestAnimationFrame(animate);
      }

      // ---------- 传感器 ----------
      function onOrientation(e) {
        const beta  = e.beta  || 0;
        const gamma = e.gamma || 0;
        // gamma：左右倾斜 → x 方向
        // beta：前后倾斜 → y 方向（手机顶部朝自己为负，翻过来为正）
        tiltX = Math.max(-1, Math.min(1, gamma / 45));
        tiltY = Math.max(-1, Math.min(1, beta  / 45));
      }

      function onMotion(e) {
        const acc = e.accelerationIncludingGravity;
        if (!acc) return;

        // 减去静止重力估计（低通滤波）
        // 静止时 acc 约为 (0, -9.8, 0) 竖屏, 但部分设备方向不同
        // 这里直接取变化量，减去一个缓慢更新的基线
        const ax = acc.x || 0;
        const ay = acc.y || 0;

        // 低通滤波出重力分量
        gravityX = gravityX * 0.92 + ax * 0.08;
        gravityY = gravityY * 0.92 + ay * 0.08;

        // 实际运动加速度 = 原始 - 重力
        rawAccX = ax - gravityX;
        rawAccY = ay - gravityY;

        // 设备 y 向上，屏幕 y 向下，取反
        rawAccY = -rawAccY;
      }

      let gravityX = 0, gravityY = 0;

      function requestPermission() {
        const tasks = [];
        if (typeof DeviceOrientationEvent !== 'undefined' &&
            typeof DeviceOrientationEvent.requestPermission === 'function') {
          tasks.push(DeviceOrientationEvent.requestPermission());
        }
        if (typeof DeviceMotionEvent !== 'undefined' &&
            typeof DeviceMotionEvent.requestPermission === 'function') {
          tasks.push(DeviceMotionEvent.requestPermission());
        }
        Promise.all(tasks).then(states => {
          if (states.every(s => s === 'granted')) {
            window.addEventListener('deviceorientation', onOrientation);
            window.addEventListener('devicemotion', onMotion);
          }
        }).catch(() => {});
      }

      // ---------- 启动 ----------
      window.addEventListener('load', () => {
        init();
        animate();

        if (typeof DeviceOrientationEvent !== 'undefined' &&
            typeof DeviceOrientationEvent.requestPermission === 'function') {
          // iOS 13+ 需要用户手势授权
          const trigger = () => {
            requestPermission();
            document.body.removeEventListener('touchstart', trigger);
            document.body.removeEventListener('click', trigger);
          };
          document.body.addEventListener('touchstart', trigger, { once: true });
          document.body.addEventListener('click', trigger, { once: true });
        } else {
          // Android / 其他浏览器直接监听
          window.addEventListener('deviceorientation', onOrientation);
          window.addEventListener('devicemotion', onMotion);
        }
      });

      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(init, 150);
      });
      window.addEventListener('orientationchange', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(init, 250);
      });

    })();
  </script>
</body>
</html>