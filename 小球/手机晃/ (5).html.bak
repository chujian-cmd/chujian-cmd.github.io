<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>泛光圆 · 晃动小球</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background: black;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
      touch-action: none;
      overscroll-behavior: none;
      overflow: hidden;
    }

    .scene {
      position: relative;
      width: 100%;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .glow-ring {
      position: relative;
      width: min(80vw, 80vh);
      height: min(80vw, 80vh);
      max-width: 560px;
      max-height: 560px;
      border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, #111, #000);
      box-shadow:
        0 0 25px rgba(0, 200, 255, 0.7),
        0 0 60px rgba(0, 180, 255, 0.4),
        inset 0 0 30px rgba(0, 220, 255, 0.2),
        inset 0 0 10px rgba(0, 255, 255, 0.3);
      border: 1px solid rgba(0, 200, 255, 0.4);
    }

    .glow-ring::after {
      content: '';
      position: absolute;
      inset: -2px;
      border-radius: 50%;
      box-shadow: 0 0 15px #00c8ff, 0 0 30px #0088ff;
      opacity: 0.5;
      filter: blur(3px);
      z-index: -1;
    }

    .balls-layer {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      overflow: hidden;
    }

    .ball {
      position: absolute;
      left: 0;
      top: 0;
      border-radius: 50%;
      will-change: transform;
    }

    .hint {
      position: fixed;
      bottom: 16px;
      left: 0;
      right: 0;
      text-align: center;
      color: rgba(120, 220, 255, 0.6);
      font-size: 14px;
      letter-spacing: 2px;
      pointer-events: none;
      text-shadow: 0 0 10px #00aaff;
      z-index: 10;
    }
  </style>
</head>
<body>
  <div class="scene">
    <div class="glow-ring" id="glowRing">
      <div class="balls-layer" id="ballsLayer"></div>
    </div>
  </div>
  <div class="hint">晃动手机 · 甩一甩试试</div>

  <script>
    (function() {
      // ---------- 配置 ----------
      const BALL_COUNT   = 7;
      const FRICTION_LOW = 0.995;  // 低速时：几乎无阻尼 → 跟手停住
      const FRICTION_HIGH= 0.92;   // 高速时：保留一些阻尼，但能飞
      const WALL_BOUNCE  = 0.75;
      const BALL_BOUNCE  = 0.8;
      const FORCE        = 0.55;   // 倾斜力（减少，避免盖过甩动）
      const SENSITIVITY  = 2.0;
      const MAX_SPEED    = 25;     // 放开限速，让甩能飞
      const DEAD_ZONE    = 0.05;
      const SHAKE_GAIN   = 22;     // 甩动加速度 → 速度 的放大倍数

      const COLORS = [
        '#4df0ff', '#3a9eff', '#b84dff', '#00e0c0',
        '#5f7aff', '#ff4dd0', '#7af0ff',
      ];

      const ring       = document.getElementById('glowRing');
      const ballsLayer = document.getElementById('ballsLayer');

      let ringW = 0, ringH = 0;
      let ballRadius = 8;

      let balls = [];

      // 手机倾斜 (-1 ~ 1)
      let tiltX = 0, tiltY = 0;

      // ---------- 初始化 ----------
      function init() {
        const rect = ring.getBoundingClientRect();
        ringW = rect.width;
        ringH = rect.height;
        ballRadius = Math.max(7, Math.min(14, ringW * 0.04));

        balls = [];
        ballsLayer.innerHTML = '';

        const cx = ringW / 2;
        const cy = ringH / 2;
        const maxR = ringW / 2 - ballRadius - 4;
        const minDist = ballRadius * 2.1;
        const minDistSq = minDist * minDist;

        for (let i = 0; i < BALL_COUNT; i++) {
          let x = 0, y = 0, ok = false, tries = 0;

          while (!ok && tries < 300) {
            ok = true;
            const a = Math.random() * Math.PI * 2;
            const r = Math.sqrt(Math.random()) * maxR;
            x = cx + Math.cos(a) * r;
            y = cy + Math.sin(a) * r;

            for (let b of balls) {
              const dx = x - b.x, dy = y - b.y;
              if (dx * dx + dy * dy < minDistSq) {
                ok = false;
                break;
              }
            }
            tries++;
          }

          const color = COLORS[i % COLORS.length];
          const el = document.createElement('div');
          el.className = 'ball';
          el.style.width  = ballRadius * 2 + 'px';
          el.style.height = ballRadius * 2 + 'px';
          el.style.background = color;
          el.style.boxShadow = `0 0 10px ${color}, 0 0 20px ${color}80`;
          ballsLayer.appendChild(el);

          balls.push({ x, y, vx: 0, vy: 0, el });
        }

        for (let b of balls) {
          b.el.style.transform = `translate3d(${b.x - ballRadius}px, ${b.y - ballRadius}px, 0)`;
        }
      }

      // ---------- 物理更新 ----------
      function update() {
        const cx = ringW / 2;
        const cy = ringH / 2;
        const maxR = ringW / 2 - ballRadius - 2;

        let fx = Math.abs(tiltX) < DEAD_ZONE ? 0 : tiltX;
        let fy = Math.abs(tiltY) < DEAD_ZONE ? 0 : tiltY;

        for (let b of balls) {
          // 1) 倾斜力（很弱，主要是"跟手"）
          b.vx += fx * FORCE;
          b.vy += fy * FORCE;

          // 2) 动态阻尼：速度越大阻尼越小 → 甩出去能飞，慢下来就停
          const sp = Math.hypot(b.vx, b.vy);
          let friction;
          if (sp > 3) {
            // 高速：弱阻尼（能飞）
            friction = FRICTION_HIGH;
          } else {
            // 低速：强阻尼（跟手、停住）
            friction = FRICTION_LOW;
          }
          b.vx *= friction;
          b.vy *= friction;

          // 限速
          const sp2 = Math.hypot(b.vx, b.vy);
          if (sp2 > MAX_SPEED) {
            b.vx = b.vx / sp2 * MAX_SPEED;
            b.vy = b.vy / sp2 * MAX_SPEED;
          }

          if (Math.abs(b.vx) < 0.05) b.vx = 0;
          if (Math.abs(b.vy) < 0.05) b.vy = 0;

          b.x += b.vx;
          b.y += b.vy;
        }

        // 3) 球与球碰撞
        const r2 = ballRadius * 2;
        const r2Sq = r2 * r2;
        for (let i = 0; i < balls.length; i++) {
          for (let j = i + 1; j < balls.length; j++) {
            const a = balls[i], b = balls[j];
            let dx = b.x - a.x;
            let dy = b.y - a.y;
            let d2 = dx * dx + dy * dy;

            if (d2 > 0 && d2 < r2Sq) {
              const d = Math.sqrt(d2);
              const nx = dx / d;
              const ny = dy / d;

              const overlap = (r2 - d) / 2;
              a.x -= nx * overlap;
              a.y -= ny * overlap;
              b.x += nx * overlap;
              b.y += ny * overlap;

              const rvx = b.vx - a.vx;
              const rvy = b.vy - a.vy;
              const vn = rvx * nx + rvy * ny;

              if (vn < 0) {
                const impulse = -(1 + BALL_BOUNCE) * vn / 2;
                a.vx -= impulse * nx;
                a.vy -= impulse * ny;
                b.vx += impulse * nx;
                b.vy += impulse * ny;
              }
            }
          }
        }

        // 4) 圆形边界
        for (let b of balls) {
          let dx = b.x - cx;
          let dy = b.y - cy;
          const dist = Math.hypot(dx, dy);

          if (dist > maxR) {
            const nx = dx / (dist || 1);
            const ny = dy / (dist || 1);

            b.x = cx + nx * maxR;
            b.y = cy + ny * maxR;

            const vn = b.vx * nx + b.vy * ny;
            if (vn > 0) {
              b.vx -= (1 + WALL_BOUNCE) * vn * nx;
              b.vy -= (1 + WALL_BOUNCE) * vn * ny;
            }
          }

          b.el.style.transform = `translate3d(${b.x - ballRadius}px, ${b.y - ballRadius}px, 0)`;
        }
      }

      function animate() {
        update();
        requestAnimationFrame(animate);
      }

      // ---------- 陀螺仪 ----------
      function onOrientation(e) {
        const beta  = e.beta  || 0;
        const gamma = e.gamma || 0;
        tiltX = Math.max(-1, Math.min(1, gamma / 60)) * SENSITIVITY * 0.3;
        tiltY = Math.max(-1, Math.min(1, beta  / 60)) * SENSITIVITY * 0.3;
      }

      // ---------- 甩动检测（devicemotion） ----------
      // 使用加速度变化量来检测"甩"，把甩的冲量加到每个小球上
      let lastShakeX = 0, lastShakeY = 0;
      let lastShakeTime = 0;

      function onMotion(e) {
        const acc = e.accelerationIncludingGravity;
        if (!acc) return;

        const now = performance.now();
        if (now - lastShakeTime < 16) return; // 节流

        const dt = Math.max(16, now - lastShakeTime) / 1000;
        lastShakeTime = now;

        const ax = acc.x || 0;
        const ay = acc.y || 0;

        // 加速度变化量 → 甩动力度
        const dax = ax - lastShakeX;
        const day = ay - lastShakeY;
        lastShakeX = ax;
        lastShakeY = ay;

        // 转成速度增量（注意坐标方向：设备 x 向右，y 向上，与屏幕 y 向下相反）
        // 甩动力度 = 加速度变化 * 系数，限幅
        let pushX = Math.max(-1, Math.min(1, dax / 15)) * SHAKE_GAIN;
        let pushY = Math.max(-1, Math.min(1, day / 15)) * SHAKE_GAIN;

        // device y 向上 → 屏幕 y 向下，取反
        pushY = -pushY;

        // 加到所有小球上（甩一下整个都飞）
        for (let b of balls) {
          b.vx += pushX;
          b.vy += pushY;
        }
      }

      function requestPermission() {
        if (typeof DeviceOrientationEvent !== 'undefined' &&
            typeof DeviceOrientationEvent.requestPermission === 'function') {
          DeviceOrientationEvent.requestPermission()
            .then(state => {
              if (state === 'granted') {
                window.addEventListener('deviceorientation', onOrientation);
              }
            })
            .catch(() => {});
        }
        if (typeof DeviceMotionEvent !== 'undefined' &&
            typeof DeviceMotionEvent.requestPermission === 'function') {
          DeviceMotionEvent.requestPermission()
            .then(state => {
              if (state === 'granted') {
                window.addEventListener('devicemotion', onMotion);
              }
            })
            .catch(() => {});
        }
      }

      // ---------- 启动 ----------
      window.addEventListener('load', () => {
        init();
        animate();

        if (window.DeviceOrientationEvent) {
          if (typeof DeviceOrientationEvent.requestPermission === 'function') {
            const trigger = () => {
              requestPermission();
              document.body.removeEventListener('touchstart', trigger);
              document.body.removeEventListener('click', trigger);
            };
            document.body.addEventListener('touchstart', trigger, { once: true });
            document.body.addEventListener('click', trigger, { once: true });
          } else {
            window.addEventListener('deviceorientation', onOrientation);
            if (window.DeviceMotionEvent) {
              window.addEventListener('devicemotion', onMotion);
            }
          }
        }
      });

      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(init, 150);
      });
      window.addEventListener('orientationchange', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(init, 250);
      });

    })();
  </script>
</body>
</html>