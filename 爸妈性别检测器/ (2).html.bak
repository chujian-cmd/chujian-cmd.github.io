<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>爸妈性别检测器</title>
<style>
  /* 模仿 tkinter 经典风格：灰色系统底色、立体浮雕边框、系统默认字体 */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    background: #d4d0c8;              /* 经典 Windows 95/98 灰 */
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: "MS Sans Serif", "Segoe UI", Tahoma, "Microsoft YaHei", sans-serif;
    font-size: 13px;
    color: #000000;
    padding: 20px;
  }

  /* 主窗口 —— 模仿 tkinter 的 Tk 窗口：灰底 + 外凸边框 */
  .window {
    background: #d4d0c8;
    width: 340px;
    padding: 2px;                     /* 留出边框厚度 */
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #808080;
    border-bottom: 2px solid #808080;
    box-shadow: 1px 1px 0 #000000;
  }

  /* 标题栏 —— 模仿 tkinter 窗口标题栏 */
  .titlebar {
    background: #000080;              /* 经典深蓝 */
    color: #ffffff;
    font-size: 12px;
    font-weight: bold;
    padding: 3px 5px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    letter-spacing: 1px;
    border-bottom: 1px solid #000000;
  }

  .titlebar .title-text {
    font-family: "MS Sans Serif", "Segoe UI", Tahoma, "Microsoft YaHei", sans-serif;
  }

  /* 模拟窗口按钮 */
  .titlebar .win-buttons {
    display: flex;
    gap: 2px;
  }

  .titlebar .win-buttons span {
    display: inline-block;
    width: 16px;
    height: 14px;
    background: #d4d0c8;
    border-top: 1px solid #ffffff;
    border-left: 1px solid #ffffff;
    border-right: 1px solid #808080;
    border-bottom: 1px solid #808080;
    color: #000000;
    font-size: 9px;
    line-height: 12px;
    text-align: center;
    font-weight: bold;
    font-family: "MS Sans Serif", sans-serif;
    cursor: default;
  }

  /* 内容区 */
  .content {
    padding: 16px 14px 14px 14px;
  }

  /* 说明标签 —— 模仿 tkinter Label */
  .label {
    background: #d4d0c8;
    font-size: 13px;
    color: #000000;
    margin-bottom: 14px;
    line-height: 1.5;
    text-align: left;
  }

  /* 按钮组 —— 横排 */
  .button-row {
    display: flex;
    gap: 12px;
    margin-bottom: 14px;
  }

  /* 经典 tkinter 按钮：凸起浮雕效果 */
  .btn {
    flex: 1;
    background: #d4d0c8;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #808080;
    border-bottom: 2px solid #808080;
    box-shadow: 1px 1px 0 #000000;
    color: #000000;
    font-family: "MS Sans Serif", "Segoe UI", Tahoma, "Microsoft YaHei", sans-serif;
    font-size: 13px;
    padding: 6px 0;
    text-align: center;
    cursor: pointer;
    user-select: none;
    letter-spacing: 2px;
  }

  /* 按下效果：凹陷 */
  .btn:active {
    border-top: 2px solid #808080;
    border-left: 2px solid #808080;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
    box-shadow: none;
    transform: translate(1px, 1px);
  }

  .btn:focus {
    outline: 1px dotted #000000;
    outline-offset: -4px;
  }

  /* 结果显示区 —— 模仿 tkinter 的 Entry/Label 凹陷效果 */
  .result-box {
    background: #ffffff;
    border-top: 2px solid #808080;
    border-left: 2px solid #808080;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
    box-shadow: inset 1px 1px 0 #000000;
    padding: 10px 12px;
    font-size: 14px;
    color: #000000;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: "MS Sans Serif", "Segoe UI", Tahoma, "Microsoft YaHei", sans-serif;
    word-break: break-word;
  }

  /* 仿 tkinter 弹出消息框的样式（用于点击按钮时的弹窗） */
  .dialog-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.2);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    visibility: hidden;
    opacity: 0;
    transition: none;
  }

  .dialog-overlay.active {
    visibility: visible;
    opacity: 1;
  }

  /* 弹窗窗口 —— 经典 tkinter messagebox 风格 */
  .dialog {
    background: #d4d0c8;
    padding: 2px;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #808080;
    border-bottom: 2px solid #808080;
    box-shadow: 2px 2px 0 #000000;
    min-width: 260px;
    max-width: 320px;
  }

  .dialog-titlebar {
    background: #000080;
    color: #ffffff;
    font-size: 12px;
    font-weight: bold;
    padding: 3px 6px;
    letter-spacing: 1px;
  }

  .dialog-body {
    padding: 18px 16px 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .dialog-message {
    font-size: 13px;
    color: #000000;
    text-align: center;
    line-height: 1.6;
    font-family: "MS Sans Serif", "Segoe UI", Tahoma, "Microsoft YaHei", sans-serif;
  }

  .dialog-btn-wrap {
    display: flex;
    justify-content: center;
  }

  .dialog-ok-btn {
    background: #d4d0c8;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #808080;
    border-bottom: 2px solid #808080;
    box-shadow: 1px 1px 0 #000000;
    color: #000000;
    font-family: "MS Sans Serif", "Segoe UI", Tahoma, "Microsoft YaHei", sans-serif;
    font-size: 13px;
    padding: 3px 24px;
    cursor: pointer;
    user-select: none;
    min-width: 76px;
  }

  .dialog-ok-btn:active {
    border-top: 2px solid #808080;
    border-left: 2px solid #808080;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
    box-shadow: none;
    transform: translate(1px, 1px);
  }

  .dialog-ok-btn:focus {
    outline: 1px dotted #000000;
    outline-offset: -4px;
  }

  /* 底部状态栏文字 —— 仿 tkinter 底部提示 */
  .status-bar {
    background: #d4d0c8;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #808080;
    border-bottom: 2px solid #808080;
    padding: 4px 6px;
    font-size: 11px;
    color: #000000;
    letter-spacing: 0.5px;
    margin-top: 12px;
    text-align: center;
  }
</style>
</head>
<body>

<!-- 主窗口 -->
<div class="window">
  <div class="titlebar">
    <span class="title-text">爸妈性别检测器</span>
    <div class="win-buttons">
      <span>_</span>
      <span>□</span>
      <span>×</span>
    </div>
  </div>

  <div class="content">
    <div class="label">
      请点击下方按钮，检测对应人物的性别：
    </div>

    <div class="button-row">
      <button class="btn" id="btnDad">爸 爸</button>
      <button class="btn" id="btnMom">妈 妈</button>
    </div>

    <div class="result-box" id="resultBox">等待检测…</div>

    <div class="status-bar">
      状态：就绪 | 点击按钮弹出结果
    </div>
  </div>
</div>

<!-- 仿 tkinter messagebox 弹窗 -->
<div class="dialog-overlay" id="dialogOverlay">
  <div class="dialog">
    <div class="dialog-titlebar" id="dialogTitle">检测结果</div>
    <div class="dialog-body">
      <div class="dialog-message" id="dialogMessage"></div>
      <div class="dialog-btn-wrap">
        <button class="dialog-ok-btn" id="dialogOkBtn">确 定</button>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    // DOM 元素
    const btnDad = document.getElementById('btnDad');
    const btnMom = document.getElementById('btnMom');
    const resultBox = document.getElementById('resultBox');
    const dialogOverlay = document.getElementById('dialogOverlay');
    const dialogTitle = document.getElementById('dialogTitle');
    const dialogMessage = document.getElementById('dialogMessage');
    const dialogOkBtn = document.getElementById('dialogOkBtn');

    // 人物数据
    const personData = {
      dad: { name: '爸爸', gender: '男性' },
      mom: { name: '妈妈', gender: '女性' }
    };

    // 显示弹窗
    function showDialog(title, message) {
      dialogTitle.textContent = title;
      dialogMessage.textContent = message;
      dialogOverlay.classList.add('active');
      // 让确定按钮获得焦点，方便回车关闭
      dialogOkBtn.focus();
    }

    // 关闭弹窗
    function closeDialog() {
      dialogOverlay.classList.remove('active');
    }

    // 检测并显示结果
    function detectPerson(key) {
      const person = personData[key];
      if (!person) return;

      // 更新下方结果框
      resultBox.textContent = `${person.name} 的性别是：${person.gender}`;

      // 弹出仿 tkinter 消息框
      showDialog(
        '性别检测结果',
        `您检测的是【${person.name}】\n性别：${person.gender}`
      );
    }

    // 绑定按钮事件
    btnDad.addEventListener('click', function() {
      detectPerson('dad');
    });

    btnMom.addEventListener('click', function() {
      detectPerson('mom');
    });

    // 弹窗确定按钮关闭
    dialogOkBtn.addEventListener('click', closeDialog);

    // 点击遮罩层也可关闭（但保留点击确定按钮的更常见交互）
    dialogOverlay.addEventListener('click', function(e) {
      if (e.target === dialogOverlay) {
        closeDialog();
      }
    });

    // 键盘回车 / ESC 关闭弹窗
    document.addEventListener('keydown', function(e) {
      if (dialogOverlay.classList.contains('active')) {
        if (e.key === 'Enter' || e.key === 'Escape') {
          e.preventDefault();
          closeDialog();
        }
      }
    });

    // 初始状态
    resultBox.textContent = '等待检测…';
  })();
</script>
</body>
</html>