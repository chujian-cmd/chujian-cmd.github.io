<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>人物性别检测器</title>
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    background: #d4d0c8;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    font-family: "MS Sans Serif", "Segoe UI", Tahoma, "Microsoft YaHei", sans-serif;
    font-size: 13px;
    color: #000000;
    padding: 20px;
  }

  .window {
    background: #d4d0c8;
    width: 360px;
    padding: 2px;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #808080;
    border-bottom: 2px solid #808080;
    box-shadow: 1px 1px 0 #000000;
  }

  .titlebar {
    background: #000080;
    color: #ffffff;
    font-size: 12px;
    font-weight: bold;
    padding: 3px 5px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    letter-spacing: 1px;
    border-bottom: 1px solid #000000;
  }

  .titlebar .win-buttons {
    display: flex;
    gap: 2px;
  }

  .titlebar .win-buttons span {
    display: inline-block;
    width: 16px;
    height: 14px;
    background: #d4d0c8;
    border-top: 1px solid #ffffff;
    border-left: 1px solid #ffffff;
    border-right: 1px solid #808080;
    border-bottom: 1px solid #808080;
    color: #000000;
    font-size: 9px;
    line-height: 12px;
    text-align: center;
    font-weight: bold;
    cursor: default;
  }

  .content {
    padding: 16px 14px 14px 14px;
  }

  .label {
    background: #d4d0c8;
    font-size: 13px;
    margin-bottom: 14px;
    line-height: 1.5;
  }

  /* 按钮区改成网格，容纳更多人物 */
  .button-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 14px;
  }

  .btn {
    background: #d4d0c8;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #808080;
    border-bottom: 2px solid #808080;
    box-shadow: 1px 1px 0 #000000;
    color: #000000;
    font-family: "MS Sans Serif", "Segoe UI", Tahoma, "Microsoft YaHei", sans-serif;
    font-size: 13px;
    padding: 6px 0;
    text-align: center;
    cursor: pointer;
    user-select: none;
    letter-spacing: 2px;
    /* 去掉点击后浏览器默认的蓝色焦点框 */
    -webkit-tap-highlight-color: transparent;
  }

  .btn:focus {
    outline: none;              /* 彻底去掉焦点蓝框 */
  }

  /* 用焦点样式代替：只在键盘操作时显示虚线框（无障碍友好） */
  .btn:focus-visible {
    outline: 1px dotted #000000;
    outline-offset: -4px;
  }

  .btn:active {
    border-top: 2px solid #808080;
    border-left: 2px solid #808080;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
    box-shadow: none;
    transform: translate(1px, 1px);
  }

  /* 按钮禁用状态：检测中 */
  .btn:disabled {
    color: #808080;
    text-shadow: 1px 1px 0 #ffffff;
    cursor: default;
  }

  .btn:disabled:active {
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #808080;
    border-bottom: 2px solid #808080;
    box-shadow: 1px 1px 0 #000000;
    transform: none;
  }

  .result-box {
    background: #ffffff;
    border-top: 2px solid #808080;
    border-left: 2px solid #808080;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
    box-shadow: inset 1px 1px 0 #000000;
    padding: 10px 12px;
    font-size: 14px;
    color: #000000;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: "MS Sans Serif", "Segoe UI", Tahoma, "Microsoft YaHei", sans-serif;
    word-break: break-word;
  }

  .status-bar {
    background: #d4d0c8;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #808080;
    border-bottom: 2px solid #808080;
    padding: 4px 6px;
    font-size: 11px;
    color: #000000;
    letter-spacing: 0.5px;
    margin-top: 12px;
    text-align: center;
  }

  /* 弹窗 */
  .dialog-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.2);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    visibility: hidden;
    opacity: 0;
  }

  .dialog-overlay.active {
    visibility: visible;
    opacity: 1;
  }

  .dialog {
    background: #d4d0c8;
    padding: 2px;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #808080;
    border-bottom: 2px solid #808080;
    box-shadow: 2px 2px 0 #000000;
    min-width: 260px;
    max-width: 320px;
  }

  .dialog-titlebar {
    background: #000080;
    color: #ffffff;
    font-size: 12px;
    font-weight: bold;
    padding: 3px 6px;
    letter-spacing: 1px;
  }

  .dialog-body {
    padding: 18px 16px 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .dialog-message {
    font-size: 13px;
    color: #000000;
    text-align: center;
    line-height: 1.7;
    font-family: "MS Sans Serif", "Segoe UI", Tahoma, "Microsoft YaHei", sans-serif;
    white-space: pre-line;
  }

  .dialog-btn-wrap {
    display: flex;
    justify-content: center;
  }

  .dialog-ok-btn {
    background: #d4d0c8;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #808080;
    border-bottom: 2px solid #808080;
    box-shadow: 1px 1px 0 #000000;
    color: #000000;
    font-family: "MS Sans Serif", "Segoe UI", Tahoma, "Microsoft YaHei", sans-serif;
    font-size: 13px;
    padding: 3px 24px;
    cursor: pointer;
    user-select: none;
    min-width: 76px;
    -webkit-tap-highlight-color: transparent;
  }

  .dialog-ok-btn:focus {
    outline: none;
  }

  .dialog-ok-btn:focus-visible {
    outline: 1px dotted #000000;
    outline-offset: -4px;
  }

  .dialog-ok-btn:active {
    border-top: 2px solid #808080;
    border-left: 2px solid #808080;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
    box-shadow: none;
    transform: translate(1px, 1px);
  }
</style>
</head>
<body>

<div class="window">
  <div class="titlebar">
    <span>人物性别检测器</span>
    <div class="win-buttons">
      <span>_</span>
      <span>□</span>
      <span>×</span>
    </div>
  </div>

  <div class="content">
    <div class="label">
      请点击人物按钮，检测对应人物的性别：
    </div>

    <div class="button-grid" id="buttonGrid">
      <button class="btn" data-person="dad">爸 爸</button>
      <button class="btn" data-person="mom">妈 妈</button>
      <button class="btn" data-person="grandpa">爷 爷</button>
      <button class="btn" data-person="grandma">奶 奶</button>
      <button class="btn" data-person="uncle">叔 叔</button>
      <button class="btn" data-person="aunt">阿 姨</button>
      <button class="btn" data-person="brother">哥 哥</button>
      <button class="btn" data-person="sister">姐 姐</button>
    </div>

    <div class="result-box" id="resultBox">等待检测…</div>

    <div class="status-bar" id="statusBar">
      状态：就绪 | 点击按钮弹出结果
    </div>
  </div>
</div>

<!-- 弹窗 -->
<div class="dialog-overlay" id="dialogOverlay">
  <div class="dialog">
    <div class="dialog-titlebar" id="dialogTitle">检测结果</div>
    <div class="dialog-body">
      <div class="dialog-message" id="dialogMessage"></div>
      <div class="dialog-btn-wrap">
        <button class="dialog-ok-btn" id="dialogOkBtn">确 定</button>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const buttonGrid = document.getElementById('buttonGrid');
    const resultBox = document.getElementById('resultBox');
    const statusBar = document.getElementById('statusBar');
    const dialogOverlay = document.getElementById('dialogOverlay');
    const dialogTitle = document.getElementById('dialogTitle');
    const dialogMessage = document.getElementById('dialogMessage');
    const dialogOkBtn = document.getElementById('dialogOkBtn');

    // 人物数据
    const personData = {
      dad:      { name: '爸爸', gender: '男性' },
      mom:      { name: '妈妈', gender: '女性' },
      grandpa:  { name: '爷爷', gender: '男性' },
      grandma:  { name: '奶奶', gender: '女性' },
      uncle:    { name: '叔叔', gender: '男性' },
      aunt:     { name: '阿姨', gender: '女性' },
      brother:  { name: '哥哥', gender: '男性' },
      sister:   { name: '姐姐', gender: '女性' }
    };

    let busy = false;   // 防止重复点击
    let dialogTimer = null;

    function showDialog(title, message) {
      dialogTitle.textContent = title;
      dialogMessage.textContent = message;
      dialogOverlay.classList.add('active');
      dialogOkBtn.focus();
    }

    function closeDialog() {
      dialogOverlay.classList.remove('active');
    }

    // 检测某个按钮对应的人物，加入延迟
    function detectPerson(btn) {
      if (busy) return;
      const key = btn.dataset.person;
      const person = personData[key];
      if (!person) return;

      busy = true;

      // 把按钮显示成“检测中”
      const originalText = btn.textContent;
      btn.textContent = '检测中…';
      btn.disabled = true;
      resultBox.textContent = '正在检测…';
      statusBar.textContent = '状态：检测中，请稍候…';

      // 延迟 900ms 再出结果，反应不那么快
      setTimeout(function() {
        // 恢复按钮
        btn.textContent = originalText;
        btn.disabled = false;
        busy = false;

        // 更新结果显示框
        resultBox.textContent = `${person.name} 的性别是：${person.gender}`;
        statusBar.textContent = '状态：检测完成 | 可继续点击其他人物';

        // 弹出仿 tkinter 消息框
        showDialog('性别检测结果',
          `您检测的是【${person.name}】\n性别：${person.gender}`);
      }, 900);
    }

    // 给所有人物按钮绑定事件
    const allBtns = buttonGrid.querySelectorAll('.btn');
    allBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        detectPerson(btn);
      });
    });

    // 弹窗关闭
    dialogOkBtn.addEventListener('click', closeDialog);
    dialogOverlay.addEventListener('click', function(e) {
      if (e.target === dialogOverlay) closeDialog();
    });

    document.addEventListener('keydown', function(e) {
      if (dialogOverlay.classList.contains('active')) {
        if (e.key === 'Enter' || e.key === 'Escape') {
          e.preventDefault();
          closeDialog();
        }
      }
    });

    // 初始
    resultBox.textContent = '等待检测…';
    statusBar.textContent = '状态：就绪 | 点击按钮弹出结果';
  })();
</script>
</body>
</html>